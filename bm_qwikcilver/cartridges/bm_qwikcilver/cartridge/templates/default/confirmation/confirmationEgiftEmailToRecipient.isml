<isinclude template="/components/modules" sf-toolkit="off" />
<isdecorate template="common/layout/email">
    <isset name="urlHelpers" value="${require('*/cartridge/scripts/helpers/urlHelpers')}" scope="page" />
    <isscript>
        var orderBase = dw.crypto.Encoding.toBase64(new dw.util.Bytes(pdict.order.orderNumber))
    </isscript>
    <tr style="padding: 0;">
        <td style="vertical-align: middle; text-align: center; color: #333; font-size:14px;">
            <table style="padding-top:35px;" cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
                <tr style="padding: 0;">
                    <td style="padding:0 32px 15px;vertical-align:top;text-align:left;">
                        <iscomment> Gift Card Image Details </iscomment>
                        <div style="border:2px solid #f2f2f2;padding:15px 0 24px; margin-bottom:30px;">
                            <p
                                style="margin:0;font-size:36px;line-height:50px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center">
                                <isprint value="${Resource.msg('egift.surprise.heading', 'giftcards', null)}"
                                    encoding="off" />
                            </p>
                            <p
                                style="margin:0 0 20px;font-size:16px;line-height:18px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center;text-transform: capitalize;">
                                ${Resource.msgf('egift.treated.msg', 'giftcards', null, pdict.senderName)}
                            </p>
                            <iscomment> Normal Product Line Items </iscomment>
                            <table width="100%" cellpadding="0" cellspacing="0"
                                style="border-collapse:collapse;margin-top:15px;">
                                <tbody>
                                    <isset name="lineItem" value="${pdict.lineItem}" scope="page" />
                                    <isif
                                        condition="${pdict.sendEmailNow && pdict.recipientEmail}">
                                        <tr>
                                            <td
                                                style="vertical-align:middle;padding-left: 32px;padding-right: 15px;width: 50%;">

                                                    <img src="${lineItem.images.large[0].absURL}"
                                                        alt="${lineItem.images.large[0].alt}"
                                                        title="${lineItem.images.large[0].title}"
                                                        style="border:0;vertical-align:top;width:100%;max-height: 261px;height: 100%;max-width:261px;"
                                                        width="261" />
                                                <p
                                                    style="color:#666;font-size:14px;line-height:18px;padding: 0;margin: 5px 0 0;text-align:left;">
                                                    ${Resource.msg('egift.amount.label', 'giftcards', null)}
                                                </p>
                                                <p
                                                    style="color:#000000;font-size:20px;font-weight:bold;padding:0;margin: 5px 0;text-align:left;">
                                                    ${pdict.amount}</p>
                                                <p
                                                    style="margin:0;color:#000000;font-size:14px;line-height:18px;padding:0;text-align:left;">
                                                    ${Resource.msg('egift.useit.store.text', 'giftcards', null)}
                                                </p>
                                            </td>
                                            <td style="padding: 0;vertical-align:top;width: 30%;">
                                                <iscomment>
                                                    <div
                                                        style="text-transform:uppercase;font-size:16px;color:#333;margin-bottom:15px;line-height:23px">
                                                        <a href="${URLUtils.https('Product-Show', 'pid', lineItem.id)}"
                                                            title="${lineItem.productName}"
                                                            style="text-decoration:none;text-transform:uppercase;font-size:16px;color:#333;line-height:23px;margin-bottom:15px;font-family:'HelveticaNeue-Light',Arial,sans-serif"
                                                            target="_blank">${lineItem.productName}</a>
                                                    </div>
                                                </iscomment>
                                                <div
                                                    style="text-transform: capitalize;color:#666;font-size:14px;line-height:18px;margin-bottom:15px;">
                                                    ${pdict.recipientName + ','}
                                                </div>
                                                <isif
                                                    condition="${pdict.eGiftMessage && pdict.eGiftMessage !== null}">
                                                    <div
                                                        style="color:#666;font-size:14px;line-height:18px;margin-bottom:15px;">
                                                        ${pdict.eGiftMessage}
                                                    </div>
                                                </isif>
                                                <div
                                                    style="color:#666;font-size:14px;line-height:18px;text-transform: capitalize;">
                                                    ${'- ' + pdict.senderName}
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td colspan="3" align="center">
                                                <p
                                                    style="margin:0;font-size:30px;line-height:40px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center">
                                                    <isprint
                                                        value="${Resource.msg('egift.card.number', 'giftcards', null)}"
                                                        encoding="off" />
                                                </p>
                                                <isif condition="${pdict.giftcardNumber !== null}">
                                                    <p
                                                        style="margin:0;font-size:18px;line-height:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center">
                                                        ${pdict.giftcardNumber}
                                                    </p>
                                                </isif>
                                                <p
                                                    style="margin:15px 0 0;font-size:30px;line-height:40px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center">
                                                    <isprint
                                                        value="${Resource.msg('egift.card.pin', 'giftcards', null)}"
                                                        encoding="off" /><span> -
                                                        ${pdict.cardPin}</span>
                                                </p>
                                                <p
                                                    style="margin:15px 0 0;font-size:30px;line-height:40px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center">
                                                    ${pdict.amount}
                                                </p>
                                                <p
                                                    style="font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#000000;font-size: 14px;text-align:center;">
                                                    <img style="display:block;margin:0 auto;"
                                                        src="${pdict.eGiftBarCodeURL}"
                                                        alt="eGift Barcode" />
                                                    <isif condition="${pdict.eGiftBarCode}">
                                                        <span style="display:inline-block"
                                                            class="card-no">${pdict.eGiftBarCode}</span>
                                                    </isif>
                                                </p>
                                                <p
                                                    style="font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#000000;font-weight:600;">
                                                    ${Resource.msg('confirm.order.card.expiry.date', 'giftcards', null)}<span
                                                        style="font-size: 14px; padding-left: 5px;font-style: italic;">${pdict.expiryDate}</span>
                                                </p>
                                            </td>
                                        </tr>
                                        <iscomment> <tr>
                                            <td colspan="3" style="border-top:1px solid #f2f2f2;margin-bottom:30px;">
                                                <p
                                                    style="margin:15px 0 0;font-size:14px;line-height:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;text-align:center">
                                                    <isif condition="${'eGiftVideoLink' in pdict && pdict.eGiftVideoLink && pdict
                                                                     .eGiftVideoLink !== 'undefined'}">
                                                        <a style="font-size: 16px;font-weight: 600;text-decoration:underline;color:#005699;text-align:center;"
                                                            href="${URLUtils.abs('Giftcard-GiftcardVideoLandingPage', 'video', orderBase, 'uuid', lineItem.UUID)}">
                                                            ${Resource.msg('special.message.text', 'giftcards', null)}
                                                        </a>
                                                    </isif>
                                                </p>
                                            </td>
                                        </tr> </iscomment>
                                    </isif>
                                </tbody>
                            </table>
                        </div>
                        <div>
                            <iscomment> You've got it Content Asset </iscomment>
                            <isprint value="${pdict.barCodeMarkup}" encoding="off" />
                        </div>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</isdecorate>
