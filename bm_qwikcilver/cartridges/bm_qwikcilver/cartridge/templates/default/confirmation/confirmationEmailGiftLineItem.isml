<table border="0" cellpadding="0" cellspacing="0" width="100%" bgcolor="#EFEDEB" style="background-color: #f6f4f2;">
    <tbody>
        <tr>
            <td align="center" bgcolor="#EFEDEB" style="background-color: #f6f4f2;">
                <table border="0" cellpadding="0" cellspacing="0" width="660" class="devicewidth" align="center">
                    <tbody>
                        <tr>
                            <td bgcolor="#F6F4F2" align="center" style="background-color: #f6f4f2;">
                                <table border="0" cellpadding="0" cellspacing="0" width="600" class="devicewidth"
                                    align="center">
                                    <tbody>
                                        <tr>
                                            <td align="center" bgcolor="#F6F4F2" style="background-color: #F6F4F2;">
                                                <table border="0" cellpadding="0" cellspacing="0" width="560">
                                                    <tbody>
                                                        <tr>
                                                            <td height="40"
                                                                style="height: 40px;font-size:0px;mso-line-height-rule:exactly;line-height: 0px;">
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td align="center"
                                                                style="font-family: 'Times New Roman', Times, serif; font-size: 24px; letter-spacing: 1px; line-height: 30px; color:#1A1919">
                                                                ${Resource.msgf('egift.title', 'common', null, pdict.recipientName)}
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td height="20"
                                                                style="height: 20px;font-size:0px;mso-line-height-rule:exactly;line-height: 0px;">
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td align="center"
                                                                style="font-family: 'Times New Roman',Times,serif;font-size: 24px;letter-spacing: 1px; line-height: 30px; color: #1a1919;">
                                                                ${pdict.eGiftMessage} </td>
                                                        </tr>
                                                        <tr>
                                                            <td height="20"
                                                                style="height: 20px;font-size:0px;mso-line-height-rule:exactly;line-height: 0px;">
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td align="center" bgcolor="#F6F4F2"
                                                                style="background-color: #F6F4F2;"></td>
                                                        </tr>
                                                        <tr>
                                                            <td height="20"
                                                                style="height: 20px;font-size:0px;mso-line-height-rule:exactly;line-height: 0px;">
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td align="center">
                                                                <table border="0" cellspacing="0" cellpadding="0"
                                                                    width="230">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td valign="top" width="10">
                                                                                <isif
                                                                                    condition="${pdict.lineItem.ispersonalizedGiftcard}">
                                                                                    <img width="100%"
                                                                                        src="${pdict.lineItem.personalizeGiftcardImage}"
                                                                                        alt="personalized giftcard" />
                                                                                <iselse/>
                                                                                    <img width="100%"
                                                                                        src="${pdict.lineItem.images.large[0].absURL}"
                                                                                        alt="${pdict.lineItem.images.large[0].alt}" />
                                                                                </isif>
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td height="20"
                                                                                style="height: 20px;font-size:0px;mso-line-height-rule:exactly;line-height: 0px;">
                                                                            </td>
                                                                        </tr>
                                                                        <tr>
                                                                            <td width="200" height="48" align="center"
                                                                                valign="middle" bgcolor="#453f3f"
                                                                                style="background-color: #453f3f;">
                                                                                <a href=<isif
                                                                                    condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('hasAliases')}">
                                                                                    "https://${request.httpHost}/<isif
                                                                                        condition="${require('dw/system/Site').current.getCustomPreferenceValue('SelectSite').value === 'multilingualSite'}">
                                                                                        ${request.getLocale().toString().substring(0, 2)}
                                                                                    </isif>"
                                                                                <iselse/>
                                                                                    ${URLUtils.abs(new  dw.web.URLAction('Home-Show', dw.system.Site.current.ID))}
                                                                                    </isif> target="_blank"
                                                                                    style="font-family: 'Scala Sans OT',
                                                                                    Helvetica, sans-serif; font-size:
                                                                                    12px; color: #ffffff;
                                                                                    text-transform: uppercase;
                                                                                    letter-spacing: 2px;
                                                                                    text-decoration: none; display:
                                                                                    inline-block; line-height: 14px;"
                                                                                    class="btn_label">${Resource.msg('egiftCard.button', 'common', null)}</a>
                                                                            </td>
                                                                        </tr>
                                                                        <iscomment> <tr>
                                                                            <td>
                                                                                <p
                                                                                    style="text-align: center; font-family: Arial,Helvetica,sans-serif;font-size: 14px;line-height: 24px;color: #453f3f;">
                                                                                    ${Resource.msg('giftCard.text.description', 'common', null)}
                                                                                </p>
                                                                            </td>
                                                                        </tr> </iscomment>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <p
                                                                    style="margin-top: 30px;margin-bottom:0;text-align: center;font-family: 'Times New Roman',Times,serif;font-size:16px;line-height:24px;color: #865;">
                                                                    <a href="${dw.web.URLUtils.abs(new  dw.web.URLAction('Faq-GiftcardBalance', dw.system.Site.current.ID))}"
                                                                        style="text-decoration: unset;color: #865;">
                                                                        ${Resource.msg('giftCard.text.checkBalance', 'common', null)}
                                                                    </a><a
                                                                        href="${dw.web.URLUtils.abs(new  dw.web.URLAction('Page-Show', dw.system.Site.current.ID), new dw.web.URLParameter('cid', 'faq-gift-card-terms-and-con'))}"
                                                                        style="text-align: center;font-family: 'Times New Roman',Times,serif;font-size:16px;line-height:24px;color: #865;text-decoration: unset;">${Resource.msg('faq.text.title', 'common', null)}</a>
                                                                </p>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center">
                                                                <table width="600" style="width:600px;" align="center">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td align="center">
                                                                                <h4
                                                                                    style="font-family: 'Times New Roman',Times,serif;font-size: 24px;letter-spacing: 1px;line-height: 30px;color: #1a1919; margin-bottom: 10px;">
                                                                                    <span>${Resource.msg('egift.card.number', 'common', null)}</span>
                                                                                    <isif
                                                                                        condition="${pdict.giftcardNumber !== null}">
                                                                                        <p
                                                                                            style="font-size: 18px;color: black;font-weight:600;line-height:22px;margin:0;color: #1a1919;margin-bottom: 5px;">
                                                                                            ${pdict.giftcardNumber}
                                                                                        </p>
                                                                                    </isif>
                                                                                </h4>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center">
                                                                <table width="600" style="width:600px;" align="center">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td align="center">
                                                                                <h4
                                                                                    style="font-family: 'Times New Roman',Times,serif;font-size: 24px;letter-spacing: 1px;line-height: 30px;color: #1a1919;margin-top: 0; margin-bottom: 10px;">
                                                                                    <span>${Resource.msg('egift.card.pin', 'common', null)}</span>${pdict.cardPin}
                                                                                </h4>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td>
                                                                <table align="center">
                                                                    <tr>
                                                                        <td>
                                                                            <h4
                                                                                style="font-family: 'Times New Roman',Times,serif;font-size: 24px;letter-spacing: 1px;line-height: 30px;color: #1a1919;margin: 0px;">
                                                                                ${pdict.amount} </h4>
                                                                        </td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <tr>
            <td>
                <table align="center" style="width:600px">
                    <tbody>
                        <tr>
                            <td
                                style="text-align:left;font:normal 14px/24px Arial,Helvetica Neue,Helvetica,sans-serif;letter-spacing:0.75px;color:#1a1919;">
                                <table align="center" style="width:600px">
                                    <tbody>
                                        <tr>
                                            <td>
                                                <table width="600" style="width: 600px;">
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                <div
                                                                    style="text-align: center; display:block;width: 100%;">
                                                                    <img src="${pdict.eGiftBarCodeURL}"
                                                                        alt="eGift Barcode" />
                                                                    <div class="bar-code">
                                                                        <isif
                                                                            condition="${pdict.eGiftBarCode}">
                                                                            <span
                                                                                class="card-no">${pdict.eGiftBarCode}</span>
                                                                        </isif>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </td>
        </tr>
        <iscomment> <isif
            condition="${'eGiftVideoLink' in lineItem.giftCardDetails && lineItem.giftCardDetails.eGiftVideoLink !== 'undefined'}">
            <tr>
                <td align="center"
                    style="font-family: 'Times New Roman',Times,serif;font-size: 24px;letter-spacing: 1px; line-height: 30px; color: #1a1919;">
                    <a href="${URLUtils.abs( dw.web.URLAction('Qwikcilver-GiftcardVideoLandingPage', dw.system.Site.current.ID), new dw.web.URLParameter('video', lineItem.giftCardDetails.eGiftVideoLink))}"
                        style="font-family: 'Times New Roman',Times,serif;font-size: 24px;letter-spacing: 1px; line-height: 30px; color: #1a1919;text-decoration:underline;">${Resource.msg('special.message.text', 'common', null)}</a>
                </td>
            </tr>
        </isif> </iscomment>
        <tr>
        <tr>
            <td height="20">
            </td>
        </tr>
        <td colspan="2">
            <p
                style="text-align:center;font-size: 18px;color: black;font-weight:600;line-height:22px;margin:0;color: #1a1919;margin-bottom: 5px;">
                ${Resource.msg('confirm.order.card.expiry.date', 'common', null)}<span
                    style="font-size: 15px; padding-left: 5px;font-style: italic;"> <isprint value="${new Date(pdict.expiryDate)}" formatter="dd-MM-YYYY " timezone="SITE" /></span>
            </p>
        </td>
        </tr>
        <tr>
            <td>
                <table align="center" style="width:600px;">
                    <isprint value="${pdict.footerContact}" encoding="off" />
                </table>
            </td>
        </tr>
    </tbody>
</table>
