<!--- TEMPLATENAME: homelanding.isml --->
<isdecorate template="common/MenuFrame">
    <isinclude template="custom/modules" />
    <isinclude template="inc/Modules" />
    <isbreadcrumbs bcurl1="${URLUtils.url('Giftcard-OrderList')}" bctext1="Giftcard Resend" />
    <div class="overview_title_description">
        <table width="100%" cellspacing="0" cellpadding="0" border="0">
            <tbody>
                <tr>
                    <td colspan="5" class="overview_title">${Resource.msg('order.list.title', 'resend', null)}</td>
                </tr>
                <tr>
                    <td colspan="5" class="overview_title_description">You're Searching giftcard orders.</td>
                </tr>
            </tbody>
        </table>
    </div>
    <isinclude template="order/orderlistsearch" />

    <isif condition="${pdict.totalOrderCount == 0}">
        <table class="order-list-empty n w e s" border="0" cellpadding="0" cellspacing="0" width="100%">
            <tbody>
                <tr>
                    <td width="100%" class="table_detail">
                        <p>
                            ${Resource.msg('order.list.noorders', 'common', null)}
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    <iselse/>
        <table width="100%" border="0" cellspacing="0" cellpadding="0" id="filtertableProjects">
            <tbody>
                <tr>
                    <th class="table_header left n e s w" nowrap="nowrap" width="13%">
                        ${Resource.msg('orderid', 'common', null)}</th>
                    <th class="table_header left n e s" nowrap="nowrap" width="13%">
                        ${Resource.msg('orderdate', 'common', null)}</th>
                    <th class="table_header left n e s" nowrap="nowrap" width="21%">
                        ${Resource.msg('email', 'common', null)}</th>
                    <th class="table_header right n e s" nowrap="nowrap" width="13%">
                        ${Resource.msg('total', 'common', null)}</th>
                </tr>
                <isset name="paymentInstrument" value="${null}" scope="page" />
                <isloop items="${pdict.orders}" var="order" status="loopstate">
                    <tr class="list-table">
                        <td class="table_detail w e s" nowrap="nowrap">
                            <a href="${URLUtils.url('Giftcard-OrderDetails', 'OrderNo', order.orderNo)}"
                                target="_blank">${order.orderNo}</a>
                        </td>
                        <isset name="calendarDate" value="${dw.util.Calendar(order.getCreationDate())}" scope="page" />
                        <isset name="creationDate"
                            value="${dw.util.StringUtils.formatCalendar(dw.util.Calendar(calendarDate), 'yyyy-MM-dd HH:mm')}"
                            scope="page" />
                        <td class="table_detail left e s" nowrap="nowrap"><label class="item-label"
                                for="">${creationDate}</label></td>
                        <td class="table_detail left e s" nowrap="nowrap">${order.getCustomerEmail()}</td>
                        <td class="table_detail right e s" nowrap="nowrap">${order.getTotalGrossPrice()}</td>
                    </tr>
                </isloop>
            </tbody>
        </table>
        <table class="pagecursor" width="100%" border="0" cellspacing="1" cellpadding="1">
            <tbody>
                    <td class="pagecursortxt top" nowrap="nowrap">
                        ${Resource.msg('order.list.showing','resend',null)}
                        ${pdict.startRow + '-' + pdict.endRow}
                        ${Resource.msg('order.list.of','resend',null)}
                        ${pdict.totalOrderCount}
                        ${Resource.msg('order.list.items','resend',null)}
                    </td>
                    <isif condition="${pdict.totalOrderCount > 10}">
                        <td class="pagecursortxt top hide-${pdict.pageSize.toFixed()}" nowrap="nowrap">
                            ${Resource.msg('order.list.show','resend',null)}
                            <span class="pagecursortxt ten">
                                <a class="pagecursorbtn perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize',10)}">10</a>
                            </span>
                            <span class="pagecursortxt fifty">
                                <a class="pagecursorbtn perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize',50)}">50</a>
                            </span>
                            <span class="pagecursortxt hundred">
                                <a class="pagecursorbtn perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize',100)}">100</a>
                            </span>
                            <span class="pagecursortxt hundred">
                                <a class="pagecursorbtn perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize',pdict.totalOrderCount)}">All</a>
                            </span>
                            ${Resource.msg('order.list.items','resend',null)}
                        </td>
                        <isif condition="${pdict.pageNumber > 1}">
                            <td class="pagecursortxt" width="1">
                                <a class="pagecursorbtn perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize',pdict.pageSize,'pagenumber',(pdict.pageNumber - 1))}">${Resource.msg('order.list.prev','resend',null)}</a>
                            </td>
                        </isif>

                        <isloop items="${pdict.pages}" var="page" status="loopstatus">
                            <td class="pagecursortxt" width="1">
                                    <a class="pagecursorbtn pagecursoritem perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize', pdict.pageSize,'pagenumber',page)}">
                                        <isif condition="${page === pdict.pageNumber.toString()}">
                                            <b>[${page}]</b>
                                        <iselse/>
                                            ${page}
                                        </isif>
                                    </a>
                            </td>
                        </isloop>
                        <isif condition="${pdict.pageNumber < pdict.pageCount}">
                            <td class="pagecursortxt" width="1">
                                <a class="pagecursorbtn perm_not_disabled" href="${URLUtils.url('Giftcard-OrderList','pagesize',pdict.pageSize,'pagenumber',(pdict.pageNumber + 1))}">${Resource.msg('order.list.next','resend',null)}</a>
                            </td>
                        </isif>
                    </isif>
            </tbody>
        </table>

    </isif>

</isdecorate>