<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
     <type-extension type-id="Order">
       <custom-attribute-definitions>
          <attribute-definition attribute-id="eInvoiceStatus">
                <display-name xml:lang="x-default">E-Invoice Status</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_erp_id">
                <display-name xml:lang="x-default">E-Invoice Erp_Id</display-name>
                <description xml:lang="x-default">Used to fetch invoice-related data.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_number">
                <display-name xml:lang="x-default">E-Invoice Number</display-name>
                <description xml:lang="x-default">Invoice Number.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_qr_code">
                <display-name xml:lang="x-default">E-Invoice QR Code</display-name>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_status">
                <display-name xml:lang="x-default">E-Invoice Status</display-name>
                <description xml:lang="x-default">Status of E-Invoice.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_submittion_date">
                <display-name xml:lang="x-default">E-Invoice Submission Date</display-name>
                <description xml:lang="x-default">Created date of E-Invoice.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
             </custom-attribute-definitions>
              <group-definitions>
               <attribute-group group-id="eInvoice">
                <display-name xml:lang="x-default">E-Invoice Details</display-name>
                <attribute attribute-id="eInvoice_submittion_date"/>
                <attribute attribute-id="eInvoice_erp_id"/>
                <attribute attribute-id="eInvoice_number"/>
                <attribute attribute-id="eInvoice_qr_code"/>
                <attribute attribute-id="eInvoice_status"/>
            </attribute-group>
             </group-definitions>
    </type-extension>  

    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="eInvoice_enable">
                <display-name xml:lang="x-default">Enable E-Invoice</display-name>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_enable_shipping_tax">
                <display-name xml:lang="x-default">E-Invoice Enable Shipping Tax</display-name>
                <description xml:lang="x-default">Apply tax to shipping services.</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>true</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_scope">
                <display-name xml:lang="x-default">E-Invoice Scope</display-name>
                <description xml:lang="x-default">Scope of E-Invoice should be followed by ".default". Ex. 0001-1234-5678/.default</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_supplier_info">
                <display-name xml:lang="x-default">E-Invoice Supplier Info</display-name>
                <description xml:lang="x-default">Supplier Information</description>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="eInvoice_user_agent">
                <display-name xml:lang="x-default">E-Invoice User Agent</display-name>
                <description xml:lang="x-default">User-agent name while submitting the invoice.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="eInvoice">
                <display-name xml:lang="x-default">E-Invoice Config</display-name>
                <attribute attribute-id="eInvoice_enable"/>
                <attribute attribute-id="eInvoice_scope"/>
                <attribute attribute-id="eInvoice_user_agent"/>
                <attribute attribute-id="eInvoice_supplier_info"/>
                <attribute attribute-id="eInvoice_enable_shipping_tax"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

</metadata>
