<div class="address-summary h-font-size--16">
    <div>
        <span class="firstName">
            <isif condition="${address && address.firstName}">${address.firstName}</isif>
        </span>
        <span class="lastName">
            <isif condition="${address && address.lastName}">${address.lastName}</isif>
        </span>
    </div>

    <div class="address1">
        <isif condition="${address && address.address1}">${address.address1}</isif>
    </div>

    <div class="address2">
        <isif condition="${address && address.address2}">${address.address2}</isif>
    </div>

    <span class="city">
        <isif condition="${address && address.city}">${address.city},</isif>
    </span>
    <span class="district">
        <isif condition="${address && address.district}">${address.district},</isif>
    </span>
    <span class="subDistrict">
        <isif condition="${address && address.subDistrict}">${address.subDistrict},</isif>
    </span>
    <span class="stateCode">
       <isif condition="${address && address.stateCode}">${address.stateCode}</isif>
    </span>
    <iscomment> <span class="postalCode">
       <isif condition="${address && address.postalCode}">${address.postalCode}</isif>
    </span> </iscomment>
    <div class="countryCode">
       <isif condition="${address && address.countryCode}">${address.countryCode.value === 'AU' ? 'Australia' : address.countryCode.value}</isif>
    </div>
</div>
