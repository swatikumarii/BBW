<isset name="hasEmbeddedBonusProducts" value="${lineItem.bonusProductLineItemUUID === 'bonus'}" scope="page" />
<isset name="bonusproductlineitem" value="${hasEmbeddedBonusProducts ? 'bonus-product-line-item' : ''}" scope="page" />
<isset name="bonuslineitemrow" value="${hasEmbeddedBonusProducts ? 'bonus-line-item-row' : ''}" scope="page" />

<div class="card">
    <div class="product-info product-line-item ${bonusproductlineitem} uuid-${lineItem.UUID} ${!lineItem.promoPrice && lineItem.price.sales.value === 0 ? 'zero-price-item' :''}" data-pid="${lineItem.id}">
        <!--- name and remove buttons --->

        <div class="line-item">
            <div class="item-image">
                <isif condition="${lineItem.isEgiftCard}">
                    <img class="product-image" src="${lineItem.images.small[0].url}" srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x" alt="${lineItem.images.small[0].alt}"
                    title="${lineItem.images.small[0].title}" />
                <iselse/>
                    <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
                        <img class="product-image" src="${lineItem.images.small[0].url}" srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x" alt="${lineItem.images.small[0].alt}"
                            title="${lineItem.images.small[0].title}" />
                    </a>
                </isif>
            </div>
            <div class="item-attributes d-flex flex-column">
                <div class="social-badge-wrapper d-flex h-grid-gap--5 flex-wrap h-maxwidth--150">
                    <isif condition="${lineItem.badge1}">
                        <div class="b-product-tile__social-badge">
                            <div
                                class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                                ${lineItem.badge1}</div>
                        </div>
                    </isif>
                    <isif condition="${lineItem.badge2}">
                        <div class="b-product-tile__social-badge">
                            <div
                                class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                                ${lineItem.badge2}</div>
                        </div>
                    </isif>
                    <isif condition="${lineItem.badge3}">
                        <div class="b-product-tile__social-badge">
                            <div
                                class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                                ${lineItem.badge3}</div>
                        </div>
                    </isif>
                </div>
                <isinclude template="cart/productCard/cartProductCardHeader" />
                <isloop items="${lineItem.variationAttributes}" var="attribute" status="loopstate">
                    <isif condition="${attribute.displayName !== 'amount'}">
                        <p class="line-item-attributes ${attribute.displayName}-${lineItem.UUID}">${attribute.displayName}:
                            ${attribute.displayValue}</p>
                    </isif>
                </isloop>
                <isloop items="${lineItem.options}" var="option">
                    <isif condition="${!!option}" >
                        <div class="lineItem-options-values" data-option-id="${option.optionId}"
                            data-value-id="${option.selectedValueId}">
                            <p class="line-item-attributes">${option.displayName}</p>
                        </div>
                    </isif>
                </isloop>

                <iscomment> Giftcard Details </iscomment>

                    <isif condition="${'giftCardDetails' in lineItem && lineItem.giftCardDetails}">
                        <div class="giftcard-details">
                            <span class="d-block h-font-size--14 h-clr--green-1 pb-2">${Resource.msg('gift.card.delivered.by.email.text', 'cart', null)}</span>
                            <span class="d-block h-font-size--14 giftcard-receipient-name pb-2">${Resource.msg('label.input.recipientsname', 'forms', null)}${': '} ${lineItem.giftCardDetails.recipientName && lineItem.giftCardDetails.recipientName !== null ? lineItem.giftCardDetails
                                                                            .recipientName : ''}${','} ${lineItem.giftCardDetails.recipientEmail && lineItem.giftCardDetails.recipientEmail !== null ? lineItem.giftCardDetails
                            .recipientEmail : ''}</span>
                            <span class="d-block h-font-size--14 giftcard-receipient-email pb-2">${Resource.msg('label.input.sendername', 'forms', null)}${': '} ${lineItem.giftCardDetails.senderName && lineItem.giftCardDetails.senderName !== null ? lineItem.giftCardDetails
                                                                            .senderName : ''}</span>
                            <span class="h-font-size--14 giftcard-message pb-2">${Resource.msg('label.egift.message', 'forms', null)}${': '}  ${lineItem.giftCardDetails.eGiftMessage && lineItem.giftCardDetails.eGiftMessage !== null ? lineItem.giftCardDetails
                                                                .eGiftMessage : ''}</span>
                        </div>
                    </isif>
                    <isif condition="${lineItem.greetingCardMessage}">
                        <span class="label greeting-card-message">${Resource.msg('greeting.card.message', 'greetingCard', null)}${lineItem.greetingCardMessage}</span>
                    </isif>
                <isif condition="${!lineItem.isBonusProductLineItem}">
                    <!--- promotions --->
                    <div class="line-item-promo item-${lineItem.UUID}">
                        <isset name="cartPage" value="${true}" scope="page" />
                        <isinclude template="checkout/productCard/productCardProductPromotions" />
                    </div>
                    <iscomment> motivators </iscomment>
                    <div class="line-item-promo-motivator item-${lineItem.UUID} ${lineItem.isFreeItem ? 'd-none' : ''}">
                        <isset name="cartPage" value="${true}" scope="page" />
                        <isinclude template="checkout/productCard/productCardProductMotivators" />
                    </div>
                </isif>
                <iscomment> wishlist </iscomment>
                <isif condition="${!lineItem.isBonusProductLineItem}">
                    <isinclude template="wishlist/components/addToWishListButtonCart" sf-toolkit="on" />
                </isif>
                <isif condition="${lineItem.isBonusProductLineItem}">
                   <span class="change-bonus-product mt-3 text-decoration-underline" data-uuid="${lineItem.bonusProductLineItemUUID}">Choose a different gift/product</span>
                    <iscomment> TODO: Implement remove </iscomment>
                   <iscomment> <span class="change-bonus-product mt-2 text-decoration-underline" data-uuid="${lineItem.bonusProductLineItemUUID}">Remove Gift</span> </iscomment>
                </isif>
            </div>
            <div class="row">
                <div class="col-lg-12 d-flex flex-row">
                </div>
            </div>
        </div>

        <iscomment> Price, Qty, Total Price </iscomment>

        <isif condition="${!lineItem.isBonusProductLineItem || lineItem.isPWP}">
            <isinclude template="cart/productCard/cartProductCardProductPrice" />
            <div class="line-item-remove">
                <span class="cart-delete-confirmation-btn" data-pid="${lineItem.id}" data-name="${lineItem.productName}"
                    data-action="${pdict.actionUrls.removeProductLineItemUrl}" data-uuid="${lineItem.UUID}">
                    <img src="${URLUtils.staticURL('/images/close-icon.svg')}" alt="close icon" width="20" />
                </span>
            </div>
        </isif>

        <isif condition="${lineItem.customBundle}">
            <div class="currentCustomBundle">
                ${dw.experience.PageMgr.getPage(lineItem.customBundle).name} ${Resource.msg('bundle', 'productBundle', null)}
            </div>
        </isif>
    </div>
    <isif condition="${lineItem.bonusProductLineItemUUID === 'bonus'}">
        <div class="d-none justify-content-between pt-3">
            <div class="bonus-line-item-msg">${Resource.msg('text.lineitem.bonus.msg','cart',null)}:</div>
            <isloop items="${lineItem.discountLineItems}" var="discountLineItem">
                <div class="bonus-product-button" data-duuid="${discountLineItem.uuid}" data-pliuuid="${discountLineItem.pliuuid}"
                    data-maxpids="${discountLineItem.maxpids}" data-pageStart="0" data-pageSize="0"
                    data-url="${discountLineItem.url}">
                    <button class="choose-bonus-button" data-toggle="modal"
                        data-target="#chooseBonusProductModal">${discountLineItem.msg}</button>
                </div>
            </isloop>
        </div>
        <isinclude template="cart/productCard/cartEmbeddedBonusProducts" />
    </isif>
</div>
