<isif condition="${lineItem.isEgiftCard}">
    <div class="line-item-header">
        <div class="line-item-name">
            ${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}
        </div>
        <div class="line-item-name-partB text-capitalize">
            ${lineItem.titlePartB ? lineItem.titlePartB : ''}
        </div>
</div>
<iselse/>
    <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
        <div class="line-item-header">
            <div class="line-item-name">
                ${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}
            </div>
            <div class="line-item-name-partB text-capitalize">
                ${lineItem.titlePartB ? lineItem.titlePartB : ''}
            </div>
        </div>
    </a>
</isif>
