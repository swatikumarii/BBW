<isset name="totalExclusiveTax"
    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showTotalsExcludingTaxes')}" scope="page" />
<isset name="shippingExclusiveTax"
    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingExcludingTaxes')}" scope="page" />
<isset name="showSalesTaxes" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showSalesTaxes')}" scope="page" />
<isset name="showShippingHandlingTaxes" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingHandlingTaxes')}"
    scope="page" />

<iscomment> Subtotal </iscomment>
<isif condition="${totalExclusiveTax}">
    <div class="row">
        <div class="col-8">
            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.merchandise.subtotal.excluding.taxes', 'cart', null)}</p>
        </div>
        <div class="col-4">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total">${pdict.totals.subTotalExclTax}
            </p>
        </div>
    </div>
<iselse/>
    <div class="row">
        <div class="col-8">
            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.merchandise.subtotal', 'cart', null)}</p>
        </div>
        <div class="col-4">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total">${pdict.totals.subTotal}</p>
        </div>
    </div>
</isif>

<iscomment> Order Discount </iscomment>
<div class="row order-discount accordion-item collapsed ${pdict.totals.totalDiscount.value === 0 ? " hide-order-discount" : ""}" data-toggle="collapse" data-target="#allDiscounts" aria-expanded="false" aria-controls="allDiscounts" role="button">
    <isinclude template="cart/cartDiscountsHtml" sf-toolkit="on" />
</div>


<iscomment> Shipping Charge </iscomment>
<isif condition="${!pdict.isGiftProductAvailable}">
    <isif condition="${shippingExclusiveTax}">
        <div class="row">
            <div class="col-8">
                <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling.excluding.taxes', 'cart', null)}</p>
            </div>
            <div class="col-4">
                <isif condition="${!pdict.hasFreeShipping}">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive">
                        ${pdict.totals.shippingTotalExclTax}</p>
                <iselse/>
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive">
                    ${Resource.msg('label.free.price', 'cart', null)}</p>
                </isif>
            </div>
        </div>
    <iselse/>
        <div class="row">
            <div class="col-8">
                <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling', 'cart', null)}</p>
            </div>
            <div class="col-4">
                <isif condition="${!pdict.hasFreeShipping}">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-inclusive">
                        ${pdict.totals.totalShippingCost}</p>
                <iselse/>
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-inclusive">
                            ${Resource.msg('label.free.price', 'cart', null)}</p>
                </isif>
            </div>
        </div>
    </isif>


    <iscomment> Shipping Tax </iscomment>
    <isif condition="${showShippingHandlingTaxes}">
        <isif condition="${!pdict.hasFreeShipping}">
            <div class="row">
                <div class="col-8">
                    <isif condition="${shippingExclusiveTax}">
                        <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling.tax', 'cart', null)}</p>
                    <iselse/>
                        <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling.tax.inclusive', 'cart', null)}</p>
                    </isif>
                </div>
                <div class="col-4">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-tax">
                        ${pdict.totals.shippingTotalTax}</p>
                </div>
            </div>
            <iscomment> Shipping Discount </iscomment>
            <div class="row shipping-discount ${pdict.totals.shippingLevelDiscountTotal.value === 0 ? 'hide-shipping-discount' : ''}">
                <div class="col-8">
                    <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.discount', 'common', null)}</p>
                </div>
                <div class="col-4 pr-0">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-discount-total"> ${'-' + pdict.totals.shippingLevelDiscountTotal.formatted}</p>
                </div>
            </div>
        </isif>
    </isif>
</isif>


<iscomment> Sales Tax </iscomment>
<isif condition="${showSalesTaxes}">
    <div class="row">
        <div class="col-8">
            <isif condition="${totalExclusiveTax}">
                <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.sales.tax', 'cart', null)}</p>
            <iselse/>
                <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.sales.tax.inclusive', 'cart', null)}</p>
            </isif>
        </div>
        <div class="col-4">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sales-tax">${pdict.totals.salesTax}</p>
        </div>
    </div>
</isif>

<div class="row">
    <div class="col-12">
        <p class="h-font-size--14 h-clr--gray-4 tax-estimated">${Resource.msg('label.tax.estimated', 'cart', null)}</p>
    </div>
</div>

<div class="row order-total">
    <div class="col-8">
        <p class="h-font-size--18 h-clr--black-1 h-fw--semibold">${Resource.msg('label.estimatedtotal', 'cart', null)}
        </p>
    </div>
    <div class="col-4">
        <p class="text-right h-font-size--18 h-clr--black-1 h-fw--semibold grand-total">${pdict.totals.grandTotal}</p>
    </div>
</div>
