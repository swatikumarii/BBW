<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/afterpay.js');
        assets.addJs('/js/cartEinstein.js');
        assets.addJs('/js/productDetail.js');
        assets.addCss('/css/cart.css');
        assets.addCss('/css/afterpaystyle.css');
        assets.addCss('/css/experience/components/commerceLayouts/pickedJustForYou.css');
        assets.addCss('/css/notifyMe.css');
    </isscript>
    <isset name="miniCart" value="${false}" scope="page" />
    <isinclude template="/components/modules" sf-toolkit="off" />

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>
    <input type="hidden" name="currency-symbol" value="${session.currency.getSymbol()}">
    <a class="continue-shopping-link" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Home-Show')}"
        title="${Resource.msg('link.continue.shopping', 'cart', null)}">
        <img src="${URLUtils.staticURL('/images/cart/arrow-left-dark-grey.svg')}"
            alt="${Resource.msg('global.storename', 'common', null)}" />
        ${Resource.msg('link.continue.shopping', 'cart', null)}
    </a>
    <div class="cartContainer">
        <div class="container text-center <isif condition="${pdict.items.length !== 0}">d-none</isif>">
            <div class="empty-recommendation-container cart-page-add-to-bag">
                <div class="empty-cart-recommendations">
                    <isslot id="cart-empty-recommendation" context="global" description="This is for empty basket recommmendations" />
                </div>
            </div>
            <div class="row cart-empty">
                <div class="col-12 text-center cart-empty-msg-wrap">
                    <h1 class="h-fw--bold h-clr--black-1 cart-empty-msg">
                        ${Resource.msg('info.cart.empty.msg', 'cart', null)}</h1>
                </div>
            </div>
            <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Home-Show')}"
                class="btn btn-primary empty-cart-continue h-font-size--16 h-fw--semibold">${Resource.msg('link.continue.shopping', 'cart', null)}</a>
            <div class="empty-recommendation-container cart-page-add-to-bag">
                <div class="empty-cart-recommendations">
                    <isslot id="cart-empty-recommendation-second" context="global" description="This is for empty basket recommmendations" />
                </div>
            </div>
        </div>
        <isset name="showBonusTitle" value="${true}" scope="page" />
        <isif condition="${pdict.items.length !== 0}">
            <div class="container cart cart-page">
                <h1 class="shoppingBagTitle h-clr--black-1 h-fw--bold h-font-size--24">
                    ${Resource.msg('label.shopping.bag', 'cart', null)}</h1>
                <div class="cartActionMessages h-font-size--16 h-clr--red h-fw--normal">
                    <isif condition="${pdict.showDangerousGoodsMsg}">
                        <isprint
                            value="${dw.system.Site.getCurrent().getCustomPreferenceValue('dangerousGoodsMessage')}"
                            encoding="off" />
                    </isif>
                </div>
                <div
                    class="free-item-toast-message success-toast ${pdict.freeItemCount === 0 ? 'hide-free-item-toast-message' : ''}">
                    <p class="h-font-size--16 h-fw--semibold h-clr--green-2 mb-0">${pdict.freeItemToastMessage}</p>
                </div>
                <isif condition="${pdict.valid.error && pdict.items.length !== 0}">
                    <div
                        class="cart-error-messaging cart-error h-font-size--14 h-bg--red-10 h-clr--red-9 px-3 py-2 mb-2">
                        <img src="${URLUtils.staticURL('images/Alert-Error.svg')}" alt="error alert" width="28px"
                            height="28px">
                        <span class="pdict-message">${pdict.valid.message}</span>
                    </div>
                </isif>
                <div class="item-removed-message success-toast mt-2 d-none">
                    ${Resource.msg('cart.item.remove.msg', 'cart', null)}
                </div>
                <isslot id="cart-page-top-1" context="global"
                    description="This slot displays on cart page top section above product cards" />
                <div class="cartDetailsHeader">
                    <div class="cartDetailsHeading text-center">
                        <span class="cart-num-items">
                            ${pdict.numItems.toString()}
                        </span>
                        ${Resource.msg('label.number.items.in.cart.new', 'cart', null)}
                    </div>
                    <div class="cartDetailsContent row">
                        <div class="col-12 col-md-6">
                            <isinclude template="cart/cartShippingApproachingDiscount" sf-toolkit="on" />
                        </div>
                        <div class="${pdict.orderApproachingDiscounts.length > 0 ? 'col-12 col-md-6' : 'd-none'}">
                            <isinclude template="cart/cartOrderApproachingDiscount" sf-toolkit="on" />
                        </div>
                        <isslot id="cart-page-details-column" context="global"
                            description="This slot displays as grid column besides item count on cart page" />
                    </div>
                </div>

                <!---product cards--->
                <div class="itemsHeader">
                    <div class="headerItem">${Resource.msg('label.item.header.item', 'cart', null)}</div>
                    <div class="headerPrice">${Resource.msg('label.item.header.price', 'cart', null)}</div>
                    <div class="headerQty">${Resource.msg('label.item.header.quantity', 'cart', null)}</div>
                    <div class="headerSavings text-center">${Resource.msg('label.item.header.savings', 'cart', null)}
                    </div>
                    <div class="headerTotal">${Resource.msg('label.item.header.total', 'cart', null)}</div>
                </div>
                <div class="cart-lineitems">
                    <isloop items="${pdict.items}" var="lineItem">
                        <isif condition="${showBonusTitle && lineItem.isBonusProductLineItem}">
                            <span class="bonus-product-title h-font-size--20 h-clr--black-1 ml-3">Your Free Gift(s)</span>
                            <isset name="showBonusTitle" value="${false}" scope="page" />
                        </isif>
                        <isif condition="${lineItem.isGiftWrapCategory}">
                            <isset name="giftWrapItem" value="${lineItem}" scope="page" />
                        <iselseif condition="${lineItem.isGreetingCardCategory}"/>
                            <isset name="greetingCardItem" value="${lineItem}" scope="page" />
                        <iselse/>
                            <isif condition="${lineItem.productType === 'bundle'}">
                                <isinclude template="cart/productCard/cartBundleCard" />
                            <iselse/>
                                <isif condition="${lineItem.noProduct === true}">
                                    <isinclude template="cart/productCard/uncategorizedCartProductCard" />
                                <iselse/>
                                    <isinclude template="cart/productCard/cartProductCard" />
                                </isif>
                            </isif>
                        </isif>
                    </isloop>
                    <isinclude template="cart/productCard/cartGreetingCard" />
                    <div class="gift-wrap-card-div">
                        <isinclude template="cart/productCard/cartGiftWrapProductCard" />
                    </div>
                </div>
                <isif condition="${!(pdict.isGiftProductAvailable)}">
                    <isinclude template="cart/greetingCard" />
                    <div class="gift-wrap-choose-div">
                        <isinclude template="cart/giftWrap" />
                    </div>
                </isif>
                <!---totals, and checkout actions--->
                <div class="cartFooter">
                    <div class="cartPromoCodeWrap">
                        <div class="cartPromo">
                            <isinclude template="cart/cartPromoCode" />
                            <div class="coupons-and-promos">
                                <isinclude template="cart/cartCouponDisplay" />
                            </div>
                        </div>
                        <isslot id="cart-bottom-below-promocode" context="global"
                            description="This slot will be rendered on the bottom part of cart page below promocode section" />
                    </div>
                    <div class="cartTotalsWrap">
                        <div class="cart-totals-bg position-relative">
                            <div class="loader">
                                <div class="h-visually-hidden" role="alert">Just a second, items loading</div>
                                <div class="spinner"></div>
                            </div>
                            <isinclude template="cart/cartTotals" />
                            <isinclude template="cart/checkoutButtons" />
                            <iscomment> Payment Method Icons </iscomment>
                            <div class="payment-options-wrapper">
                                <iscontentasset aid="checkout-billing-payment-methods-icons" />
                            </div>
                        </div>
                        <isslot id="cart-bottom-below-checkout-button" context="global"
                            description="This slot will be rendered on the bottom part of cart page below checkout buttons" />
                    </div>

                </div>
            </div>
            <isinclude template="cart/cartRemoveProductModal" />

            <isinclude template="cart/cartRemoveCouponModal" />

            <div class="d-none">
                <input type="hidden" name="email-recommendations-url" value="${URLUtils.url('Checkout-SetEmailRecommendations')}" />
                <isslot id="confirmation-email-recommendations" context="global" description="Recommendations for confirmation email" context-object="${dw.order.BasketMgr.getCurrentBasket()}"/>
                <isslot id="shipment-email-recommendations" context="global" description="Recommendations for shipment email" context-object="${dw.order.BasketMgr.getCurrentBasket()}"/>
                <isslot id="delivery-email-recommendations" context="global" description="Recommendations for delivery email"/>
                <isslot id="gc-email-recommendations" context="global" description="Recommendations for GC email" />
            </div>
        </isif>
        <div class="container">
            <isslot id="cart-recommendations-m" description="Recommended products" context="global" />
        </div>
    </div>
    <isinclude template="product/components/addFreeItem" sf-toolkit="off" />

</isdecorate>
