<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/afterpay.js');
        assets.addCss('/css/cart.css');
        assets.addCss('/css/afterpaystyle.css');
    </isscript>
    <isset name="miniCart" value="${false}" scope="page" />


    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>
    <a class="continue-shopping-link" href="${URLUtils.url('Home-Show')}"
        title="${Resource.msg('link.continue.shopping', 'cart', null)}">
        ${Resource.msg('link.continue.shopping', 'cart', null)}
    </a>
    <div class="cartContainer">
        <isif condition="${pdict.items.length === 0}">
            <div class="container text-center">
                <div class="row cart-empty">
                    <div class="col-12 text-center cart-empty-msg-wrap">
                        <h1 class="h-font-size--24 h-fw--bold h-clr--black-1 cart-empty-msg">${Resource.msg('info.cart.empty.msg', 'cart', null)}</h1>
                    </div>
                </div>
                <a href="${URLUtils.url('Home-Show')}" class="btn btn-primary empty-cart-continue h-font-size--16 h-fw--semibold">${Resource.msg('link.continue.shopping', 'cart', null)}</a>
                <div class="empty-cart-recommendations">
                    <isslot id="cart-empty-recommendation" context="global" description="This is for empty basket recommmendations" />
                </div>
            </div>
        <iselse/>
            <div class="container cart cart-page">
                <h1 class="shoppingBagTitle h-clr--black1 h-fw--bold h-font-size--24">
                    ${Resource.msg('label.shopping.bag', 'cart', null)}</h1>
                <div class="cartActionMessages"></div>
                <isif condition="${pdict.valid.error && pdict.items.length !== 0}">
                    <div class="cart-error-messaging cart-error h-font-size--14 h-bg--red-10 h-clr--red-9 px-3 py-2 mb-2">
                        <img src="${URLUtils.staticURL('images/Alert-Error.svg')}" alt="error alert" width="28px" height="28px">
                        <span>${pdict.valid.message}</span>
                    </div>
                </isif>
                <div class="item-removed-message h-font-size--16 h-bg--blue-3 h-clr--green-2 p-3 mb-2 d-none">
                    ${Resource.msg('cart.item.remove.msg', 'cart', null)}
                </div>
                <isslot id="cart-page-top-1" context="global"
                    description="This slot displays on cart page top section above product cards" />
                <div class="cartDetailsHeader">
                    <div class="cartDetailsHeading text-center">${Resource.msg('label.your.cart', 'cart', null)}</div>
                    <div class="cartDetailsContent">
                        <div class="content number-of-items">
                            <isif condition="${pdict.numItems === 1}">
                                ${Resource.msg('one.item.in.cart', 'cart', null)}
                            <iselse/>
                                ${Resource.msgf('label.number.items.in.cart', 'cart', null, pdict.numItems)}
                            </isif>
                        </div>
                        <div class="slot">
                            <isslot id="cart-page-details-column" context="global"
                                description="This slot displays as grid column besides item count on cart page" />

                        </div>
                    </div>
                </div>

                <!---product cards--->
                <div class="itemsHeader">
                    <div class="headerItem">${Resource.msg('label.item.header.item', 'cart', null)}</div>
                    <div class="headerPrice">${Resource.msg('label.item.header.price', 'cart', null)}</div>
                    <div class="headerQty">${Resource.msg('label.item.header.quantity', 'cart', null)}</div>
                    <div class="headerTotal">${Resource.msg('label.item.header.total', 'cart', null)}</div>
                </div>
                <div class="cart-lineitems">
                    <isloop items="${pdict.items}" var="lineItem">
                        <isif condition="${lineItem.productType === 'bundle'}">
                            <isinclude template="cart/productCard/cartBundleCard" />
                        <iselse/>
                            <isif condition="${lineItem.noProduct === true}">
                                <isinclude template="cart/productCard/uncategorizedCartProductCard" />
                            <iselse/>
                                <isinclude template="cart/productCard/cartProductCard" />
                            </isif>
                        </isif>
                    </isloop>
                    <isinclude template="cart/productCard/cartGreetingCard" />
                    <div class="gift-wrap-card-div">
                        <isinclude template="cart/productCard/cartGiftWrapProductCard" />
                    </div>
                </div>
                <isinclude template="cart/cartApproachingDiscount" />
                <isinclude template="cart/greetingCard" />
                <div class="gift-wrap-choose-div">
                    <isinclude template="cart/giftWrap" />
                </div>
                <!---totals, and checkout actions--->
                <div class="cartFooter">
                    <div class="cartPromoCodeWrap">
                        <div class="cartPromo">
                            <isinclude template="cart/cartPromoCode" />
                            <div class="coupons-and-promos">
                                <isinclude template="cart/cartCouponDisplay" />
                            </div>
                        </div>
                        <isslot id="cart-bottom-below-promocode" context="global"
                            description="This slot will be rendered on the bottom part of cart page below promocode section" />
                    </div>
                    <div class="cartTotalsWrap">
                        <isinclude template="cart/cartTotals" />
                        <isinclude template="cart/checkoutButtons" />
                    </div>
                    <isslot id="cart-bottom-below-checkout-button" context="global" description="This slot will be rendered on the bottom part of cart page below checkout buttons" />

                </div>
            </div>
            <isinclude template="cart/cartRemoveProductModal" />

            <isinclude template="cart/cartRemoveCouponModal" />
        </isif>
        <div class="container">
            <isslot id="cart-recommendations-m" description="Recommended products" context="global" />
        </div>
    </div>
</isdecorate>
