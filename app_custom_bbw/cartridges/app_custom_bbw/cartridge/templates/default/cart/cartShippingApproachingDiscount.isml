<div class="shipping-approaching-discounts approaching-discounts h-font-size--12 h-bg--gray-1 h-clr--black-1 my-3 px-3">
    <isif condition="${pdict.shippingApproachingDiscounts.length > 0}">
        <isloop items="${pdict.shippingApproachingDiscounts}" var="approachingDiscount">
            <div class="row align-items-center">
                <div class="col-2 icon">
                    <img src="${URLUtils.staticURL('images/icons/bopis-shipping.svg')}" alt="shipping icon" width="50" />
                </div>
                <div class="d-flex flex-column col-10 pl-0">
                    <isif condition="${approachingDiscount.distanceFromConditionThreshold > 0}">
                        <p class="h-font-size--13 h-clr--blue h-fw--bold m-0"> ${Resource.msgf('items.added.in.bag', 'cart', null, pdict.numItems)}</p>
                    <iselse/>
                        <p class="h-font-size--13 h-clr--blue h-fw--bold m-0"> ${Resource.msg('congrats.free.shipping', 'cart', null)}</p>
                    </isif>
                    <div class="single-approaching-discount">
                        <isprint value="${approachingDiscount.discountMsg}" encoding="off" />
                    </div>

                    <div class="d-flex w-100 justify-content-around align-items-center">
                        <span class="pr-1 text-nowrap d-block">
                            ${dw.util.StringUtils.formatMoney(new dw.value.Money(0, session.currency.getCurrencyCode()))}
                        </span>
                        <progress class="w-100 ${approachingDiscount.distanceFromConditionThreshold === 0 ? 'full' : ''}"
                            value="${approachingDiscount.conditionThreshold - approachingDiscount.distanceFromConditionThreshold}"
                            max="${approachingDiscount.conditionThreshold}"></progress>
                        <span class="pl-1 text-nowrap d-block">
                            ${approachingDiscount.formattedConditionThreshold}
                        </span>
                    </div>
                </div>
            </div>
        </isloop>
    </isif>
</div>
