<isloop items="${pdict.totals.discounts}" var="discount">
    <isif condition="${discount.type === 'coupon'}">
        <div class="coupon-price-adjustment d-flex justify-content-between h-bg--${discount.applied ? 'green-5' : 'red-10'} coupon-uuid-${discount.UUID}" data-uuid="${discount.UUID}">
            <isif condition="${discount.applied}">
            <div class="coupon-code h-font-size--16 h-clr--green-2 h-fw--semibold  h-bg--green-5 py-2 px-4">
                    <isloop items="${discount.relationship}" var="relatedPromotion">
                        ${Resource.msgf('msg.coupon.applied', 'cart', null, relatedPromotion.callOutMsg)}
                    </isloop>
                    <span class="coupon-applied d-block h-clr--black-1 h-font-size--14 h-fw--normal">${Resource.msg('msg.coupon.code', 'cart', null) + discount.couponCode}</span>
            </div>
            <span class="delete-coupon-confirmation-btn h-bg--green-5 py-2 px-4" data-code="${discount.couponCode}"
                aria-label="${Resource.msgf('text.remove.coupon', 'cart', null, discount.couponCode)}"
                data-action="${pdict.actionUrls.removeCouponLineItem}" data-uuid="${discount.UUID}">
                <img src="${URLUtils.staticURL('/images/close-icon.svg')}" alt="close icon" width="15" />
            </span>
            <iselse/>
                <div class="coupon-code h-font-size--16 h-fw--semibold h-bg--red-10 py-2 px-4">
                    <span class="coupon-not-applied h-clr--red">${discount.qualificationMsg}</span>
                    <span class="coupon-applied d-block h-clr--black-1 h-font-size--14 h-fw--normal">${Resource.msg('msg.coupon.code', 'cart', null) + discount.couponCode}</span>
                </div>
                <span class="delete-coupon-confirmation-btn h-bg--red-10 py-2 px-4 cursor-pointer" data-code="${discount.couponCode}"
                    aria-label="${Resource.msgf('text.remove.coupon', 'cart', null, discount.couponCode)}"
                    data-action="${pdict.actionUrls.removeCouponLineItem}" data-uuid="${discount.UUID}">
                    <img src="${URLUtils.staticURL('/images/close-icon.svg')}" alt="close icon" width="15" />
                </span>
            </isif>
        </div>
    </isif>
</isloop>
