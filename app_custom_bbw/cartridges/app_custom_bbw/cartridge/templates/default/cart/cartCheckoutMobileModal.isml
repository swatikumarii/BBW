<div class="modal fade" id="mobile-cart-checkout" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
  aria-hidden="true">
  <div class="modal-dialog modal-dialog-bottom" role="document">
    <div class="modal-content">
      <div class="modal-header p-0">
        <button type="button" class="btn btn-primary close h-bg--black-3" data-dismiss="modal" aria-label="Close">
          ${Resource.msg('checkout.mobile.modal.btn', 'cart', null)}
          <span class="arrow"></span>
        </button>
      </div>
      <div class="modal-body p-0">

        <div class="order-total h-bg--white d-flex justify-content-between h-clr--black">
          <p class="h-font-size--14 h-clr--black-1 h-fw--semibold text-uppercase mb-0">
            ${Resource.msg('label.estimatedOrderTotal', 'cart', null)}
          </p>
          <p class="text-right h-font-size--14 h-clr--black-1 h-fw--semibold grand-total mb-0">
            ${pdict.totals.grandTotal}
          </p>
        </div>

        <div class="checkout-mobile-detail">
          <a href="${URLUtils.https('Checkout-Begin')}" data-check-motivator="${URLUtils.https('Cart-MissingFree')}"
            class="btn btn-primary btn-block checkout-btn h-fw--semibold h-font-size--16 cart-checkout-btn ${pdict.valid.error ? 'disabled' : ''}"
            role="button">
            <span class="checkout-button-lock"></span>
            ${Resource.msg('button.checkout', 'cart', null)}
          </a>

          <isslot id="responsive-secure-checkout-slot" description="Checkout Detail" context="global" />
        </div>

      </div>
    </div>
  </div>
</div>
