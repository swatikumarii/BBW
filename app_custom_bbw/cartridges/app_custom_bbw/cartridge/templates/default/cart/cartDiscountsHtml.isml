<div class="col-8">
    <p class="h-font-size--16 h-clr--black-1 cart-saving position-relative"
        >${Resource.msg('label.order.savings', 'common', null)}</p>
</div>
<div class="col-4">
    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold order-discount-total">
        ${pdict.totals.totalDiscountFormatted}</p>
</div>
<isif condition="${'mergedDiscounts' in pdict.totals && pdict.totals.mergedDiscounts && pdict.totals.mergedDiscounts.length > 0}">
    <isset name="discounts" value="${pdict.totals.mergedDiscounts}" scope="page" />
<iselse>
    <isset name="discounts" value="${pdict.totals.allDiscounts}" scope="page" />
</isif>
<div class="accordion-collapse collapse col-12" id="allDiscounts">
    <isloop items="${discounts}" var="discount" status="loopstatus">
        <div class="row">
            <div class="col-8">
                <p class="h-font-size--11 h-clr--black-1">${discount.promotion}</p>
            </div>
            <div class="col-4">
                <p class="text-right h-font-size--11 h-clr--black-1 h-fw--semibold order-discount-total">
                    ${discount.discount}</p>
            </div>
        </div>
    </isloop>
</div>
