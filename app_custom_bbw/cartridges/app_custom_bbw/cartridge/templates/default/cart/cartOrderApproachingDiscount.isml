<div class="order-approaching-discounts approaching-discounts mb-3">
    <isif condition="${pdict.orderApproachingDiscounts.length > 0}">
        <isset name="approachingDiscount" value="${pdict.orderApproachingDiscounts[0]}" scope="page" />
        <div class="d-flex w-auto align-items-center single-approaching-discount-wrap">
            <div class="single-approaching-discount w-100 pl-3">
                <div>
                    <isprint value="${approachingDiscount.motivatorHeading}" encoding="off" />
                </div>
                <isprint value="${approachingDiscount.discountMsg}" encoding="off" />
                <iscomment> <progress class="w-100" value="${approachingDiscount.conditionThreshold - approachingDiscount.distanceFromConditionThreshold}" max="${approachingDiscount.conditionThreshold}"></progress> </iscomment>
            </div>
            <isif condition="${'image' in approachingDiscount}">
                <div class="pl-3">
                    <img src="${approachingDiscount.image}" alt="product image" width="50" />
                </div>
            </isif>
        </div>
    </isif>
</div>
