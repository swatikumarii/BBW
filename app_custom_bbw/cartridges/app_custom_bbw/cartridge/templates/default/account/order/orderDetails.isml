<div class="card confirm-details">
    <div class="card-header">
        <h2 class="card-header-custom">${Resource.msg('order.title.receipt', 'order', null)}</h2>
    </div>

    <div class="card-body">
        <p>
            <span class="summary-section-label order-date-label">${Resource.msg('label.order.date', 'order', null)}</span>
            <span class="summary-details order-date"><isprint value="${pdict.order.creationDate}" style="DATE_SHORT"/></span>
            <br/>
            <isif condition="${pdict.order.estimatedArrivalTime}">
                <span class="summary-section-label order-number-label">${Resource.msg('label.estimated.delivery', 'order', null)}</span>
                <span class="summary-details order-number">${pdict.order.estimatedArrivalTime}</span>
            </isif>
            <span class="summary-section-label order-number-label">${Resource.msg('label.order.number', 'confirmation', null)}</span>
            <span class="summary-details order-number">${pdict.order.orderNumber}</span>
        </p>
        <isset name="orderEmail" value="${pdict.order.orderEmail}" scope="page" />
        <!--- Shipping Address --->
        <isloop var="shippingModel" items="${pdict.order.shipping}" status="shippingLoop">
            <isif condition="${shippingLoop.first}">
                <div class="single-shipping" data-shipment-summary="${shippingModel.UUID}">
                    <p class="summary-section-label shipping-addr-label">${Resource.msg('label.order.shipping.address', 'order', null)}</p>
                    <isif condition="${shippingModel.shippingAddress !== null}">
                        <isset name="address" value="${shippingModel.shippingAddress}" scope="page"/>
                    <iselse>
                        <isset name="address" value="${{}}" scope="page"/>
                    </isif>
                    <div class="summary-details shipping">
                         <isinclude template="checkout/addressSummary" />
                        <isif condition="${shippingModel.shippingAddress && shippingModel.shippingAddress.countryCode.displayValue}">
                            ${shippingModel.shippingAddress.countryCode.displayValue}</isif>
                        <div class="shipping-phone">
                            <isif condition="${shippingModel.shippingAddress && shippingModel.shippingAddress.phone}">
                            <span>${Resource.msg('label.order.phone', 'order', null)} ${shippingModel.shippingAddress.phone}</span></isif>
                        </div>
                    </div>

                    <!--- Shipping information --->
                    <p class="summary-section-label shipping-method-label">${Resource.msg('label.order.shipping.method', 'confirmation', null)}</p>
                    <div class="row summary-details leading-lines">
                        <div class="col-8">
                            <p class="shipping-method">
                                <isset name="shippingMethod" value="${shippingModel.selectedShippingMethod.ID}" scope="page" />
                                <span class="shipping-method-title">${shippingModel.selectedShippingMethod.displayName}</span>
                            </p>
                        </div>
                    </div>
                    <isinclude template="checkout/shipping/giftMessageSummary" />
                </div>
            </isif>
        </isloop>
        <!--- Billing Address --->
        <span class="summary-section-label billing-addr-label">${Resource.msg('label.order.billing.address', 'order', null)}</span><br/>
        <isif condition="${pdict.order.billing.billingAddress.address !== null}">
            <isset name="address" value="${pdict.order.billing.billingAddress.address}" scope="page"/>
            <iselse>
            <isset name="address" value="{}" scope="page"/>
        </isif>

        <div class="summary-details billing">
            <isinclude template="checkout/addressSummary" />
            <isif condition="${pdict.order.billing.billingAddress.address && pdict.order.billing.billingAddress.address.countryCode.displayValue}">
                <span class="order-summary-country">${pdict.order.billing.billingAddress.address.countryCode.displayValue}</span></isif>
            <isif condition="${pdict.order.billing.billingAddress.address !== null && pdict.order.billing.billingAddress.address.phone}">
                <span class="order-summary-phone">${Resource.msg('label.order.phone', 'order', null)} ${pdict.order.billing.billingAddress.address.phone}</span>
            </isif>
        </div>
        <!--- Payment information --->
        <div class="summary-details">
            <span class="summary-section-label payment-info-label">${Resource.msg('label.order.payment.info', 'order', null)}</span><br/>
            <isinclude template="checkout/billing/paymentOptions/paymentOptionsSummary" />
        </div>

    </div>
</div>
<div class="card checkout-order-total-summary">
    <div class="card-body order-total-summary">
        <!--- Subtotal --->
        <isif condition="${pdict.order.totals.subTotal}">
            <div class="row leading-lines subtotal-item">
                <div class="col-6 start-lines">
                    <p class="order-receipt-label"><span>${Resource.msg('label.order.subtotal','order', null)}</span></p>
                </div>
                <div class="col-6 end-lines">
                    <p class="text-right"><span class="sub-total">${pdict.order.totals.subTotal}</span></p>
                </div>
            </div>
        </isif>

        <!--- Order Discount --->
        <isif condition="${pdict.order.totals.orderLevelDiscountTotal.value != 0}">
            <div class="row leading-lines order-discount <isif condition="${pdict.order.totals.orderLevelDiscountTotal.value === 0}">hide-order-discount</isif>">
                <div class="col-6 start-lines">
                    <p class="order-receipt-label"><span>${Resource.msg('label.order.discount', 'common', null)}</span></p>
                </div>
                <div class="col-6 end-lines">
                    <p class="text-right"><span class="order-discount-total">- ${pdict.order.totals.orderLevelDiscountTotal.formatted}</span></p>
                </div>
            </div>
        </isif>

        <!--- Shipping Cost --->
        <isif condition="${pdict.order.totals.totalShippingCost}">
            <div class="row leading-lines shipping-item">
                <div class="col-6 start-lines">
                    <p class="order-receipt-label"><span>${Resource.msg('label.order.shipping.cost','order', null)}</span></p>
                </div>
                <div class="col-6 end-lines">
                    <p class="text-right"><span class="shipping-total-cost">${pdict.order.totals.totalShippingCost}</span></p>
                </div>
            </div>
        </isif>

            <!--- Shipping Discount --->
        <isif condition="${pdict.order.totals.shippingLevelDiscountTotal.value != 0}">
            <div class="row leading-lines shipping-discount <isif condition="${pdict.order.totals.shippingLevelDiscountTotal.value === 0}">hide-shipping-discount</isif>">
                <div class="col-6 start-lines">
                    <p class="order-receipt-label"><span>${Resource.msg('label.shipping.discount', 'common', null)}</span></p>
                </div>
                <div class="col-6 end-lines">
                    <p class="text-right"><span class="shipping-discount-total">- ${pdict.order.totals.shippingLevelDiscountTotal.formatted}</span></p>
                </div>
            </div>
        </isif>

        <!--- Grand Total --->
        <isif condition="${pdict.order.totals.grandTotal}">
            <div class="row grand-total leading-lines">
                <div class="col-6 start-lines">
                    <p class="order-receipt-label"><span>${Resource.msg('label.order.grand.total','order', null)}</span></p>
                </div>
                <div class="col-6 end-lines">
                    <p class="text-right"><span class="grand-total-sum">${pdict.order.totals.grandTotal}</span></p>
                </div>
            </div>
        </isif>
    </div>
</div>
<isinclude template="account/order/orderProductSummary" />
