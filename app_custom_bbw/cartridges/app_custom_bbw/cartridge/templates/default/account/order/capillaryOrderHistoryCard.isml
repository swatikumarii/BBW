<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/custom.js');
    assets.addCss('/css/account/account.css');
</isscript>
<div class="card collapse show" id="orderlist" data-parent="#order-list-accordion">
    <div class="card-head card-info-group">
        <div class="d-md-flex d-block align-items-center justify-content-between">
            <div class="order-date-wrap">
                <p class="date-placed">
                    <span class="d-block order-left-info">${Resource.msg('label.orderhistory.dateordered', 'account', null)}</span>
                    <span class="d-block order-right-info">
                        <isset name="creationDate" value="${new Date(orderDate)}" scope="page" />
                        <isprint value="${creationDate}" formatter="dd-MM-yyyy hh:mm a" />
                    </span>
                </p>
                <p class="date-placed">
                    <span class="d-block text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderhistory.ordernumber', 'account', null)}</span>
                    <span class="d-block order-right-info">
                        <isprint value="${order.id}" /></span>
                </p>
                <p class="date-placed">
                    <span class="text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderDetail.status', 'order', null)}</span>
                <span class="summary-details order-number text-capitalize order-right-info">${order.delivery_status}</span>
                </p>
                <p class="date-placed mb-2 mb-md-0">
                    <span class="d-block text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderhistory.ordertotal', 'account', null)}</span>
                    <span class="d-block order-right-info">${session.currency.currencyCode} ${order.gross_amount}</span>
                </p>
                <p class="date-placed mb-2 mb-md-0">
                    <span class="d-block text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderhistory.location', 'account', null)}</span>
                    <span class="d-block order-right-info">${order.store}</span>
                </p>
            </div>
            <div class="d-flex flex-column h-grid-gap--5">
                <a class="btn btn-hover"
                    href="${URLUtils.url('Order-StoreDetails', 'orderID', order.id)}"
                    aria-label="${Resource.msgf('label.orderhistory.vieworderdetails', 'account', null, order.id)}">${Resource.msg('order.link.view.details', 'account', null)}</a>
            </div>
        </div>
    </div>
</div>
