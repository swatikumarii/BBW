<isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/custom.js');
        assets.addCss('/css/account/orderTrack.css');
    </isscript>

<div class="d-flex align-items-center justify-content-between">
    <div class="">
        <p>${Resource.msg('label.orderhistory.dateordered', 'account', null)}
            <span class="h-clr--black">
                <isprint value="${order.creationDate}" /></span>
        </p>
        <p>${Resource.msg('label.orderhistory.ordernumber', 'account', null)}
            <span class="h-clr--black">
                <isprint value="${order.orderNumber}" /></span>
        </p>
        <p>${Resource.msg('label.orderhistory.ordertotal', 'account', null)} : <span
                class="h-clr--black">${order.priceTotal}</span>
        </p>
    </div>
    <div class="">
        <a class="btn btn-hover details-btn text-uppercase h-clr--white"
            href="${URLUtils.url('Order-Details', 'orderID', order.orderNumber, 'orderFilter', pdict.orderFilter)}"
            class="pull-right"
            aria-label="${Resource.msgf('label.orderhistory.vieworderdetails', 'account', null, order.orderNumber)}">${Resource.msg('order.link.view', 'account', null)}</a>

        <button class="add-order-to-cart no-spinner" title="${Resource.msgf('label.reorder.btn', 'order', null, 'all')}"
            data-oid="${order.orderNumber}" aria-label="${Resource.msgf('label.reorder.btn', 'order', null, 'all')}"
            tabindex="0">
            <span>${Resource.msg('label.reorder.btn', 'order', null)}</span>
        </button>

        <button id="invoiceDownload" class="btn-transparent"
            data-action="${order.invoiceDownloadUrl}">${Resource.msg('account.download', 'account', null)} </button>
    </div>

</div>
