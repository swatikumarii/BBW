<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/orderHistory.js');
        assets.addJs('/js/custom.js');
        assets.addCss('/css/account/account.css');
    </isscript>

    <div class="container h-maxwidth--1400 mx-auto">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
    </div>

    <div class="container-fluid p-0">
        <div class="col mobile-my-account h-font-size--16 h-clr--black-1">
            ${Resource.msg('label.myaccount', 'account', null)}
        </div>
    </div>

    <div class="h-maxwidth--1400 mx-auto my-account">
        <div class="row account-dashboard">
            <div class="account-nav-wrap">
                <div class="my-account-nav">
                    <isinclude template="account/accountNav" />
                </div>
            </div>

            <div class="description-detail">
                <div class="my-account-description">
                    <div class="account-profile">
                        <div class="profile-heading">
                            <h1>${Resource.msg('label.store.orderhistory', 'account', null)}</h1>
                            <isif condition="${empty(pdict.orders)}">
                                <div class="h-font-size--12">${Resource.msg('label.noOrder', 'account', null)}</div>
                            </isif>
                        </div>
                    </div>
                </div>
                <div class="order-list-container">
                    <div id="order-list-accordion" class="accordion">
                        <isset name="previousYear" value="0" scope="page" />
                        <isloop items="${pdict.orders}" var="order" status="loopstate">
                            <isset name="orderDate" value="${(order.billing_time).replace(' ', 'T')+'+05:30'}" scope="page" />
                            <isif condition="${new Date(orderDate).getFullYear().toString() !== previousYear}">
                                <h3 class="headinfo-year" data-toggle="collapse" data-target="#orderlist" aria-expanded="true"
                                    aria-controls="orderlist">${new Date(orderDate).getFullYear().toString()} ${Resource.msg('label.orders', 'account', null)}</h3>
                                <isset name="previousYear" value="${new Date(orderDate).getFullYear().toString()}" scope="page" />
                            </isif>
                            <isinclude template="account/order/capillaryOrderHistoryCard" />
                        </isloop>
                    </div>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
