<input class="quantity" value="1" type="hidden" />
<isif condition="${lineItem.available}">
    <div class="add-to-cart-wishlist">
        <button class="add-to-cart btn btn-hover" data-pid="${lineItem.id}" data-url="${URLUtils.url('Cart-AddProduct')}"
            data-option="${JSON.stringify(lineItem.selectedOptions)}" ${!lineItem.available ? "disabled" : ""}>
            ${Resource.msg('button.addToBag', 'common', null)}
        </button>

        <div id="add-wishlist-to-cart-snackbar">${Resource.msg('item.added.to.cart', 'common', null)}</div>
    </div>
<iselse/>
    <div id="order-level-out-of-stock-snackbar" class="error" >${Resource.msg('out.of.stock.message', 'order', null)}</div>
    <button type="button" class="btn order-level-out-of-stock-snackbar-btn"> ${Resource.msg('button.addToBag', 'common', null)}
    </button>
    <iscomment> <div class="notify-me main-quantity-${lineItem.id}">
        <span class="notify-me-available-msg"></span>
        <input type="hidden" id="notify-list-msg" value="${Resource.msg('button.notifyInList', 'notifyMe', null)}" />
        <input type="hidden" id="notify-msg" value="${Resource.msg('button.notifyMe', 'notifyMe', null)}" />
        <isif condition="${lineItem.enableNotifyMe}">
            <button type="button" class="btn btn-block notifyBackInStockButton notify-me-btn"
                data-url="${URLUtils.url('BackInStock-CheckLogin')}" data-pid="${lineItem.id}"
                data-img="${lineItem.imageObj.mediumLarge ? lineItem.imageObj.mediumLarge[0].url : lineItem.imageObj.small[0].url}"
                data-img2x="${lineItem.imageObj.mediumLarge_2x ? lineItem.imageObj.mediumLarge_2x[0].url : lineItem.imageObj.small_2x[0].url}"
                ${lineItem.productPresentInNotifyList ? 'disabled='
            disabled '': ''} data-pname="${lineItem.name}">
                ${lineItem.productPresentInNotifyList ? Resource.msg('button.notifyInList', 'notifyMe', null) : Resource.msg(
                'button.notifyMe', 'notifyMe', null)} </button>
        <iselse/>
            <button type="button" class="btn out-of-stock"> ${Resource.msg('button.outOfStock', 'notifyMe', null)}
            </button>
        </isif>
    </div> </iscomment>
</isif>
