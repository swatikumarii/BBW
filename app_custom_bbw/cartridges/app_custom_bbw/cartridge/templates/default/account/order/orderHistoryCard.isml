<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/custom.js');
    assets.addCss('/css/account/account.css');
</isscript>
<isif condition="${order.orderStatus.value != dw.order.Order.ORDER_STATUS_CANCELLED && order.orderStatus.value != dw.order.Order.ORDER_STATUS_FAILED}">
    <div class="card collapse show" id="orderlist" data-parent="#order-list-accordion">
        <div class="card-head card-info-group">
            <div class="d-md-flex d-block align-items-center justify-content-between">
                <div class="order-date-wrap">
                    <p class="date-placed">
                        <span class="d-block order-left-info">${Resource.msg('label.orderhistory.dateordered', 'account', null)}</span>
                        <span class="d-block order-right-info">
                            <isset name="creationDate" value="${new Date(order.creationDate)}" scope="page" />
                            <isset name="siteLocale" value="${dw.system.Site.getCurrent().defaultLocale}" scope="page" />
                            <isprint value="${creationDate}" formatter="dd-MM-yyyy hh:mm a" />
                        </span>
                    </p>
                    <p class="date-placed">
                        <span class="d-block text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderhistory.ordernumber', 'account', null)}</span>
                        <span class="d-block order-right-info">
                            <isprint value="${order.orderNumber}" /></span>
                    </p>
                    <p class="date-placed">
                        <span class="text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderDetail.status', 'order', null)}</span>
                        <isif condition="${order.exportStatus.value != dw.order.Order.EXPORT_STATUS_EXPORTED && order.shippingStatus.value != dw.order.Order.SHIPPING_STATUS_SHIPPED}">
                            <span
                                class="summary-details order-number text-capitalize order-right-info">${Resource.msg('orderstatusinclude.orderplaced', 'order', null)}</span>

                        <iselseif condition="${order.exportStatus.value == dw.order.Order.EXPORT_STATUS_EXPORTED && order.shippingStatus.value != dw.order.Order.SHIPPING_STATUS_SHIPPED}" />
                            <span
                                class="summary-details order-number text-capitalize order-right-info">${Resource.msg('orderstatusinclude.orderprocessed', 'order', null)}</span>

                        <iselseif condition="${order.shippingStatus.value == dw.order.Order.SHIPPING_STATUS_SHIPPED}" />
                            <span
                                class="summary-details order-number text-capitalize order-right-info">${Resource.msg('orderstatusinclude.ordershipped', 'order', null)}</span>
                        </isif>
                    </p>
                    <p class="date-placed mb-2 mb-md-0">
                        <span class="d-block text-capitalize h-fw--normal order-left-info">${Resource.msg('label.orderhistory.ordertotal', 'account', null)}</span>
                        <span class="d-block order-right-info">${order.priceTotal}</span>
                    </p>
                </div>
                <div class="d-flex flex-column h-grid-gap--5">
                    <a class="btn btn-hover"
                        href="${URLUtils.url('Order-Details', 'orderID', order.orderNumber, 'orderFilter', pdict.orderFilter)}"
                        aria-label="${Resource.msgf('label.orderhistory.vieworderdetails', 'account', null, order.orderNumber)}">${Resource.msg('order.link.view.details', 'account', null)}</a>
                </div>
            </div>
        </div>
    </div>
</isif>
