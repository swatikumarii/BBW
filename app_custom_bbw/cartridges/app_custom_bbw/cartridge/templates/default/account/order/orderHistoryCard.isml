<isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/custom.js');
        assets.addCss('/css/account/account.css');
    </isscript>

<div class="card collapse show" id="orderlist" data-parent="#order-list-accordion">
    <div class="card-head card-info-group">
        <div class="d-md-flex d-block align-items-center justify-content-between">
            <div class="order-date-wrap">
                <p class="date-placed">
                    <span class="d-block">${Resource.msg('label.orderhistory.dateordered', 'account', null)}</span>
                    <span class="d-block">
                        <isprint value="${order.creationDate}" /></span>
                </p>
                <p class="date-placed">
                    <span class="d-block text-capitalize h-fw--normal">${Resource.msg('label.orderhistory.ordernumber', 'account', null)}</span>
                    <span class="d-block">
                        <isprint value="${order.orderNumber}" /></span>
                </p>
                <p>
                    <span class="text-capitalize h-fw--normal">${Resource.msg('label.orderDetail.status', 'order', null)}</span>
                    <isif condition="${order.exportStatus.value != dw.order.Order.EXPORT_STATUS_EXPORTED}">
                        <span class="summary-details order-number h-clr--black">${Resource.msg('orderstatusinclude.orderplaced', 'order', null)}</span>

                    <iselseif condition="${order.exportStatus.value == dw.order.Order.EXPORT_STATUS_EXPORTED}" />
                        <span class="summary-details order-number h-clr--black">${Resource.msg('orderstatusinclude.orderprocessed', 'order', null)}</span>

                    <iselseif condition="${order.shippingStatus.value == dw.order.Order.SHIPPING_STATUS_SHIPPED}"/>
                        <span class="summary-details order-number h-clr--black">${Resource.msg('orderstatusinclude.ordershipped', 'order', null)}</span>
                    </isif>
                </p>
                <p class="date-placed mb-2 mb-md-0">
                    <span class="d-block text-capitalize h-fw--normal">${Resource.msg('label.orderhistory.ordertotal', 'account', null)}</span>
                    <span class="d-block">${order.priceTotal}</span>
                </p>
            </div>
            <div class="d-flex flex-column h-grid-gap--5">
                <a class="btn btn-hover"
                    href="${URLUtils.url('Order-Details', 'orderID', order.orderNumber, 'orderFilter', pdict.orderFilter)}"
                    aria-label="${Resource.msgf('label.orderhistory.vieworderdetails', 'account', null, order.orderNumber)}">${Resource.msg('order.link.view', 'account', null)}</a>

                <iscomment> <button class="add-order-to-cart no-spinner btn btn-hover"
                        title="${Resource.msgf('label.reorder.btn', 'order', null, 'all')}"
                        data-oid="${order.orderNumber}"
                        aria-label="${Resource.msgf('label.reorder.btn', 'order', null, 'all')}" tabindex="0">
                        <span>${Resource.msg('label.reorder.btn', 'order', null)}</span>
                    </button>

                    <button id="invoiceDownload" class="invoice-download btn btn-hover"
                        data-action="${order.invoiceDownloadUrl}">${Resource.msg('account.download', 'account', null)}
                    </button> </iscomment>
            </div>
            <iscomment>
                <div id="add-order-to-cart-snackbar">${Resource.msg('item.added.to.cart', 'common', null)}</div>
            </iscomment>
        </div>
    </div>
</div>
