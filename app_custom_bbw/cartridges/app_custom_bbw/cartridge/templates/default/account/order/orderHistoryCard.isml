<isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/custom.js');
        assets.addCss('/css/account/account.css');
    </isscript>

<iscomment>
    <h3 class="headinfo-year">2024 Orders</h3>
</iscomment>
<div class="card">
    <div class="card-head card-info-group">
        <div class="d-md-flex d-block align-items-center justify-content-between">
            <div class="">
                <p class="date-placed">${Resource.msg('label.orderhistory.dateordered', 'account', null)}
                    <span>
                        <isprint value="${order.creationDate}" /></span>
                </p>
                <p class="my-order-no mb-0">${Resource.msg('label.orderhistory.ordernumber', 'account', null)}
                    <span class="h-clr--black">
                        <isprint value="${order.orderNumber}" /></span>
                </p>
                <p class="my-order-total mb-0">${Resource.msg('label.orderhistory.ordertotal', 'account', null)} :
                    <span class="h-clr--black">${order.priceTotal}</span>
                </p>
            </div>
            <div class="d-flex flex-column h-grid-gap--5">
                <a class="btn btn-hover"
                    href="${URLUtils.url('Order-Details', 'orderID', order.orderNumber, 'orderFilter', pdict.orderFilter)}"
                    aria-label="${Resource.msgf('label.orderhistory.vieworderdetails', 'account', null, order.orderNumber)}">${Resource.msg('order.link.view', 'account', null)}</a>

                <button class="add-order-to-cart no-spinner btn btn-hover"
                    title="${Resource.msgf('label.reorder.btn', 'order', null, 'all')}" data-oid="${order.orderNumber}"
                    aria-label="${Resource.msgf('label.reorder.btn', 'order', null, 'all')}" tabindex="0">
                    <span>${Resource.msg('label.reorder.btn', 'order', null)}</span>
                </button>

                <button id="invoiceDownload" class="invoice-download btn btn-hover"
                    data-action="${order.invoiceDownloadUrl}">${Resource.msg('account.download', 'account', null)}
                </button>
            </div>
            <div id="add-order-to-cart-snackbar">${Resource.msg('item.added.to.cart', 'common', null)}</div>
        </div>
    </div>
</div>
