<isset name="miniCart" value="${false}" scope="page" />

<div class="account-profile">
    <div class="profile-heading">
        <h1 class="mb-2">${Resource.msg('label.order.your.items', 'order', null)}</h1>
    </div>
    <div class="d-flex align-items-center">
        <img width="40px" height="40px" alt="${Resource.msg('label.shipping.truck', 'order', null)}"
            src="${URLUtils.staticURL('/images/account/shipping-truck-32.svg')}" />
        <p class="your-item h-font-size--16 px-2 mb-0 h-clr--black-1 h-fw--bold"><span
                class="pr-1 h-clr--blue h-fw--bold">${Resource.msg('label.shipping.via', 'order', null)}</span><span class="pr-1 h-fw--bold d-inline-block text-capitalize">${shippingMethod} - <isprint value="${totalProductLineItems}" formatter="##" /> ${Resource.msg('label.items', 'order', null)}</span></p>
    </div>
</div>

<div class="order-product-summary mb-4">
    <table class="table table-responsive">
        <thead class="item-details-header">
            <tr>
                <th class="order-description border-top-0 text-uppercase" colspan="2">
                    ${Resource.msg('label.item.description', 'order', null)}</th>
                <th class="order-qty border-top-0 text-center text-uppercase">${Resource.msg('label.qty', 'order', null)}</th>
                <th class="order-price border-top-0 text-right text-uppercase">${Resource.msg('label.item.header.savings', 'cart', null)}</th>
                <th class="order-price border-top-0 text-right text-uppercase">${Resource.msg('label.price', 'order', null)}</th>
            </tr>
        </thead>
        <tbody>
            <isloop items="${pdict.order.shipping}" var="shippingModel">
                <isloop items="${shippingModel.productLineItems.items}" var="lineItem">
                    <tr class="product-info uuid-${lineItem.UUID} pid-${lineItem.id}">
                        <td class="item-image">
                            <img class="product-image" src="${lineItem.images.small[0].url}" srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x"
                                alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}"
                                width="100" />
                        </td>
                        <td class="item-details">
                            <div class="line-item-name">
                                <isif condition="${pdict.isEgiftCard || lineItem.noProduct}">
                                    <span>${lineItem.fragranceName ? lineItem.fragranceName : lineItem.productName}</span>
                                <iselse/>
                                    <a class="product-name" title="${lineItem.productName}"
                                    href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}"><span>${lineItem.fragranceName ? lineItem.fragranceName : lineItem.productName}</span></a>
                                </isif>
                                <isif condition="${lineItem.titlePartB}">
                                    <span class="product-number d-block">${lineItem.titlePartB}</span>
                                </isif>
                                <isif condition="${lineItem.volume}">
                                    <span class="product-number d-block">${lineItem.volume}</span>
                                </isif>
                                <span class="product-number d-block">${Resource.msg('lable.orderDetail.item.id', 'order', null)} :
                                    ${lineItem.id}</span>
                                <iscomment> <span class="order-email">${Resource.msg('label.bracket.open', 'order', null)}${orderEmail}${Resource.msg('label.bracket.close', 'order', null)}</span>
                                </iscomment>
                            </div>
                        </td>
                        <td class="item-qty">
                            <span class="mobile-label d-inline-block d-md-none">
                                ${Resource.msg('label.qty', 'order', null)}
                            </span>
                            <span class="pricing qty-card-quantity-count ">
                                <isprint value="${lineItem.quantity}" formatter="##" /></span>
                        </td>
                        <td class="saving">
                                <isif condition="${lineItem.totalSavings && lineItem.totalSavings != '-'}">
                                    <span class="d-inline d-md-none h-clr--black-3 h-font-size--14 h-fw--bold">${Resource.msg('cart.label.saved', 'cart', null)}</span>
                                    <span class="value ml-1">${lineItem.totalSavings}</span>
                                <iselse/>
                                    <span class="value value-dash d-none d-md-block">${'-'}</span>
                                </isif>
                        </td>
                        <td class="pricing item-total">
                            <span>
                                <isif condition="${lineItem.noProduct}">
                                    ${lineItem.priceTotal.currencyCode} ${lineItem.priceTotal.value}
                                <iselseif condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}"/>
                                    ${Resource.msg('label.free.price', 'cart', null)}
                                <iselse/>
                                    <span class="d-inline d-md-none">${Resource.msg('cart.label.total', 'cart', null)} </span> ${lineItem.priceTotal.price}
                                </isif>
                            </span>
                        </td>
                        <td class="order-add-cart">
                            <isif condition="${!pdict.isEgiftCard}">
                                <isinclude template="account/order/orderAddToCartButton" />
                            </isif>
                        </td>
                    </tr>
                </isloop>
            </isloop>
        </tbody>
    </table>
</div>
