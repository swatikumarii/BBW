<form action="${URLUtils.url('Account-SavePassword')}" class="change-password-form" method="POST" <isprint
    value="${pdict.profileForm.attributes}" encoding="off" />>

    <div class="form-group position-relative password-btn-wrap
        <isif condition=" ${pdict.profileForm.login.currentpassword.mandatory === true}">${Resource.msg('label.required', 'account', null)}</isif>">
        <label class="form-control-label" for="currentPassword">
            <isprint value="${pdict.profileForm.login.currentpassword.label}" encoding="htmlcontent" />
        </label>
        <input type="password" class="form-control password" id="currentPassword"
            data-missing-error="${Resource.msg('error.message.currentpassword', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.password', 'forms', null)}"
            aria-describedby="form-password-error" autocomplete="off" <isprint
            value="${pdict.profileForm.login.currentpassword.attributes}" encoding="off" />/>
        <button type="button" class="show-hide-current-password" aria-label="Show Password">
            <span class="show">${Resource.msg('form.show', 'forms', null)}</span>
        </button>
        <p class="form-caption">${Resource.msg('form.password.caption', 'forms', null)}</p>
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group position-relative password-btn-wrap
                <isif condition=" ${pdict.profileForm.login.newpasswords.newpassword.mandatory === true}">${Resource.msg('label.required', 'account', null)}</isif>">
                
        <label class="form-control-label" for="newPassword">
            <isprint value="${pdict.profileForm.login.newpasswords.newpassword.label}" encoding="htmlcontent" />
        </label>

        <input type="password" class="form-control" id="newPassword"
            data-missing-error="${Resource.msg('error.message.password', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.password', 'forms', null)}"
            aria-describedby="form-password-error" autocomplete="off" <isprint
            value="${pdict.profileForm.login.newpasswords.newpassword.attributes}" encoding="off" />/>

        <button type="button" class="show-hide-new-password" aria-label="Show Password">
            <span class="show">${Resource.msg('form.show', 'forms', null)}</span>
        </button>
        <div class="invalid-feedback"></div>
    </div>

    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
    <div class="required-pass d-none" id="password-requirements" aria-live="polite" aria-hidden="true">
        <ul class="pw-requirements">
            <li class="pw-requirement" id="rule8to50char">
                <span class="rule8to50char pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.8_50characters', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="rule1number">
                <span class="rule1number pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.leastOneNumber', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="rule1uppercase">
                <span class="rule1uppercase pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.leastOneUpper', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="rule1lowercase">
                <span class="rule1lowercase pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.leastOneLowerUpper', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="ruleNoSpaces">
                <span class="ruleNoSpaces pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.noSpace', 'forms', null)}
                </span>
            </li>
        </ul>
    </div>

    <p class="h-font-size--12 text-center"><a class="h-clr--black-3"
            href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}"
            title="Go to Privacy">${Resource.msg('form.privacy.policy', 'forms', null)}</a></p>

    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGoogleRecaptcha')}">
        <div class="row justify-content-center form-group">
            <button data-sitekey="${dw.system.Site.getCurrent().getCustomPreferenceValue('googleRecaptchaSiteKey')}"
                data-callback="submitPassword" data-action="submit" name="save"
                class="btn btn-save text-uppercase btn-hover btn-primary g-recaptcha">
                ${Resource.msg('button.update', 'account', null)}
            </button>
        </div>
    <iselse/>
        <div class="row justify-content-center form-group">
            <button type="submit" name="save" class="btn btn-save text-uppercase btn-hover btn-primary">
                ${Resource.msg('button.update', 'account', null)}
            </button>
        </div>
    </isif>

</form>
