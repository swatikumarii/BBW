<form action="${URLUtils.url('Account-SavePassword')}" class="change-password-form" method="POST" <isprint
    value="${pdict.profileForm.attributes}" encoding="off" />>

    <div class="form-group
            <isif condition=" ${pdict.profileForm.login.currentpassword.mandatory === true}">required</isif>">
        <label class="form-control-label" for="currentPassword">
            <isprint value="${pdict.profileForm.login.currentpassword.label}" encoding="htmlcontent" />
        </label>
        <input type="password" class="form-control" id="currentPassword"
            data-missing-error="${Resource.msg('error.message.password.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            aria-describedby="form-password-error" autocomplete="off" <isprint
            value="${pdict.profileForm.login.currentpassword.attributes}" encoding="off" />/>
        <button type="button" class="hide-show" aria-label="Show Password"><span class="show">Show</span></button>
        <p class="form-caption">${Resource.msg('form.password.caption', 'forms', null)}</p>
        <div class="invalid-feedback"></div>
    </div>

    <div class="form-group
            <isif condition=" ${pdict.profileForm.login.newpasswords.newpassword.mandatory === true}">required</isif>">
        <label class="form-control-label" for="newPassword">
            <isprint value="${pdict.profileForm.login.newpasswords.newpassword.label}" encoding="htmlcontent" />
        </label>
        <input type="password" class="form-control" id="newPassword"
            data-missing-error="${Resource.msg('error.message.password.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            aria-describedby="form-password-error" autocomplete="off" <isprint
            value="${pdict.profileForm.login.newpasswords.newpassword.attributes}" encoding="off" />/>
        <button type="button" class="hide-show" aria-label="Show Password"><span class="show">Show</span></button>
        <div class="invalid-feedback"></div>
    </div>
    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />

<p class="h-font-size--12 text-center"><a class="h-clr--black-3"
        href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}"
        title="Go to Privacy">${Resource.msg('form.privacy.policy', 'forms', null)}</a></p>

<div class="row justify-content-center form-group">
    <button type="submit" name="save"
        class="btn btn-save text-uppercase  btn-primary">${Resource.msg('button.update', 'account', null)}</button>
</div>

</form>
