<isdecorate template="common/layout/page">
    <isinclude template="/components/modules" sf-toolkit="off" />
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
    </isscript>

    <div class="hero slant-down login-banner bg-white">
        <div class="container login-page">
            <!---Breadcrumbs--->
            <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
            <div class="d-flex justify-content-center slot-banner">
                <img class="d-sm-none w-100" src="${URLUtils.staticURL('/images/login/create-account_m.png')}"
                    alt="${Resource.msg('login.create.account-image', 'login', null)}" />
                <img class="d-none d-sm-block register-banner-img"
                    src="${URLUtils.staticURL('/images/login/create-account_d.png')}"
                    alt="${Resource.msg('login.create.account-image', 'login', null)}" />
            </div>
            <div class="row m-0">
                <div class="col-md-12 col-xl-10 col-sm-12 p-0 register-form-head">
                    <h1 class="page-title text-justify h-font-size--24 h-clr--black-3 mb-0 ">
                        ${Resource.msg('header.hero.image.login', 'login', null)}</h1>
                    <p class="required-field-para d-flex justify-content-end h-clr--black-1 mb-0"><span
                            class="required-indicator">*</span>${Resource.msg('required.field.label', 'login', null)}
                    </p>
                </div>
            </div>
            <div class="row justify-content-center equal-height">
                <div class="col-sm-12 col-md-5 col-xl-4">
                    <div class="register-form-nav">
                        <isinclude template="account/components/registerForm" />
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <iscontentasset aid="myAccount-help" />
            </div>
        </div>
    </div>
</isdecorate>
