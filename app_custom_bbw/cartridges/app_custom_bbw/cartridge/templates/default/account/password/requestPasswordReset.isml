<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/login.css');
        assets.addJs('/js/login.js');
    </isscript>
    <div class="hero slant-down login-banner bg-white">
        <div class="container login-page">
            <!---Breadcrumbs--->
            <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
            <div class="row justify-content-center equal-height">
                <div class="col-md-8">
                    <h1 class="page-title text-justify h-font-size--24 h-clr--black-3 mb-4 ">${Resource.msg('label.forgotpassword', 'login', null)}</h1>
                    <isinclude template="account/password/passwordResetForm" />
                </div>
            </div>
        </div>
    </div>
</isdecorate>
