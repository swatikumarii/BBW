<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
    </isscript>
    <div class="hero slant-down login-banner">
        <div class="container  login-page">
            <div class="row justify-content-center">
                <div class="col-sm-6 reset-password-form">
                    <h1 class="page-title page-title text-justify h-font-size--24 h-clr--black-3 mb-4 ">
                        ${Resource.msg('label.profile.reset.password', 'login', null)}</h1>
                            <p class="required-field-para h-clr--black-1"><span class="required-indicator">*</span>
                                ${Resource.msg('required.field.label', 'login', null)}</p>
                          <div class="row">
                          <div class="col-md-6">
                            <isinclude template="account/password/newPasswordForm" />
                          </div>
                         </div>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
