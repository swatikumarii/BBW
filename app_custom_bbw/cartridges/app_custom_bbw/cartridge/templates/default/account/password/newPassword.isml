<isdecorate template="common/layout/page">
<isinclude template="/components/modules" sf-toolkit="off" />
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
    </isscript>
    <div class="hero slant-down login-banner">
        <div class="container  login-page">
            <div class="row justify-content-center">
                <div class="col-md-12 col-xl-12 col-sm-12 form-reset-password">
                    <h1 class="page-title page-title text-justify h-font-size--24 h-clr--black-3 ">
                        ${Resource.msg('label.profile.reset.password', 'login', null)}</h1>
                            <p class="required-field-para h-clr--black-1 d-flex justify-content-end"><span class="required-indicator">*</span>
                                ${Resource.msg('required.field.label', 'login', null)}</p>
                          <div class="row">
                          <div class="col-md-6 newpassword-form">
                            <isinclude template="account/password/newPasswordForm" />
                          </div>
                         </div>
                </div>
            </div>
            <div class="signin-question pt-5">
                <iscontentasset aid="myAccount-help" />
            </div>
        </div>
    </div>
</isdecorate>
