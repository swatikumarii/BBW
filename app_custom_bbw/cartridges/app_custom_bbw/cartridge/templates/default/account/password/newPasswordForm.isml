<form action="${URLUtils.url('Account-SaveNewPassword')}" class="" method="POST" name="change-password-form bbb"
    ${pdict.passwordForm.attributes}>
    <input type="hidden" name="token" value="${pdict.token}" />
    <div class="request-password-body reset-passowrd-body">
        <div class="form-group forgot-password-form
        <isif condition=" ${pdict.passwordForm.newpassword.mandatory === true}">required</isif>">
            <label class="form-control-label text-justify reset-label-name" for="newPassword">
                <span class="required-indicator">*</span>
                <isprint value="${pdict.passwordForm.newpassword.label}" encoding="htmlcontent" />
            </label>
                <input type="password" class="form-control select-dropdown-value h-clr--black-1" id="newPassword"
                data-missing-error="${Resource.msg('error.message.password.required', 'forms', null)}"
                data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
                data-pattern-mismatch="${Resource.msg('error.message.parse.password', 'forms', null)}"
                aria-describedby="form-password-error" autocomplete="off" required
                <isprint value=${pdict.passwordForm.newpassword.attributes} encoding="off" />/>
                <div class="invalid-feedback">
                    <isprint value="${pdict.passwordForm.newpassword.error}" encoding="htmlcontent" />
                </div>
                <button type="button"
                    class="resetpassword-hide-show border-0 d-flex justify-content-center align-items-center text-captialize position-absolute p-0 h-clr--black-3"
                    aria-label="Show Password">
                    <span class="show h-font-size--16">${Resource.msg('password.show.label', 'login', null)}</span>
                </button>
        </div>
        <div class="required-pass d-none" id="password-requirements" aria-live="polite" aria-hidden="true">
            <ul class="pw-requirements">
                <li class="pw-requirement" id="rule8to50char">
                    <span class="rule8to50char pw-error" aria-hidden="true">
                        <span class="circle" aria-hidden="true"></span>
                        ${Resource.msg('error.message.password.8_50characters', 'forms', null)}
                    </span>
                </li>
                <li class="pw-requirement" id="rule1number">
                    <span class="rule1number pw-error" aria-hidden="true">
                        <span class="circle" aria-hidden="true"></span>
                        ${Resource.msg('error.message.password.leastOneNumber', 'forms', null)}
                    </span>
                </li>
                <li class="pw-requirement" id="rule1uppercase">
                    <span class="rule1uppercase pw-error" aria-hidden="true">
                        <span class="circle" aria-hidden="true"></span>
                        ${Resource.msg('error.message.password.leastOneUpper', 'forms', null)}
                    </span>
                </li>
                <li class="pw-requirement" id="rule1lowercase">
                    <span class="rule1lowercase pw-error" aria-hidden="true">
                        <span class="circle" aria-hidden="true"></span>
                        ${Resource.msg('error.message.password.leastOneLowerUpper', 'forms', null)}
                    </span>
                </li>
                <li class="pw-requirement" id="ruleSpecialChar">
                    <span class="ruleSpecialChar pw-error" aria-hidden="true">
                        <span class="circle" aria-hidden="true"></span>
                        ${Resource.msg('error.message.password.noSpecialChar', 'forms', null)}
                    </span>
                </li>
                <li class="pw-requirement" id="ruleNoSpaces">
                    <span class="ruleNoSpaces pw-error" aria-hidden="true">
                        <span class="circle" aria-hidden="true"></span>
                        ${Resource.msg('error.message.password.noSpace', 'forms', null)}
                    </span>
                </li>
            </ul>
        </div>
        <div class="form-group forgot-password-form
                <isif condition=" ${pdict.passwordForm.newpasswordconfirm.mandatory === true}">required</isif>">
            <label class="form-control-label" for="newPasswordConfirm">
                <isprint value="${pdict.passwordForm.newpasswordconfirm.label}" encoding="htmlcontent" />
            </label>
            <input type="password" class="form-control ${!pdict.passwordForm.newpasswordconfirm.valid ? 'is-invalid' : ''}"
                id="newPasswordConfirm" <isprint value="${pdict.passwordForm.newpasswordconfirm.attributes}" encoding="off" />
            />
            <div class="invalid-feedback">
                <isprint value="${pdict.passwordForm.newpasswordconfirm.error}" encoding="htmlcontent" />
            </div>
            <button type="button"
                class="password-hide-show border-0 d-flex justify-content-center align-items-center text-captialize position-absolute p-0 h-clr--black-3"
                aria-label="Show Password">
                <span class="show h-font-size--16">${Resource.msg('password.show.label', 'login', null)}</span>
            </button>
        </div>


        <div class="mt-3 d-flex justify-content-center">
            <button type="submit" name="save"
                class="btn btn-save btn-block btn-primary d-flex justify-content-center changepassowrd-btn text-uppercase">${Resource.msg('label.profile.reset.password', 'login', null)}
            </button>
        </div>
    </div>
</form>
