<form class="reset-password-form" action="${URLUtils.url('Account-PasswordResetDialogForm', 'mobile', pdict.mobile)}"
    method="POST" name="email-form" id="email-form">
    <div class="request-password-body">
        <p class=" text-left">
            ${Resource.msg('msg.forgotpassword', 'login', null)}
            <a href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}" class="h-clr--black-3 h-font-size--14">
                ${Resource.msg('link.privacypolicy.registration', 'login', null)}
            </a>
        </p>
        <div class="form-group required forgot-password-form">
            <label class="form-control-label text-justify reset-label-name" for="reset-password-email">
            <span class="required-indicator">*</span>
                <isprint value="${Resource.msg('label.input.login.email', 'login', null)}" encoding="htmlcontent" />
            </label>
         <div class="d-flex">
          <div class="forgotPassword">
            <input id="reset-password-email" type="email" class="form-control login-form-input" name="loginEmail"
                aria-describedby="emailHelp" required>
            <div class="invalid-feedback" role="alert" id="resetEmail">${Resource.msg('forgot.msg.email', 'login', null)}</div>
            </div>
            <button type="submit" id="submitEmailButton" class="btn btn-primary btn-block resetpassword-btn w-auto text-uppercase">
                ${Resource.msg('button.send', 'login', null)}
            </button>
         </div>
        </div>
    </div>
</form>
