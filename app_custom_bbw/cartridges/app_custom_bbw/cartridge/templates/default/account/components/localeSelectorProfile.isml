<div class="account-profile">
  <div class="profile-heading">
    <h3 class="account-info-header h-clr--black-3 h-font-size--14 text-uppercase">
      ${Resource.msg('label.profile.yourlocale', 'account', null)}</h3>
  </div>
</div>
<div class="row justify-content-center">
  <div class="account-info">
    <div class="form-group">
      <label class="form-control-label" for="email">
              ${Resource.msg('label.profile.locale', 'account', null)}
      </label>
      <isif condition="${pdict.localeModel.locale.localeLinks.length > 0}">
        <div class="form-group select-box">
          <div class="dropdown country-selector" data-url="${URLUtils.url('Page-SetLocale')}" tabindex="0">

            <div class="select-wrap w-100 dropdown-country-selector" aria-labelledby="dropdownCountrySelector">
              <select class="form-control h-clr--black-1 w-100">
                <isloop items="${pdict.localeModel.locale.localeLinks}" var="localeLink">
                  <option class="" data-locale="${localeLink.localID}" data-currencyCode="${localeLink.currencyCode}">
                    <i class="fi fi-${localeLink.country.toLowerCase()}"></i>
                    ${localeLink.displayName}
                  </option>
                </isloop>
              </select>
            </div>
          </div>
        </div>
      </isif>
      <div class="row justify-content-center form-group">
        <button type="submit" name="save" class="btn btn-save text-uppercase btn-hover btn-primary">
          ${Resource.msg('button.update', 'account', null)}
        </button>
      </div>
    </div>
  </div>
</div>
