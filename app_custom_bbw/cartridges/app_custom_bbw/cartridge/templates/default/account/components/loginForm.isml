<form action="${pdict.actionUrl}" class="login" method="POST" name="login-form">
    <div class="form-group required">
        <label class="form-control-label text-justify" for="login-form-email">
            ${Resource.msg('label.login.email', 'login', null)}
        </label>
        <input type="email" id="login-form-email" required aria-required="true" class="form-control login-form-input required"
            aria-describedby="form-email-error" name="loginEmail" value="${pdict.userName}">
        <div class="invalid-feedback text-left" id="form-email-error"></div>
    </div>

    <div class="form-group required password-box position-relative">
        <label class="form-control-label text-justify" for="login-form-password">
            ${Resource.msg('label.input.login.password', 'login', null)}
        </label>
        <input type="password" id="login-form-password" required aria-required="true" class="form-control required login-form-input"
            aria-describedby="form-password-error" name="loginPassword">
        <div class="invalid-feedback text-left" id="form-password-error"></div>
        <button type="button" class="hide-show border-0 d-flex justify-content-center align-items-center text-captialize h-50 position-absolute p-0 h-clr--black-3" aria-label="Show Password">
           <span class="show h-font-size--16">${Resource.msg('password.show.label', 'login', null)}</span>
        </button>
    </div>

    <div class="clearfix">
        <iscomment> <div class="form-group custom-control custom-checkbox pull-left remember-me">
            <input type="checkbox" class="custom-control-input" id="rememberMe" name="loginRememberMe" value="true"
                <isif condition="${pdict.rememberMe}">checked</isif>
            >
            <label class="custom-control-label" for="rememberMe">
                ${Resource.msg('label.checkbox.login.rememberme', 'login', null)}
            </label>
        </div> </iscomment>

        <div class="forgot-password text-justify">
            <a class="d-sm h-font-size--14  h-clr--gray sign-in-forgot" href="${URLUtils.url('Account-PasswordReset')}"
                title="${Resource.msg('label.forgotpassword', 'login', null)}">
                ${Resource.msg('label.forgotpassword', 'login', null)}
            </a>
        </div>
    </div>

    <div class="privacy-block privacy-policy w-100 text-center h-clr--black-3 h-font-size--12">
        <a href="${'#'}" class="text-center">
            ${Resource.msg('link.privacypolicy.registration', 'login', null)}
        </a>
    </div>

    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
    <input type="hidden" name="loginRedirectUrl" value="${pdict.loginRedirectUrl}" />
    <input type="hidden" name="loginRedirectQueryString" value="${pdict.loginRedirectQueryString}" />
    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGoogleRecaptcha')}">
        <div class="login-btn register-btn">
            <button
                data-sitekey="${dw.system.Site.getCurrent().getCustomPreferenceValue('googleRecaptchaSiteKey')}"
                data-callback="submitLogin"
                data-action="submit"
                class="btn btn-block btn-primary g-recaptcha">${Resource.msg('button.text.loginform', 'login', null)}</button>
        </div>
    <iselse/>
        <div class="login-btn register-btn text-center">
            <button type="submit" class="btn btn-block btn-primary text-uppercase signin-btn sign-in-btn w-auto">${Resource.msg('button.text.loginform', 'login', null)}</button>
        </div>
    </isif>
</form>
