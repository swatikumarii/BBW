<form action="${pdict.createAccountUrl}" class="registration " method="POST" name="${pdict.profileForm.htmlName}">
    <div class="form-group select-box register-form   <isif condition=" ${!!pdict.profileForm.customer.salutation.mandatory === true}">
        required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-salutation">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.salutation.label}" encoding="htmlcontent" />
        </label>
        <div class="select-wrap ">
            <select
                class="form-control salutation selectric-dropdown salutation-hide h-clr--black-1"
                id="registration-form-salutation"
                data-missing-error="${Resource.msg('error.salutation.message', 'forms', null)}"
                data-range-error="${Resource.msg('error.message.50orless', 'forms', null)}" <isprint
                value="${pdict.profileForm.customer.salutation.attributes}" encoding="off" />
            >
            <option value=""> ${Resource.msg('label.select.salutation.profile', 'forms', null)} </option>
            <option value="Mr" <isif condition="${pdict.profileForm.salutation.htmlValue == " Mr"}">selected</isif>>
                ${Resource.msg('label.select.mr.salutation.profile', 'forms', null)}
            </option>
            <option value="Mrs" <isif condition="${pdict.profileForm.salutation.htmlValue == " Mrs"}">selected</isif>>
                ${Resource.msg('label.select.mrs.salutation.profile', 'forms', null)}</option>
            <option value="Miss" <isif condition="${pdict.profileForm.salutation.htmlValue == " Miss"}">selected</isif>>
                ${Resource.msg('label.select.miss.salutation.profile', 'forms', null)}
            </option>
            </select>
            <div class="invalid-feedback text-left mt-5" id="salutation-error">${Resource.msg('error.salutation.message', 'forms', null)}
            </div>
        </div>
    </div>
    <div class="form-group register-form text-center <isif condition="
        ${!!pdict.profileForm.customer.firstname.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-fname">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.firstname.label}" encoding="htmlcontent" />
        </label>
        <input required type="text" class="form-control select-dropdown-value h-clr--black-1"
            id="registration-form-fname"
            data-missing-error="${Resource.msg('error.message.fname.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.fname.2orGreater', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.fname', 'forms', null)}"
            aria-describedby="form-fname-error" <isprint value=${pdict.profileForm.customer.firstname.attributes}
            encoding="off" />
        />
        <div class="invalid-feedback text-left" id="fname-error">${Resource.msg('error.message.fname.required', 'forms', null)}</div>
    </div>

    <div class="form-group register-form text-center <isif condition="
        ${!!pdict.profileForm.customer.lastname.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-lname">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.lastname.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control select-dropdown-value h-clr--black-1" id="registration-form-lname"
            data-missing-error="${Resource.msg('error.message.lname.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.lname.2orGreater', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.lname', 'forms', null)}"
            aria-describedby="form-lname-error" required <isprint
            value=${pdict.profileForm.customer.lastname.attributes} encoding="off" />/>
        <div class="invalid-feedback text-left" id="lname-error">${Resource.msg('error.message.lname.required', 'forms', null)}</div>
    </div>

    <div class="form-group register-form text-center phone-drpdwn <isif condition="
        ${!!pdict.profileForm.customer.phone.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-phone">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.phone.label}" encoding="htmlcontent" />
        </label>
        <input type="tel" class="form-control select-dropdown-value h-clr--black-1" required
            id="registration-form-phone" initOptions.allowDropdown="true"
            data-missing-error="${Resource.msg('error.message.phone.required', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.phone.profile.form', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.50orless', 'forms', null)}"
            aria-describedby="form-phone-error" <isprint value=${pdict.profileForm.customer.phone.attributes}
            encoding="off" /> />
    </div>

    <div class="form-group register-form text-center <isif condition="
        ${!!pdict.profileForm.customer.email.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-email">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.email.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control select-dropdown-value h-clr--black-1" id="registration-form-email"
            data-missing-error="${Resource.msg('error.message.email.required', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.email', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.email.50orless', 'forms', null)}"
            aria-describedby="form-email-error" required <isprint value=${pdict.profileForm.customer.email.attributes}
            encoding="off" />>
        <div class="invalid-feedback text-left" id="email-error">${Resource.msg('error.message.email.required', 'forms', null)}</div>
    </div>

    <div class="form-group register-form text-center <isif condition="
        ${!!pdict.profileForm.customer.emailconfirm.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-email-confirm">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.emailconfirm.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control select-dropdown-value h-clr--black-1"
            id="registration-form-email-confirm"
            data-missing-error="${Resource.msg('error.message.email.required', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.email', 'forms', null)}"
            data-email-mismatch="${Resource.msg('error.message.mismatch.email', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.email.50orless', 'forms', null)}"
            aria-describedby="form-email-confirm-error" required <isprint
            value=${pdict.profileForm.customer.emailconfirm.attributes} encoding="off" />/>
        <div class="invalid-feedback text-left" id="confirm-email-error">${Resource.msg('error.message.email.required', 'forms', null)}</div>
    </div>

    <div class="form-group password-box position-relative register-form text-center <isif condition="
        ${!!pdict.profileForm.login.password.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-password">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.login.password.label}" encoding="htmlcontent" />
        </label>
        <input type="password" class="form-control select-dropdown-value h-clr--black-1" id="registration-form-password"
            data-missing-error="${Resource.msg('error.message.password.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.password', 'forms', null)}"
            aria-describedby="form-password-error" autocomplete="off" required <isprint
            value=${pdict.profileForm.login.password.attributes} encoding="off" />/>
        <button type="button" id="toggle-password"
            class="register-form-hide register-hide border-0 d-flex justify-content-center align-items-center text-captialize h-50 position-absolute p-0 h-clr--black-3"
            aria-label="Show Password">
            <span class="show h-font-size--16">${Resource.msg('password.show.label', 'login', null)}</span>
        </button>
    </div>
    <div class="required-pass d-none" id="password-requirements" aria-live="polite" aria-hidden="true">
        <ul class="pw-requirements">
            <li class="pw-requirement" id="rule8to50char">
                <span class="rule8to50char pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.8_50characters', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="rule1number">
                <span class="rule1number pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.leastOneNumber', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="rule1uppercase">
                <span class="rule1uppercase pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.leastOneUpper', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="rule1lowercase">
                <span class="rule1lowercase pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.leastOneLowerUpper', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="ruleSpecialChar">
                <span class="ruleSpecialChar pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.noSpecialChar', 'forms', null)}
                </span>
            </li>
            <li class="pw-requirement" id="ruleNoSpaces">
                <span class="ruleNoSpaces pw-error" aria-hidden="true">
                    <span class="circle" aria-hidden="true"></span>
                    ${Resource.msg('error.message.password.noSpace', 'forms', null)}
                </span>
            </li>
        </ul>
    </div>

    <div class="form-group  password-box position-relative register-form text-center <isif condition="
        ${!!pdict.profileForm.login.passwordconfirm.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-password-confirm">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.login.passwordconfirm.label}" encoding="htmlcontent" />
        </label>
        <input type="password" class="form-control select-dropdown-value h-clr--black-1"
            id="registration-form-password-confirm"
            data-missing-error="${Resource.msg('error.message.password.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            aria-describedby="form-password-confirm-error" autocomplete="off" required <isprint
            value=${pdict.profileForm.login.passwordconfirm.attributes} encoding="off" />/>
        <div class="invalid-feedback text-left" id="confirm-password-error">
            ${Resource.msg('error.message.password.required', 'forms', null)}</div>
        <button type="button" id="toggle-password"
            class="register-form-confirm-password register-hide border-0 d-flex justify-content-center align-items-center text-captialize position-absolute p-0 h-clr--black-3"
            aria-label="Show Password">
            <span class="show h-font-size--16">${Resource.msg('password.show.label', 'login', null)}</span>
        </button>
    </div>
    <div class="form-group select-box register-form <isif condition="
        ${!!pdict.profileForm.customer.gender.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-gender">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.gender.label}" encoding="htmlcontent" />
        </label>
        <div class="select-wrap ">
            <select class="form-control gender selectric-dropdown gender-hide h-clr--black-1"
                id="registration-form-gender"
                data-missing-error="${Resource.msg('error.gender.message', 'forms', null)}"
                data-range-error="${Resource.msg('error.message.50orless', 'forms', null)}" <isprint
                value="${pdict.profileForm.customer.gender.attributes}" encoding="off" />>
            <option value=""> ${Resource.msg('label.select.gender.profile', 'forms', null)} </option>
            <option value="Male" <isif condition="${pdict.profileForm.gender.htmlValue == " Male"}">selected</isif>>
                ${Resource.msg('label.select.male.gender.profile', 'forms', null)}
            </option>
            <option value="Female" <isif condition="${pdict.profileForm.gender.htmlValue == " Female"}">selected</isif>>
                ${Resource.msg('label.select.female.gender.profile', 'forms', null)}</option>
            <option value="Prefer Not To Say" <isif condition="${pdict.profileForm.gender.htmlValue == " Prefer Not To
                                                           Say "}">selected</isif>>
                ${Resource.msg('label.select.notToSay.gender.profile', 'forms', null)}
            </option>
            </select>
            <div class="invalid-feedback text-left mt-5" id="gender-error">${Resource.msg('error.gender.message', 'forms', null)}</div>
        </div>
    </div>
    <div class="form-group register-form text-center">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-zip">
            <isprint value="${pdict.profileForm.customer.zip.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control select-dropdown-value h-clr--black-1" id="registration-form-zip"
            data-range-error="${Resource.msg('error.message.zip.10orless', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.zip', 'forms', null)}"
            aria-describedby="form-zip-error" <isprint value=${pdict.profileForm.customer.zip.attributes}
            encoding="off" /> />
        <div class="invalid-feedback text-left" id="registration-form-zip-error"></div>
    </div>
    <div class="form-group select-box register-form <isif condition="
        ${!!pdict.profileForm.customer.nationality.mandatory === true}">required</isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-nationality">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.nationality.label}" encoding="htmlcontent" />
        </label>
        <div class="select-wrap">
            <select class="form-control gender selectric-dropdown gender-hide h-clr--black-1"
                id="registration-form-nationality"
                data-missing-error="${Resource.msg('error.message.nationality', 'forms', null)}" <isprint
                value="${pdict.profileForm.customer.nationality.attributes}" encoding="off" />>
            <isloop items=${pdict.nationalities} var="nationality">
                <option id="${nationality}" value="${nationality.toLowerCase().trim()}" <isif
                    condition="${pdict.nationality.toLowerCase().trim() == nationality.toLowerCase().trim()}">
                    selected
                    </isif>>${nationality}</option>
            </isloop>
            </select>
            <div class="invalid-feedback text-left mt-5" id="nationality-error">${Resource.msg('error.message.nationality', 'forms', null)}</div>
        </div>
    </div>
    <iscontentasset aid="register-form" />

    <div class="form-group register-form text-center <isif condition="
        ${!!pdict.profileForm.customer.dob.mandatory === true}">required
        </isif>">
        <label class="form-control-label h-font-size--14 text-justify" for="registration-form-dob">
            <span class="required-indicator">*</span>
            <isprint value="${pdict.profileForm.customer.dob.label}" encoding="htmlcontent" />
        </label>
        <input type="date" class="form-control datepicker select-dropdown-value h-clr--black-1"
            id="registration-form-dob" data-mask="99/99/9999" data-min-age="0" placeholder="DD/MM/YYYY"
            data-missing-error="${Resource.msg('error.message.dob.required', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.dob', 'forms', null)}" required <isprint
            value=${pdict.profileForm.customer.dob.attributes} encoding="off" />>
        <div class="invalid-feedback text-left" id="dob-error=">${Resource.msg('error.message.dob.required', 'forms', null)}</div>
    </div>

    <div class="form-group register-form text-center custom-control custom-checkbox p-0">
        <input type="checkbox" id="add-to-email-list" class="add-to-email-list custom-control-input" data-missing-error="${Resource.msg('error.message.checkbox.required', 'forms', null)}" required
        />
        <label class="custom-control-label h-clr--black-1 h-font-size--16" for="add-to-email-list">
            <span class="h-clr--black-1 h-font-size--16 cursor-pointer"><isprint value="${pdict.profileForm.customer.addtoemaillist.label}" encoding="htmlcontent" /> ${Resource.msg('label.terms.contitions', 'forms', null)}</span>
            <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Page-Show', 'cid', 'terms-of-use')}"
                class="h-clr--black-1 h-font-size--16 d-block text-left b-link--underlined">${Resource.msg('label.read.here', 'forms', null)}</a>
        </label>
        <div class="invalid-feedback p-0" id="tnc-checkbox-error"></div>
    </div>

    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
    <div class="text-center register-privacy">
        <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}" class="h-font-size--12 h-clr--black-3">
            ${Resource.msg('link.privacypolicy.registration', 'login', null)}
        </a>
    </div>
    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGoogleRecaptcha') == true}">
        <div class="d-flex justify-content-center changepassword">
            <button data-sitekey="${dw.system.Site.getCurrent().getCustomPreferenceValue('googleRecaptchaSiteKey')}"
                data-callback="submitRegistration" data-action="submit"
                class="btn btn-block btn-primary g-recaptcha changepassowrd-btn text-uppercase w-auto create-btn">
                ${Resource.msg('button.createaccount.registration', 'registration', null)}
            </button>
        </div>
    <iselse/>
        <div class="d-flex justify-content-center changepassword">
            <button type="submit" class="btn btn-block btn-primary changepassowrd-btn text-uppercase w-auto create-btn">
                ${Resource.msg('button.createaccount.registration', 'registration', null)}
            </button>
        </div>
    </isif>
    <iscomment>
        <div class="privacy-policy">
            ${Resource.msg('description.privacypolicy.registration', 'registration', null)}
            <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${'#'}">
                ${Resource.msg('link.privacypolicy.registration', 'registration', null)}
            </a>
        </div>
    </iscomment>
        <div class="register-success d-none" id="register-success-message">
            ${Resource.msg('toast.success.register', 'account', null)}</div>
</form>
