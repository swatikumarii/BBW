<form action="${URLUtils.url('Account-SaveProfile')}" class="edit-profile-form" method="POST" <isprint value="${pdict.profileForm.attributes}" encoding="off" />>
    <div class="form-group
        <isif condition="${pdict.profileForm.customer.firstname.mandatory === true}">required</isif>">
        <label class="form-control-label" for="firstName">
            <isprint value="${pdict.profileForm.customer.firstname.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control" id="firstName"
            data-missing-error="${Resource.msg('error.message.fname.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.fname.2orGreater', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.fname', 'forms', null)}"
            aria-describedby="form-fname-error" <isprint value=${pdict.profileForm.customer.firstname.attributes}
            encoding="off" /> />
        <div class="invalid-feedback" id="form-fname-error"></div>
    </div>

    <div class="form-group
        <isif condition="${pdict.profileForm.customer.lastname.mandatory === true}">required</isif>">
        <label class="form-control-label" for="lastName">
            <isprint value="${pdict.profileForm.customer.lastname.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control" id="lastName"
            data-missing-error="${Resource.msg('error.message.lname.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.lname.2orGreater', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.lname', 'forms', null)}"
            aria-describedby="form-lname-error" <isprint value=${pdict.profileForm.customer.lastname.attributes}
            encoding="off" />/>
        <div class="invalid-feedback" id="form-lname-error"></div>
    </div>

    <div class="form-group
        <isif condition="${pdict.profileForm.customer.phone.mandatory === true}">required</isif>">
        <label class="form-control-label" for="phone">
            <isprint value="${pdict.profileForm.customer.phone.label}" encoding="htmlcontent" />
        </label>
        <input type="tel" class="form-control" id="phone"
            initOptions.allowDropdown="true"
            data-missing-error="${Resource.msg('error.message.required', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.phone.profile.form', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.50orless', 'forms', null)}" aria-describedby="form-phone-error"
            <isprint value=${pdict.profileForm.customer.phone.attributes} encoding="off" />
        placeholder="${Resource.msg('example.phone', 'forms', null)}"/>
        <div class="invalid-feedback" id="form-phone-error"></div>
    </div>
    <p>${Resource.msg('form.phone.caption', 'forms', null)}</p>

    <div class="form-group
            <isif condition=" ${pdict.profileForm.customer.dob.mandatory === true}">required</isif>">
        <labdel class="form-control-label" for="dob">
            <isprint value="${pdict.profileForm.customer.dob.label}" encoding="htmlcontent" />
        </labdel>
        <p>${pdict.profileForm.customer.dob.value}</p>
    </div>
    <p>${Resource.msg('form.birthday.caption', 'forms', null)}</p>

    <div class="form-group
            <isif condition=" ${pdict.profileForm.customer.zip.mandatory === true}">required</isif>">
        <label class="form-control-label" for="zip">
            <isprint value="${pdict.profileForm.customer.zip.label}" encoding="htmlcontent" />
        </label>
        <input type="text" class="form-control" id="zip"
            data-missing-error="${Resource.msg('error.message.zip.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.zip.10orless', 'forms', null)}"
            data-pattern-mismatch="${Resource.msg('error.message.parse.zip', 'forms', null)}" aria-describedby="form-zip-error"
            <isprint value=${pdict.profileForm.customer.zip.attributes} encoding="off" /> />
        <div class="invalid-feedback" id="form-zip-error"></div>
    </div>

    <div class="form-group
        <isif condition="${pdict.profileForm.login.password.mandatory === true}">required</isif>">
        <label class="form-control-label" for="password">
            <isprint value="${pdict.profileForm.login.password.label}" encoding="htmlcontent" />
        </label>
        <div class="invalid-feedback"></div>
        <input type="password" class="form-control" id="password"
            data-missing-error="${Resource.msg('error.message.password.required', 'forms', null)}"
            data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
            aria-describedby="form-password-error" autocomplete="off" <isprint
            value=${pdict.profileForm.login.password.attributes} encoding="off" />/>
        <div class="invalid-feedback" id="form-password-error"></div>
    </div>
    <p>${Resource.msg('form.password.caption', 'forms', null)}</p>

    <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}"/>
    <input type="hidden" name="${pdict.profileForm.customer.emailconfirm.attributes}" value="${pdict.profileForm.customer.emailconfirm.attributes}" />
    <div class="row">
        <div class="col form-group">
            <button type="button" class="api-${pdict.consentApi} ${pdict.tracking_consent == null ? '' : 'consented' } tracking-consent tracking-consent-btn"
                data-caOnline="${pdict.caOnline}"
                data-url="${URLUtils.url('ConsentTracking-GetContent', 'cid', 'tracking_hint')}"
                data-reject="${URLUtils.url('ConsentTracking-SetConsent', 'consent', 'false')}"
                data-accept="${URLUtils.url('ConsentTracking-SetConsent', 'consent', 'true')}"
                data-acceptText="${Resource.msg('button.consentTracking.yes', 'common', null)}"
                data-rejectText="${Resource.msg('button.consentTracking.no', 'common', null)}"
                data-heading="${Resource.msg('heading.consentTracking.track.consent', 'common', null)}"
                data-tokenName="${pdict.csrf.tokenName}"
                data-token="${pdict.csrf.token}"
            >
                ${Resource.msg('link.tracking.consent','account',null)}
            </button>
        </div>
    </div>
    <p><a href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}" title="Go to Privacy">${Resource.msg('form.privacy.policy', 'forms', null)}</a></p>
    <div class="row">
        <iscomment> <div class="col">
            <a href="${URLUtils.url('Account-Show')}" class="btn btn-block btn-outline-primary">${Resource.msg('button.cancel','account',null)}</a>
        </div> </iscomment>

        <div class="col">
            <button type="submit" name="save" class="btn btn-save btn-block btn-primary">${Resource.msg('button.save','account',null)}</button>
        </div>
    </div>
</form>
