<form action="${URLUtils.url('Account-SaveProfile')}" class="edit-profile-form" method="POST" <isprint
    value="${pdict.profileForm.attributes}" encoding="off" />>
<div class="form-group
        <isif condition=" ${pdict.profileForm.customer.firstname.mandatory === true}">required</isif>">
    <label class="form-control-label" for="firstName">
        <isprint value="${pdict.profileForm.customer.firstname.label}" encoding="htmlcontent" />
    </label>
    <input type="text" class="form-control" id="firstName"
        data-missing-error="${Resource.msg('error.message.fname.required', 'forms', null)}"
        data-range-error="${Resource.msg('error.message.fname.2orGreater', 'forms', null)}"
        data-pattern-mismatch="${Resource.msg('error.message.parse.fname', 'forms', null)}"
        aria-describedby="form-fname-error" <isprint value=${pdict.profileForm.customer.firstname.attributes}
        encoding="off" /> />
    <div class="invalid-feedback" id="form-fname-error"></div>
</div>

<div class="form-group
        <isif condition=" ${pdict.profileForm.customer.lastname.mandatory === true}">required</isif>">
    <label class="form-control-label" for="lastName">
        <isprint value="${pdict.profileForm.customer.lastname.label}" encoding="htmlcontent" />
    </label>
    <input type="text" class="form-control" id="lastName"
        data-missing-error="${Resource.msg('error.message.lname.required', 'forms', null)}"
        data-range-error="${Resource.msg('error.message.lname.2orGreater', 'forms', null)}"
        data-pattern-mismatch="${Resource.msg('error.message.parse.lname', 'forms', null)}"
        aria-describedby="form-lname-error" <isprint value=${pdict.profileForm.customer.lastname.attributes}
        encoding="off" />/>
    <div class="invalid-feedback" id="form-lname-error"></div>
</div>

<div class="form-group
        <isif condition=" ${pdict.profileForm.customer.phone.mandatory === true}">required</isif>">
    <label class="form-control-label" for="phone">
        <isprint value="${pdict.profileForm.customer.phone.label}" encoding="htmlcontent" />
    </label>
    <input type="tel" class="form-control" id="phone" initOptions.allowDropdown="true"
        data-missing-error="${Resource.msg('error.message.required', 'forms', null)}"
        data-pattern-mismatch="${Resource.msg('error.message.parse.phone.profile.form', 'forms', null)}"
        data-range-error="${Resource.msg('error.message.50orless', 'forms', null)}" aria-describedby="form-phone-error"
        <isprint value=${pdict.profileForm.customer.phone.attributes} encoding="off" />
    placeholder="${Resource.msg('example.phone', 'forms', null)}"/>
    <p class="form-caption">${Resource.msg('form.phone.caption', 'forms', null)}</p>
    <div class="invalid-feedback" id="form-phone-error"></div>
</div>

<div class="form-group
            <isif condition=" ${pdict.profileForm.customer.dob.mandatory === true}">
    </isif>">
    <label class="birthday-label form-control-label" for="dob">
        <isprint value="${Resource.msg('label.input.birthday', 'forms', null)}" encoding="htmlcontent" />
    </label>
    <div class="birthday-date">
        <p class="mb-0">${pdict.profileForm.customer.dob.value}</p>
    </div>
    <iscomment>
        <p class="form-caption">${Resource.msg('form.birthday.caption', 'forms', null)}</p>
    </iscomment>
</div>


<div class="form-group
            <isif condition=" ${pdict.profileForm.customer.zipCode.mandatory === true}">required</isif>">
    <label class="form-control-label" for="zipCode">
        <isprint value="${pdict.profileForm.customer.zipCode.label}" encoding="htmlcontent" />
    </label>
    <input type="text" class="form-control" id="zipCode"
        data-missing-error="${Resource.msg('error.message.zip.required', 'forms', null)}"
        data-range-error="${Resource.msg('error.message.zip.upto4', 'forms', null)}"
        data-pattern-mismatch="${Resource.msg('error.message.parse.zip', 'forms', null)}"
        aria-describedby="form-zip-error" <isprint value=${pdict.profileForm.customer.zipCode.attributes} encoding="off" />
    />
    <div class="invalid-feedback" id="form-zip-error"></div>
</div>

<div class="form-group position-relative password-btn-wrap
        <isif condition=" ${pdict.profileForm.login.password.mandatory === true}">required</isif>">
    <label class="form-control-label" for="password">
        <isprint value="${pdict.profileForm.login.currentpassword.label}" encoding="htmlcontent" />
    </label>
    <div class="invalid-feedback"></div>
    <input type="password" class="form-control password" id="password"
        data-missing-error="${Resource.msg('error.message.password', 'forms', null)}"
        data-range-error="${Resource.msg('error.message.password.8_50characters', 'forms', null)}"
        data-pattern-mismatch="${Resource.msg('error.message.parse.password', 'forms', null)}"
        aria-describedby="form-password-error" autocomplete="off" <isprint
        value=${pdict.profileForm.login.password.attributes} encoding="off" />/>
    <button type="button" class="show-hide-password" aria-label="Show Password"><span class="show">Show</span></button>
    <div class="invalid-feedback" id="form-password-error"></div>
    <p class="form-caption">${Resource.msg('form.password.caption', 'forms', null)}</p>
</div>

<input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
<input type="hidden" name="${pdict.profileForm.customer.emailconfirm.attributes}"
    value="${pdict.profileForm.customer.emailconfirm.attributes}" />


<p class="h-font-size--12 text-center"><a class="h-clr--black-3"
        href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}"
        title="Go to Privacy">${Resource.msg('form.privacy.policy', 'forms', null)}</a></p>

<isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGoogleRecaptcha')}">
    <div class="row justify-content-center form-group">
        <button data-sitekey="${dw.system.Site.getCurrent().getCustomPreferenceValue('googleRecaptchaSiteKey')}"
            data-callback="submitProfile" data-action="submit" name="save"
            class="btn btn-save btn-hover text-uppercase btn-primary g-recaptcha">
            ${Resource.msg('button.update', 'account', null)}
        </button>
    </div>
<iselse/>
    <div class="row justify-content-center form-group">
        <button type="submit" name="save"
            class="btn btn-save btn-hover text-uppercase btn-primary">${Resource.msg('button.update', 'account', null)}</button>
    </div>
</isif>
</form>
