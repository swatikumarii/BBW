<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/account/profile.css');
        assets.addJs('/js/profile.js');
    </isscript>
    <div class="hero slant-down account-image">
    </div>
    <div class="container login-page">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
      <div class="row justify-content-center equal-height">
      <div class="col-md-10">
        <h1 class="page-title text-justify h-font-size--24 h-clr--black-3 mb-4">
            ${Resource.msg('label.profile.reset.password', 'login', null)}</h1>
            <p class="required-field-para h-clr--black-1"><span class="required-indicator">*</span>${Resource.msg('required.field.label', 'login', null)}</p>
      </div>
      </div>
        <div class="row justify-content-center equal-height">
            <div class="col-md-8">
                <div class="reset-password-form">
                    <isinclude template="account/changePasswordForm" />
                </div>
            </div>
        </div>
    </div>
</isdecorate>
