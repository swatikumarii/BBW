<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/paymentInstruments.js');
        assets.addJs('/js/custom.js');
        assets.addCss('/css/account/payment.css');
        assets.addCss('/css/account/account.css');
    </isscript>

    <div class="container h-maxwidth--1400 mx-auto">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
    </div>

    <div class="container-fluid p-0">
        <div class="col mobile-my-account h-font-size--16 h-clr--black-1">
            ${Resource.msg('label.myaccount', 'account', null)}
        </div>
    </div>

    <div class="h-maxwidth--1400 mx-auto my-account">
        <isinclude template="account/payment/deletePaymentModal" />
        <div class="row account-dashboard">
            <div class="account-nav-wrap">
                <div class="my-account-nav">
                    <isinclude template="account/accountNav" />
                </div>
            </div>
            <div class="description-detail">
                <div class="my-account-description">
                    <div class="account-profile">
                        <div class="profile-heading">
                            <h1 class="page-title">${Resource.msg('page.heading.payments', 'payment', null)}</h1>
                        </div>
                    </div>
                </div>
                <iscomment>
                    <isif condition="${pdict.noSavedPayments}">
                        <div class="row justify-content-center h3 no-saved-payments">
                            <p>${Resource.msg('msg.no.saved.payments', 'payment', null)}</p>
                        </div>
                    </isif>
                </iscomment>
                <isinclude template="account/payment/savedPayments" />
                <div class="row justify-content-center">
                    <div class="col-12">
                        <div class="row">
                            <iscomment>
                                <div class="col">
                                    <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Account-Show')}" class="text-center back-to-account-link"
                                        aria-label="${Resource.msg('label.addressbook.myaccount', 'account', null)}">
                                        ${Resource.msg('link.profile.backtomyaccount', 'account', null)}
                                    </a>
                                </div>
                            </iscomment>
                            <isif condition="${pdict.addPaymentUrl}">
                                <div class="col">
                                    <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${pdict.addPaymentUrl}" class="btn btn-save btn-hover"
                                        aria-label="${Resource.msg('label.payment.addnewpayment', 'payment', null)}">${Resource.msg('label.payment.addnewpayment', 'payment', null)}</a>
                                </div>
                            </isif>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
