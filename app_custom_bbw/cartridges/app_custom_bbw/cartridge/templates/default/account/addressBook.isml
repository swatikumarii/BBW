<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/addressBook.js');
        assets.addJs('/js/validation.js');
        assets.addJs('/js/custom.js');
        assets.addCss('/css/account/account.css');
    </isscript>
    <script
        src="https://maps.googleapis.com/maps/api/js?key=${dw.system.Site.getCurrent().getCustomPreferenceValue('mapAPI')}&libraries=places">
                </script>
    <isinclude template="account/deleteAddressModal" />

    <div class="container h-maxwidth--1400 mx-auto">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
    </div>

    <div class="container-fluid p-0">
        <div class="col mobile-my-account h-font-size--16 h-clr--black-1">
            ${Resource.msg('label.myaccount', 'account', null)}
        </div>
    </div>

    <div class="h-maxwidth--1400 mx-auto my-account">
        <div class="row account-dashboard">
            <div class="account-nav-wrap">
                <div class="my-account-nav">
                    <isinclude template="account/accountNav" />
                </div>
            </div>
            <div class="description-detail">
                <isif condition="${pdict.showSuccessMessage}">
                    <div
                        class="alert alert-success alert-dismissible address-save-msg border-0 h-font-size--16 h-fw--bold d-flex align-items-center">
                        <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="#" class="close" data-dismiss="alert" aria-label="close">
                            <img src="${URLUtils.staticURL('/images/account/download.svg')}"
                                alt="${Resource.msg('global.storename', 'common', null)}" />
                        </a>
                        ${Resource.msg('address.save.success', 'account', null)}
                    </div>
                    <iscomment>
                        <div class="address-save-msg">${Resource.msg('address.save.success', 'account', null)}</div>
                    </iscomment>
                </isif>
                <div class="my-account-description">
                    <div class="account-profile">
                        <div class="profile-heading">
                            <h1 class="title text-capitalize">
                                ${Resource.msg('label.address', 'account', null)}
                            </h1>
                        </div>
                    </div>
                </div>
                <!-- Rows for addresses in the Address Book -->
                <div class="address-book">
                    <isloop items="${pdict.addressBook}" var="address">
                        <div class="justify-content-center" id="uuid-${address.address.UUID}">

                            <isif condition="${address.address.ID == pdict.addressBook[0].address.ID}">
                                <h2 class="h-font-size--16 m-0">${Resource.msg('label.addressbook.defaultaddress', 'account', null)}</h2>
                                <isset name="prevoiusAddress"
                                    value="${Resource.msg('label.addressbook.defaultaddress', 'account', null)}"
                                    scope="page" />
                            </isif>
                            <isif condition="${address.address.ID != pdict.addressBook[0].address.ID && prevoiusAddress != Resource.msg(
                                             'label.addressbook.otheraddress', 'account', null)}">
                                <h2 class="h-font-size--16 other-address-heading">
                                    ${Resource.msg('label.addressbook.otheraddress', 'account', null)}</h2>
                                <isset name="prevoiusAddress"
                                    value="${Resource.msg('label.addressbook.otheraddress', 'account', null)}"
                                    scope="page" />
                            </isif>

                            <isif condition="${address.address.ID == pdict.addressBook[0].address.ID}">
                                <div class="card border-0 default">
                                    <div class="card-address">
                                        <div class="address-id">${address.address.ID}</div>
                                        <div>${address.address.firstName} ${address.address.lastName}</div>
                                        <div>${address.address.address1}</div>
                                        <isif condition="${address.address.address2 !== null}">
                                            <div>${address.address.address2}</div>
                                        </isif>
                                        <div>${address.address.city}, ${address.address.stateCode}
                                            ${address.address.postalCode}
                                        </div>
                                        <isif condition="${address.address.district}">
                                            <div>${address.address.district}</div>
                                        </isif>
                                        <isif condition="${address.address.subDistrict}">
                                            <div>${address.address.subDistrict}</div>
                                        </isif>
                                        <div>${address.address.countryCode.displayValue}</div>
                                        <isif condition="${address.address.phone}">
                                            <div>${Resource.msg('lable.address.phone', 'account', null)}
                                                ${address.address.phone}
                                            </div>
                                        </isif>
                                        <isif condition="${address.address.ID !== pdict.addressBook[0].address.ID}">
                                            <span class="card-make-default-link">
                                                <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Address-SetDefault', 'addressId', address.address.ID)}"
                                                    class="normal"
                                                    aria-label="${Resource.msg('label.addressbook.makedefaultaddress', 'account', null)}">${Resource.msg('link.addressbook.makedefault', 'account', null)}</a>
                                            </span>
                                            <span class="space">${Resource.msg('label.space', 'account', null)}</span>
                                        </isif>

                                        <button type="button" id="editAddress" class="edit border-0"
                                            data-href="${URLUtils.url('Address-EditAddress')}"
                                            data-id="${address.address.ID}" data-toggle="modal"
                                            data-target="#address-form">
                                            ${Resource.msg('link.edit', 'account', null)}
                                        </button>
                                        <span class="space">${Resource.msg('label.space', 'account', null)}</span>

                                        <button type="button"
                                            class="delete remove-btn remove-address btn-light border-0"
                                            data-toggle="modal" data-target="#deleteAddressModal"
                                            data-id="${address.address.ID}"
                                            data-url="${pdict.actionUrls.deleteActionUrl}"
                                            aria-label="${Resource.msg('label.addressbook.deleteaddress', 'account', null)}">
                                            ${Resource.msg('label.addressbook.delete', 'account', null)}
                                        </button>


                                    </div>
                                </div>
                            <iselse/>
                                <div class="other-address">
                                    <div class="card-address">
                                        <div class="address-id">${address.address.ID}</div>
                                        <div>${address.address.firstName} ${address.address.lastName}</div>
                                        <div>${address.address.address1}</div>
                                        <isif condition="${address.address.address2 !== null}">
                                            <div>${address.address.address2}</div>
                                        </isif>
                                        <div>${address.address.city}, ${address.address.stateCode}
                                            ${address.address.postalCode}
                                        </div>
                                        <div>${address.address.countryCode.displayValue}</div>
                                        <isif condition="${address.address.phone}">
                                            <div>${Resource.msg('lable.address.phone', 'account', null)}
                                                ${address.address.phone}
                                            </div>
                                        </isif>
                                        <isif condition="${address.address.ID !== pdict.addressBook[0].address.ID}">
                                            <span class="card-make-default-link">
                                                <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Address-SetDefault', 'addressId', address.address.ID)}"
                                                    class="normal"
                                                    aria-label="${Resource.msg('label.addressbook.makedefaultaddress', 'account', null)}">${Resource.msg('link.addressbook.makedefault', 'account', null)}</a>
                                            </span>
                                            <span class="space">${Resource.msg('label.space', 'account', null)}</span>
                                        </isif>

                                        <button type="button" id="editAddress" class="edit border-0 bg-white"
                                            data-href="${URLUtils.url('Address-EditAddress')}"
                                            data-id="${address.address.ID}" data-toggle="modal"
                                            data-target="#address-form">
                                            ${Resource.msg('link.edit', 'account', null)}
                                        </button>
                                        <span class="space">${Resource.msg('label.space', 'account', null)}</span>

                                        <button type="button"
                                            class="delete remove-btn remove-address btn-light border-0 bg-white"
                                            data-toggle="modal" data-target="#deleteAddressModal"
                                            data-id="${address.address.ID}"
                                            data-url="${pdict.actionUrls.deleteActionUrl}"
                                            aria-label="${Resource.msg('label.addressbook.deleteaddress', 'account', null)}">
                                            ${Resource.msg('label.addressbook.delete', 'account', null)}
                                        </button>


                                    </div>
                                </div>
                            </isif>
                        </div>
                    </isloop>
                    <isinclude template="account/addressFormModal" />
                    <isinclude template="account/addressFormModalEdit" />
                </div>
                <isif condition="${pdict.addressBook.length > 1}">
                    <div class="add-address-create-modal position-relative other-address-btn">
                        <isset name="prevoiusAddress"
                            value="${Resource.msg('label.addressbook.otheraddress', 'account', null)}" scope="page" />
                        <a data-toggle="modal" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="#add-address-form" class="btn btn-save btn-primary"
                            aria-label="${Resource.msg('label.addressbook.addnewaddress', 'account', null)}">${Resource.msg('button.addnew', 'account', null)}</a>

                    </div>
                <iselseif condition="${pdict.addressBook.length > 0 &&  pdict.addressBook[0].address.ID}" />
                    <div class="add-address-create-modal position-relative">
                        <isset name="prevoiusAddress"
                            value="${Resource.msg('label.addressbook.otheraddress', 'account', null)}" scope="page" />
                        <a data-toggle="modal" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="#add-address-form"
                            class="btn btn-save btn-primary position-relative pull-right"
                            aria-label="${Resource.msg('label.addressbook.addnewaddress', 'account', null)}">${Resource.msg('button.addnew', 'account', null)}</a>

                    </div>
                <iselse/>
                    <div class="add-address-create-modal position-relative">
                        <isset name="prevoiusAddress"
                            value="${Resource.msg('label.addressbook.otheraddress', 'account', null)}" scope="page" />
                        <a data-toggle="modal" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="#add-address-form" class="btn btn-save btn-primary "
                            aria-label="${Resource.msg('label.addressbook.addnewaddress', 'account', null)}">${Resource.msg('button.addnew', 'account', null)}</a>

                    </div>
                </isif>
            </div>
        </div>
    </div>
</isdecorate>
