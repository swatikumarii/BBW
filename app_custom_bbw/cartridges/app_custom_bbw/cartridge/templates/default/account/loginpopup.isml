<script defer type="text/javascript" src="${URLUtils.staticURL('/js/login.js')}"></script>
<div class="modal fade hide login-modal-fade" id="loginModal" tabindex="-1" role="dialog" aria-labelledby="loginModalTitle"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-bottom login-modal-view text-left" role="document">
        <div class="modal-content modal-content-head">
            <div class="modal-header border-0">
                <button type="button" class="close close-icon-btn" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">
                    <iscomment> &times; </iscomment>
                        <img src="${URLUtils.staticURL('/images/login/cross.svg')}" alt="cross icon" width="17" />
                    </span>
                </button>

            </div>
            <div class="modal-body login-modal-body">
                <div class="col-12 pb-0">
                    <h4 class="h-font-size--18 h-clr--black-1 h-fw--bold">${Resource.msg('login.label', 'login', null)}
                    </h4>
                    <p class="h-font-size--16 login-para h-clr--gray">
                        ${Resource.msg('login.para', 'login', null)}
                    </p>
                    <isinclude template="account/components/loginModalForm" />
                  <div class="privacy-block w-100 text-center h-clr--black-3 h-font-size--14">
                    <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Page-Show', 'cid', 'privacy-policy')}" class="text-center">
                        ${Resource.msg('link.privacypolicy.registration', 'login', null)}
                    </a>
                    </div>
                    <iscomment>
                        <div>
                            <a hreflang="${pdict.hrefLang}" href="${URLUtils.https('Login-Show')}" role="button"
                                aria-label="${Resource.msg('label.header.signup', 'common', null)}">${Resource.msg('label.header.signup', 'common', null)}</a>
                        </div>
                    </iscomment>
                    <div class="register">
                        <h3 class="h-clr--pink h-font-size--18 h-fw--bold">
                            ${Resource.msg('join.title', 'login', null)}
                        </h3>
                    
                        <p class="h-font-size--16 mb-0">
                            <iscomment> ${Resource.msg('join.para', 'login', null)} </iscomment>
                            ${Resource.msg('create.para', 'login', null)}
                            <a id="log-in-page-url" hreflang="${pdict.hrefLang}" href="${URLUtils.https('Login-CreateAccount')}" role="button" class="h-clr--black-3 h-font-size--16"
                                aria-label="${Resource.msg('label.header.signup', 'common', null)}">${Resource.msg('label.header.signup', 'common', null)}</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade hide merge-cart-modal" id="isMergeCartModal" tabindex="-1" role="dialog" aria-labelledby="isMergeCartModalTitle"
    aria-hidden="true">
    <div class="modal-dialog merge-cart-dialog" role="document">
        <div class="modal-content merge-cart-content">
            <div class="modal-header merge-cart-header border-0 p-0">
               <h2 class="modal-title h-font-size-md--18 h-font-size-sm--18 h-font-size--16 h-clr--black-3 m-0 h-fw--semibold "> ${Resource.msg('merge.cart.header', 'login', null)} </h2>
                <button type="button" class="close h-bg--gray-1 close-icon-btn modal-close-icon" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">
                        <iscomment> <img src="/on/demandware.static/Sites-bbw-au-Site/-/default/dwf607c6e4/images/login/cross.svg" alt="cross icon"
                            width="17"> </iscomment>
                    </span>
                </button>
            </div>
            <div class="modal-body merge-item-body p-0 mt-2">
                <div class="col-12 p-0">
                    <span class="merge-item-para h-clr--black-1 h-font-size-md--16 h-font-size-sm--16 h-font-size--14 m-0 ">
                        ${Resource.msg('merge.cart.para', 'login', null)}</span>
                </div>
            </div>
            <div class="modal-footer border-0 p-0 merge-cart-footer mt-3 justify-content-md-end justify-content-center">
                <input type="hidden" class="home-show-url" value="${URLUtils.url('Home-Show')}" />
                <input type="hidden" class="forgot-password-url" value="${URLUtils.url('Account-PasswordReset')}" />
                <input type="hidden" class="forgot-password-url" value="${URLUtils.url('Account-SetNewPassword')}" />
                <input type="hidden" class="forgot-password-url" value="${URLUtils.url('Account-DoSetNewPassword')}" />
                <input type="hidden" id="sign-up-url" value="${URLUtils.abs('Login-CreateAccount')}" />
                <input type="hidden" id="my-account-url" value="${URLUtils.https('Account-Show')}" />
                <input type="hidden" class="cart-merge-url" value="${URLUtils.url('Cart-Merge')}"/>
                <input type="hidden" class="redirect-url" value="${pdict.loginRedirectUrl}"/>
                <button type="button" class="merge btn h-font-size-md--16 h-font-size-sm--16 h-font-size--14 m-0 mr-1" data-dismiss="modal" aria-label="Close">
                    ${Resource.msg('merge.cart.button1', 'login', null)}
                </button>
                <button type="button" class="dont-merge btn btn-secondary h-font-size-md--16 h-font-size-sm--16 h-font-size--14 h-clr--gray" data-dismiss="modal" aria-label="Close">
                    ${Resource.msg('merge.cart.button2', 'login', null)}
                </button>
            </div>
        </div>
    </div>
</div>
<input type="hidden" class="wishlist-pid" name="wishlist-pid" value=''>
