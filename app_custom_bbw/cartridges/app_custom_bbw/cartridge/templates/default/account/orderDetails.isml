<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        //assets.addCss('/css/account/orderTrack.css');
        assets.addCss('/css/account/profile.css');
        assets.addJs('/js/custom.js');
        assets.addJs('/js/orderHistory.js');
        assets.addCss('/css/account/account.css');
    </isscript>

    <div class="container h-maxwidth--1400 mx-auto">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
    </div>

    <div class="container-fluid p-0">
        <div class="col mobile-my-account h-font-size--16 h-clr--black-1">
            ${Resource.msg('label.myaccount', 'account', null)}
        </div>
    </div>
    <isinclude template="product/components/removeGiftLineItem" />
    <div class="h-maxwidth--1400 mx-auto my-account receipt <isif condition=" ${pdict.order.shipping.length > 1}">multi-ship</isif>">
        <div class="row account-dashboard">
            <isif condition="${session.isCustomerAuthenticated()}">
                <div class="account-nav-wrap">
                    <div class="my-account-nav">
                        <isinclude template="account/accountNav" />
                    </div>
                </div>
            </isif>
                <div class="description-detail ${session.isCustomerAuthenticated() ? '' : 'description-order-details'}">
                    <div class="my-account-description">
                        <isinclude template="account/order/orderDetails" />
                        <div class="d-md-flex">
                            <div class="order-btn mr-2 mb-2 mb-md-0">
                                <a class="btn btn-hover btn-block" hreflang="${pdict.hrefLang}" href="${URLUtils.url('Order-History')}"
                                    title="${Resource.msg('link.orderdetails.myaccount', 'account', null)}"
                                    aria-label="${Resource.msg('link.orderdetails.myaccount', 'account', null)}">
                                    ${pdict.exitLinkText}
                                </a>
                            </div>
                            <div class="order-btn">
                                <a class="continue-shopping-link btn-block" hreflang="${pdict.hrefLang}" href="${URLUtils.url('Home-Show')}"
                                    title="${Resource.msg('link.continue.shopping', 'cart', null)}">
                                    ${Resource.msg('link.continue.shopping', 'cart', null)}
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</isdecorate>
