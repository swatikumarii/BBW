<isdecorate template="common/layout/page">

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>

    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/account/dashboard.css');
    </isscript>

    <div class="hero slant-down account-image">
        <h1 class="page-title">${Resource.msg('page.heading.dashboard','account',null)}</h1>
    </div>

    <div class="container">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs"/>
        <div class="row">
            <div class="col-md-3 col-sm-3 p-0 order-lg-0 order-md-0  order-sm-0 order-1 mb-5">
                <div class="my-account-nav">
                    <isinclude template="account/accountNav" />
                </div>
            </div>
            <div class="col-md-9 col-sm-9 p-0">
                <div class="my-account-description">
                    <isinclude template="account/accountOverview" />
                </div>
            </div>
        </div>
    </div>
</isdecorate>
