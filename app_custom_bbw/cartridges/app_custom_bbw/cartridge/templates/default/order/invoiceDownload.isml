<div id="content">
    <table style="table-layout: fixed; width: 100%; ">
        <tbody>
            <tr style="vertical-align: baseline;">
                <td class="" style="vertical-align: baseline;">
                    <div>
                        <isset name="headerImage"
                            value="${require('dw/system/Site').getCurrent().getCustomPreferenceValue('header_image')}"
                            scope="page" />
                        <img class="hidden-md-down img-fluid w-100"
                            src="${headerImage ? headerImage.url : URLUtils.staticURL('/images/header/Logos-main.svg')}"
                            alt="${Resource.msg('global.storename', 'common', null)}" style="width: 180px" />
                    </div>
                </td>
                <td style="vertical-align: baseline;">
                    <div style="padding-bottom: 10px;">
                        <strong
                            style="text-transform: uppercase;font-family:GaramondPro;font-size:16px;letter-sapcing:1px;line-height:normal;">${Resource.msg('label.invoice', 'order', null)}</strong>
                    </div>
                    <div>
                        <p>${Resource.msg('label.customer.service', 'order', null)}</p>
                    </div>
                    <isif
                        condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('BBWCustomerServiceEmail')}">
                        <p
                            style="margin: 0;line-height: 24px; font:normal 14px/24px ScalaSansOT,sans-serif;letter-spacing:0.75px;color:#1a1919">
                            ${Resource.msg('label.email', 'order', null)}:
                            ${dw.system.Site.getCurrent().getCustomPreferenceValue('BBWCustomerServiceEmail')}
                        </p>
                    </isif>
                    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('BBWCompanyPhone')}">
                        <div
                            style="margin: 0;line-height: 24px; font:normal 14px/24px ScalaSansOT,sans-serif;letter-spacing:0.75px;color:#1a1919">
                            ${Resource.msg('phone.text.address', 'order', null)}:
                            <isprint value="${dw.system.Site.getCurrent().getCustomPreferenceValue('BBWCompanyPhone')}"
                                encoding="off" />
                        </div>
                    </isif>
                    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('BBWCompanyAddress')}">
                        <div
                            style="margin: 0;line-height: 24px; font:normal 14px/24px ScalaSansOT,sans-serif;letter-spacing:0.75px;color:#1a1919">
                            <isprint
                                value="${dw.system.Site.getCurrent().getCustomPreferenceValue('BBWCompanyAddress')}"
                                encoding="off" />
                        </div>
                    </isif>
                </td>
            </tr>
        </tbody>
    </table>

    <div>
        <table
            style="table-layout: fixed; width: 100%; background-color: #727272; padding-top: 20px; padding-bottom: 20px;">
            <tbody>
                <tr style="vertical-align: baseline;">
                    <td style="vertical-align:baseline;">
                        <p style="color:white; font-size:18px; margin:0px;">
                            <span style="color:white; font-weight:700; font-size:24px">${Resource.msg('label.order', 'order', null)}: </span>
                            ${pdict.order.orderNumber}
                        </p>
                        <p style="color:white; font-size:18px; margin-top:5px;">
                            <span
                                style="color:white; font-weight:700; font-size:24px">${Resource.msg('label.order.date', 'confirmation', null)} </span>
                            <isprint value="${pdict.order.creationDate}" style="DATE_LONG" />
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div style="padding-top:8px; padding-bottom:8px;">
        <table style="table-layout: fixed; width: 100%;">
            <tbody>
                <tr style="vertical-align: baseline;">
                    <td style="vertical-align:baseline; width:56%;">
                        <div style="    background-color: #c7c7c7;     margin-left: -4px;
    padding-top: 8px;
    padding-bottom: 15px;">
                            <strong
                                style="text-transform: uppercase;font-family:GaramondPro;font-size:16px;letter-sapcing:1px;line-height:normal;">
                                ${Resource.msg('shipping.details', 'order', null)}
                            </strong>
                        </div>
                        <div>
                            <isloop items="${pdict.order.shipping}" var="shippingModel" status="shippingLoop">
                                <isset name="address" value="${shippingModel.shippingAddress}" scope="page" />
                                <isinclude template="order/addressSummaryInvoice" />
                            </isloop>
                        </div>
                    </td>
                    <td style="width:44%;">
                        <div>
                            <div style="    background-color: #c7c7c7;     margin-left: -4px;
    padding-top: 8px;
    padding-bottom: 15px;">
                                <strong
                                    style="text-transform: uppercase;font-family:GaramondPro;font-size:16px;letter-sapcing:1px;line-height:normal;display: block;width: 100%;">
                                    ${Resource.msg('billing.to', 'order', null)}
                                </strong>
                            </div>
                            <div>
                                <isset name="address" value="${pdict.order.billing.billingAddress.address}"
                                    scope="page" />
                                <p style="margin:0px; font-family:ScalaSansOT,sans-serif;">
                                    <isinclude template="order/addressSummaryInvoice" />
                                </p>
                            </div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div style="padding-top: 1cm; padding-bottom: 1cm;">
        <table style="table-layout: fixed; width: 100%; ">
            <tbody>
                <tr style="vertical-align: baseline;">
                    <td style="vertical-align:baseline; width:56%;">
                        <div class="summary-details">
                            <span style="background-color:#cdcdcd; width:100%; display:block;"
                                class="summary-section-label payment-info-label h-fw--semibold h-clr--black-1 mb-1 h-font-size--16">${Resource.msg('label.order.payment.info', 'order', null)}:</span>
                            <isinclude template="checkout/billing/paymentOptions/paymentOptionsSummary" />
                        </div>
                    </td>
                    <td style="width:44%;">
                        <div style="padding-bottom: 10px;text-align: right;">
                            <span
                                style="background-color:#cdcdcd; width:100%; margin-left: -5px; display:block; text-align:left;"
                                class="summary-section-label payment-info-label h-fw--semibold h-clr--black-1 mb-1 h-font-size--16">${Resource.msg('label.order.shipping.method', 'confirmation', null)}</span>
                            <isloop var="shippingModel" items="${pdict.order.shipping}" status="shippingLoop">
                                <p class="shipping-method" style="text-align:left;">
                                    ${Resource.msg('label.shipping', 'order', null)}-
                                    <span
                                        class="shipping-method-title h-font-size--16">${shippingModel.selectedShippingMethod.displayName}</span>
                                </p>
                            </isloop>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div>
        <table>
            <thead>
                <tr>
                    <th width="34%" style="text-align:left;     background-color: #d0d0d0;" >
                        ${Resource.msg('label.item.description', 'order', null)}
                    </th>
                    <th width="20%" style="    background-color: #d0d0d0;">
                        ${Resource.msg('label.item.sku', 'order', null)}
                    </th>
                    <th style="    background-color: #d0d0d0;">
                        ${Resource.msg('label.qty', 'order', null)}
                    </th>
                    <th style="    background-color: #d0d0d0;">
                        ${Resource.msg('label.price', 'order', null)}
                    </th>
                    <th style="    background-color: #d0d0d0; text-align: right;">
                        ${Resource.msg('label.amount', 'order', null)}
                    </th>
                </tr>
            </thead>

            <tbody>
                <isloop items="${pdict.order.items.items}" var="lineItem">
                    <tr>
                        <td style="border-top: 1px solid #eee; padding: 5px; vertical-align: middle; height: 120px;"
                            valign="center">
                            <div class="product-card-wrapper" style="width: 100%;height: auto;display: flex;">
                                <div class="product-image">
                                    <isif condition="${lineItem.ispersonalizedGiftcard}">
                                        <img style="float:left;margin-right:10px"
                                            src="${lineItem.personalizeGiftcardImage}" alt="${lineItem.alt}" height="90"
                                            width="90">
                                    <iselse/>
                                        <img style="float:left;" src="${lineItem.images.small[0].absURL}"
                                            alt="${lineItem.images.small[0].alt}"
                                            title="${lineItem.images.small[0].title}" height="90" width="90">
                                    </isif>
                                </div>
                                <div class="product-details"
                                    style="">
                                    <isif condition="${lineItem.ispersonalizedGiftcard}">
                                        <p
                                            style="margin:0px;font-size:18px;font: normal 20px/24px GaramondPro TimesNewRoman,Times New Roman,Times,serif;letter-spacing: 0.75px;color: #1a1919;">
                                            ${Resource.msg('personalized.giftcard.name', 'common', null)}</p>
                                    <iselse/>
                                        <p
                                            style="margin:0px;font-size:18px;font: normal 20px/24px GaramondPro TimesNewRoman,Times New Roman,Times,serif;letter-spacing: 0.75px;color: #1a1919;width:120%;">
                                            ${lineItem.productName}</p>
                                    </isif>
                                    <isif condition="${lineItem.productCategory === 'greetingCardProducts'}">
                                        <p
                                            style="margin:0px;font-size:14px;font: normal 14px/24px ScalaSansOT,sans-serif; letter-spacing: 0.75px;color: #1a1919;">
                                            ${lineItem.greetingCardMessage}</p>
                                    </isif>
                                    <isif
                                        condition="${'giftCardDetails' in lineItem && lineItem.giftCardDetails && lineItem.giftCardDetails.isEgiftProduct}">
                                        <p
                                            style="margin:0px; margin-left: 10px;font-size:14px;font: normal 14px/24px ScalaSansOT,sans-serif; letter-spacing: 0.75px;color: #1a1919;">
                                            ${Resource.msg('productCard.egift.email.label', 'cart', null)}
                                            ${lineItem.giftCardDetails.recipientEmail}</p>
                                    </isif>
                                </div>
                            </div>
                        </td>
                        <iscomment>
                            <td valign="center">
                                <div class="product-card-wrapper">
                                    <div class="product-image">
                                        <div class="product-line-item-details d-flex flex-row">
                                            <a href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
                                                <div class="item-image">
                                                    <img class="product-image" src="${lineItem.images.small[0].url}"
                                                        alt="${lineItem.images.small[0].alt}"
                                                        title="${lineItem.images.small[0].title}" width="100" />
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="product-details"
                                        style="display: flex;flex-direction: column;justify-content:center;margin-left:20px;">
                                        <span
                                            class="d-block h-fw--semibold h-clr--black-1 h-font-size--15">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</span>
                                        <span class="d-block h-font-size--14">${lineItem.titlePartB ? lineItem.titlePartB : ''}</span>
                                        <isloop items="${lineItem.promotions}" var="promotion">
                                            <isprint value="${promotion.details}" encoding="off" />
                                        </isloop>
                                    </div>
                                </div>
                            </td>
                        </iscomment>
                        <td valign="center">
                            <div class="product-card-wrapper">
                                <div class="product-details"
                                    style="text-align:center">
                                    <p
                                        style="margin:0px;font-size:14px;font: normal 14px/24px ScalaSansOT,sans-serif; letter-spacing: 0.75px;color: #1a1919;">
                                        ${lineItem.id}</p>
                                </div>
                            </div>
                        </td>
                        <td align="center">
                            <isprint value="${lineItem.quantity}" formatter="##" />
                        </td>
                        <td align="center">
                            <isif
                                condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}">
                                <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                    </div>
                            <iselse/>
                                <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                    ${lineItem.price.sales.formatted}</div>
                            </isif>
                        </td>
                        <td align="right" style="border-top: 1px solid #eee; padding: 5px; font-family:GaramondPro;">
                            <isif
                                condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}">
                                <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                    ${Resource.msg('label.free.price', 'cart', null)}</div>
                            <iselse/>
                                <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                    ${lineItem.priceTotal.price}</div>
                            </isif>
                        </td>
                    </tr>
                </isloop>
            </tbody>
        </table>
    </div>
    <div style="border-top: 1px solid #eee; border-bottom: 1px solid">
        <table style="table-layout: fixed; width: 100%; border-collapse: collapse; max-width:800px; margin:15px auto;">
            <tbody>
                <isset name="totalExclusiveTax"
                    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showTotalsExcludingTaxes')}"
                    scope="page" />
                <isset name="shippingExclusiveTax"
                    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingExcludingTaxes')}"
                    scope="page" />

                <iscomment> Subtotal </iscomment>
                <isif condition="${totalExclusiveTax}">
                    <div class="row">
                        <div class="col-12">
                            <p class="h-font-size--16 h-clr--black-1">
                            <strong>${Resource.msg('label.merchandise.subtotal.excluding.taxes', 'cart', null)}</strong>
                                                            ${pdict.order.totals.subTotalExclTax}
                            </p>
                        </div>
                        <iscomment> <div class="col-4">
                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total">
                                ${pdict.order.totals.subTotalExclTax}
                            </p>
                        </div> </iscomment>
                    </div>
                <iselse/>
                    <div class="row">
                        <div class="col-8">
                            <p class="h-font-size--16 h-clr--black-1">
                            <strong>${Resource.msg('label.merchandise.subtotal', 'cart', null)}</strong>
                            ${pdict.order.totals.subTotal}
                            </p>
                        </div>
                        <iscomment> <div class="col-4">
                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total">
                                ${pdict.order.totals.subTotal}
                            </p>
                        </div> </iscomment>
                    </div>
                </isif>

                <iscomment> Order Discount </iscomment>
                <div class="row order-discount ${pdict.order.totals.totalDiscount.value === 0 ? '' : 'active'}">
                    <div class="col-12">
                        <p class="h-font-size--16 h-clr--black-1">
                        <strong>${Resource.msg('label.order.discount', 'common', null)}</strong>
                        ${pdict.order.totals.totalDiscountFormatted}
                        </p>
                    </div>
                    <iscomment> <div class="col-4">
                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold order-discount-total">
                            ${pdict.order.totals.totalDiscountFormatted}</p>
                    </div> </iscomment>
                </div>


                <iscomment> Shipping Charge </iscomment>

                <isif condition="${shippingExclusiveTax}">
                    <div class="row">
                        <div class="col-8">
                            <p class="h-font-size--16 h-clr--black-1">
                                ${Resource.msg('label.shipping.and.handling.excluding.taxes', 'cart', null)}</p>
                        </div>
                        <div class="col-4">
                            <p
                                class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive">
                                ${pdict.order.totals.shippingTotalExclTax}</p>
                        </div>
                    </div>
                <iselse/>
                    <div class="row">
                        <div class="col-8">
                            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling', 'cart', null)}</p>
                        </div>
                        <div class="col-4">
                            <p
                                class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-inclusive">
                                ${pdict.order.totals.totalShippingCost}</p>
                        </div>
                    </div>
                </isif>


                <iscomment> Shipping Tax </iscomment>
                <div class="row">
                    <div class="col-8">
                        <isif condition="${shippingExclusiveTax}">
                            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling.tax', 'cart', null)}
                            </p>
                        <iselse/>
                            <p class="h-font-size--16 h-clr--black-1">
                                ${Resource.msg('label.shipping.and.handling.tax.inclusive', 'cart', null)}</p>
                        </isif>
                    </div>
                    <div class="col-4">
                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-tax">
                            ${pdict.order.totals.shippingTotalTax}</p>
                    </div>
                </div>

                <iscomment> Shipping Discount </iscomment>
                <div
                    class="row shipping-discount ${pdict.order.totals.shippingLevelDiscountTotal.value === 0 ? '' : 'active'}">
                    <div class="col-8">
                        <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.discount', 'common', null)}</p>
                    </div>
                    <div class="col-4">
                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-discount-total">
                            ${'-' + pdict.order.totals.shippingLevelDiscountTotal.formatted}</p>
                    </div>
                </div>


                <iscomment> Sales Tax </iscomment>
                <div class="row">
                    <div class="col-8">
                        <isif condition="${totalExclusiveTax}">
                            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.sales.tax', 'cart', null)}
                            </p>
                        <iselse/>
                            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.sales.tax.inclusive', 'cart', null)}</p>
                        </isif>
                    </div>
                    <div class="col-4">
                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sales-tax">
                            ${pdict.order.totals.totalTax}</p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12">
                        <p class="h-font-size--14 h-clr--gray-4">${Resource.msg('label.tax.estimated', 'cart', null)}
                        </p>
                    </div>
                </div>

                <div class="row">
                    <div class="col-8">
                        <p class="h-font-size--18 h-clr--black-1 h-fw--semibold">${Resource.msg('label.estimatedtotal', 'cart', null)}
                        </p>
                    </div>
                    <div class="col-4">
                        <p class="text-right h-font-size--18 h-clr--black-1 h-fw--semibold grand-total">
                            ${pdict.order.totals.grandTotal}
                        </p>
                    </div>
                </div>
            </tbody>
        </table>
    </div>
    <div>
        <table style="table-layout: fixed; width: 100%;">
            <tbody>
                <tr style="vertical-align: baseline;">
                    <td style="vertical-align:baseline;">
                        <p style="font-size:18px; margin-bottom: 20px;">
                            ${Resource.msg('label.invoice.purchase', 'order', null)}
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div>
        <table style="table-layout: fixed; width: 100%;">
            <tbody>
                <tr style="vertical-align: baseline;">
                    <td style="vertical-align:baseline;">
                        <p style="font-size:18px;">
                            ${Resource.msg('label.contat.service', 'order', null)}
                        </p>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div>
        <table style="table-layout: fixed; width: 100%;">
            <tbody>
                <tr style="vertical-align: baseline;">
                    <td style="vertical-align:baseline;">
                        <h1 style="font-size:20px">
                            ${Resource.msg('label.return.policy', 'order', null)}
                        </h1>
                        <ol style="padding-left:22px; padding-top:0px">
                            <li style="font-size:20px">
                                ${Resource.msg('label.return.policy', 'order', null)}
                            </li>
                            <li style="font-size:20px">
                                ${Resource.msg('label.return.policy', 'order', null)}
                            </li>
                            <li style="font-size:20px">
                                ${Resource.msg('label.return.policy', 'order', null)}
                            </li>
                            <li style="font-size:20px">
                                ${Resource.msg('label.return.policy', 'order', null)}
                            </li>
                        </ol>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
<script>
    window.onload = function () {
        window.print();
    };
</script>
