<isset name="productCopy" value="${pdict.product}" scope="page" />
<isset name="product" value="${pdict.product}" scope="page" />
<isset name="isBundle" value="${false}" scope="page" />
<isset name="isQuickView" value="${true}" scope="page" />
<isset name="isProductSet" value="${false}" scope="page" />
<isset name="loopState" value="${{
                               count: 1}}" scope="page" />
<div class="product-quickview product-${product.productType} col product-wrapper product-detail pdp-quickview"
    data-pid="${product.id}">
    <div class="row">
        <!-- Product Images Carousel -->
        <isinclude template="product/components/imageCarousel" />

        <!-- Product Name and Number -->
        <div class="col-sm-6">
            <iscomment>Product Brand</iscomment>
            <div class="row">
                <div class="col">
                    <h1 class="product-name h-clr--black-1 text-capitalize h-font-size--18 h-fw--bold m-0">
                        ${product.fragranceName ? product.fragranceName : product.name}
                        <isif condition="${product.titlePartB}">
                            <div class="row">
                                <div class="col">
                                    <span
                                        class="titlePartB-name small-title h-font-size--16 h-fw--normal h-clr--gray-4 d-block">${product.titlePartB}</span>
                                </div>
                            </div>
                        </isif>
                    </h1>
                </div>
            </div>

            <!-- Product Name -->
            <isif condition="${product.brand}">
                <div class="row">
                    <div class="col">
                        <h3 class="brand-name h-font-size--12 mb-0 h-clr--gray-4">${product.brand}</h3>
                    </div>
                </div>
            </isif>

            <iscomment>Product Description</iscomment>
            <isif condition="${product.shortDescription}">
                <p class="short-descrition h-font-size--14 h-clr--gray">
                    <isprint value="${product.shortDescription}" encoding="off" />
                </p>
            </isif>

            <!-- Prices -->
            <div class="prices">
                <isset name="price" value="${product.price}" scope="page" />
                <isinclude template="product/components/pricing/main" />
            </div>

            <div class="attributes">

                <isif condition="${product.volume}">
                    <div class="row">
                        <div class="col">
                            <h3 class="volume-name h-clr--gray-4">${product.volume}</h3>
                        </div>
                    </div>
                </isif>

                <iscomment>Afterpay</iscomment>
                <isscript>
                                                var sitePreferences = require("*/cartridge/scripts/util/afterpayUtilities.js").sitePreferencesUtilities;
                                                var afterpayPDPEnable = sitePreferences.isDisplayPdpInfo() && sitePreferences.isAfterpayEnabled();
                                            </isscript>
                <isif condition="${afterpayPDPEnable == true}">
                    <input type="hidden" class="updated-widget"
                        value="${URLUtils.https('AfterpayWidget-GetUpdatedWidget')}">
                    <div class="afterpay-widget">
                        <isinclude template="util/modulesAfterpay" />
                        <isafterpaymessage classname="${pdict.classname}" totalprice="${pdict.totalPrice}"
                            eligible="${pdict.apEligible}" mpid="${pdict.apMpid}"
                            approductids="${pdict.apProductIDs}" />
                    </div>
                </isif>

                <!-- Applicable Promotions -->
                <isloop items="${product.promotions}" var="promotion" status="loopstatus">
                    <div class="promotion-callout h-fw--semibold h-font-size--18 h-clr--pink">
                        <span class="callout-message">
                            <isprint value="${promotion.calloutMsg}" encoding="off">
                        </span>
                        <button type="button" data-placement="top"
                            class="callout-detail p-0 btn-with-image ds-js-simple-tooltip ds-tooltip-button h-bg--white custom-button border-0 d-block"
                            data-toggle="popover" id="tooltip-footer_iroll_popover_emailcapture486"
                            title="<div class='pdp-title'></div>" data-content="<a href='#' class='close cursor-pointer'></a><div class='popover-content pdp-pop-content ds-tooltip-content'>
                                                            <isprint value=" ${promotion.details}" />
                    </div>
                    <div class='arrow-fill'></div>"
                    data-html="true" data-original-title="" aria-describedby="popover14574">
                    </button>
                    </div>
                </isloop>



            <isinclude template="product/components/mainAttributes" />

            <isloop items="${product.variationAttributes}" var="attr" status="attributeStatus">
                <div data-attr="${attr.id}" class="swatch row">
                    <div class="col-8">
                        <isinclude template="product/components/variationAttribute" />
                    </div>

                    <isif condition="${attributeStatus.last}">
                        <!-- Quantity Drop Down Menu -->
                        <div class="attribute quantity col-4 d-sm-none">
                            <isif condition="${pdict.addToCartUrl || pdict.updateCartUrl}">
                                <isinclude template="product/components/quantity" />
                            </isif>
                        </div>
                    </isif>
                </div>
            </isloop>
            <div class="d-sm-none row availability align-self-end " data-ready-to-order="${product.readyToOrder}"
                data-available="${product.available}">
                <isinclude template="product/components/availability" />
            </div>

            <div class="d-flex quantity-cart-wrap w-100">
                <isif condition="${!product.variationAttributes}">
                    <div class="simple-quantity">
                        <isinclude template="product/components/quantity" />
                    </div>
                </isif>
                <!-- Cart and [Optionally] Apple Pay -->
                <div class="js-add-to-cart-button">
                    <isif condition="${(!product.isMaster && !product.available)}">
                        <isinclude template="product/components/notifyMe" />
                    <iselse/>
                        <isinclude template="product/components/addToCartProduct" />
                    </isif>
                </div>
            </div>
            <div class="afterPayExtension">
                <isinclude template="product/components/addToCartButtonExtension" />
            </div>

            <div class="full-link"></div>

            <div class="product-options">
                <isif condition="${product.options && product.options.length > 0}">
                    <isinclude template="product/components/options" />
                </isif>
            </div>

        </div>
        <isset name="loopState" value="${{
                                       count: 1}}" scope="page" />
    </div>
</div>
<isif condition="${product.productType === 'bundle'}">
    <isinclude template="product/components/bundleItems" />
</isif>
<isset name="product" value="${productCopy}" scope="page" />
</div>
