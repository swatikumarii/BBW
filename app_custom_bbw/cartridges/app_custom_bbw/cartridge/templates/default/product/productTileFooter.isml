<div class="row tile-body-footer no-gutters">
    <button class="add-to-cart btn" data-toggle="modal" data-target="#chooseBonusProductModal" data-pid="${product.id}"
        ${!product.available ? "disabled" : ""}>
        ${Resource.msg('button.addtocart', 'common', null)}
    </button>
    <div class="b-product-tile__ratings col-xs-12 col-sm-6 b-text-a h-clr--blue text-decoration-none h-bdc--blue">
        <span class="sr-only">${Resource.msgf('label.product.ratings', 'common', null, product.rating)}</span>
        <isinclude template="product/components/ratings" />
    </div>
    <div class="b-product-tile__availability b-text-a text-decoration-none">
        <div class="b-product-tile__shipping-availability">
            <span class="b-product-tile__availability-message product-available h-clr--blue h-fw--bold">Available</span>
            for shipping
        </div>
        <div class="b-product-tile__in-store-availability">
            <span class="b-product-tile__set-store b-text-a text-decoration-none h-fw--bold h-clr--black-3">To See Availability</span>
            <a class="b-product-tile__choose-store b-text-a" href="javascript:void(0)"
                role="button">Set Store</a>
        </div>
    </div>
</div>
