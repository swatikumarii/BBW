<div class="row tile-body-footer no-gutters flex-column">
    <isif condition="${!product.available}">
        <div class="notify-me main-quantity-${product.id}">
            <span class="notify-me-available-msg"></span>
            <input type="hidden" id="notify-list-msg" value="${Resource.msg('button.notifyInList', 'notifyMe', null)}" />
            <input type="hidden" id="notify-msg" value="${Resource.msg('button.notifyMe', 'notifyMe', null)}" />
            <isif condition="${product.enableNotifyMe}">
                <button type="button" class="btn btn-block notifyBackInStockButton notify-me-btn" data-url="${URLUtils.url('BackInStock-CheckLogin')}"
                    data-pid="${product.id}"
                    data-img="${product.images.large ? product.images.large[0].url : product.images.medium[0].url}"
                    data-pname="${product.productName}"> ${Resource.msg('button.notifyMe', 'notifyMe', null)} </button>
            <iselse/>
                <button type="button" class="btn out-of-stock"> ${Resource.msg('button.outOfStock', 'notifyMe', null)}
                </button>
            </isif>
        </div>
    <iselse/>
        <button class="add-to-cart btn" data-toggle="modal" data-target="#chooseBonusProductModal" data-pid="${product.id}"
            ${!product.available ? "disabled" : ""}>
            ${Resource.msg('button.addToBag', 'common', null)}
        </button>
        <span class="add-to-cart-error text-danger"></span>
    </isif>
    <div class="ratings b-product-tile__ratings col-xs-12 col-sm-6 b-text-a h-clr--blue text-decoration-none h-bdc--blue">
        <span class="sr-only">${Resource.msgf('label.product.ratings', 'common', null, product.rating)}</span>
        <isinclude template="product/components/ratings" />
    </div>
    <div class="b-product-tile__availability b-text-a text-decoration-none">
        <div class="b-product-tile__shipping-availability">
            <span class="b-product-tile__availability-message product-available h-clr--blue h-fw--bold">${Resource.msg('product-tile-shipping-availability-msg1', 'search', null)}</span>
            ${Resource.msg('product-tile-shipping-availability-msg2', 'search', null)}
        </div>
        <iscomment> <div class="b-product-tile__in-store-availability">
            <span class="b-product-tile__set-store b-text-a text-decoration-none h-fw--bold h-clr--black-3">To See Availability</span>
            <a class="b-product-tile__choose-store b-text-a" href="javascript:void(0)"
                role="button">Set Store</a>
        </div> </iscomment>
    </div>
</div>
