<isdecorate template="common/layout/page">

    <isscript>
        var assets = require('*/cartridge/scripts/assets');
        assets.addJs('/js/productDetail.js');
        assets.addJs('/js/afterpay.js');
        assets.addCss('/css/product/detail.css');
        assets.addCss('/css/afterpaystyle.css');
    </isscript>

    <isset name="product" value="${pdict.product}" scope="page" />
    <isset name="isQuickView" value="${false}" scope="page" />
    <isset name="isProductSet" value="${pdict.product.productType === 'set'}" scope="page" />
    <isobject object="${product.raw}" view="detail">
        <div class="container product-detail product-wrapper" data-pid="${product.id}">
            <div class="row">
                <div class="col-12">
                    <!--Breadcrumbs-->
                    <div class="product-breadcrumb">
                        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
                    </div>
                </div>
            </div>

            <div class="row mb-5">
                <!-- Product Images Carousel -->
                <isinclude template="product/components/imageCarousel" />

                <div class="col-12 col-sm-6">
                    <!-- Product Name -->
                    <isif condition="${product.brand}">
                        <div class="row">
                            <div class="col">
                                <h3 class="brand-name hidden-sm-down">${product.brand}</h3>
                            </div>
                        </div>
                    </isif>
                    <div class="row">
                        <div class="col">
                            <h1 class="product-name hidden-sm-down text-capitalize h-clr--black-1 h-fw--bold">
                                ${product.fragranceName ? product.fragranceName : product.name}
                                <span class="small-title h-font-size--16 h-fw--normal h-clr--gray-4 d-block">Body
                                    Wash</span>
                            </h1>
                        </div>
                    </div>
                    <isif condition="${product.titlePartB}">
                        <div class="row">
                            <div class="col">
                                <h3 class="titlePartB-name hidden-sm-down">${product.titlePartB}</h3>
                            </div>
                        </div>
                    </isif>


                    <div class="row">
                        <div class="col rating-review">
                            <div class="pull-left">
                                <isinclude template="product/components/pidRating" />
                            </div>
                            <div class="review h-font-size--13">
                                <a class="h-clr--blue" href="#">${Resource.msg('label.rating-review', 'product', null)}</a>
                            </div>
                        </div>
                    </div>

                    <div class="prices-add-to-cart-actions">
                        <div class="row">
                            <div class="col-12">
                                <!-- Prices -->
                                <div class="prices">
                                    <isset name="price" value="${product.price}" scope="page" />
                                    <isinclude template="product/components/pricing/main" />
                                </div>
                            </div>
                        </div>

                        <div class="ship-it-icon">
                            <isif condition="${product.expressShip}">
                                <iscomment> Show Express ship icon </iscomment>
                            </isif>
                        </div>
                        <iscomment>Afterpay</iscomment>
                        <isscript>
                                                    var sitePreferences = require("*/cartridge/scripts/util/afterpayUtilities.js").sitePreferencesUtilities;
                                                    var afterpayPDPEnable = sitePreferences.isDisplayPdpInfo() && sitePreferences.isAfterpayEnabled();
                                                </isscript>
                        <isif condition="${afterpayPDPEnable}">
                            <input type="hidden" class="updated-widget"
                                value="${URLUtils.https('AfterpayWidget-GetUpdatedWidget')}" />
                            <div class="afterpay-widget">
                                <isinclude
                                    url="${URLUtils.url('AfterpayWidget-IncludeAfterpayMessage', 'pid', product.id)}" />
                            </div>
                        </isif>
                    </div>

                    <div class="attributes">

                        <isif condition="${product.volume}">
                            <div class="row">
                                <div class="col">
                                    <h3 class="volume-name h-font-size--14 h-clr--gray-4">${product.volume}</h3>
                                </div>
                            </div>
                        </isif>

                        <!-- Applicable Promotions -->
                        <div class="row">
                            <div class="col-12 promotions">
                                <isinclude template="product/components/promotions" />
                            </div>
                        </div>
                        <div class="promotion-callout h-fw--semibold h-font-size--18 h-clr--pink">
                            <span class="callout-message">Mix &amp; Match All Body, Skin &amp; Hair Care: Buy 3, Get 3
                                FREE or Buy 2, Get 1 FREE</span>

                            <button type="button"
                                class="callout-detail p-0 btn-with-image ds-js-simple-tooltip ds-tooltip-button h-bg--white custom-button border-0 d-block"
                                data-toggle="popover" id="tooltip-footer_iroll_popover_emailcapture486" title=""
                                data-content="<a href='javascript:;' class='close cursor-pointer'></a><div class='popover-content ds-tooltip-content'><p>In Stores &amp; Online - Buy 3, Get 3 Free All Full-Size Body, Skin &amp; Hair Care on
                                    April 13, 2024 at 6:00 AM ET to April 22, 2024 at 5:59 AM ET.</p>
                                <p>Eligible items can be found at www.bathandbodyworks.com/c/body-care/body-care-promotion. No code required. Must add 6
                                items to bag. Shipping and handling apply to free items.&ZeroWidthSpace; Free items are the 3 lowest priced items in
                                each set of 6. Price of free items will be prorated as a discount across all items. Single item purchases are at regular
                                price. Offer is not valid toward previous purchases or on product purchased through third parties (including, but not
                                limited to, Instacart). Offer subject to adjustment due to returns, cancellations and exchanges. Refer to the return
                                policy for more information. No rain checks issued. Other restrictions may apply. Offer subject to change without
                                notice. Selection may vary by store, pick up in store, and online.&ZeroWidthSpace; </p></div>"
                                data-html="true" data-original-title="" aria-describedby="popover14574">
                            </button>
                        </div>

                        <iscomment> Bopis Options </iscomment>
                        <div class="bopis-delivery-options border-left-0 border-right-0">
                            <fieldset>
                                <legend class="delivery-options h-clr--black-1 h-font-size--16 h-fw--semibold">
                                    ${Resource.msg('bopis.heading', 'product', null)}</legend>

                                <div class="bopis-eligible-for-pickup">
                                    <input class="bopis-shipping-option bopis-delivery-option-input" type="radio"
                                        value="shipping" checked="" />
                                    <label class="ship-it-msg mb-0 h-clr--black-1 h-fw--bold" for="pdp-shippingOption">
                                        <span class="ship-it-truck-icon"></span>
                                        <span>${Resource.msg('bopis.label.ship', 'product', null)}</span>
                                    </label>
                                    <div class="availability-web">
                                        <div class="availability-msg">
                                            <div class="in-stock-msg h-clr--green-2">
                                                Available
                                            </div>
                                        </div>
                                    </div>

                                    <div class="bopis-pfs-with-store-container">
                                        <div class="bopis-pfs-option-main-container">
                                            <input class="bopis-pick-from-store-option bopis-delivery-option-input"
                                                type="radio" value="pickfromstore" />
                                            <label
                                                class="bopis-pick-from-store-option-label h-fw--bold mb-0 h-clr--blue"
                                                for="pdp-pickFromStoreOption">
                                                <span class="pdp-pick-up-icon"></span>
                                                <span class="pick-up-in-store-msg ">${Resource.msg('bopis.label.pick', 'product', null)}</span>
                                            </label>
                                        </div>
                                        <div class="bopis-set-store-container bopis-pdp-set-store">
                                            <a href=""
                                                class="h-fw--semibold h-clr--black-1">${Resource.msg('bopis.label.set.store', 'product', null)}</a>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>
                        </div>

                        <!-- Attributes and Quantity -->
                        <isinclude template="product/components/mainAttributes" />

                        <isset name="isBundle" value="${false}" scope="page" />
                        <isset name="loopState" value="${{
                                                       count: 1}}" scope="page" />
                        <isloop items="${product.variationAttributes}" var="attr" status="attributeStatus">
                            <div class="row" data-attr="${attr.id}">
                                <div class="col-8">
                                    <isinclude template="product/components/variationAttribute" />
                                </div>

                                <isif condition="${attributeStatus.last && !isBundle}">
                                    <!-- Quantity Drop Down Menu -->
                                    <div class="attribute quantity col-4">
                                        <isinclude template="product/components/quantity" />
                                    </div>
                                </isif>
                            </div>
                        </isloop>

                        <div class="row">
                            <div class="d-flex quantity-cart-wrap">
                                <isif condition="${!product.variationAttributes}">
                                    <div class="simple-quantity">
                                        <isinclude template="product/components/quantity" />
                                    </div>
                                </isif>
                                <!-- Cart and [Optionally] Apple Pay -->
                                <div class="js-add-to-cart-button">
                                    <isif condition="${(!product.isMaster && !product.available)}">
                                        <isinclude template="product/components/notifyMe" />
                                    <iselse/>
                                        <isinclude template="product/components/addToCartProduct" />
                                    </isif>
                                </div>
                            </div>
                        </div>

                        <div class="product-options">
                            <isif condition="${product.options && product.options.length > 0}">
                                <isinclude template="product/components/options" />
                            </isif>
                        </div>

                        <!-- Size Chart -->
                        <isif condition="${product.variationAttributes && product.sizeChartId}">
                            <div class="row">
                                <div class="size-chart col-12">
                                    <isinclude template="product/components/sizeChart" />
                                </div>
                            </div>
                        </isif>

                        <!-- Product Availability -->
                        <iscomment>
                            <isinclude template="product/components/productAvailability" />
                        </iscomment>

                        <iscomment> Product Description </iscomment>
                        <isinclude template="product/components/descriptionAndDetails" />

                        <!-- Social Sharing Icons -->
                        <div class="row">
                            <isinclude template="product/components/socialIcons" />
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <isslot id="cts-recommendations-m" description="Complete the set products" context="global"
                    context-object="${pdict.product.raw}" />
            </div>

            <isset name="loopState" value="${{
                                           count: 1}}" scope="page" />


            <div class="recommendations">
                <isslot id="product-recommendations-m" description="Recommended products" context="global"
                    context-object="${pdict.product.raw}" />
            </div>
        </div>
    </isobject>
    <isslot id="pdp-recommendation-slot-1" description="Main home page slot." context="global" />
    <isslot id="pdp-recommendation-slot-2z" description="Main home page slot." context="global" />
</isdecorate>
