<isloop items="${pdict.a}" var="giftContent" status="loopstatus">
    <div class="d-flex giftcontent-popup">
        <div class="mb-1">
            <img src="${giftContent.images.mediumLarge[0].absURL}" alt="${giftContent.productName}" width="40"
                height="40">
        </div>
        <div class="mb-1 h-font-size--12 ">
            ${giftContent.productName}
        </div>
        <div class="mb-1 h-font-size--12">
            ${giftContent.price.sales.formatted}
        </div>
    </div>
</isloop>
