<isset name="product" value="${pdict.product}" scope="page" />
<td align="center" style="padding:0 5px 20px;vertical-align:top;text-align:center;">
    <table cellpadding="0" cellspacing="0" border="0" align="center" width="100%" class="product-tile"
        style="width: 100%;max-width: 200px;margin: 0 auto;">
        <tr>
            <td>
                <div class="img-wrapper" style="width: 100%;text-align: center;margin: 0 auto;">
                    <a class="product-ing-link" href="${pdict.urls.product}"
                         style="display: block;width: 100%;">
                        <img class="product-image" src="${product.images['medium'][0].absURL}"
                            alt="${product.productName}" title="${product.images['medium'][0].title}" itemprop="image" style="width: 100%;margin: 0 auto;" />
                    </a>
                </div>
            </td>
        </tr>
        <tr>
            <td style="vertical-align:bottom;height: 149px;">
                <div class="detail-wrapper">
                    <div class="product-details" style="text-align: center;">
                        <div class="product-name"
                            style="color: #1a1a1a;letter-spacing: .16px;line-height: 20px;font-size: 16px;text-transform: capitalize;font-weight: 600;margin-bottom: 5px;">
                            ${product.fragranceName ? product.fragranceName : product.productName}</div>
                        <isif condition="${product.titlePartB}">
                            <div class="product-title-b"
                                style="font-size: 14px;color: #1a1a1a;line-height: 16px;letter-spacing: 0.21px;margin-bottom: 5px;">
                                ${product.titlePartB}</div>
                        </isif>
                        <isif condition="${product.price.sales.formatted}">
                            <div class="product-price"
                                style="color: #1a1a1a;font-weight: 600;font-size: 16px;letter-spacing: .09px;line-height: 20px;">
                                ${product.price.sales.formatted}</div>
                        </isif>
                    </div>
                    <div class="product-btn-wrapper">
                        <div>
                            <a href="${pdict.urls.product}"
                                style="font-size:14px;text-transform:uppercase;background-color:#333;border:1px solid #333;color:#ffffff;display:inline-block;font-family:sans-serif;font-size:14px;line-height:35px;text-align:center;text-decoration:none;width:100%;max-width:80%;margin-top:10px;-webkit-text-size-adjust:none;mso-hide:all;cursor: pointer;">${Resource.msg('btn.label.notifyme', 'email', null)}</a>
                        </div>
                    </div>
                </div>
            </td>
        </tr>
    </table>
</td>
