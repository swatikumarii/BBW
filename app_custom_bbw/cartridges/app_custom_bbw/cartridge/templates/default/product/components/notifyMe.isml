<isif condition="${typeof(product) == 'undefined'}">
    <isset name="product" value="${pdict.product}" scope="page" />
</isif>
<isif condition="${!product.available}">
    <div class="notify-me main-quantity-${product.id}">
        <span class="notify-me-available-msg"></span>
        <input type="hidden" id="notify-list-msg" value="${Resource.msg('button.notifyInList', 'notifyMe', null)}" />
        <input type="hidden" id="notify-msg" value="${Resource.msg('button.notifyMe', 'notifyMe', null)}" />
        <isif condition="${product.enableNotifyMe}">
            <button type="button" class="btn notifyBackInStockButton"
                data-url="${URLUtils.url('BackInStock-CheckLogin')}" data-pid="${product.id}"
                data-img="${product.images.large ? product.images.large[0].url : product.images.medium[0].url}"
                ${pdict.productPresentInNotifyList ? 'disabled='disabled'': ''}
                data-pname="${product.productName}"> ${pdict.productPresentInNotifyList ? Resource.msg('button.notifyInList', 'notifyMe', null) : Resource.msg('button.notifyMe', 'notifyMe', null)} </button>
        <iselse/>
            <button type="button" class="btn out-of-stock"> ${Resource.msg('button.outOfStock', 'notifyMe', null)}
            </button>
        </isif>
    </div>
</isif>
