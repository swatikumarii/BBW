<div class="quantity">
    <div class="quantity-field qty bundle-footer">
        <span class="quantity-button decrease h-fw--semibold d-flex align-items-center justify-content-center h-clr--black-1 float-left">${Resource.msg('label.quantity.decrease', 'product', null)}</span>
        <input type="number" class="input-text text-center p-0 float-left border-0 h-fw--semibold quantity-select" name="Quantity" id="Quantity" value="1" data-available="${product.maxOrderQty}"/>
        <span class="quantity-button increase h-fw--semibold d-flex align-items-center justify-content-center h-clr--black-1 float-left">${Resource.msg('label.quantity.increase', 'product', null)}</span>
    </div>
</div>
