<div class="pdp-link">
    <p class="b-product-tile__badge h-clr--blue h-fw--semibold">New Fragrance</p>
    <a class="b-product-tile__link" href="${pdict.urls.product}">
        <h3 class="b-product-tile__name b-text-h2 h-clr-black-1 h-fw--semibold h-mb--5">${product.productName}</h3>
        <p class="product-type b-product-tile__product-type b-text-h2 h-clr-black-1">
            Ultimate Hydration Body Cream
        </p>
        <isif condition="${pdict.product.titlePartB}">
            <p class="product-type b-product-tile__product-type b-text-h2 h-clr-black-1">
                ${product.titlePartB}
            </p>
        </isif>
    </a>
</div>
