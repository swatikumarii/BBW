<isif condition="${price.type === 'tiered'}">
    <div class="price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <isinclude template="/product/components/pricing/tiered" />
        <isif condition="${product.price.type === 'range'}">
            <meta itemprop="priceCurrency" content="${product.price.currency}" />
        <iselseif condition="${product.price.sales}">
            <meta itemprop="priceCurrency" content="${product.price.sales.currency}" />
        <iselse>
            <meta itemprop="priceCurrency" content="${product.price.list.currency}" />
        </isif>
    </div>
<iselseif condition="${price.type === 'range'}">
    <div class="price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <isinclude template="/product/components/pricing/range" />
        <isif condition="${product.price.type === 'range'}">
            <meta itemprop="priceCurrency" content="${product.price.currency}" />
        <iselseif condition="${product.price.sales}">
            <meta itemprop="priceCurrency" content="${product.price.sales.currency}" />
        <iselse>
            <meta itemprop="priceCurrency" content="${product.price.list.currency}" />
        </isif>
    </div>
<iselse>
    <div class="price" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
        <isset name="isLowPrice" value="${}" scope="page" />
        <isinclude template="/product/components/pricing/default" />
        <isif condition="${product.price.type === 'range'}">
            <meta itemprop="priceCurrency" content="${product.price.currency}" />
        <iselseif condition="${product.price.sales}">
            <meta itemprop="priceCurrency" content="${product.price.sales.currency}" />
        <iselse>
            <meta itemprop="priceCurrency" content="${product.price.list.currency}" />
        </isif>
    </div>
</isif>
