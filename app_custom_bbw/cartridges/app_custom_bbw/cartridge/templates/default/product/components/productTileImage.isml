<div class="image-container b-product-tile__img-wrapper position-relative">
    <div class="social-badge-wrapper d-flex h-grid-gap--5 position-absolute flex-wrap h-maxwidth--150">
        <isif condition="${product.dynamicBadge}">
            <div class="b-product-tile__social-badge">
                <div
                    class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                    ${product.dynamicBadge}</div>
            </div>
        </isif>
        <isif condition="${product.badge1}">
            <div class="b-product-tile__social-badge">
                <div
                    class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                    ${product.badge1}</div>
            </div>
        </isif>
        <isif condition="${product.badge2}">
            <div class="b-product-tile__social-badge">
                <div
                    class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                    ${product.badge2}</div>
            </div>
        </isif>
        <isif condition="${product.badge3}">
            <div class="b-product-tile__social-badge">
                <div
                    class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                    ${product.badge3}</div>
            </div>
        </isif>
    </div>
    <isif condition="${product.images['medium'].length > 2}">
        <div id="plpCarousel-${product.id}" class="carousel slide b-product-tile__carousel js-product-carousel"
            data-interval="0" data-prev="${Resource.msg('button.previous', 'common', null)}"
            data-next="${Resource.msg('button.next', 'common', null)}">
            <div class="carousel-inner" role="listbox">
                <a class="d-block"
                    hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${pdict.urls.product}">
                    <isloop items="${product.images['medium']}" var="image" status="loopStatus">
                        <div class='carousel-item <isif condition="${loopStatus.index == 0}">active</isif>'>
                            <div class="carousel-img-wrapper d-flex h-maxheight--300">
                                <img data-src="${image.url}" data-srcset="${image.url} 1x, ${product.images['medium_2x'][loopStatus.index].url} 2x"
                                    src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 11 14'%3E%3C/svg%3E"
                                    class="w-100 h-100 mx-auto b-product-tile__img carousel-product-img lazy"
                                    alt="${image.alt} image number ${image.index}" itemprop="image" width="202px"
                                    height="300px" />
                            </div>
                        </div>
                    </isloop>
                </a>
            </div>
            <isif condition="${product.images['medium'].length > 1}">
                <div class="carousel-controls-wrapper h-hidden-sm-down">
                    <a class="carousel-control-prev slider-control" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${" #"}plpCarousel-${product.id}"
                        role="button" data-slide="prev">
                        <span class="sr-only">${Resource.msg('button.previous', 'common', null)}</span>
                    </a>
                    <a class="carousel-control-next slider-control" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${" #"}plpCarousel-${product.id}"
                        role="button" data-slide="next">
                        <span class="sr-only">${Resource.msg('button.next', 'common', null)}</span>
                    </a>
                </div>
            </isif>
        </div>
    <iselseif condition="${product.images['medium'].length == 2}" />
        <isloop items="${product.images['medium']}" var="image" status="loopStatus">
            <a class="d-none d-md-none d-lg-block h-hidden-sm-down"
                hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${pdict.urls.product}">
                <div class='img-inner-wrapper ${loopStatus.index == 0 ? ' main-img-wrapper' : 'hover-img-wrapper'}'>
                    <img class="tile-image b-product-tile__img mx-auto w-100 lazy" data-src="${image.url}" data-srcset="${image.url} 1x, ${product.images['medium_2x'][loopStatus.index].url} 2x"
                        alt="${product.productName}"
                        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 11 14'%3E%3C/svg%3E"
                        title="${image.title}" itemprop="image" width="202px" height="300px" />
                </div>
            </a>
        </isloop>
        <div id="plpCarousel-${product.id}"
            class="carousel slide b-product-tile__carousel js-product-carousel d-block d-md-block d-lg-none"
            data-interval="0" data-prev="${Resource.msg('button.previous', 'common', null)}"
            data-next="${Resource.msg('button.next', 'common', null)}">
            <div class="carousel-inner" role="listbox">
                <a class="d-block" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${pdict.urls.product}">
                    <isloop items="${product.images['medium']}" var="image" status="loopStatus">
                        <div class='carousel-item <isif condition="${loopStatus.index == 0}">active</isif>'>
                            <div class="carousel-img-wrapper d-flex h-maxheight--300">
                                <img data-src="${image.url}" data-srcset="${image.url} 1x, ${product.images['medium_2x'][loopStatus.index].url} 2x"
                                    src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 11 14'%3E%3C/svg%3E"
                                    class="w-100 h-100 mx-auto b-product-tile__img carousel-product-img lazy"
                                    alt="${image.alt} image number ${image.index}" itemprop="image" width="202px"
                                    height="300px" />
                            </div>
                        </div>
                    </isloop>
                </a>
            </div>
            <isif condition="${product.images['medium'].length > 1}">
                <div class="carousel-controls-wrapper h-hidden-sm-down">
                    <a class="carousel-control-prev slider-control" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${" #"}plpCarousel-${product.id}"
                        role="button" data-slide="prev">
                        <span class="sr-only">${Resource.msg('button.previous', 'common', null)}</span>
                    </a>
                    <a class="carousel-control-next slider-control" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${" #"}plpCarousel-${product.id}"
                        role="button" data-slide="next">
                        <span class="sr-only">${Resource.msg('button.next', 'common', null)}</span>
                    </a>
                </div>
            </isif>
        </div>
    <iselseif condition="${product.images['medium'].length < 2}" />
        <isloop items="${product.images['medium']}" var="image" status="loopStatus">
            <a class="d-block"
                hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${pdict.urls.product}">
                <div class='img-inner-wrapper lazy-skeleton'>
                    <img class="tile-image b-product-tile__img mx-auto w-100 lazy" data-src="${image.url}" data-srcset="${image.url} 1x, ${product.images['medium_2x'][loopStatus.index].url} 2x"
                        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 11 14'%3E%3C/svg%3E"
                        alt="${product.productName}" title="${image.title}" itemprop="image" width="202px"
                        height="300px" />
                    <div class="skeleton-loader"></div>
                </div>
            </a>
        </isloop>
    </isif>
    <isif condition="${product.images['medium'].length > 0}">
        <link itemprop="image" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${product.images['medium'][0].url}" />
    </isif>
    <isif condition="${!product.isEgiftCard}">
        <iscomment> <a
                class="b-product-tile__wishlistTile wishlistTile position-absolute add-to-wish-list ${pdict.itemExist ? 'added' : ''}"
                hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Wishlist-AddProduct')}"
                title="${Resource.msg('wishlist.addto.wishlist.heart', 'wishlist', null)}">
                <span class="fa-stack fa-lg">
                    <i class="icon-wishlist icon-heart-o"></i>
                    <i class="fa fa-heart-o fa-stack-1x"></i>
                </span>
            </a> </iscomment>
        <iscomment> Search suggestions - Add to Cart Button </iscomment>
        <isif condition="${product.available}">
            <div class="suggestions__btn-add-to-cart position-absolute">
                <button class="add-to-cart-search h-bg--white rounded-circle d-flex align-items-center justify-content-center"
                    data-toggle="modal" data-target="#chooseBonusProductModal" data-pid="${product.id}" ${!product.available ? "disabled" : ""}>
                    <img src="${URLUtils.staticURL('/images/icons/UI-AddToBag-plus.svg')}" alt="add-to-cart" width="30px"
                        height="30px" />
                </button>
            </div>
        </isif>
        <isif condition="${pdict.display.showQuickView !== false}">
            <button class="b-product-tile__quickview quickview hidden-sm-down position-absolute"
                data-href="${pdict.urls.quickView}"
                title="${Resource.msg('label.btn.quicklook', 'search', null)}"
                aria-label="${Resource.msgf('button.quickview', 'common', null, product.productName)}">${Resource.msg('label.btn.quicklook', 'search', null)}</button>
        </isif>
    </isif>
</div>
