<div class="modal fade" id="delete-gift-certificate-line-item-modal" tabindex="-1" role="dialog" aria-labelledby="delete-gift-certificate-line-item-modal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header delete-confirmation-body border-0">
                <h5 class="modal-title h-font-size--18 h-clr--black-1 h-fw--semibold">${Resource.msg('egift.delete.product.confirmation.modal.msg1','giftcards',null)}</h5>
                <button type="button" class="close pull-right" data-dismiss="modal">
                    <span aria-hidden="true">
                        <img src="${URLUtils.staticURL('/images/login/cross.svg')}" alt="cross icon" width="17" />
                    </span>
                    <span class="sr-only"> </span>
                </button>
                <p class="product-to-remove"></p>
            </div>
            <div class="modal-body delete-confirmation-body">
                <span class="modal-content-data h-clr--black-1 h-font-size--16">${Resource.msg('egift.delete.product.confirmation.modal.msg2','giftcards',null)}</span>
                <p class="product-to-remove"></p>       
            </div>
            <div class="modal-footer border-0 pt-0">
                <isif condition="${isBundlePage}">
                    <button type="button" class="btn delete-egiftitem-confirmation-btn  h-font-size--16"
                        data-dismiss="modal"
                        data-addtocarturl="${addToCartUrl}"
                        data-action="${removeLineItemURL}"
                    >${Resource.msg('button.confirm','address',null)}</button>
                <iselseif condition="${pdict.isOrderBaseRemoveGiftCard}" />
                    <button type="button" class="btn order-base-delete-egiftitem-confirmation-btn  h-font-size--16"
                        data-dismiss="modal"
                        data-oid="${pdict.order.orderNumber}"
                        data-addtocarturl="${URLUtils.url('Cart-AddProductFromOrder')}"
                        data-action="${URLUtils.url('Giftcard-RemoveLineItems')}"
                    >${Resource.msg('button.confirm','address',null)}</button>
                <iselse/>
                    <button type="button" class="btn delete-egiftitem-confirmation-btn  h-font-size--16"
                        data-dismiss="modal"
                        data-addtocarturl="${URLUtils.url('Cart-AddProduct')}"
                        data-action="${URLUtils.url('Giftcard-RemoveLineItems')}"
                    >${Resource.msg('button.confirm','address',null)}</button>
                </isif>
            </div>
        </div>
    </div>
</div>
