<div class="product-tile b-product-tile" itemscope itemtype="http://schema.org/Product">
    <!-- dwMarker="product" dwContentID="${product.uuid}" -->
    <!-- Product Social Badge -->
    <div class="b-product-tile__social-badge">
        <div class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">Trending!</div>
    </div>
    <isinclude template="product/components/productTileImage" />
    <div class="tile-body b-product-tile__body">
        <isif condition="${pdict.display.swatches !== false}">
            <isinclude template="product/components/productTileSwatch" />
        </isif>

        <isinclude template="product/components/productTileName" />
        <isset name="price" value="${product.price}" scope="page" />
        <isif condition="${product.productType === 'set'}">
            <isinclude template="product/components/pricing/setPrice" />
        <iselse/>
            <isinclude template="product/components/pricing/main" />
        </isif>
        <div class="b-product-tile__product-promo mb-3">
            <div class="b-product-tile__promotional-message">
                <a href="${pdict.urls.product}" class="b-product-tile__promo-link b-text-a text-decoration-none"
                    title="${'Go to Product:' + product.productName}" data-name="${product.productName}"
                    data-pid="${pdict.product.id}">
                    <span class="h-clr--pink h-fw--semibold">Mix &amp; Match All Body, Skin &amp; Hair Care: Buy 3, Get 3 FREE or Buy 2, Get 1 FREE</span>
                </a>
            </div>
        </div>
        <isscript>
            var sitePreferences = require("*/cartridge/scripts/util/afterpayUtilities.js").sitePreferencesUtilities;
            var afterpayPLPEnable = sitePreferences.isDisplayPlpInfo()  && sitePreferences.isAfterpayEnabled();
        </isscript>
        <isif condition="${afterpayPLPEnable}">
            <isinclude template="util/modulesAfterpay" />

            <isafterpaymessage classname="${pdict.classname}" totalprice="${pdict.totalPrice}"
                eligible="${pdict.apEligible}" mpid="${pdict.apMpid}" approductids="${pdict.apProductIDs}" />
        </isif>

        <isif condition="${pdict.display.ratings !== false}">
            <isinclude template="product/productTileFooter" />
        </isif>
    </div>
    <!-- END_dwmarker -->
</div>
