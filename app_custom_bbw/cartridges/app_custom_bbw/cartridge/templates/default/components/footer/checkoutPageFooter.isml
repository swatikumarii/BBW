<div class="checkout-footer"></div>
<footer id="footercontent" class="checkout-footer-copyright">
<isinclude template="/account/autoLogout" />
    <div class="row no-gutters">
        <!--  copyright content-->
        <div class="col-sm-12 copyright-notice pr-0">
            <iscontentasset aid="footer-copyright" />
        </div>
    </div>
    <iscomment> Back to Top - Button </iscomment>
    <div class="scroll-to-top-link js-scrolltotop">
        <div class="scroll-to-top-wrapper">
            <button id="backtotop" aria-label="${Resource.msg('aria.label.title', 'footer', null)}"
                data-once="backtotop sprinklr-back-to-top"
                class="sprinklr-enabled d-flex align-items-center bg-transparent">
                ${Resource.msg('aria.label.title', 'footer', null)}
            </button>
        </div>
        <div class="col-lg-8 col-sm-7 pull-sm-5 pull-lg-4 copyright-notice">
            <iscontentasset aid="footer-copy" />
        </div>
    </div>
</footer>
