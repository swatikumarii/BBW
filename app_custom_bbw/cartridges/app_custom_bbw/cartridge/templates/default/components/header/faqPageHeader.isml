<isinclude template="/components/modules" sf-toolkit="off" />

<header class="header h-bg--white h-auto">
    <nav class="bbw-nav h-bg--white">
        <div class="header bbw-nav-wrap h-maxwidth--1400 mx-auto position-relative">
            <div class="navbar-header brand primary-logo">
                <a class="logo-home d-block" href="${URLUtils.url('Home-Show')}"
                    title="${Resource.msgf('global.homepage.tooltip', 'common', null, Resource.msg('global.storename', 'common', null), Resource.msg(
                        'global.home', 'common', null))}">
                    <isset name="headerImage" value="${require('dw/system/Site').getCurrent().getCustomPreferenceValue('header_image')}" scope="page" />
                    <img class="hidden-md-down img-fluid w-100" src="${headerImage ? headerImage.url : URLUtils.staticURL('/images/header/Logos-main.svg')}"
                        alt="${Resource.msg('global.storename', 'common', null)}" />
                </a>
            </div>
        </div>
    </nav>
    <div class="ticker-wrapper w-100 text-center h-font-size--16 h-bg--blue-3 h-clr--blue-4">
        <iscontentasset aid="header-ticker" />
    </div>
</header>
