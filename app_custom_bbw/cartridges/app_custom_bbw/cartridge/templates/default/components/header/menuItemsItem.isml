<div class="menu-wrap dropdown-menu border-0 menu-wrap-level-3">
    <ul class="level-3-ul" role="menu" aria-hidden="true" aria-label="${category.id}">
        <isloop items="${menuItem.subCategories}" var="category">
            <isif condition="${category.subCategories}">
                <li class="dropdown-item dropdown level-3-li" role="presentation">
                    <a hreflang="${request.getLocale()}" href="${category.url}" id="${category.id}"
                        class="level-2-link dropdown-link dropdown-toggle h-font-size--14 h-fw--semibold text-uppercase"
                        role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                        tabindex="0">${category.name}</a>
                    <isset name="menuItem" value="${category}" scope="page" />
                    <isinclude template="components/header/menuItem" />
                </li>
            <iselse/>
                <li class="dropdown-item" role="presentation">
                    <a hreflang="${request.getLocale()}" href="${category.url}" id="${category.id}" role="menuitem" class="dropdown-link"
                        tabindex="0">${category.name}</a>
                </li>
            </isif>
        </isloop>
    </ul>
</div>
