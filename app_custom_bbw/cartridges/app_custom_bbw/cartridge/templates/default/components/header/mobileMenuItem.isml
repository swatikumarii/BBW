<isset name="exploreCategory" value="${category}" scope="page" />
<ul class="level-2-ul dropdown-menu position-relative p-0" role="menu" aria-hidden="true" aria-label="${category.id}">
    <isset name="categorySlotId" value="${category.slotId}" scope="page" />
    <isloop items="${menuItem.subCategories}" var="category">
        <isif condition="${category.subCategories}">
            <li class="dropdown-item dropdown level-2-li p-0" role="presentation">
                <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${category.url}" id="${category.id}"
                    class="level-2-link dropdown-link dropdown-toggle h-font-size--16 h-fw--semibold" role="button"
                    data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" tabindex="0">${category.name}</a>
                <isset name="menuItem" value="${category}" scope="page" />
                <isinclude template="components/header/mobileMenuItemsItem" />
            </li>
        <iselse/>
            <li class="dropdown-item level-2-li p-0" role="presentation">
                <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${category.url}" id="${category.id}" role="menuitem" class="dropdown-link level-2-link h-font-size--16 h-fw--semibold"
                    tabindex="0">${category.name}</a>
            </li>
        </isif>
    </isloop>
    
    <li class="dropdown-item dropdown level-2-li p-0">
        <iscomment>Menu right with images and text</iscomment>
        <div class="menu-right w-100">
            <isinclude template="components/header/menuItemSlot" />
        </div>
    </li>
    <li class="level-2-li explore-li" role="presentation">
        <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="<isprint value=" ${exploreCategory.url}" encoding="htmldoublequote" />"
        class="level-2-link h-font-size--16 h-fw--semibold h-clr--gray"
        role="button">${Resource.msg('label.menu.category.explore', 'common', null) + ' ' + exploreCategory.name}</a>
        <isset name="menuItem" value="${category}" scope="page" />
    </li>
</ul>
