<ul class="level-3-ul dropdown-menu p-0" role="menu" aria-hidden="true" aria-label="${category.id}">
    <isloop items="${menuItem.subCategories}" var="category">
        <isif condition="${category.subCategories}">
            <li class="dropdown-item dropdown level-3-li p-0 border-0" role="presentation">
                <a hreflang="${pdict.hrefLang}" href="${category.url}" id="${category.id}"
                    class="level-2-link dropdown-link dropdown-toggle h-font-size--16 h-fw--semibold text-uppercase h-clr--gray-4 d-block"
                    role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                    tabindex="0">${category.name}</a>
                <isset name="menuItem" value="${category}" scope="page" />
                <isinclude template="components/header/menuItem" />
            </li>
        <iselse/>
            <li class="dropdown-item p-0 border-0" role="presentation">
                <a hreflang="${pdict.hrefLang}" href="${category.url}" id="${category.id}" role="menuitem"
                    class="dropdown-link h-font-size--16 h-clr--gray-4 d-block" tabindex="0">${category.name}</a>
            </li>
        </isif>
    </isloop>
</ul>
