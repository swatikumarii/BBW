<div class="row">
    <div class="w-100" role="navigation" aria-label="Breadcrumb">
        <ol class="breadcrumb h-bg--white w-100 mb-0">
            <isloop items="${pdict.breadcrumbs}" var="breadcrumbValue" status="loopState">
                <li class="breadcrumb-item">
                    <isif condition="${loopState.last}">
                        <a hreflang="${request.getLocale()}" href="${breadcrumbValue.url}" aria-current="page">
                            ${breadcrumbValue.htmlValue}
                        </a>
                    <iselse>
                        <a hreflang="${request.getLocale()}" href="${breadcrumbValue.url}">
                            ${breadcrumbValue.htmlValue}
                        </a>
                    </isif>
                </li>
            </isloop>
        </ol>
    </div>
</div>
