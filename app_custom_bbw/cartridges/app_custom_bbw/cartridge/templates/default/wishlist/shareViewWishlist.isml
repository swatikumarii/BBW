<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
       assets.addCss('/css/wishlist.css');
        assets.addJs('/js/wishlist.js');
        assets.addCss('/css/account/account.css');
       assets.addCss('/css/login.css');
    </isscript>

    <div class="h-maxwidth--1400 mx-auto my-account">

        <isif condition="${pdict.privateList}">
            <div class="row">
                <div class="col-12 text-center">
                    <p>${pdict.errorMsg}</p>
                </div>
            </div>
            <iselse>
                <div class="row">
                    <div class="col-lg-10 col-md-8">
                        <div class="my-account-description profile">
                            <div class="account-profile">
                                <div class="profile-heading">
                                    <h1 class="title text-capitalize position-relative">
                                        ${Resource.msgf('label.wishlist.header', 'account', null, pdict.firstName)}
                                    </h1>
                                </div>
                            </div>

                            <div class="row justify-content-center">
                                <div class="account-info">
                                    <isinclude template="wishlist/components/wishlist" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
        </isif>
    </div>
</isdecorate>
