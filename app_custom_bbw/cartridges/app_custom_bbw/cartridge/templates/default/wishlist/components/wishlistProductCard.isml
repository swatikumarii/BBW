<div class="card border-0 product-info uuid-${item.UUID} pid-${item.pid}">
    <!--- image, attributes, availability --->
    <table class="table">
        <tr>
            <td class="item-image">
                <div class="item-image">
                    <img width="70px" height="70px" class="product-image" src="${item.imageObj.small[0].url}" alt="${item.imageObj.small[0].alt}"
                        title="${item.imageObj.small[0].title}" />
                </div>
            </td>
            <td class="item-details">
                <!--- product name--->
                <div class="line-item-name">
                    ${item.name}
                </div>
            </td>
            <td class="item-price">
                <!---unit price and quantity --->
                <isinclude template="wishlist/components/productListItemProductPrice" />
                    
                    <isloop items="${item.variationAttributes}" var="attribute">
                        <isloop items="${attribute.values}" var="eachValue">
                            <isif condition="${!!eachValue.selected}">
                                <p class="line-item-attributes">${attribute.displayName}:
                                    ${eachValue.displayValue}
                                </p>
                            </isif>
                        </isloop>
                    </isloop>
                    <isif condition="${item.options}">
                        <isloop items="${item.options}" var="option">
                            <isif condition="${!!option}">
                                <p class="line-item-attributes">${option.displayName}:${option.displayValue}</p>
                            </isif>
                        </isloop>
                    </isif>
                    <isinclude template="wishlist/components/wishlistProductCardAvailability" />

                    <isset name="creationDate" value="${new Date(item.creationDate)}" scope="page" />
                    <div class="createDate"> ${creationDate.getDate().toString() + '\\' + (creationDate.getMonth() + 1) + '\\' + creationDate.getFullYear().toString()} </div>
                    <isloop items="${pdict.expressShip}" var="wishlistItem">
                        <div class="wishlist-item">
                            <!-- Check if express shipping is available -->
                            <isif
                                condition="${wishlistItem.product.ID == item.pid && wishlistItem.product.custom.expressShip === true}">
                                <span class="express-shipping-indication">${Resource.msg('wishlist.expressShipping.available', 'wishlist', null)}</span>
                            </isif>
                        </div>
                    </isloop>
                </div>
            </td>
            <td class="item-product-detail">
                <isif condition="${!!item.master}">
                    <isinclude template="wishlist/components/selectAttributesButton" />
                <iselse/>
                    <!-- add to Cart from Wishlist -->
                    <isinclude template="wishlist/components/addToCartButton" />
                </isif>
                <isinclude template="wishlist/components/wishlistProductCardHeader" />
            </td>
        </tr>
    </table>
</div>
