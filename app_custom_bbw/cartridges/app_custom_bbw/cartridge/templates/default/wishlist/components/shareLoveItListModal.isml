<div class="modal fade hide" id="shareLoveItList" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
  aria-hidden="true">
  <div class="modal-dialog modal-dialog-bottom login-modal-view text-left" role="document">
    <div class="modal-content">
      <div class="modal-header border-bottom-0">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p class="h-font-size--18 h-fw--bold h-clr--black-3">${Resource.msg('share.love.it.list', 'wishlist', null)}</p>
              <div class="url-container" id="wishlistUrl">
              <isprint name="shareUrl" value="${URLUtils.https('Wishlist-ShowOthers', 'id', pdict.wishlist.UUID)}" scope="page" />
              </div>
      </div>
      <div class="modal-footer border-top-0">
        <button type="button" class="btn btn-secondary border-0 h-font-size--16 text-uppercase"
          data-dismiss="modal">${Resource.msg('label.close', 'wishlist', null)}</button>
          <a id="copyWishlistUrl" class="button-primary copy-url copy-code" href="#" tabindex="0"
            data-analytics-trigger="share-love-it-list-copy-link">COPY</a>
          </div>
      </div>
    </div>
  </div>
</div>
