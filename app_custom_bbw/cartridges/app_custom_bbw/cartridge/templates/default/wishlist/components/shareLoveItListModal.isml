<!-- Modal -->
<div class="modal fade hide" id="shareLoveItList" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
  aria-hidden="true">
  <div class="modal-dialog modal-dialog-bottom login-modal-view text-left" role="document">
    <div class="modal-content">
      <div class="modal-header border-bottom-0">
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
          <p class="h-font-size--18 h-fw--bold h-clr--black-3">${Resource.msg('share.love.it.list', 'wishlist', null)}</p>
      </div>
      <div class="modal-footer border-top-0">
        <button type="button" class="btn btn-secondary border-0 h-font-size--16 text-uppercase" data-dismiss="modal">Close</button>
        <iscomment> <button type="button" class="btn btn-primary">Save changes</button> </iscomment>
      </div>
    </div>
  </div>
</div>
