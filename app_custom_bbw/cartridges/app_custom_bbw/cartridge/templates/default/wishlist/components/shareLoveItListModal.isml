<div class="modal fade hide share-love-it-list-modal" id="shareLoveItList" tabindex="-1" role="dialog"
  aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-bottom login-modal-view text-left" role="document">
    <div class="modal-content">
      <button type="button" class="close" data-dismiss="modal" aria-label="Close">
        <span aria-hidden="true">
          <img src="${URLUtils.staticURL('/images/account/download.svg')}"
            alt="${Resource.msg('global.storename', 'common', null)}" />
        </span>
      </button>
      <div class="modal-body">
        <h4 class="h-font-size--18 h-fw--bold h-clr--black-3">${Resource.msg('share.love.it.list', 'wishlist', null)}
        </h4>
        <p class="h-font-size--16">${Resource.msg('label.copy.link', 'wishlist', null)}</p>
        <div class="url-container" id="wishlistUrl">
          <isprint name="shareUrl" value="${URLUtils.https('Wishlist-ShowOthers', 'id', pdict.wishlist.UUID)}"
            scope="page" />
        </div>
        <div class="button-container d-flex justify-content-end">
          <button type="button" class="btn btn-secondary btn-close border-0 h-font-size--16 h-fw--semibold text-uppercase align-items-center"
            data-dismiss="modal">${Resource.msg('label.close', 'wishlist', null)}</button>
          <a id="copyWishlistUrl" class="btn btn-hover copy-url copy-code h-font-size--16 h-fw--semibold text-uppercase align-items-center" href="#" tabindex="0"
            data-analytics-trigger="share-love-it-list-copy-link">${Resource.msg('label.copy', 'wishlist', null)}</a>
        </div>
      </div>
    </div>
  </div>
</div>
