<tr style="padding: 0;">
    <td style="background-color: #ffffff; background-size: cover; text-align: center; vertical-align: middle; padding: 48px 10px; color: #333;">
        <div style="min-width: 300px; width: 100%; max-width: 420px; margin: 0 auto;">
            <isif condition="${pdict.heading && pdict.heading.length > 0}">
                <a href="${urlHelpers.setHostToUrl(URLUtils.https('Home-Show'))}" style="display: block; font-size: 16px; font-weight: normal; margin-bottom: 15px; color: #333; text-decoration: none;">
                    <isprint value="${pdict.heading}" encoding="on" />
                </a>
            </isif>
            <div style="font-size: 30px; line-height: 40px; font-weight: bold; margin-bottom: 15px; text-transform: uppercase; color: #333;">
                <isprint value="${pdict.title}" encoding="off" />
            </div>
            <isif condition="${pdict.number && pdict.number.length > 0}">
                <div style="font-size: 16px; width: 100%; font-weight: bold; margin-bottom: 15px; color: #333;">
                    <isprint value="${pdict.number}" encoding="off" />
                </div>
            </isif>
            <isif condition="${pdict.text && pdict.text.length > 0}">
                <div style="font-size: 16px; width: 100%; color: #333; ${pdict.textsecond && pdict.textsecond.length > 0 ? 'margin-bottom: 15px;' : '' }">
                    <isprint value="${pdict.text}" encoding="off" />
                </div>
            </isif>
            <isif condition="${pdict.textsecond && pdict.textsecond.length > 0}">
                <div style="font-size: 16px; line-height: 24px; width: 100%; color: #333; ${pdict.cta && pdict.cta.length > 0 ? 'margin-bottom: 30px;' : '' }">
                    <isprint value="${pdict.textsecond}" encoding="off" />
                </div>
            </isif>
            <isif condition="${pdict.cta && pdict.cta.length > 0 && pdict.url && pdict.url.length > 0}">
                <a href="${pdict.url}" style=" font-size: 14px; font-weight: bold; font-style: italic; letter-spacing: 1px; padding: 15px 80px; background-color: transparent; color: #333; border: 1px solid #fff; text-decoration: none; display: inline-block; text-transform: uppercase;">
                    <isprint value="${pdict.cta}" encoding="on" />
                </a>
            </isif>
        </div>
    </td>
</tr>
