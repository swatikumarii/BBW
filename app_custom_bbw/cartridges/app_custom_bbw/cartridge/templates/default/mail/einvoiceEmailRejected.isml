<isinclude template="/components/modules" sf-toolkit="off" />
<isdecorate template="common/layout/email">
    <tr style="padding: 0;">
        <td style="vertical-align: middle; text-align: center; color: #333; font-size: 14px;">
            <table style="padding-top: 35px;" cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        ${Resource.msg('email.body.rejection.text', 'einvoice', null)}
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        <strong>${Resource.msg('email.body.invoice.details.text', 'einvoice', null)}</strong>
                    </td>
                </tr>
                <tr>
                    <td>
                        <table>
                            <tr style="padding: 0;">
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    <strong>${Resource.msg('email.body.order.number.text', 'einvoice', null)}</strong>
                                </td>
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    ${pdict.orderId}
                                </td>
                            </tr>
                            <tr style="padding: 0;">
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    <strong>${Resource.msg('email.body.invoice.submission.date.text', 'einvoice', null)}</strong>
                                </td>
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    ${pdict.submissionDate}
                                </td>
                            </tr>
                            <tr style="padding: 0;">
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    <strong>${Resource.msg('email.body.invoice.submission.id.text', 'einvoice', null)}</strong>
                                </td>
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    ${pdict.erpId}
                                </td>
                            </tr>
                            <tr style="padding: 0;">
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    <strong>${Resource.msg('email.body.invoice.error.rejection.text', 'einvoice', null)}</strong>
                                </td>
                                <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                                    ${pdict.errorMsg}
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        <strong>${Resource.msg('email.body.invoice.next.step.text', 'einvoice', null)}</strong>
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        ${Resource.msg('email.body.invoice.next.step.one.text', 'einvoice', null)}
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        ${Resource.msg('email.body.invoice.next.step.two.text', 'einvoice', null)}
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        ${Resource.msg('email.body.invoice.next.step.three.text', 'einvoice', null)}
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding: 0 32px 15px; vertical-align: top; text-align: left;">
                        ${Resource.msg('email.body.invoice.understanding.text', 'einvoice', null)}
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</isdecorate>
