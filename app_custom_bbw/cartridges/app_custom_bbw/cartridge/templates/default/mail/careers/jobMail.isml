<isif condition="${!empty(pdict.EmailMessage)}">
${Resource.msg('label.input.name', 'forms', null)} : <isprint value="${pdict.EmailMessage.name}" /> <br>
${Resource.msg('label.input.contact', 'forms', null)} : <isprint value="${pdict.EmailMessage.phone}" /><br>
${Resource.msg('label.input.email', 'forms', null)} : <isprint value="${pdict.EmailMessage.email}" /> <br>
