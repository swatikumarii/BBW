<isinclude template="/components/modules" sf-toolkit="off" />
<isdecorate template="common/layout/email">
    <isset name="urlHelpers" value="${require('*/cartridge/scripts/helpers/urlHelpers')}" scope="page" />
    <iscomment>
        <isemailheaderdynamic heading="${Resource.msg('label.sitename', 'email', null)}"
            title="${Resource.msg('headline.resetpassword.notification.email', 'email', null)}" />
    </iscomment>
    <tr style="padding: 0;">
        <td style="vertical-align: middle; text-align: center; color: #333; font-size:14px;">
            <table style="padding-top:35px;" cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
                <iscomment> Order Line Items </iscomment>
                <tr style="padding: 0;">
                    <td style="padding:0 32px 15px;vertical-align:top;text-align:left;">
                        <iscomment> Order Number and Order Date </iscomment>
                        <table cellpadding="0" cellspacing="0" style="width:100%">
                            <tbody>
                                <tr>
                                    <td style="vertical-align:bottom;text-align:left;font-size:18px">
                                        ${Resource.msg('label.order.number', 'confirmation', null)}
                                        <div style="color:#005699;font-weight:bold;font-size:22px;padding-top:6px">
                                            <a href="${dw.web.URLUtils.abs('Order-Status')}"
                                                title="${pdict.order.orderNumber}"
                                                style="text-decoration:none;color:#005699;font-weight:bold;font-size:22px;"
                                                target="_blank">
                                                ${pdict.order.orderNumber}
                                            </a>
                                        </div>
                                    </td>
                                    <td style="vertical-align:bottom;text-align:right;font-size:18px">
                                        ${Resource.msg('label.order.date', 'confirmation', null)} <span
                                            style="font-weight:bold">
                                            <isprint value="${new Date(pdict.order.creationDate)}"
                                                formatter="dd/MM/YYYY " timezone="SITE" />
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <iscomment> Order Customer Name and Message Body</iscomment>
                        <h1
                            style="margin:35px 30px 14px;font-size:28px;font-weight:normal;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msgf('email.title.confirmation.sender.name', 'confirmation', null, pdict.order.billing.billingAddress.address
                            .firstName)}
                        </h1>
                        <p
                            style="margin:0 30px 20px;font-size:22px;line-height:33px;padding-right:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('shipped.order.email.body', 'email', null)}
                        </p>
                        <p
                            style="margin:0 30px 20px;font-size:22px;line-height:33px;padding-right:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('track.order.text.alert.msg', 'email', null)} <a href="#" style="text-decoration:underline;color:#005699;">${Resource.msg('track.order.alert.text.label', 'email', null)}</a>
                        </p>
                        <p
                            style="margin:0 30px 20px;font-size:22px;line-height:33px;padding-right:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('email.customer.care.text', 'email', null)} <a href="#"
                                style="text-decoration:underline;color:#005699;">${Resource.msg('email.customer.care.label', 'email', null)}</a>
                        </p>
                        <iscomment> View Order Status Image and Button </iscomment>
                        <div style="border:3px solid #f2f2f2;padding:36px 0;text-align:center">
                            <p style="margin:0 0 44px">
                                <img src="${URLUtils.absStatic('/images/email/orders/status/icon-shipped.png')}"
                                    alt="Progress" style="border:0;vertical-align:top;width:90%;" />
                            </p>
                            <div>
                                <!--[if mso]>
                                            <v:rect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="${dw.web.URLUtils.abs('Order-Status')}" style="height:40px;v-text-anchor:middle;width:200px;" strokecolor="#333" fillcolor="#333">
                                                <w:anchorlock/>
                                                <center style="font-size:14px;text-transform:uppercase;color:#ffffff;font-family:sans-serif;font-size:13px;">${Resource.msg('track.your.order.email.btn', 'confirmation', null)}</center>
                                            </v:rect>
                                        <![endif]--><a href="${dw.web.URLUtils.abs('Order-Status')}"
                                    style="font-size:14px;text-transform:uppercase;background-color:#333;border:1px solid #333;color:#ffffff;display:inline-block;font-family:sans-serif;font-size:14px;line-height:40px;text-align:center;text-decoration:none;width:200px;-webkit-text-size-adjust:none;mso-hide:all;cursor: pointer;">${Resource.msg('track.your.order.email.btn', 'email', null)}</a>
                            </div>
                            <p
                                style="margin:16px 0 0;font-size:16px;line-height:16px;color:#666666;text-align:center;font-family:'HelveticaNeue-Regular','Helvetica Neue Regular','HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                                ${Resource.msg('track.order.id.label', 'email', null)}
                                <span style="color:#005699;text-decoration:underline;"><strong>1z2309930355546232</strong></span>
                                   <span>${Resource.msg('track.order.expedited.label', 'email', null)}</span>
                            </p>
                        </div>
                        <p
                            style="margin:11px 0 32px;font-size:14px;line-height:14px;color:#666666;text-align:center;font-family:'HelveticaNeue-Regular','Helvetica Neue Regular','HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('track.information.notice.text', 'email', null)}</p>

                        <div
                            style="font-size:26px;border-bottom:1px solid #333;text-transform:uppercase;margin:0;padding-bottom:13px;margin-bottom:5px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('email.order.youritem.label', 'confirmation', null)}
                        </div>
                        <p style="margin:20px 0 20px;color:#666666;text-align:left;font-family:'HelveticaNeue-Regular','Helvetica Neue Regular','HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            <img width="42px" height="22px" src="${URLUtils.absStatic('/images/email/orders/status/shipped-icon.png')}" alt="Shipped"
                                style="border:0;vertical-align:top;width:42pxlheight:22px;" />
                            <span style="margin-left:10px;color:#000000;font-weight:bold;font-size:16px;line-height:16px;display: inline-block;height: 28px;vertical-align: middle;">${Resource.msg('track.order.shipped.label', 'email', null)}</span>
                            <span style="display:block;font-size:14px;line-height:14px;">${Resource.msg('track.order.expedited.label', 'email', null)}</span>
                        </p>
                        <iscomment> Normal Product Line Items </iscomment>
                        <table width="100%" cellpadding="0" cellspacing="0"
                            style="border-collapse:collapse;margin-top:15px;border-top: 3px solid #f2f2f2;">
                            <tbody>
                                <isif condition="${pdict.order.shipping.length === 1}">
                                    <isloop items="${pdict.order.items.items}" var="lineItem">
                                        <tr>
                                            <td width="119"
                                                style="vertical-align:middle;padding:20px 0 0;width:119px;text-align:center">
                                                <a style="display:block;"
                                                    href="${URLUtils.https('Product-Show', 'pid', lineItem.id)}">
                                                    <img src="${lineItem.images.small[0].url}"
                                                        alt="${lineItem.images.small[0].alt}"
                                                        title="${lineItem.images.small[0].title}"
                                                        style="border:0;vertical-align:top;width:auto;max-height: 160px;height: 100%;max-width:119px;"
                                                        width="119" />
                                                </a>
                                            </td>
                                            <td width="245" style="padding:46px 0 20px 20px;vertical-align:top">
                                                <div style="width:245px">
                                                    <div
                                                        style="text-transform:uppercase;font-size:16px;color:#333;margin-bottom:15px;line-height:23px">
                                                        <a href="${URLUtils.https('Product-Show', 'pid', lineItem.id)}"
                                                            title="${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}"
                                                            style="text-decoration:none;text-transform:uppercase;font-size:16px;color:#333;line-height:23px;margin-bottom:15px;font-family:'HelveticaNeue-Light',Arial,sans-serif"
                                                            target="_blank">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</a>
                                                    </div>
                                                    <isif
                                                        condition="${'giftCardDetails' in lineItem && lineItem.giftCardDetails}">
                                                        <div style="color:#666;font-size:14px;line-height:18px">
                                                            ${lineItem.giftCardDetails.recipientName}
                                                        </div>
                                                        <isif
                                                            condition="${lineItem.giftCardDetails.eGiftMessage && lineItem.giftCardDetails.eGiftMessage !== null}">
                                                            <div style="color:#666;font-size:14px;line-height:18px">
                                                                ${lineItem.giftCardDetails.eGiftMessage}
                                                            </div>
                                                        </isif>
                                                        <div style="color:#666;font-size:14px;line-height:18px">
                                                            ${lineItem.giftCardDetails.senderName}
                                                        </div>
                                                        <iselseif
                                                            condition="${'greetingCardMessage' in lineItem && lineItem.greetingCardMessage}" />
                                                        <div style="color:#666;font-size:14px;line-height:18px">
                                                            ${lineItem.greetingCardMessage}
                                                        </div>
                                                    <iselse/>
                                                        <isif condition="${'titlePartB' in lineItem && lineItem.titlePartB}">
                                                            <div style="color:#666;font-size:14px;line-height:18px">
                                                                ${lineItem.titlePartB}
                                                            </div>
                                                        </isif>
                                                        <div style="color:#666;font-size:14px;line-height:18px">
                                                            ${lineItem.volume ? lineItem.volume : ''}
                                                        </div>
                                                        <isif condition="${'customBundle' in lineItem && lineItem.customBundle}">
                                                            <div style="color:#666;font-size:14px;line-height:18px">
                                                                ${dw.experience.PageMgr.getPage(lineItem.customBundle).name}
                                                            </div>
                                                        </isif>
                                                        <div style="color:#666;font-size:14px;line-height:18px">
                                                            ${Resource.msg('email.order.itemno.label', 'confirmation', null)} ${lineItem.id}
                                                        </div>
                                                    </isif>
                                                </div>
                                            </td>
                                            <td
                                                style="font-size:16px;color:#333;padding:50px 10px 20px;vertical-align:top;text-align:center;">
                                                <span
                                                    style="text-transform: uppercase;">${Resource.msg('label.header.quantity', 'confirmation', null)} </span>
                                                <isprint value="${lineItem.quantity}" />
                                            </td>
                                            <td
                                                style="font-size:16px;padding:50px 0 20px;vertical-align:top;text-align:center;">
                                                <isif condition="${lineItem.totalSavings && lineItem.totalSavings.value != 0}">
                                                    ${lineItem.totalSavings}
                                                <iselse/>
                                                    ${'-'}
                                                </isif>
                                            </td>
                                            <td
                                                style="font-size:16px;padding:50px 0 20px;vertical-align:top;text-align:right">
                                                <isif condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}">
                                                    ${Resource.msg('label.free.price', 'cart', null)}
                                                <iselse/>
                                                    ${lineItem.priceTotal.price}
                                                </isif>
                                            </td>
                                        </tr>
                                    </isloop>
                                </isif>
                            </tbody>
                        </table>
                        <p
                            style="font-size:14px;line-height:14px;color:#666666;text-align:center;font-family:'HelveticaNeue-Regular','Helvetica Neue Regular','HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;border-top: 3px solid #f2f2f2;padding: 20px 0;">
                            ${Resource.msg('email.order.looking.more.text', 'confirmation', null)}<a
                                style="color:#005699;text-decoration:underline;"
                                href="${dw.web.URLUtils.abs('Order-Status')}">
                                ${Resource.msg('email.order.looking.more.here.text', 'confirmation', null)}</a>
                        </p>

                        <iscomment> Shipped Order Email Content Asset - Content </iscomment>
                        <isprint value="${pdict.markup}" encoding="off" />

                        <iscomment> Shipping Section </iscomment>
                        <div
                            style="font-size:26px;border-bottom:1px solid #333;text-transform:uppercase;margin:0 0 16px;padding-bottom:13px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('email.order.shipping.heading', 'confirmation', null)}
                        </div>
                        <iscomment> Shipping Summary </iscomment>
                        <div style="border:1px solid #e5e5e5;margin-bottom:37px">
                            <table width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed">
                                <tbody>
                                    <tr>
                                        <isloop items="${pdict.order.shipping}" var="shippingModel"
                                            status="shippingLoop">
                                            <td
                                                style="vertical-align:top;padding:21px 12px 33px 24px;color:#666666;font-size:16px;line-height:24px">
                                                <div style="color:#333;font-weight:bold;margin-bottom:10px">
                                                    ${Resource.msg('email.order.shippedto.heading', 'confirmation', null)}
                                                </div>
                                                <isset name="address" value="${shippingModel.shippingAddress}"
                                                    scope="page" />
                                                <isinclude template="checkout/addressSummary" />
                                            </td>
                                            <td
                                                style="vertical-align:top;padding:21px 0 33px 50px;color:#666666;font-size:16px;line-height:24px">

                                                <div style="color:#333;font-weight:bold;margin-bottom:10px">
                                                    ${Resource.msg('email.order.shipping.method.heading', 'confirmation', null)}</div>
                                                <div style="padding-bottom:20px">
                                                    <div style="color:#333333">
                                                        ${shippingModel.selectedShippingMethod.displayName}</div>
                                                </div>
                                                <isif
                                                    condition="${shippingModel.selectedShippingMethod.estimatedArrivalTime}">
                                                    <div style="color:#333;font-weight:bold;margin-bottom:10px">
                                                        ${Resource.msg('email.order.shipping.estimated.delivery.heading', 'confirmation', null)}</div>
                                                    <div style="padding-bottom:20px">
                                                        <div style="color:#333333">
                                                            ${shippingModel.selectedShippingMethod.estimatedArrivalTime}
                                                        </div>
                                                    </div>
                                                </isif>
                                            </td>
                                        </isloop>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <iscomment> Billing Section </iscomment>
                        <div
                            style="font-size:26px;border-bottom:1px solid #333;text-transform:uppercase;margin:0;padding-bottom:13px;margin-bottom:16px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msg('email.order.billing.heading', 'confirmation', null)}
                        </div>
                        <div style="border:1px solid #e5e5e5;margin-bottom:30px">
                            <table width="100%" cellpadding="0" cellspacing="0" style="table-layout:fixed">
                                <tbody>
                                    <tr>
                                        <td
                                            style="vertical-align:top;padding:21px 12px 33px 24px;color:#666666;font-size:16px;line-height:24px">
                                            <div style="color:#333;font-weight:bold;margin-bottom:10px">
                                                ${Resource.msg('email.order.billto.heading', 'confirmation', null)}
                                            </div>
                                            <isinclude template="checkout/addressSummary" />
                                        </td>
                                        <td
                                            style="vertical-align:top;padding:21px 0 33px 50px;color:#666666;font-size:16px;line-height:24px">
                                            <div style="color:#333;font-weight:bold;margin-bottom:10px">
                                                ${Resource.msg('email.order.payment.method.heading', 'confirmation', null)}
                                            </div>
                                            <isloop items="${pdict.order.billing.payment.selectedPaymentInstruments}"
                                                var="payment">
                                                <isif
                                                    condition="${payment.paymentMethod === 'AdyenComponent' || payment.paymentMethod === 'CREDIT_CARD'}">
                                                    <isinclude
                                                        template="checkout/confirmation/adyenConfirmationDetails" />
                                                </isif>
                                                <p>${Resource.msg('email.order.payment.order.amount.label', 'confirmation', null)}: ${pdict.order.totals.grandTotal}</p>
                                            </isloop>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <iscomment> Payment Summary </iscomment>
                        <table width="100%" cellpadding="0" cellspacing="0">
                            <tbody>
                                <tr>
                                    <td style="vertical-align:top;background:#f2f2f2;padding:30px 35px;">
                                        <table width="100%" cellpadding="0" cellspacing="0">
                                            <tbody>
                                                <tr>
                                                    <td colspan="2"
                                                        style="vertical-align:top;font-size:26px;line-height:26px;text-transform:uppercase;border-bottom:3px solid #e5e5e5;padding-bottom:18px;text-align:center;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                                                        ${Resource.msg('email.order.payment.summary.heading', 'confirmation', null)}
                                                    </td>
                                                </tr>
                                                <iscomment> Subtotal </iscomment>
                                                <tr>
                                                    <isif condition="${totalExclusiveTax}">
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:23px 0 13px">
                                                            ${Resource.msg('email.order.payment.merch.subtotal.label', 'confirmation', null)}
                                                        </td>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:23px 0 13px;text-align:right">
                                                            ${pdict.order.totals.subTotalExclTax}
                                                        </td>
                                                    <iselse/>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:23px 0 13px">
                                                            ${Resource.msg('email.order.payment.merch.subtotal.label', 'confirmation', null)}
                                                        </td>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:23px 0 13px;text-align:right">
                                                            ${pdict.order.totals.subTotal}
                                                        </td>
                                                    </isif>
                                                </tr>

                                                <iscomment> Order Discount </iscomment>
                                                <isif condition="${pdict.order.totals.allDiscounts.length > 0}">
                                                    <isloop items="${pdict.order.totals.allDiscounts}" var="discount"
                                                        status="loopstatus">
                                                        <tr>
                                                            <td
                                                                style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0">
                                                                ${discount.promotion}
                                                            </td>
                                                            <td
                                                                style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0;text-align:right">
                                                                ${discount.discount}</td>
                                                        </tr>
                                                    </isloop>
                                                </isif>
                                                <iscomment> Shipping Charge </iscomment>
                                                <tr>
                                                    <isif condition="${shippingExclusiveTax}">
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0">
                                                            ${Resource.msg('email.order.payment.shipping.ground.label1', 'confirmation', null)}
                                                            - <span
                                                                style="text-transform:none">${Resource.msg('email.order.payment.shipping.ground.label2', 'confirmation', null)}</span>
                                                        </td>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0;text-align:right">
                                                            ${pdict.order.totals.shippingTotalExclTax}</td>
                                                    <iselse/>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0">
                                                            ${Resource.msg('email.order.payment.shipping.ground.label1', 'confirmation', null)}
                                                            - <span
                                                                style="text-transform:none">${Resource.msg('email.order.payment.shipping.ground.label2', 'confirmation', null)}</span>
                                                        </td>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0;text-align:right">
                                                            ${pdict.order.totals.totalShippingCost}</td>
                                                    </isif>
                                                </tr>
                                                <iscomment> Shipping Ground </iscomment>
                                                <tr>
                                                    <td
                                                        style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0">
                                                        ${Resource.msg('email.shipping.and.handling.tax', 'confirmation', null)}
                                                    </td>
                                                    <td
                                                        style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0;text-align:right">
                                                        ${pdict.order.totals.shippingTotalTax}</td>
                                                </tr>
                                                <iscomment> Shipping Discounts </iscomment>
                                                <tr>
                                                    <isif
                                                        condition="${!pdict.order.totals.shippingLevelDiscountTotal.value === 0}">
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0">
                                                            ${Resource.msg('label.shipping.discount', 'common', null)}
                                                        </td>
                                                        <td
                                                            style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0;text-align:right">
                                                            ${'-' + pdict.order.totals.shippingLevelDiscountTotal.formatted}
                                                        </td>
                                                    </isif>
                                                </tr>

                                                <iscomment> Discounts </iscomment>
                                                <tr>
                                                    <td
                                                        style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0">
                                                        ${Resource.msg('label.order.discount', 'common', null)}
                                                    </td>
                                                    <td
                                                        style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0;text-align:right">
                                                        ${pdict.order.totals.totalDiscountFormatted}</td>
                                                </tr>
                                                <tr>
                                                    <td
                                                        style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0 20px">
                                                        ${Resource.msg('email.order.payment.sales.tax.label', 'confirmation', null)}</td>
                                                    <td
                                                        style="font-size:18px;text-transform:uppercase;vertical-align:top;padding:13px 0 20px;text-align:right">
                                                        ${pdict.order.totals.totalTax}
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td
                                                        style="font-size:21px;text-transform:uppercase;vertical-align:top;padding:22px 0 2px;border-top:3px solid #e5e5e5;font-weight:bold">
                                                        ${Resource.msg('email.order.payment.order.total.label', 'confirmation', null)}</td>
                                                    <td
                                                        style="font-size:21px;text-transform:uppercase;vertical-align:top;padding:22px 0 2px;border-top:3px solid #e5e5e5;font-weight:bold;text-align:right">
                                                        ${pdict.order.totals.grandTotal}</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                <iscomment> Order Email Content Asset - Content </iscomment>
                <tr style="padding: 0;">
                    <td style="padding:0 32px 0;vertical-align:top;text-align:left;">
                        <isprint value="${pdict.footermarkup}" encoding="off" />
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</isdecorate>
