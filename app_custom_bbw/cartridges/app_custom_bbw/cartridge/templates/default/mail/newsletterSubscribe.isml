<isset name="ID" value="${pdict.id}" scope="page" />
<isinclude template="/components/modules" sf-toolkit="off" />
<isdecorate template="common/layout/email">
    <isset name="urlHelpers" value="${require('*/cartridge/scripts/helpers/urlHelpers')}" scope="page" />
    <iscomment>
        <isemailheaderdynamic heading="${Resource.msg('label.sitename', 'email', null)}"
            title="${Resource.msg('headline.resetpassword.notification.email', 'email', null)}" />
    </iscomment>
    <tr style="padding: 0;">
        <td style="vertical-align: middle; text-align: center; color: #333; font-size:14px;">
            <table style="padding-top:15px;" cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
                <tr style="padding: 0;">
                    <td style="padding:0 0 15px;vertical-align:top;text-align:left;">
                        <isprint value="${pdict.markup}" encoding="off" />
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</isdecorate>

