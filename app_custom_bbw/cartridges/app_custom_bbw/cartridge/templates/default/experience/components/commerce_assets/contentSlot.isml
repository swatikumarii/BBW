<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/slickSliderComponent.js');
    assets.addCss('/css/slickSlider/slick.css');
    assets.addCss('/css/slickSlider/slick-theme.css');
</isscript>
<isif condition="${pdict.contentSlotId === Resource.msg('slot.recommendation.einstein', 'common', null)}">
    <div class="content-slot-component">
        <isslot id="einstein-recommendation-panel" description="Einstein recommendation Panel" context="global" />
    </div>
</isif>
<isif condition="${pdict.contentSlotId === Resource.msg('slot.recommendation.picked.for.you', 'common', null)}">
    <div class="content-slot-component">
        <isslot id="picked-just-for-you" description="Picked Just for You" context="global" />
    </div>
</isif>
