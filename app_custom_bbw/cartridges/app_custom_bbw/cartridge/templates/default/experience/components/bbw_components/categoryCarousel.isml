<h2>${pdict.carouselTitle}</h2>
<isloop items="${pdict.selectedProducts}" var="onlineProduct" begin="${0}" end="${pdict.productsCount}"
    status="loopstate">
    <div>
        <span>${onlineProduct.name}</span>
        <isif condition="${'titlePartB' in onlineProduct.custom}">
            <span>${onlineProduct.custom.titlePartB}</span>
        </isif>
        <a href="">Add to bag</a>
    </div>
</isloop>
<a href="${pdict.shopButtonLink}">${pdict.shopButtonText}</a>
