<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/productDetail.js');
</isscript>
<div class="product-grid-wrapper ${pdict.sectionCustomClass ? pdict.sectionCustomClass : ''}">
    <div class="product-grid h-dsp--grid h-grid-gap--15 h-grid-gap-lg--55 no-gutters h-mt-md--0 h-mb-md--50 h-mb--45">
        <input type="hidden" class="add-to-cart-url" value="${URLUtils.url('Cart-AddProduct')}" />
        <isloop items="${pdict.selectedProducts}" var="onlineProduct" status="loopstate">
            <div class="col product-grid-item h-mb-md--50">
                <isinclude url="${URLUtils.url('Tile-Show', 'pid', onlineProduct.id)}" />
            </div>
        </isloop>
    </div>
    <isif condition="${pdict.viewAllButtonLink !== ''}">
        <div class="h-flex-center w-100">
            <a class="show-all-link text-center btn shop b-text-letter-space-0 h-fw--normal w-auto"
                hreflang="${pdict.hrefLang}" href="${pdict.viewAllButtonLink}">
                <isprint value="${pdict.viewAllButtonText}" encoding="off" />
            </a>
        </div>
    </isif>
</div>
