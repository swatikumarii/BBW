<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/productDetail.js');
</isscript>
<div class="h-dsp-md--grid">
    <div class="shop-the-module-wrapper">
        <div class="shop-the-module ds-smooth-scroll d-flex js-shop-the-module-scroll">
            <input type="hidden" class="add-to-cart-url" value="${URLUtils.url('Cart-AddProduct')}" />
            <isloop items="${pdict.selectedProducts}" var="onlineProduct" status="loopstate">
                <div class="shop-the-module__slide js-shop-the-module-slide">
                    <div class="ds-shop-the-image-product-tile ${pdict.productDetailAlignment}">
                        <isinclude url="${URLUtils.url('Tile-Show', 'pid', onlineProduct.id)}" />
                    </div>
                </div>
            </isloop>
        </div>
        <isif condition="${pdict.viewAllButtonLink !== ''}">
            <a class="text-center" href="${pdict.viewAllButtonLink}">
                <isprint value="${pdict.viewAllButtonText}" encoding="off" />
            </a>
        </isif>
    </div>
</div>
