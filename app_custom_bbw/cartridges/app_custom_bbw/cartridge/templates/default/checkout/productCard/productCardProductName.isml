<div class="line-item-name">
    <span class="d-block h-fw--semibold h-clr--black-1 h-font-size--15 product-title">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</span>
    <span class="d-block h-font-size--14 h-clr--gray-4 prod-desc">${lineItem.titlePartB ? lineItem.titlePartB : ''}</span>
    <span class="d-block h-font-size--14 h-clr--gray-4 prod-desc">${lineItem.volume ? lineItem.volume : ''}</span>
    <isif condition="${'customBundle' in lineItem && lineItem.customBundle}">
        <span class="d-block h-font-size--14">${dw.experience.PageMgr.getPage(lineItem.customBundle).name}</span>
    </isif>
</div>
