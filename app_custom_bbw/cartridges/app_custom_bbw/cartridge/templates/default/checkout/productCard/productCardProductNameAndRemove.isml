<div class="line-item-name h-pb--10">
    <isif condition="${lineItem.isEgiftCard}">
            <span class="d-block h-fw--bold h-clr--black-1 h-font-size--16">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</span>
    <iselse/>
        <a hreflang="${request.getLocale()}" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
            <span class="d-block h-fw--bold h-clr--black-1 h-font-size--16">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</span>
        </a>
    </isif>
    <span class="d-block h-font-size--13">${lineItem.titlePartB ? lineItem.titlePartB : ''}</span>
    <span class="d-block h-font-size--11">${lineItem.volume ? lineItem.volume : ''}</span>
</div>
<isif condition="${!lineItem.isBonusProductLineItem}">
    <div class="remove-line-item h-pos--absolute">
        <span type="button" class="cart-delete-confirmation-btn" data-pid="${lineItem.id}"
            data-name="${lineItem.productName}" data-action="${pdict.actionUrls.removeProductLineItemUrl}"
            data-uuid="${lineItem.UUID}"
            aria-label="${Resource.msgf('text.remove.line.item', 'cart', null, lineItem.productName)}">
            <img src="${URLUtils.staticURL('/images/close-16.svg')}" alt="close icon" width="20" />
        </span>
    </div>
</isif>
