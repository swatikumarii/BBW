<isif condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}">
    <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">${Resource.msg('label.free.price', 'cart', null)}</div>
<iselse/>
    <isif condition="${'nonAdjustedPrice' in lineItem.priceTotal}">
        <div class="strike-through">
            ${lineItem.priceTotal.nonAdjustedPrice}
        </div>
    </isif>
    <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">${lineItem.priceTotal.price}</div>
</isif>
