<isif condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}">
    <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID} h-font-size--${!(miniCart) ? '16' : '14'} h-fw--semibold h-clr--black-1">${Resource.msg('label.free.price', 'cart', null)}</div>
<iselse/>
    <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID} h-font-size--${!(miniCart) ? '16' : '14'} h-fw--semibold ${'nonAdjustedPrice' in lineItem.priceTotal ? 'minicart-red cart-black-1' : 'checkout-black-1'}">${lineItem.priceTotal.price}</div>
</isif>
