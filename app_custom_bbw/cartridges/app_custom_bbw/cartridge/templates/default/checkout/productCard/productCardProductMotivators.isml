<isif condition="${pdict.miniCart !== null}">
    <isset name="miniCart" value="${pdict.miniCart}" scope="page" />
</isif>
<isif condition="${pdict.cartPage !== null}">
    <isset name="cartPage" value="${pdict.cartPage}" scope="page" />
</isif>
<isif condition="${pdict.lineItem !== null}">
    <isset name="lineItem" value="${pdict.lineItem}" scope="page" />
</isif>
<isif condition="${lineItem.promotions}">
    <isloop items="${lineItem.promotions}" var="promotion">
        <isif condition="${promotion.motivator}">
            <div class="h-font-size--14${!(miniCart) ? ' promotion' : ''} ${cartPage ? 'h-fw--semibold' : ''}">
                <isprint value="${promotion.motivator}" encoding="off" />
            </div>
        </isif>
    </isloop>
</isif>
