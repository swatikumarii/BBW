<isset name="promotionDetails" value="" scope="page" />

<isif condition="${pdict.miniCart !== null}">
    <isset name="miniCart" value="${pdict.miniCart}" scope="page" />
</isif>
<isif condition="${pdict.cartPage !== null}">
    <isset name="cartPage" value="${pdict.cartPage}" scope="page" />
</isif>
<isif condition="${pdict.lineItem !== null}">
    <isset name="lineItem" value="${pdict.lineItem}" scope="page" />
</isif>
<isif condition="${lineItem.promotions}">
    <isloop items="${lineItem.promotions}" var="promotion" status="loopstatus">
        <div class="h-font-size--14${!(miniCart) ? ' promotion' : ''} ${cartPage ? 'h-fw--semibold' : ''}">
            <isprint value="${promotion.calloutMsg}" encoding="off" />
        </div>
        <isset name="showDescription" value="${false}" scope="page" />
        <isif condition="${miniCart}">
            <isset name="showDescription" value="${true}" scope="page" />
        <iselseif condition="${cartPage}" />
            <isset name="showDescription" value="${true}" scope="page" />
        </isif>

        <isif condition="${!empty(promotion.details)}">
            <isif condition="${loopstatus.first}">
                <isset name="promotionDetails" value="${promotion.details}" scope="page" />
            <iselse/>
                <isset name="promotionDetails" value="${promotionDetails + ',<br>' + promotion.details}" scope="page" />
            </isif>
        </isif>
       
    </isloop>

    <isif condition="${showDescription && !empty(promotionDetails)}">
        <div class="promotion-callout h-fw--semibold h-font-size--18 h-clr--pink">
            <button type="button"
                class="callout-detail p-0 btn-with-image ds-js-simple-tooltip ds-tooltip-button h-bg--white custom-button border-0 d-block"
                data-placement="right" data-toggle="popover" id="tooltip-footer_iroll_popover_emailcapture486"
                title="<div class='pdp-title'></div>" data-content="<a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href='#' class='close cursor-pointer'></a>
                            <div class='popover-content pdp-pop-content ds-tooltip-content'>
                                <isprint value=" ${promotionDetails}" />
        </div>
        <div class='arrow-fill'></div>"
        data-html="true" data-original-title="" aria-describedby="popover14574">
        </button>
        </div>
    </isif>
</isif>
