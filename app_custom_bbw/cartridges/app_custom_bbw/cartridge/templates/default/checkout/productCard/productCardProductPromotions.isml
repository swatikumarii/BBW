<isif condition="${lineItem.appliedPromotions}">
    <isloop items="${lineItem.appliedPromotions}" var="appliedPromotion">
        <div class="h-font-size--12">
            <isprint value="${appliedPromotion.callOutMsg}" encoding="off" />
        </div>
        <isif condition="${miniCart}">
            <div class="info-icon promo-details h-font-size--12">
                ${Resource.msg('label.promo.details', 'cart', null)}
                <div class="tooltip d-none">
                    <isprint value="${appliedPromotion.details}" encoding="off" />
                </div>
            </div>
        </isif>
    </isloop>
</isif>
