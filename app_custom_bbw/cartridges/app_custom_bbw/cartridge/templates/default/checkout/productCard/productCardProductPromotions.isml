<isif condition="${lineItem.promotions}">
    <isloop items="${lineItem.promotions}" var="promotion">
            <div class="h-font-size--${!(miniCart) ? '14 promotion' : '12'}">
            <isprint value="${promotion.calloutMsg}" encoding="off" />
        </div>
        <isset name="showDescription" value="${false}" scope="page" />
        <isif condition="${miniCart}">
            <isset name="showDescription" value="${true}" scope="page" />
        <iselseif condition="${cartPage}" />
            <isset name="showDescription" value="${true}" scope="page" />
        </isif>

        <isif condition="${showDescription && promotion.details !== ''}">
            <div class="h-pos--relative d-flex flex-column justify-content-center promo-details-wrap">
                <span class="callout-detail promo-details h-font-size--${miniCart ? '12' : '14'} p-0 btn-with-image ds-js-simple-tooltip ds-tooltip-button h-bg--white custom-button border-0 d-block">
                    ${Resource.msg('label.promo.details', 'cart', null)}
                </span>
                <span class="promo-details-tooltip" style="display:none">
                    <div class="tooltip-arrow"></div>
                    <div class="promo-details-content">
                        <isprint value="${promotion.details}" encoding="off" />
                    </div>
                </span>
            </div>
        </isif>
    </isloop>
</isif>
