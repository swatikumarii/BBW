<div class="product-line-item" data-product-line-item="${lineItem.UUID}">
    <div class="row">
        <div class="col-4">
            <iscomment> Image </iscomment>
            <div class="product-line-item-details d-flex flex-row">
                <div class="item-image">
                    <img class="product-image" src="${lineItem.images.small[0].url}"
                        alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}" width="100" />
                </div>
            </div>
        </div>
        <div class="col-8 pr-md-0">
            <div class="line-item-header flex-column">
                <iscomment> Display Name </iscomment>
                <isif condition="${miniCart}">
                    <isinclude template="checkout/productCard/productCardProductNameAndRemove" />
                <iselse/>
                    <isinclude template="checkout/productCard/productCardProductName" />
                </isif>
                <iscomment> Variation Attributes </iscomment>
                <div class="item-attributes">
                    <isloop items="${lineItem.variationAttributes}" var="attribute">
                        <p class="line-item-attributes">${attribute.displayName}: ${attribute.displayValue}</p>
                    </isloop>
                    <iscomment> Options </iscomment>
                    <div class="item-options">
                        <isloop items="${lineItem.options}" var="option">
                            <div class="line-item-option">${option.displayName}</div>
                        </isloop>
                    </div>
                </div>
                <iscomment> Promotion callout </iscomment>
                <div class="line-item-promo item-${lineItem.UUID} h-pb--10">
                    <isinclude template="checkout/productCard/productCardProductPromotions" />
                </div>
                <div class="h-pb--10">
                    <isinclude template="wishlist/components/addToWishListButtonCart" sf-toolkit="on" />
                </div>
                <iscomment> Quantity </iscomment>
                <div class="d-flex align-items-center justify-content-between">
                    <div class="line-item-quantity">
                        <isif condition="${miniCart && !lineItem.customBundle}">
                            <isinclude template="checkout/productCard/productCardQuantitySelector" />
                        <iselse/>
                            <isinclude template="checkout/productCard/productCardQuantityDisplay" />
                        </isif>
                    </div>
                    <iscomment> Price </iscomment>
                    <div class="line-item-total-price">
                        <div class="item-total-${lineItem.UUID} price">
                            <isinclude template="checkout/productCard/productCardProductTotalPrice" />
                        </div>
                    </div>
                </div>
                <div class="product-availability pt-2">
                    <span>
                        ${Resource.msg('label.availability', 'common', null)}
                    </span>
                    <span class="${lineItem.available ? 'h-clr--green' : 'h-clr--red'}">
                        ${lineItem.availability.messages[0]}
                    </span>
                </div>
                <isif condition="${lineItem.customBundle}">
                    <div class="currentCustomBundle">
                        ${dw.experience.PageMgr.getPage(lineItem.customBundle).name} ${Resource.msg('bundle', 'productBundle', null)}
                    </div>
                </isif>
            </div>
        </div>
    </div>
</div>
