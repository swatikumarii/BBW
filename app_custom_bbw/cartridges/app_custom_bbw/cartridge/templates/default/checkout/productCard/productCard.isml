<div class="product-line-item" data-pid="${lineItem.id}" data-product-line-item="${lineItem.UUID} ">
    <div class="row">
        <div class="col-4">
            <iscomment> Image </iscomment>
            <div class="product-line-item-details d-flex flex-row">
                <isif condition="${lineItem.isEgiftCard}">
                    <div class="item-image">
                        <img class="product-image" src="${lineItem.images.small[0].url}"
                            srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x"
                            alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}"
                            width="100" />
                    </div>
                <iselse/>
                    <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
                        <div class="item-image">
                            <img class="product-image" src="${lineItem.images.small[0].url}"
                                srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x"
                                alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}"
                                width="100" />
                        </div>
                    </a>
                </isif>
            </div>
        </div>
        <div class="col-8 pr-1 pr-md-0">
            <div class="line-item-header flex-column">
                <iscomment> Display Name </iscomment>
                <isif condition="${lineItem.isBonusProductLineItem}">
                    <span>${Resource.msg('label.free.gift', 'common', null)}</span>
                </isif>
                <isif condition="${miniCart}">
                    <isinclude template="checkout/productCard/productCardProductNameAndRemove" />
                <iselse>
                        <isinclude template="checkout/productCard/productCardProductName" />
                </isif>
                <iscomment> Variation Attributes </iscomment>
                <div class="item-attributes">
                    <isloop items="${lineItem.variationAttributes}" var="attribute" status="loopstate">
                        <p
                            class="line-item-attributes ${lineItem.variationAttributes.length > 0 && loopstate.index !== lineItem.variationAttributes.length - 1 ? 'mb-0' : ''}">
                            ${attribute.displayName}: ${attribute.displayValue}</p>
                    </isloop>
                    <iscomment> Options </iscomment>
                    <div class="item-options">
                        <isloop items="${lineItem.options}" var="option">
                            <div class="line-item-option">${option.displayName}</div>
                        </isloop>
                    </div>
                </div>
                <isif condition="${'giftCardDetails' in lineItem && lineItem.giftCardDetails}">
                    <div class="giftcard-details">
                        <span
                            class="d-block giftcard-receipient-name h-font-size--14 pb-2 h-line-height--16">${Resource.msg('label.input.recipientsname', 'forms', null)}${': '} ${lineItem.giftCardDetails.recipientName && lineItem.giftCardDetails.recipientName !== null ? lineItem.giftCardDetails
                                                                                                                                                                                .recipientName : ''}</span>
                        <span
                            class="d-block giftcard-receipient-email h-font-size--14 pb-2 h-line-height--16">${Resource.msg('label.input.sendername', 'forms', null)}${': '} ${lineItem.giftCardDetails.recipientEmail && lineItem.giftCardDetails.recipientEmail !== null ? lineItem.giftCardDetails
                                                                                                                                                                             .recipientEmail : ''}</span>
                        <span
                            class="d-block giftcard-message h-font-size--14 pb-2 h-line-height--16">${Resource.msg('label.egift.message', 'forms', null)}${': '} ${lineItem.giftCardDetails.eGiftMessage && lineItem.giftCardDetails.eGiftMessage !== null ? lineItem.giftCardDetails
                                                                                                                                                                 .eGiftMessage : ''}</span>
                    </div>
                </isif>
                <iscomment> Promotion callout </iscomment>
                <isif condition="${miniCart}">
                    <div class="line-item-promo item-${lineItem.UUID} h-pb--10">
                        <isinclude template="checkout/productCard/productCardProductPromotions" />
                    </div>
                    <div class="h-pb--10">
                        <isinclude template="wishlist/components/addToWishListButtonCart" sf-toolkit="on" />
                    </div>
                    <iscomment> Quantity </iscomment>
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="line-item-quantity">
                            <isif condition="${!lineItem.customBundle}">
                                <isinclude template="checkout/productCard/productCardQuantitySelector" />
                            <iselse/>
                                <isinclude template="checkout/productCard/productCardQuantityDisplay" />
                                <isif condition="${!lineItem.available}">
                                    <p class="h-clr--red h-font-size--14 mb-2 h-line-height--16">
                                        ${Resource.msg('label.outOfStock.message', 'checkout', null)}
                                    </p>
                                </isif>
                            </isif>
                        </div>
                        <iscomment> Price </iscomment>
                        <div class="line-item-total-price">
                            <div class="item-total-${lineItem.UUID} price">
                                <isinclude template="checkout/productCard/productCardProductTotalPrice" />
                            </div>
                        </div>
                    </div>
                    <div class="product-availability pt-2">
                        <span class="${lineItem.available ? 'h-clr--green-2' : 'h-clr--red'}">
                            ${lineItem.availability.messages[0]}
                        </span>
                    </div>
                    <isif condition="${lineItem.customBundle}">
                        <div class="currentCustomBundle">
                            ${dw.experience.PageMgr.getPage(lineItem.customBundle).name} ${Resource.msg('bundle', 'productBundle', null)}
                        </div>
                    </isif>
                    <iselse>
                        <isinclude template="checkout/productCard/productCardQuantityDisplay" />
                        <isif condition="${!lineItem.available}">
                            <p class="h-clr--red h-font-size--14 mb-2 h-line-height--16">
                                ${Resource.msg('label.outOfStock.message', 'checkout', null)}
                            </p>
                        </isif>
                        <isinclude template="checkout/productCard/productCardProductPromotions" />
                        <isif condition="${pdict.containsDangerousGoods && lineItem.dangerousGoods}">
                            <div class="dangerous-goods-label h-font-size--12 h-clr--red h-fw--normal">
                                ${Resource.msg('dangerous.goods.lable', 'common', null)}
                            </div>
                        </isif>
                        <div class="h-min-width-perc--100">
                            <isinclude template="checkout/productCard/productCardProductTotalPrice" />
                        </div>
                </isif>
            </div>
        </div>
    </div>
</div>
