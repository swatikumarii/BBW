<div class="product-line-item" data-pid="${lineItem.id}" data-product-line-item="${lineItem.UUID} ">
    <div class="row">
        <div class="col-3 p-0">
            <iscomment> Image </iscomment>
            <div class="product-line-item-details d-flex flex-row">
                <isif condition="${lineItem.isEgiftCard}">
                    <div class="item-image">
                        <img class="product-image" src="${lineItem.images.small[0].url}" srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x" alt="${lineItem.images.small[0].alt}"
                            title="${lineItem.images.small[0].title}" width="100" />
                    </div>
                <iselse/>
                    <a hreflang="${request.getLocale()}" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
                        <div class="item-image">
                            <img class="product-image" src="${lineItem.images.small[0].url}" srcset="${lineItem.images.small[0].url} 1x, ${lineItem.images.small_2x[0].url} 2x"
                                alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}"
                                width="100" />
                        </div>
                    </a>
                </isif>
            </div>
        </div>
        <div class="col-9 pr-md-0">
            <div class="line-item-header flex-column">
                <div class="social-badge-wrapper d-flex h-grid-gap--5 flex-wrap h-maxwidth--150">
                    <isif condition="${lineItem.badge1}">
                        <div class="b-product-tile__social-badge">
                            <div
                                class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                                ${lineItem.badge1}</div>
                        </div>
                    </isif>
                    <isif condition="${lineItem.badge2}">
                        <div class="b-product-tile__social-badge">
                            <div
                                class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                                ${lineItem.badge2}</div>
                        </div>
                    </isif>
                    <isif condition="${lineItem.badge3}">
                        <div class="b-product-tile__social-badge">
                            <div
                                class="b-product-tile__social-badge-text h-bg--blue h-clr--white d-inline-flex h-fw--bold justify-content-center b-text-a text-decoration-none">
                                ${lineItem.badge3}</div>
                        </div>
                    </isif>
                </div>
                <iscomment> Display Name </iscomment>
                <div class="line-item-name">
                    <isif condition="${lineItem.isEgiftCard}">
                        <span class="d-block h-fw--semibold h-clr--black-1 h-font-size--16">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</span>
                    <iselse/>
                        <a hreflang="${request.getLocale()}" href="${URLUtils.url('Product-Show', 'pid', lineItem.id)}">
                            <span class="d-block h-fw--semibold h-clr--black-1 h-font-size--16">${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}</span>
                        </a>
                    </isif>
                    <span class="d-block h-font-size--14 h-clr--gray-4">${lineItem.titlePartB ? lineItem.titlePartB : ''}</span>
                    <span class="d-block h-font-size--14 h-clr--gray-4">${lineItem.volume ? lineItem.volume : ''}</span>
                </div>
                <isif condition="${!lineItem.isBonusProductLineItem}">
                    <div class="remove-line-item h-pos--absolute">
                        <span type="button" class="cart-delete-confirmation-btn" data-pid="${lineItem.id}"
                            data-name="${lineItem.productName}" data-action="${pdict.actionUrls.removeProductLineItemUrl}"
                            data-uuid="${lineItem.UUID}"
                            aria-label="${Resource.msgf('text.remove.line.item', 'cart', null, lineItem.productName)}">
                            <img src="${URLUtils.staticURL('/images/icons/minicart-popup-remove-btn.svg')}" alt="close icon" width="20" />
                        </span>
                    </div>
                </isif>
                <iscomment> Variation Attributes </iscomment>
                <div class="item-attributes">
                    <isloop items="${lineItem.variationAttributes}" var="attribute" status="loopstate">
                        <isif condition="${attribute.displayName !== 'amount'}">
                            <p
                                class="line-item-attributes ${lineItem.variationAttributes.length > 0 && loopstate.index !== lineItem.variationAttributes.length - 1 ? 'mb-0' : ''}">
                                ${attribute.displayName}: ${attribute.displayValue}</p>
                        </isif>
                    </isloop>
                    <iscomment> Options </iscomment>
                    <div class="item-options">
                        <isloop items="${lineItem.options}" var="option">
                            <div class="line-item-option">${option.displayName}</div>
                        </isloop>
                    </div>
                </div>
                <isif condition="${'giftCardDetails' in lineItem && lineItem.giftCardDetails}">
                    <div class="giftcard-details">
                        <span class="d-block h-font-size--12 h-clr--green-1 pb-1">${Resource.msg('gift.card.delivered.by.email.text', 'cart', null)}</span>
                        <span class="d-block h-font-size--12 giftcard-receipient-name pb-1">${Resource.msg('label.input.recipientsname', 'forms', null)}${': '} ${lineItem.giftCardDetails.recipientName && lineItem.giftCardDetails.recipientName !== null ? lineItem.giftCardDetails
                                                                                                                                                                .recipientName : ''}${','} ${lineItem.giftCardDetails.recipientEmail && lineItem.giftCardDetails.recipientEmail !== null ? lineItem.giftCardDetails
                                                                                                                                                                                           .recipientEmail : ''}</span>
                        <span class="d-block h-font-size--12 giftcard-receipient-email pb-1">${Resource.msg('label.input.sendername', 'forms', null)}${': '} ${lineItem.giftCardDetails.senderName && lineItem.giftCardDetails.senderName !== null ? lineItem.giftCardDetails
                                                                                                                                                             .senderName : ''}</span>
                        <span class="h-font-size--12 giftcard-message mb-2">${Resource.msg('label.egift.message', 'forms', null)}${': '}
                            ${lineItem.giftCardDetails.eGiftMessage && lineItem.giftCardDetails.eGiftMessage !== null ? lineItem.giftCardDetails
                            .eGiftMessage : ''}</span>
                    </div>
                </isif>
                <iscomment> Quantity </iscomment>
                <div class="d-flex flex-column justify-content-between">
                    <div class="line-item-quantity">
                        <p class="line-item-quantity-info h-font-size--14 mb-1">
                            <span class="line-item-total-text h-clr--gray-4 qty-card-quantity-label">
                                ${Resource.msg('field.selectquantity', 'cart', null)}
                            </span>
                            <span class="pricing qty-card-quantity-count h-clr--gray-4">
                                <isprint value="${lineItem.quantity}" formatter="##" /></span>
                        </p>
                    </div>
                    <div class="line-item-promo item-${lineItem.UUID} h-pb--10">
                        <isset name="miniCart" value="${false}" scope="page" />

                        <isinclude template="checkout/productCard/productCardProductPromotions" />
                    </div>
                </div>
            </div>
            <iscomment> Price </iscomment>
            <div class="line-item-total-price w-100 text-right">
                <div class="item-total-${lineItem.UUID} price">
                    <isif condition="${'priceValue' in lineItem.priceTotal && lineItem.priceTotal.priceValue <= 0}">
                        <div
                            class="pricing line-item-total-price-amount item-total-${lineItem.UUID} h-font-size--16 h-fw--semibold h-clr--black-1">
                            ${Resource.msg('label.free.price', 'cart', null)}</div>
                    <iselse/>
                        <div
                            class="pricing line-item-total-price-amount item-total-${lineItem.UUID} h-font-size--16 h-fw--semibold h-clr--black-1">
                            ${lineItem.priceTotal.price}</div>
                    </isif>
                </div>
            </div>
        </div>
    </div>
</div>
