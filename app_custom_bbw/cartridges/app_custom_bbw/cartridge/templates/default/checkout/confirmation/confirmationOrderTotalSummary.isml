
<iscomment> Subtotal </iscomment>
    <div class="row">
      <div class="col-12 payment-title">
         <h2 class="text-uppercase h-font-size--20 text-center">${Resource.msg('label.payment.summary', 'confirmation', null)}</h2>
      </div>
        <div class="col-8">
            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('confirmation.label.merchandise.subtotal', 'confirmation', null)}</p>
        </div>
        <div class="col-4">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold subtotal">${Resource.msg('bill.total', 'confirmation', null)}</p>
        </div>
    </div>

<iscomment> Shipping Charge </iscomment>

    <div class="row">
        <div class="col-8">
            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling', 'confirmation', null)}</p>
        </div>
        <div class="col-4">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost">
                ${pdict.order.totals.totalShippingCost}</p>
        </div>
    </div>


<iscomment> Shipping Tax </iscomment>
<div class="row">
    <div class="col-8">
            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.shipping.and.handling.tax', 'confirmation', null)}
            </p>
    </div>
    <div class="col-4">
        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-tax">
            ${pdict.order.totals.shippingTotalTax}</p>
    </div>
</div>



<iscomment> Sales Tax </iscomment>
<div class="row">
    <div class="col-8">
            <p class="h-font-size--16 h-clr--black-1">${Resource.msg('label.sales.tax.inclusive', 'confirmation', null)}</p>
    </div>
    <div class="col-4">
        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sales-tax">${pdict.order.totals.totalTax}</p>
    </div>
</div>

<div class="row confirmation-total-wrap">
    <div class="col-8">
        <p class="h-font-size--18 h-clr--black-1 h-fw--semibold">${Resource.msg('label.estimatedtotal', 'confirmation', null)}
        </p>
    </div>
    <div class="col-4">
        <p class="text-right h-font-size--18 h-clr--black-1 h-fw--semibold grand-total">${pdict.order.totals.grandTotal}</p>
    </div>
</div>
