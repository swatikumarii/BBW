<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/checkout/checkout.css');
        assets.addJs('/js/orderHistory.js');
    </isscript>

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>
    <div class="hide-sessionTimeOut container receipt <isif condition="${pdict.order.shipping.length > 1}">multi-ship</isif>">
    <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
        <div class="row">
        <div class="col-md-12 col-sm-12 d-flex justify-content-center slot-banner">
            <img class="md-banner-img w-100 d-none d-sm-block"
                src="${URLUtils.staticURL('/images/orderConfirm/order-confirmed.png')}"
                alt="${Resource.msg('order.confirm.image', 'common', null)}" />
            <img class="d-sm-none md-banner-img w-100" src="${URLUtils.staticURL('/images/orderConfirm/thankyou-mobile-banner.svg')}"
                alt="${Resource.msg('order.confirm.image', 'common', null)}" />
        </div>
        </div>
        <div class="row">
            <div class="${pdict.returningCustomer ? 'col-sm-12' : 'col-md-12' }">
                <isinclude template="checkout/confirmation/confirmationDetails" />
                <div class="my-5 d-flex justify-content-center">
                    <a href="${URLUtils.url('Home-Show')}" class="btn d-flex h-flex-center order-confirmation-continue-shopping h-font-size--16 h-fw--semibold h-line-height--20" role="button" aria-pressed="true">
                        <span>${Resource.msg('button.continue.shopping','confirmation',null)}</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
