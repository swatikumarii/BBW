<!--- Shipping Address --->

<div class="single-shipping row">
    <div class="summary-details shipping h-font-size--16 h-clr--black-1 col-md-6">
        <h2>Ship to</h2>
        <isinclude template="checkout/confirmation/confirmationAddressSummaryInvoice" />
        <div class="shipping-phone">
            ${Resource.msg('label.phone.number', 'confirmation', null)}
        </div>
    </div>

    <!--- Shipping information --->
    <div class="summary-details leading-lines col-md-6">
        <div class="start-lines">
            <h2>Shipping method</h2>
            <p class="shipping-method h-font-size--16 h-clr--black-1">
                <span class="shipping-method-title">${Resource.msg('label.standard.shipping', 'confirmation', null)}</span>
                <span class="shipping-method-arrival-time">
                </span>
            ${Resource.msg('bill.total', 'confirmation', null)}
            </p>
        </div>
    </div>
</div>
