<isscript>
    var date = new Date();
    var monthNameShort = date.toLocaleString('default', { month: 'short' }).substr(0,3);
    var todayDate = date.getDate();
</isscript>
<div class="card-body confirmation-details">
    <div class="col-sm-10 col-md-6 col-xl-6 text-center confirmation-data">
        <p class="mb-0 h-font-size--16 h-clr--black-1">
            <span class="summary-section-label  order-number-label">${Resource.msg('label.order.number', 'confirmation', null)}</span>
            <span class="summary-details order-number h-fw--semibold">${pdict.order.orderNumber}</span>
        </p>
        <p  class="mb-0 h-font-size--16 h-clr--black-1">
            <span class="summary-section-label  order-date-label">${Resource.msg('label.order.date', 'confirmation', null)}</span>
            <span class="summary-details order-date h-fw--semibold">
                <isprint value="${pdict.order.creationDate}" formatter="dd/MM/yy hh:mm a" /></span>
        </p>
        <p  class="mb-0 h-font-size--16 h-clr--black-1">
            <span class="summary-section-label  order-date-label">${Resource.msg('label.total', 'confirmation', null)}</span>
            <span class="summary-details order-date h-fw--semibold">${pdict.order.totals.grandTotal}
            </span>
        </p>
        <isif condition="${pdict.order.orderEmail}">
            <p class="order-thank-you-email-msg h-font-size--16 h-clr--black-1 mb-0">
            <span class="summary-section-label  order-number-label">${Resource.msg('error.confirmation.error', 'confirmation', null)}</span>
            <span class="summary-details order-number h-fw--semibold">${pdict.order.orderEmail}</span>
            </p>
        </isif>
        <button id="invoiceDownload" class="h-fw--normal print-text h-clr--gray bg-white border-0 h-font-size--16"
            data-action="${pdict.order.invoiceDownloadUrl}">${Resource.msg('label.print', 'confirmation', null)}</button>
    </div>
</div>
<isif condition="${pdict.order.orderStatus && pdict.order.orderStatus.value === pdict.orderStatusVal.ORDER_STATUS_CREATED}">
    <div class="purhase-pending">
        <p class="mb-0">${Resource.msg('message.order.pending', 'order', null)} </p>
    </div>
<iselseif condition="${pdict.order.orderStatus && (pdict.order.orderStatus.value === pdict.orderStatusVal.ORDER_STATUS_FAILED || pdict.order.orderStatus.value === pdict.orderStatusVal.ORDER_STATUS_CANCELLED)}">
    <div class="purhase-failed">
        <p class="mb-0">${Resource.msg('message.order.failed', 'order', null)} <p>
    </div>
<iselse>
    <div class="success-toast confirmation-msg">
        ${Resource.msg('purchase.label.message', 'confirmation', null)}
    </div>
    <isif condition="${pdict.order.items.items[0] && 'isEgiftCard' in pdict.order.items.items[0] && pdict.order.items.items[0].isEgiftCard}">
        <isif condition="${pdict.order.items.items.length > 1}">
            <div class="success-toast confirmation-msg">
                ${Resource.msg('egiftcards.delivery.message', 'confirmation', null)}
            </div>
        <iselse/>
            <isif condition="${pdict.order.items.items[0].giftCardDetails.eGiftScheduledDay != todayDate || pdict.order.items.items[0].giftCardDetails.eGiftScheduledMonths !==  monthNameShort}">
                <div class="success-toast confirmation-msg">
                    <isset name="deliveryDate" value="${Number(pdict.order.items.items[0].giftCardDetails.eGiftScheduledDay).toFixed(0) + '-' + pdict.order.items.items[0].giftCardDetails.eGiftScheduledMonths}" scope="page" />
                    ${Resource.msgf('egiftcard.delivery.message', 'confirmation', null, deliveryDate, pdict.order.items.items[0].giftCardDetails.recipientEmail)}
                </div>
            </isif>
        </isif>
    </isif>
</isif>
<h2 class="h-font-size--24 h-fw--bold h-clr--black-3 card-header-confirmation text-left text-uppercase">
    ${Resource.msg('label.your.order', 'confirmation', null)}</h2>
<isinclude template="checkout/confirmation/confirmationDetailsView" />
