<isdecorate template="common/layout/checkout">

    <iscomment> Load Static Assets </iscomment>
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/checkout.js');
        assets.addJs('/js/afterpayCheckout.js');
        assets.addJs('/js/cashappCheckout.js');
        assets.addCss('/css/checkout/checkout.css');
        assets.addCss('/css/afterpaystyle.css');
    </isscript>

    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>
    <div class="loader">
        <div class="h-visually-hidden" role="alert">Just a second, items loading</div>
        <div class="spinner" style="position:fixed"></div>
    </div>
    <div id="checkout-main"
        class="container data-checkout-stage ${pdict.order.usingMultiShipping && pdict.order.shipping.length > 1 ? 'multi-ship' : ''}"
        data-customer-type="${pdict.customer.registeredUser ? 'registered' : 'guest'}"
        data-checkout-stage="${pdict.currentStage}" data-checkout-get-url="${URLUtils.https('CheckoutServices-Get')}">
        <div class="container">
            <input type="hidden" name="overrideAfterpay" value="${false}">
            <input type="hidden" name="billing-url" value="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}">
            <input type="hidden" name="review-url" value="${URLUtils.url('Checkout-Begin', 'stage', 'placeOrder')}">
            <isif condition="${pdict.isGiftProductAvailable}">
                <div class="checkout-steps d-flex justify-content-between">
                    <div class="step-1 d-flex align-items-center flex-column h-width-perc-md--100 step-connect shipping-step">
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}">
                            <span class="step-text h-font-size--14 d-block">
                                ${Resource.msg('checkout.step.billing', 'checkout', null)}
                            </span>
                        </a>
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}">
                            <span class="d-block step-count h-fw--semibold">
                                ${Resource.msg('checkout.step.1', 'checkout', null)}
                            </span>
                        </a>
                    </div>
                    <div class="step-2 d-flex align-items-center flex-column h-width-perc-md--100 payment-step">
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'placeOrder')}">
                            <span class="step-text h-font-size--14 d-block">${Resource.msg('checkout.step.review', 'checkout', null)}</span>
                        </a>
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'placeOrder')}">
                            <span class="d-block step-count h-fw--semibold ">
                                ${Resource.msg('checkout.step.2', 'checkout', null)}
                            </span>
                        </a>
                    </div>
                </div>
            <iselse/>
                <div class="checkout-steps d-flex justify-content-between">
                    <div class="step-1 d-flex align-items-center flex-column h-width-perc-md--100 step-connect shipping-step">
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'shipping')}">
                            <span class="step-text h-font-size--14 d-block">
                                ${Resource.msg('checkout.step.shipping', 'checkout', null)}
                            </span>
                        </a>
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'shipping')}">
                            <span class="d-block step-count h-fw--semibold">
                                ${Resource.msg('checkout.step.1', 'checkout', null)}
                            </span>
                        </a>
                    </div>
                    <div class="step-2 d-flex align-items-center flex-column h-width-perc-md--100 step-connect payment-step">
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}">
                            <span class="step-text h-font-size--14 d-block">
                                ${Resource.msg('checkout.step.billing', 'checkout', null)}
                            </span>
                        </a>
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}">
                            <span class="d-block step-count h-fw--semibold">
                                ${Resource.msg('checkout.step.2', 'checkout', null)}
                            </span>
                        </a>
                    </div>
                    <div class="step-3 d-flex align-items-center flex-column h-width-perc-md--100 place-order-step">
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'placeOrder')}">
                            <span class="step-text h-font-size--14 d-block">${Resource.msg('checkout.step.review', 'checkout', null)}</span>
                        </a>
                        <a hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'placeOrder')}">
                            <span class="d-block step-count h-fw--semibold ">
                                ${Resource.msg('checkout.step.3', 'checkout', null)}
                            </span>
                        </a>
                    </div>
                </div>
            </isif>
        </div>

        <div class="row">
            <div class="col-12">
                <h2 class="h-font-size--20 h-font-size-md--24 h-clr--black-3 h-mt--0 h-mb--25 h-line-height-md--28 h-line-height--24 pb-3 h-fw--bold border-bottom border-dark">${Resource.msg('label.order.your.items', 'order', null)}</h2>
            </div>
            <div class="col-lg-8 col-md-6">
                <div class="review-shipping-summary border">
                    <isinclude template="checkout/shipping/shippingSummary" />
                </div>
                <div class="review-billing-summary border">
                    <isinclude template="checkout/billing/billingSummary" />
                </div>
                <div class="review-product-summary">
                    <isset name="isOrderConfirmPage" value="${false}" scope="page" />
                    <isinclude template="checkout/review/productSummary" />
                </div>
                <div class="h-maxwidth-perc-md--75">


                    <iscomment> Checkout Forms: Shipping, Payment, Coupons, Billing, etc </iscomment>


                    <div class="alert alert-danger error-message bg-white" role="alert">
                        <div class="payment-error">
                            <p class="error-message-text mb-0 h-font-size--14 h-fw--semibold h-clr--red"></p>
                        </div>

                        <div class="col-md-12 text-center">
                            <a class="h-clr--white btn h-font-size--14 h-fw--semibold retry-payment-btn"
                                hreflang="${pdict.hrefLang}" href="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}">
                                <span class="step-text h-font-size--16 d-block">
                                    ${Resource.msg('label.go.back.btn', 'checkout', null)}
                                </span>
                            </a>
                        </div>
                    </div>

                    <iscomment> Step 1: Customer </iscomment>
                    <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableAfterpay')}">
                        <iscomment>Start of Afterpay</iscomment>
                        <iscomment>Afterpay error message</iscomment>
                        <isset name="afterpayError" value="${pdict.afterpayApiError}" scope="page" />
                        <isif condition="${!empty(afterpayError)}">
                            <div class="alert alert-danger " role="alert">
                                <isprint value="${afterpayError}" encoding="on" />
                            </div>
                        </isif>
                        <iscomment>End of Afterpay</iscomment>
                    </isif>
                    <iscomment>We only allow edits for non-registered customers</iscomment>
                    <div class="checkout-blocks customer ${!pdict.customer.registeredUser ? 'guest' : 'registered'}">
                        <div class="h-maxwidth-perc-md--90 mx-auto mx-md-0 accordion">
                            <isinclude template="checkout/customer/customer" />
                        </div>
                    </div>

                    <iscomment> Step 2: Shipping </iscomment>
                    <div class="checkout-blocks shipping">
                        <div class="h-maxwidth-perc-md--90 mx-auto mx-md-0">
                            <isinclude template="checkout/shipping/shipping" />
                            <isif condition="${pdict.containsDangerousGoods}">
                                <div class="dangerous-goods-message">
                                    <isprint
                                        value="${dw.system.Site.getCurrent().getCustomPreferenceValue('dangerousGoodsMessage')}"
                                        encoding="off" />
                                </div>
                            </isif>
                        </div>
                    </div>

                    <iscomment> Step 3: Payment and Billing </iscomment>
                    <div class="checkout-blocks billing mb-0 mb-md-4">
                        <div class="h-maxwidth-perc-md--90 mx-auto mx-md-0">
                            <isinclude template="checkout/billing/billing" />
                        </div>
                    </div>
                    <div class="card payment-summary">
                        <div class="card-header clearfix">
                            <h2 class="pull-left card-header-custom">${Resource.msg('heading.payment', 'checkout', null)}
                            </h2>
                            <button class="edit-button pull-right"
                                aria-label="${Resource.msg('action.edit.step.msg.payment', 'checkout', null)}">${Resource.msg('action.edit.step', 'checkout', null)}</button>
                        </div>
                    </div>

                    <iscomment> Checkout Workflow Buttons </iscomment>

                    <div class="row no-gutters checkout-btn-row">
                        <div class="col-12">
                            <p class="verify-msg h-font-size--14 h-clr--black-1" style="display:none">
                                ${Resource.msg('msg.fill.all.required', 'checkout', null)}</p>
                        </div>
                        <div class="col-12 next-step-button h-pos--relative ${pdict.currentStage === 'payment' ? 'px-md-3' : 'px-md-0'}">
                            <div class="mb-sm-3 next-step-button-inner-wrapper">
                                <iscomment>Start of Afterpay</iscomment>
                                <div
                                    class="ap-checkout-ship ap-checkout-pay-tab-noecf ap-checkout-pay-notab-ecf ap-checkout-pay-notab-noecf ap-checkout-po-noecf">
                                    <iscomment>End of Afterpay</iscomment>

                                    <isif condition="${pdict.isDangerousGoodsInBasket && !pdict.isOrderShippable}">
                                        <span class="h-font-size--16 h-clr--red h-fw--normal cart-dangerous-goods">
                                        ${Resource.msgf('checkout.dangerousGoods.notShippable', 'checkout', null)}
                                        <a class="b-link--underlined" href="${URLUtils.url('Cart-Show')}">${Resource.msgf('checkout.dangerousGoods.viewCart', 'checkout', null)}</a>
                                        ${Resource.msgf('checkout.dangerousGoods.updateCart', 'checkout', null)}</span>
                                    <iselse/>
                                         <span class="h-font-size--16 h-clr--red h-fw--normal cart-dangerous-goods d-none">
                                        ${Resource.msgf('checkout.dangerousGoods.notShippable', 'checkout', null)}
                                        <a class="b-link--underlined" href="${URLUtils.url('Cart-Show')}">${Resource.msgf('checkout.dangerousGoods.viewCart', 'checkout', null)}</a>
                                        ${Resource.msgf('checkout.dangerousGoods.updateCart', 'checkout', null)}</span>
                                    </isif>
                                    <button
                                        class="btn btn-primary btn-hover h-clr--white h-fw--semibold h-font-size--16 submit-shipping"
                                        type="submit" name="submit" value="submit-shipping"
                                        ${pdict.order.usingMultiShipping && !pdict.order.shippable ? 'disabled' : ''}>
                                        ${Resource.msg('button.next.payment', 'checkout', null)}
                                    </button>

                                    <button
                                        class="btn btn-primary btn-hover h-clr--white h-fw--semibold h-font-size--16 submit-payment"
                                        type="submit" name="submit" value="submit-payment">
                                        ${Resource.msg('button.next.place.order', 'checkout', null)}
                                    </button>

                                    <button
                                        class="btn btn-primary btn-hover h-clr--white h-fw--semibold h-font-size--16 place-order"
                                        data-action="${URLUtils.url('CheckoutServices-PlaceOrder')}" type="submit"
                                        name="submit" value="place-order">${Resource.msg('button.place.order', 'checkout', null)}
                                    </button>
                                    <iscomment>Start of CashAppPay</iscomment>
                                    <iscomment>
                                        <div id="cash-app-pay" class="btn btn-block cashapp-checkout-button"></div>
                                    </iscomment>
                                    <iscomment>End of CashAppPay</iscomment>
                                    <iscomment>Start of Afterpay</iscomment>
                                </div>
                                <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableAfterpay')}">
                                    <input id="afterpay-placeorder-button"
                                        class="afterpay-widget-hideuntilready ${buttonPlaceOrderClass} btn btn-block ap-checkout-pay-tab-ecf ap-checkout-po-ecf"
                                        type="button" />
                                </isif>
                                <iscomment>End of Afterpay</iscomment>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <iscomment> Order Totals, Details and Summary </iscomment>

            <div class="col-lg-4 col-md-6">
                <div class="card order-summary">
                    <div class="order-product-summary-wrap">
                        <h2 class="h-font-size--18 h-fw--bold h-clr--black-1 text-center order-product-summary-heading">
                            ${Resource.msg('heading.your.order', 'checkout', null)}</h2>
                        <isinclude template="checkout/orderProductSummary" />
                    </div>
                    <div class="order-total-summary-wrap">
                        <h2
                            class="h-font-size--20 h-clr--black-1 h-mb--10 h-py--20 h-fw--bold border-bottom text-center review-order-summary">
                            ${Resource.msg('label.order.payment.summary', 'order', null)}</h2>
                        <isinclude template="checkout/orderTotalSummary" />
                    </div>
                </div>
                <div class="shipping-summary card">
                    <div class="d-flex justify-content-between shipping-summary-header">
                        <h2 class="h-font-size--18 h-fw--bold h-clr--black-1 ">
                            ${Resource.msg('heading.checkout.shipping', 'checkout', null)}</h2>
                        <isif condition="${!pdict.isGiftProductAvailable}">
                            <a href="${URLUtils.url('Checkout-Begin', 'stage', 'shipping')}" class="edit-button pull-right b-link--underlined h-clr--black-1">${Resource.msg('action.edit.step', 'checkout', null)}</a>
                        </isif>
                    </div>
                    <isinclude template="checkout/shipping/shippingSummary" />
                </div>
            </div>

            <div class="w-100 d-block d-md-none">
                <div class="w-100 next-step-button h-pos--relative">
                    <div class="mb-sm-3">
                        <iscomment>Start of Afterpay</iscomment>
                        <div
                            class="ap-checkout-ship ap-checkout-pay-tab-noecf ap-checkout-pay-notab-ecf ap-checkout-pay-notab-noecf ap-checkout-po-noecf">
                            <iscomment>End of Afterpay</iscomment>
                            <button class="btn btn-primary btn-hover h-clr--white h-fw--semibold h-font-size--16 submit-shipping"
                                type="submit" name="submit" value="submit-shipping" ${pdict.order.usingMultiShipping && !pdict.order.shippable ? 'disabled' : ''}>
                                ${Resource.msg('button.next.payment', 'checkout', null)}
                            </button>
<iscomment>
                            <button class="btn btn-primary h-clr--white h-fw--semibold h-font-size--16 submit-payment"
                                type="submit" name="submit" value="submit-payment">
                                ${Resource.msg('button.next.place.order', 'checkout', null)}
                            </button> </iscomment>

                            <button class="btn btn-primary h-clr--white h-fw--semibold h-font-size--16 place-order"
                                data-action="${URLUtils.url('CheckoutServices-PlaceOrder')}" type="submit" name="submit"
                                value="place-order">${Resource.msg('button.place.order', 'checkout', null)}
                            </button>
                            <iscomment>Start of CashAppPay</iscomment>
                            <iscomment>
                                <div id="cash-app-pay" class="btn btn-block cashapp-checkout-button"></div>
                            </iscomment>
                            <iscomment>End of CashAppPay</iscomment>
                            <iscomment>Start of Afterpay</iscomment>
                        </div>
                        <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('enableAfterpay')}">
                            <input id="afterpay-placeorder-button"
                                class="afterpay-widget-hideuntilready ${buttonPlaceOrderClass} btn btn-block ap-checkout-pay-tab-ecf ap-checkout-po-ecf"
                                type="button" />
                        </isif>
                        <iscomment>End of Afterpay</iscomment>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <isinclude template="checkout/shipping/shippingAddressTemplate" />

</isdecorate>
