<isset name="totalExclusiveTax"
    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showTotalsExcludingTaxes')}" scope="page" />
<isset name="shippingExclusiveTax"
    value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingExcludingTaxes')}" scope="page" />
<isset name="showSalesTaxes" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showSalesTaxes')}"
        scope="page" />
<isset name="showShippingHandlingTaxes"
        value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingHandlingTaxes')}" scope="page" />

<iscomment> Subtotal </iscomment>
<isif condition="${totalExclusiveTax}">
    <div class="row">
        <div class="col-7">
            <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.merchandise.subtotal.excluding.taxes', 'cart', null)}</p>
        </div>
        <div class="col-5">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold subtotal h-line-height--20 b-text-letter-space-01">${pdict.order.totals.subTotalExclTax}
            </p>
        </div>
    </div>
<iselse/>
    <div class="row">
        <div class="col-7">
            <p class="h-font-size--16 h-clr--black-1 h-line-height--20 merchandise-total b-text-letter-space-01">${Resource.msg('label.merchandise.subtotal', 'cart', null)}</p>
        </div>
        <div class="col-5">
            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold subtotal h-line-height--20 b-text-letter-space-01">${pdict.order.totals.subTotal}</p>
        </div>
    </div>
</isif>

<iscomment> Order Discount </iscomment>
<div class="row order-discount accordion-item collapsed ${pdict.order.totals.totalDiscount.value === 0 ? " hide-order-discount" : ""}" data-toggle="collapse" data-target="#allDiscounts" aria-expanded="false" aria-controls="allDiscounts" role="button">
    <isinclude template="checkout/orderDiscountsHtml" sf-toolkit="on" />
</div>

<iscomment> Shipping Charge </iscomment>
<isif condition="${!pdict.isGiftProductAvailable}">
    <isif condition="${shippingExclusiveTax}">
        <div class="row">
            <div class="col-7">
                <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.shipping.and.handling.excluding.taxes', 'cart', null)}</p>
            </div>
            <div class="col-5">
                <isif condition="${!pdict.order.hasFreeShipping}">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive h-line-height--20 b-text-letter-space-01">
                        ${pdict.order.totals.shippingTotalExclTax}</p>
                <iselse/>
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive h-line-height--20 b-text-letter-space-01">
                        ${Resource.msg('label.free.price', 'cart', null)}</p>
                </isif>
            </div>
        </div>
    <iselse/>
        <div class="row">
            <div class="col-7">
                <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.shipping.and.handling', 'cart', null)}</p>
            </div>
            <div class="col-5">
                <isif condition="${!pdict.order.hasFreeShipping}">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-inclusive h-line-height--20 b-text-letter-space-01">
                        ${pdict.order.totals.totalShippingCost}</p>
                <iselse/>
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-inclusive h-line-height--20 b-text-letter-space-01">
                        ${Resource.msg('label.free.price', 'cart', null)}</p>
                </isif>
            </div>
        </div>
    </isif>
    <iscomment> Shipping Tax </iscomment>
    <isif condition="${showShippingHandlingTaxes}">
        <isif condition="${!pdict.order.hasFreeShipping}">
            <div class="row">
                <div class="col-7">
                    <isif condition="${shippingExclusiveTax}">
                        <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.shipping.and.handling.tax', 'cart', null)}</p>
                    <iselse/>
                        <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">
                            ${Resource.msg('label.shipping.and.handling.tax.inclusive', 'cart', null)}</p>
                    </isif>
                </div>
                <div class="col-5">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-tax h-line-height--20 b-text-letter-space-01">
                        ${pdict.order.totals.shippingTotalTax}</p>
                </div>
            </div>
            <iscomment> Shipping Discount </iscomment>
            <div
                class="row shipping-discount ${pdict.order.totals.shippingLevelDiscountTotal.value === 0 ? 'hide-shipping-discount' : ''}">
                <div class="col-7">
                    <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.shipping.discount', 'common', null)}</p>
                </div>
                <div class="col-5">
                    <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-discount-total h-line-height--20 b-text-letter-space-01"> ${'-' + pdict.order.totals.shippingLevelDiscountTotal.formatted}</p>
                </div>
            </div>
        </isif>
    </isif>


    <iscomment> Sales Tax </iscomment>
    <isif condition="${showSalesTaxes}">
        <div class="row order-confirmation-hide">
            <div class="col-7">
                <isif condition="${totalExclusiveTax}">
                    <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.sales.tax', 'cart', null)}</p>
                <iselse/>
                    <p class="h-font-size--16 h-clr--black-1 merchandise-total h-line-height--20 b-text-letter-space-01">${Resource.msg('label.sales.tax.inclusive', 'cart', null)}</p>
                </isif>
            </div>
            <div class="col-5">
                <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sales-tax h-line-height--20 b-text-letter-space-01">${pdict.order.totals.salesTax}</p>
            </div>
        </div>
    </isif>
</isif>

<div class="row grand-total-wrap">
    <div class="col-7">
        <p class="h-font-size--18 h-clr--black-1 h-fw--semibold total-label h-line-height--20 b-text-letter-space-005">${Resource.msg('label.estimatedtotal', 'cart', null)}
        </p>
    </div>
    <div class="col-5">
        <p class="text-right h-font-size--18 h-clr--black-1 h-fw--semibold grand-total h-line-height--20 b-text-letter-space-005">${pdict.order.totals.grandTotal}</p>
    </div>
</div>

<div class="review-order-summary">
    <button class="btn btn-primary h-clr--white h-fw--semibold h-font-size--16 place-order-trigger btn-block mt-3 h-line-height--20" type="button" name="button"
        value="place-order">${Resource.msg('button.place.order', 'checkout', null)}
    </button>
</div>
