<iscomment> TODO:Make the methods dynamic from cart page zip input and remove condtion for 0 index</iscomment>
<isset name="shippingAddress" value="${pdict.forms.shippingForm.shippingAddress}" scope="page" />
<input type="hidden" name="update-shipping-method-url" value="${dw.web.URLUtils.url('Checkout-UpdateShippingMethods')}">
<div class="row leading-lines shipping-method-list"
    data-select-shipping-method-url="${URLUtils.https('CheckoutShippingServices-SelectShippingMethod')}"
    data-action-url="${URLUtils.https('CheckoutShippingServices-UpdateShippingMethodsList')}">
    <input name="shipmentUUID" type="hidden" value="${shippingModel.UUID}" />
    <isloop items="${shippingModel.applicableShippingMethods}" var="shippingMethod" status="loopstatus">
        <isif condition="${loopstatus.index === 0}">
            <div class="form-check col-9 start-lines shipping-methods-block pr-0">
                <isinclude template="checkout/shipping/selectedShippingMethod" />
                <label class="form-check-label shipping-method-option"
                    for="shippingMethod-${shippingMethod.ID}-${shippingModel.UUID}${lineItem ? '-' + lineItem.UUID : ''}">
                    <span
                        class="display-name h-font-size--16 h-fw--semibold h-clr--black-1">${shippingMethod.displayName}</span>
                    <isif condition="${shippingMethod.estimatedArrivalTime}">
                        <span
                            class="text-muted arrival-time h-font-size--16">(${shippingMethod.estimatedArrivalTime})</span>
                    </isif>
                </label>
                <div class="shipping-method-description h-clr--gray-4">
                    <isif condition="${shippingMethod.htmlDescription !== ''}">
                        <isprint value="${shippingMethod.htmlDescription}" encoding="off" />
                    <iselse/>
                        ${shippingMethod.description}
                    </isif>
                </div>
            </div>
            <isif condition="${shippingMethod.isFree}">
                <div class="col-3 text-right shipping-method-pricing end-lines">
                    <span class="shipping-cost h-clr--black-1">${Resource.msg('label.free.price', 'cart', null)}</span>
                </div>
            <iselse/>
                <div class="col-3 text-right shipping-method-pricing end-lines">
                    <span class="shipping-cost h-clr--black-1">${shippingMethod.shippingCost}</span>
                    <span style="display:none"
                        class="shipping-cost-discount h-clr--black-1">${shippingMethod.isShippingDiscountPrice}</span>
                </div>
            </isif>
        </isif>
    </isloop>
</div>

<!---------------------------------------------------------------------------------->
<!-- Template used by client to redraw shipping methods                           -->
<!---------------------------------------------------------------------------------->
<div id="shipping-method-template" style="display:none;">
    <div class="form-check col-8 start-lines shipping-methods-block">
        <input type="radio" class="form-check-input"
            id="shippingMethodRadioButton-${shippingModel.UUID}${lineItem ? '-' + lineItem.UUID : ''}">
        <label class="form-check-label shipping-method-option"
            for="shippingMethod-${shippingMethod.ID}-${shippingModel.UUID}${lineItem ? '-' + lineItem.UUID : ''}">
            <span
                class="display-name h-font-size--16 h-fw--semibold h-clr--black-1">${shippingMethod.displayName}</span>
            <span class="text-muted arrival-time h-font-size--16"
                style="display:none;">(${shippingMethod.estimatedArrivalTime})</span>
        </label>
        <div class="shipping-method-description" style="display:none;">
            ${shippingMethod.description}
        </div>
    </div>
    <isif condition="${shippingMethod.isFree}">
        <div class="col-4 text-right shipping-method-pricing end-lines">
            <span class="shipping-cost h-clr--black-1">${Resource.msg('label.free.price', 'cart', null)}</span>
        </div>
    <iselse/>
        <div class="col-4 text-right shipping-method-pricing end-lines">
            <span class="shipping-cost h-clr--black-1">${shippingMethod.shippingCost}</span>
                <span style="display:none"
                    class="shipping-cost-discount h-clr--black-1">${shippingMethod.isShippingDiscountPrice}</span>
        </div>
    </isif>
</div>
