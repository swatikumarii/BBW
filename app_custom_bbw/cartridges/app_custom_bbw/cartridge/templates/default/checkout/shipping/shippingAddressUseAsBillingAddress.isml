<div class="row">
    <div class="col-12">
        <div class="form-group">
            <div class="custom-control custom-checkbox">
                <input class="custom-control-input gift" type="checkbox"
                    id="shippingAddressUseAsBillingAddress-${lineItem ? lineItem.UUID : 'default'}-${shippingModel.UUID}" checked <isprint value="${pdict.forms.shippingForm.shippingAddress.shippingAddressUseAsBillingAddress.attributes}" encoding="off" />
                >
                <label for="shippingAddressUseAsBillingAddress-${lineItem ? lineItem.UUID : 'default'}-${shippingModel.UUID}"
                    class="custom-control-label checkout-checkbox h-font-size--16 h-clr--black-1">
                    ${Resource.msg('check.shipping.billing.same', 'checkout', null)}
                </label>
            </div>
        </div>
    </div>
</div>
