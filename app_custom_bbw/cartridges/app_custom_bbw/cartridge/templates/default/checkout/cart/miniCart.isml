<isset name="miniCart" value="${true}" scope="page" />
<div class="cart container">
    <isif condition="${pdict.reportingURLs && pdict.reportingURLs.length}">
        <isinclude template="reporting/reportingUrls" />
    </isif>
    <div class="mini-cart-content">
        <div class="minicart-header h-pos--relative">
            <span type="button" class="minicart-close-icon h-pos--absolute">
                <img src="${URLUtils.staticURL('/images/close-icon.svg')}" alt="close icon" width="20" />
            </span>
            <h1 class="text-center h-fw--semibold">${Resource.msg('title.my.shopping.cart', 'cart', null)}</h1>
        </div>
        <isslot id="minicart-top-slot" context="global" description="This slot will apper on the top of minicart" />

        <iscomment> Motivator to be added here </iscomment>

        <isif condition="${!session.isCustomerAuthenticated()}">
            <div class="minicart-login row">
                <div class="col-8">${Resource.msg('minicart.login.message', 'cart', null)}</div>
                <div class="col-4">
                    <a href="${URLUtils.url('Login-Show')}" class="border h-bdc--blue h-clr--blue d-block text-center">${Resource.msg('action.customer.login', 'checkout', null)}</a>
                </div>

            </div>
        </isif>
        <iscomment> Motivator to be added here </iscomment>
        <div class="minicart-error cart-error">
            <isif condition="${pdict.valid.error && pdict.items.length !== 0}">
                <div class="alert alert-danger alert-dismissible valid-cart-error fade show" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <img src="${URLUtils.staticURL('/images/close-icon.svg')}" alt="close icon" width="20" />
                    </button>
                    ${pdict.valid.message}
                </div>
            </isif>
        </div>

        <div class="product-summary">
            <isloop items="${pdict.items}" var="lineItem">
                <div class="row">
                    <div class="col-12">
                        <div class="border-bottom">
                            <isif condition="${lineItem.bonusProductLineItemUUID === 'bonus'}">
                                <div
                                    class="card border-0 ${miniCart ? 'bonus-product-line-item' : ''} uuid-${lineItem.UUID}">
                                    <div class="card-body">
                                        <isinclude template="checkout/productCard/bonusProductCard" />
                                    </div>
                                </div>
                            <iselse/>
                                <div class="card border-0 uuid-${lineItem.UUID}">
                                    <div class="card-body">
                                        <isif condition="${lineItem.noProduct === true}">
                                            <isinclude template="checkout/productCard/uncategorizedProductCard" />
                                        <iselse/>
                                            <isinclude template="checkout/productCard/productCard" />
                                        </isif>
                                    </div>
                                </div>
                            </isif>
                        </div>
                    </div>
                </div>
            </isloop>
        </div>
    </div>

    <isinclude template="cart/cartRemoveProductModal" />

    <div class="minicart-footer">
        <div class="row estimated-total">
            <div class="col-8">
                <p class="sub-total-label">${Resource.msg('label.estimatedtotal', 'cart', null)}</p>
            </div>
            <div class="col-4">
                <p class="text-right sub-total">${pdict.totals.subTotal}</p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 checkout-continue">
                <isinclude template="cart/checkoutButtons" />
            </div>
        </div>
    </div>
</div>
