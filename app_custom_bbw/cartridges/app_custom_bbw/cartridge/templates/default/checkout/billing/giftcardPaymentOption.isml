<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/giftcards.js');
</isscript>
<iscomment> Applicable Gift certificate Payment</iscomment>
<isif condition="${!(pdict.isGiftProductAvailable)}">
    <div class="giftcard-payment-content accordion border-top border-bottom" id="giftcard-payment-content">
        <fieldset class="payment-form-fields">
            <input type="hidden" class="redeem-giftcard-url" name="redeem-giftcard-url" value="${pdict.validateGiftCard}" />
            <input type="hidden" class="check-balance-url" name="check-balance-url" value="${pdict.checkGiftCardBalance}" />
            <div class="gift-card-apply">
                <div class="required">
                    <input type="hidden" name="remove-giftcard-url" value="${URLUtils.url('Giftcard-RemoveGiftCard')}">
                    <div class="row no-gutters">
                        <h2 class="gift-cardtitle h-font-size--18 h-fw--bold h-clr--black-1 customer-heading accordion-title d-block col-12 m-0 rotate-down b-text-letter-space-005 h-line-height--20">${Resource.msg('label.add.egift.title', 'giftcards', null)}</h2>
                        <div class="accordion-content col-12 h-maxwidth-perc-md--90" style="display:none">
                            <div class="add-giftcard-header-wrap">
                                <div class="d-flex flex-column justify-content-between added-cards" data-btn-label="${Resource.msg('label.remove.gift.card', 'checkout', null)}">
                                </div>
                                <div class="d-flex justify-content-between add-giftcard-header">
                                    <span>${Resource.msg('giftcard.text.i.have.gc', 'giftcards', null)}</span>
                                    <span class="add-giftcard-button">${Resource.msg('giftcard.add.text', 'giftcards', null)}</span>
                                </div>
                            </div>
                            <div class="m-0 pb-3 row no-gutters add-giftcard-section">
                                <div class="col-12 form-group mb-3">
                                    <label class="form-control-label h-fw--semibold h-font-size--16 b-text-letter-space-01 h-line-height--20">
                                        ${Resource.msg('label.input.egift.number', 'forms', null)}
                                    </label>
                                    <input type="text" id="egift-number" maxlength="16" name="egift-number" class="form-control giftCardNumber mb-2"
                                        data-missing-error="${Resource.msg('payment.giftcard.number.missing', 'forms', null)}" <isprint
                                        value="${pdict.giftCardForm.cardNumber.attributes}" encoding="off" /> />
                                    <div class="invalid-feedback" id="form-giftcard-number-error"></div>
                                </div>

                                <div class="col-12 col-md-5 form-group mb-3">
                                    <label class="form-control-label h-fw--semibold h-font-size--16 b-text-letter-space-01 h-line-height--20">
                                        ${Resource.msg('label.input.egift.cardpin', 'forms', null)}
                                    </label>
                                    <input type="text" id="egift-pin" maxlength="6" name="egift-pin" class="form-control giftCardPin mb-2"
                                        data-missing-error="${Resource.msg('payment.giftcard.pin.missing', 'forms', null)}" <isprint
                                        value="${pdict.giftCardForm.cardPin.attributes}" encoding="off" /> />
                                    <div class="invalid-feedback" id="form-giftcard-cardPin-error"></div>
                                </div>
                                <div class="col-12 mb-4">
                                    <label class="form-control-label h-fw--semibold h-font-size--16 b-text-letter-space-01 h-line-height--20">
                                        ${Resource.msg('label.input.egift.balance', 'forms', null)}
                                    </label>
                                    <div class="row giftcard-balance-section align-items-center no-gutters">
                                        <span class="col-8 col-md-9 giftcard-balance-wrap gift-card-balance-error"></span>
                                        <span id="egift-card-check-balance" class="col-4 col-md-3 h-font-size--14 text-right">${Resource.msg('label.egift.check-balance', 'checkout', null)}</span>
                                    </div>
                                </div>

                                <div class="row giftcard-buttons w-100 no-gutters">
                                    <div class="col-6 gift-apply-btn">
                                        <button name="giftcard-redeem" id="giftcard-redeem" class="giftcard-redeem btn btn-hover btn-primary h-font-size--14"
                                            type="button">${Resource.msg('label.egift.use.this.card', 'checkout', null)}
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <button class="giftcard-cancel-btn btn btn-secondary text-uppercase h-font-size--14" type="button">
                                            ${Resource.msg('label.egift.cancel', 'checkout', null)}
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="gift-redeem-card-error mb-2" style="display: none"></div>
                            <div class="success-toast js-gift-redeem-card-success my-3" style="display: none">${Resource.msg('giftcard.added.redemption.text', 'giftcards', null)}</div>
                            <span class="add-giftcard-text border-bottom">${Resource.msg('giftcard.add.text.description', 'giftcards', null)}</span>
                            <div class="d-flex justify-content-between giftcard-total-wrap">
                                <h2 class="h-font-size--18 h-fw--bold h-clr--black-1">${Resource.msg('label.giftcard.total', 'giftcards', null)}</h2>
                                <h2 class="h-font-size--18 h-fw--bold h-clr--black-1 giftcard-total">${pdict.order.totals.pendingTotal.giftTotal}</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
    <span class="giftcard-full-redemption d-block notification-toast h-fw--normal"></span>
    <span class="giftcard-partial-redemption d-block notification-toast h-fw--normal"></span>
</isif>
