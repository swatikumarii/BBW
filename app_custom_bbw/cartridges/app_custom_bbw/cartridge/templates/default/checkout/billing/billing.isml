<div class="payment-form">
    <h2 class="card-header-custom h-font-size--20 h-fw--bold h-clr--black-1 billing-address-heading b-text-letter-space-005 h-line-height--24 ${!pdict.customer.registeredUser ? 'guest' : 'registered'}">
        ${Resource.msg('heading.billing.address', 'checkout', null)}</h2>
    <form autocomplete="on" class="billing-form" method="POST" action="${URLUtils.url('CheckoutServices-SubmitPayment')}"
        data-address-mode="${!pdict.order.billing.billingAddress.address ? 'new' : 'edit'}" <isprint
        value=${pdict.forms.billingForm.attributes} encoding="off" /> novalidate>


        <fieldset class="billing-address-block">
            <!-------------------------------------------------------------------------->
            <!-- Billing Address Display                                             -->
            <!-------------------------------------------------------------------------->
            <isinclude template="checkout/billing/billingAddressSummary" />


            <!-------------------------------------------------------------------------->
            <!-- Billing Address                                                      -->
            <!-------------------------------------------------------------------------->
            <fieldset class="billing-address">
                <fieldset class="address-selector-block">
                    <div class="form-group billing-select-wrap">

                        <isinclude template="checkout/billing/addressSelector" />
                        <div class="invalid-feedback"></div>
                    </div>
                </fieldset>
                <isinclude template="checkout/billing/billingAddress" />
            </fieldset>

            <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
            <input type="hidden" name="localizedNewAddressTitle"
                value="${Resource.msg('msg.new.address', 'checkout', null)}" />
        </fieldset>

        <!-------------------------------------------------------------------------->
        <!-- Contact Info (Email and Phone)                                       -->
        <!-------------------------------------------------------------------------->

        <fieldset class="contact-info-block">
            <h2 class="card-header-custom h-font-size--20 h-fw--bold h-clr--black-1 billing-address-heading pt-0 b-text-letter-space-005 h-line-height--24">
                ${Resource.msg('heading.contact.info', 'checkout', null)}</h2>
            <div class="row pt-3">
                <div class="col-sm-12">
                    <div class="form-group phone-number-wrapper
                            <isif condition=${pdict.forms.billingForm.contactInfoFields.phone.mandatory === true}>required</isif>
                            ${pdict.forms.billingForm.contactInfoFields.phone.htmlName}">
                        <label class="h-font-size--16 h-fw--semibold h-clr--black-1 form-control-label h-line-height--20 b-text-letter-space-01" for="phoneNumber"><span class="h-clr--red-9">${'* '}</span>${Resource.msg('field.customer.phone.number', 'checkout', null)}</label>

                        <input type="tel" class="form-control phone" id="phoneNumber" initOptions.allowDropdown="true"
                            value="${pdict.order.billing.billingAddress.address ? pdict.order.billing.billingAddress.address.phone || '' : ''}"
                            aria-describedby="phoneInvalidMessage"
                            data-missing-error="${Resource.msg('error.phone.missing', 'forms', null)}"
                            data-pattern-mismatch="${Resource.msg('error.message.pattern.phone', 'forms', null)}"
                            <isprint value="${pdict.forms.billingForm.contactInfoFields.phone.attributes}" encoding="off" /> >
                        <div class="invalid-feedback" id="phoneInvalidMessage"></div>
                    </div>
                </div>
            </div><div class="row ">
                <div class="col-sm-12">
                    <div class="form-group info-billing mt-3
                                        <isif condition=${pdict.forms.billingForm.contactInfoFields.email.mandatory === true}>required</isif>
                                        ${pdict.forms.billingForm.contactInfoFields.email.htmlName}">
                        <div class="d-flex justify-content-between">
                            <label class="h-font-size--16 h-fw--semibold h-clr--black-1 form-control-label h-line-height--20 b-text-letter-space-01 " for="email"><span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.customer.email', 'checkout', null)}</label>
                            <span class="required-indicator-text h-clr--black-1 h-font-size--14 h-line-height--20 b-text-letter-space-01"><span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('label.required', 'account', null)}</span>
                        </div>
                        <input type="text" class="form-control email" id="contactEmail"
                            value="${pdict.userEmail}"
                            <isprint value=${pdict.forms.billingForm.contactInfoFields.email.attributes} encoding="off" />
                            data-missing-error="${Resource.msg('error.email.address', 'forms', null)}"
                            data-pattern-mismatch="${Resource.msg('valid.email.address', 'forms', null)}"
                        aria-describedby="emailInvalidMessage" >
                        <span class="info-icon info-icon">
                            <img src="${URLUtils.staticURL('/images/i-icon-gray.svg')}" alt="info icon" class="info-icon-img-gray"
                                width="10px" />
                            <img src="${URLUtils.staticURL('/images/i-icon-white.svg')}" alt="info icon" class="info-icon-img-white"
                                width="10px" />
                        </span>
                        <div class="info-icon-text info-icon-text">
                            <iscontentasset aid="email-info-icon-content" />
                        </div>
                        <div class="info-icon-border-arrow-outline"></div>
                        <div class="info-icon-border-arrow"></div>
                        <div class="invalid-feedback" id="emailInvalidMessage"></div>
                    </div>
                </div>
            </div>
        </fieldset>


        <!-------------------------------------------------------------------------->
        <!-- Promocode                                                      -->
        <!-------------------------------------------------------------------------->
        <fieldset>
            <isinclude template="checkout/billing/promocode" />
        </fieldset>

        <!-------------------------------------------------------------------------->
        <!-- Giftcard Payment                                                      -->
        <!-------------------------------------------------------------------------->
        <fieldset>
            <isinclude template="checkout/billing/giftcardPaymentOption" />
        </fieldset>

        <!-------------------------------------------------------------------------->
        <!-- Payment Options                                                      -->
        <!-------------------------------------------------------------------------->
        <fieldset>
            <h2 class="card-header-custom h-font-size--20 h-fw--bold h-clr--black-1 payment-options-heading h-mt--40 b-text-letter-space-005 h-line-height--24">
                ${Resource.msg('heading.payment.methods', 'checkout', null)}</h2>
            <div class="payment-options-wrapper">
                <iscontentasset aid="checkout-billing-payment-methods-icons"/>
            </div>
            <isinclude template="checkout/billing/paymentOptions" />
        </fieldset>

    </form>
</div>
