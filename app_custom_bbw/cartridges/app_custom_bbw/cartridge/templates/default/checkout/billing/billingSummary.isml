<isif condition="${pdict.order.billing.billingAddress.address !== null}">
    <isset name="address" value="${pdict.order.billing.billingAddress.address}" scope="page"/>
    <iselse>
    <isset name="address" value="{}" scope="page"/>
</isif>

<div class="summary-details billing">
    <span class="summary-section-label billing-addr-label d-block mb-2 h-clr--black-1 h-fw--bold">${Resource.msg('label.order.billing.address', 'order', null)}</span>
     <isinclude template="checkout/addressSummary" />
    <isif condition="${pdict.order.billing.billingAddress.address !== null}">
        <span class="order-summary-phone h-font-size--16">
        <isif condition="${!pdict.expressCheckout && pdict.order.billing.billingAddress.address.dialCode}">${Resource.msg('order.phone.dialcode', 'order', null)}${pdict.order.billing.billingAddress.address.dialCode}</isif>
        ${pdict.order.billing.billingAddress.address.phone}</span>
        <iselse>
        <span class="order-summary-phone"></span>
    </isif>
    <isif condition="${pdict.order.orderEmail}">
        <div><span class="order-summary-emailaddress h-font-size--16">${pdict.order.orderEmail}</span></div>
    </isif>
</div>

<!--- Payment information --->
<div class="summary-details">
    <span class="summary-section-label payment-info-label d-block mb-2 h-clr--black-1 h-fw--bold">${Resource.msg('label.order.payment.info', 'order', null)}</span>
    <isinclude template="checkout/billing/paymentOptions/paymentOptionsSummary" />
</div>
<iscomment> ### Custom Adyen cartridge start ### </iscomment>
<isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue("enableAdyen")}">
    <isinclude template="adyenActionModal" />
</isif>
<iscomment> ### Custom Adyen cartridge end ### </iscomment>
    <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Checkout-Begin', 'stage', 'payment')}" class="edit-button pull-right h-clr--black-1 "
    aria-label="${Resource.msg('action.edit.step.msg.shipping', 'checkout', null)}">${Resource.msg('action.edit.step', 'checkout', null)}</a>
