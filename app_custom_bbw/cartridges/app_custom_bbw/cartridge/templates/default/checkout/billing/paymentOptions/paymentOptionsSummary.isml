<div class="payment-details">
    <isloop items="${pdict.order.billing.payment.selectedPaymentInstruments}" var="payment">
        <isif condition="${payment.paymentMethod == 'AdyenPOS' || payment.paymentMethod == 'AdyenComponent' || payment.paymentMethod ===
                         'CREDIT_CARD'}">
            <isinclude template="checkout/billing/paymentOptions/adyenComponentSummary" />
            <iselseif
                condition="${payment.paymentMethod === 'CASHAPPPAY' || payment.paymentMethod === 'CLEARPAY' || payment.paymentMethod === 'AFTERPAY'}" />
            <isinclude template="checkout/billing/paymentOptions/afterpaySummary" />
        </isif>
        <isif condition="${payment.amount}">
            <div class="payment-amount h-fw--bold">
                <span class="label h-clr--black-1">
                    <isif condition="${pdict.order.currencyCode}">
                        ${pdict.order.currencyCode} <isprint value="${payment.amount}" />
                    <iselse/>
                        <isprint value="${payment.amount}" />
                    </isif>
                </span>
            </div>
        </isif>
    </isloop>
</div>
