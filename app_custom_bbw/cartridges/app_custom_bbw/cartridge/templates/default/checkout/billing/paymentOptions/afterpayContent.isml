<div class="tab-pane ${paymentOption.ID.toLowerCase() + '-content'} d-block afterpay-tab active"
    id="${paymentOption.ID.toLowerCase() + '-content'}" role="tabpanel">
    <div>
        <isscript>
            var apBrandUtilities = require('*/cartridge/scripts/util/afterpayUtilities').brandUtilities;
            var countryCodeValue = apBrandUtilities.getCountryCode();
        </isscript>
        <square-placement data-mpid="${pdict.priceContext.apMpid}" data-type="logo"
            data-amount="${pdict.priceContext.totalPrice}" data-page-type="checkout"
            data-currency="${session.currency.getCurrencyCode()}"></square-placement>
        <input name="brandCode" type="radio" value="afterpay" />
    </div>
    <fieldset class="payment-form-fields">
        <input type="hidden" class="form-control" name="${pdict.forms.billingForm.paymentMethod.htmlName}"
            value="AFTERPAY">
        <input type="hidden" class="form-control" name="${pdict.customForms.afterpayForm.isAfterpayUrl.htmlName}"
            value="${URLUtils.url('AfterpayRedirect-IsAfterpay')}">
        <input type="hidden" class="form-control" name="${pdict.customForms.afterpayForm.redirectAfterpayUrl.htmlName}"
            value="${URLUtils.url('AfterpayRedirect-Redirect')}">
    </fieldset>
    <div class="additionalFields afterpay-emi" style="display:none">
        <!-- Display Afterpay Widget during Express Checkout finalization -->
        <isinclude template="product/components/afterpaywidget" />
        <isif condition="${ecFinalize}">
            <div class="ap-checkout-pay-tab-ecf ap-checkout-pay-tab-noecf ap-checkout-po-ecf">
                <div id="afterpay-widget-container"></div>
            </div>
        <iselse/>
            <div class="ap-checkout-pay-tab-noecf">
                <input type="hidden" class="checkout-widget"
                    value="${URLUtils.https('AfterpayWidget-updateCheckoutWidget')}">
                <div class="afterpay-checkout-widget"></div>
            </div>
        </isif>
    </div>
    <!-- Display Cash App Pay Popup -->
    <div class="cap-checkout-content">
        <isinclude template="product/components/cashappwidget" />
        <div id="cash-app-pay"></div>
    </div>
</div>
