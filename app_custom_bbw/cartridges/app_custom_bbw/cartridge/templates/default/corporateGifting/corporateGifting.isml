<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
    </isscript>
    <div class="hero">
        <h1 class="page-title">${Resource.msg('title.hero.text','corporateGifting',null)}</h1>
    </div>
    <div class="container corporate-gifting-landing-page">
        <div class="row justify-content-center">
            <div class="col-sm-8 col-md-6">
                <div class="card">
                    <div class="card-body">
                        <form action="${pdict.actionUrl}" class="corporate-gifting" method="POST" name="corporate-gifting">
                            <!--- corporate gifting us first name, last name --->
                            <div class="row corporate-gifting-name">
                                <div class="col-sm-6">
                                    <div class="form-group required">
                                        <label class="form-control-label" for="corporate-gifting-first-name">
                                            ${Resource.msg('label.input.corporate-gifting-first-name', 'corporateGifting', null)}
                                        </label>
                                        <input type="text" required class="form-control required"
                                            aria-describedby="form-corporate-gifting-first-name-error" id="corporate-gifting-first-name"
                                            name="corporateGiftingFirstName">
                                        <div class="invalid-feedback" id="form-corporate-gifting-first-name-error"></div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="form-group required">
                                        <label class="form-control-label" for="corporate-gifting-last-name">
                                            ${Resource.msg('label.input.corporate-gifting-last-name', 'corporateGifting', null)}
                                        </label>
                                        <input type="text" required class="form-control required"
                                            aria-describedby="form-corporate-gifting-last-name-error" id="corporate-gifting-last-name"
                                            name="corporateGiftingLastName">
                                        <div class="invalid-feedback" id="form-corporate-gifting-last-name-error"></div>
                                    </div>
                                </div>
                            </div>
                            <!--- corporate gifting us email --->
                            <div class="row corporate-gifting-email">
                                <div class="col">
                                    <div class="form-group required">
                                        <label class="form-control-label" for="corporate-gifting-email">
                                            ${Resource.msg('label.input.corporate-gifting-email', 'corporateGifting', null)}
                                        </label>
                                        <input type="email" required class="form-control required"
                                            aria-describedby="form-corporate-gifting-email-error" id="corporate-gifting-email"
                                            name="corporateGiftingEmail">
                                        <div class="invalid-feedback" id="form-corporate-gifting-email-error"></div>
                                    </div>
                                </div>
                            </div>
                            <!--- corporate gifting us topic --->
                            <div class="row corporate-gifting-topic">
                                <div class="col">
                                    <div class="form-group">
                                        <label class="form-control-label" for="corporate-gifting-topic">
                                            ${Resource.msg('label.input.corporate-gifting-topic', 'corporateGifting', null)}
                                        </label>
                                        <select type="text" required class="form-control required" id="corporate-gifting-topic"
                                            name="corporateGiftingTopic">
                                            <option value="GY">
                                                ${Resource.msg('label.input-corporate-gifting-gym', 'corporateGifting', null)}
                                            </option>
                                            <option value="RE">
                                                ${Resource.msg('label.input-corporate-gifting-restaurant', 'corporateGifting', null)}
                                            </option>
                                            <option value="HT">
                                                ${Resource.msg('label.input-corporate-gifting-hotel', 'corporateGifting', null)}
                                            </option>
                                            <option value="SB">
                                                ${Resource.msg('label.input-corporate-gifting-small-business', 'corporateGifting', null)}
                                            </option>
                                            <option value="EN">
                                                ${Resource.msg('label.input-corporate-gifting-enterprise', 'corporateGifting', null)}
                                            </option>
                                            <option value="O">
                                                ${Resource.msg('label.input-corporate-gifting-other', 'corporateGifting', null)}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <!--- corporate gifting us comment --->
                            <div class="row corporate-gifting-comment">
                                <div class="col">
                                    <div class="form-group">
                                        <label class="form-control-label" for="corporate-gifting-comment">
                                            ${Resource.msg('label.input.corporate-gifting-comment', 'corporateGifting', null)}
                                        </label>
                                        <textarea class="form-control" id="corporate-gifting-comment" name="corporateGiftingComment" rows="4"
                                            maxlength="250"></textarea>
                                    </div>
                                </div>
                            </div>
                            <!--- corporate gifting us submit --->
                            <div class="row corporate-gifting-submnit">
                                <div class="col-sm-6">
                                </div>
                                <div class="col">
                                    <div class="form-group">
                                        <button class="btn btn-block btn-primary subscribe-corporate-gifting" type="submit"
                                            name="submit" value="submit">
                                            ${Resource.msg('label.input.corporate-gifting-submit', 'corporateGifting', null)}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</isdecorate>
