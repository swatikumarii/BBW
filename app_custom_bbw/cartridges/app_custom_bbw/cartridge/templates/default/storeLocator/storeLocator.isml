<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        if (pdict.stores.googleMapsApi) {
            assets.addJs(pdict.stores.googleMapsApi);
        }
        assets.addJs('/js/storeLocator.js');
        assets.addCss('/css/storeLocator.css');
    </isscript>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="store-locator-header d-flex justify-content-between align-items-center">
                    <p class="h-font-size--24 h-fw--bold mb-0 h-clr--black-1">${Resource.msg('store.heading', 'storeLocator', null)}</p>
                    <img class="logos-main powered-google" alt="${Resource.msg('global.storename', 'common', null)}"
                        src="${URLUtils.staticURL('/images/store-locator/powered-by-google.webp')}" />
                </div>
            </div>
        </div>
    </div>

    <isinclude template="storeLocator/storeLocatorNoDecorator" />
</isdecorate>
