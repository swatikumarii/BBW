<div class="store-details map-details" data-store-id="${store.ID}">
<div class="form-check-label">
    <div class="card border-0 p-0" data-store-id="${store.ID}">
        <div class="card-head" id="${store.ID}">
            <h2 class="mb-0 store-name map-name h-font-size--14 h-fw--bold h-clr--black-1 text-uppercase" aria-expanded="true">
                ${store.name}
            </h2>
        </div>
        <div class="store-detail show" aria-labelledby="${store.ID}">
        <div class="card-body h-font-size--14">
            <div class="row">
                <div class="col">
                    <div class="store-address">
                        <span class="text-uppercase">
                            ${store.address1}
                            <isif condition="${store.address2}">
                                ${store.address2}
                            </isif>
                            <isif condition="${store.city}">
                                ${store.city},
                            </isif>
                            <isif condition="${store.stateCode}">
                                ${store.stateCode}
                            </isif>
                            ${store.postalCode}
                        </span>
                    </div>

                    <div class="store-phone">
                        <isif condition="${store.phone}">
                            <span>${store.phone}</span>
                        </isif>
                    </div>

                    <div class="store-direction">
                        <a class="h-fw--semibold h-clr--black-1" target='_blank'
                            hreflang="${request.getLocale()}" href="${store.storeMapLink}">
                            ${Resource.msg('label.get.directions', 'storeLocator', null)}
                        </a>
                    </div>

                </div>
            </div>
        </div>
        </div>
    </div>
</div>
</div>
