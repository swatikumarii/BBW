<isinclude template="/components/modules" sf-toolkit="off" />
<script defer type="text/javascript" src="${pdict.googleMapsApi}"></script>
<script defer type="text/javascript" src="${URLUtils.staticURL('/js/storeLocatorDetail.js').toString()}"></script>
<link rel="stylesheet" href="${URLUtils.staticURL('/css/storeLocator.css').toString()}" />

<div class="h-maxwidth--1400 mx-auto store-detail-page">
    <div class="row">
        <div class="col-md-12">
            <h1 class="text-center m-0 text-uppercase h-fw--bold h-bg--gray-1">Bath & body works one utama</h1>
        </div>
    </div>
    <div class="row">
        <div class="col-md-7 store-details my-3 my-md-5" data-store-id="${pdict.storeDetail.ID}">
            <div class="store-map-details">
                <div class="store-name h-font-size--18 h-fw--bold h-clr--black-1 mb-4">
                    ${pdict.storeDetail.name}</div>
                <address class="h-clr--black-1">
                    <div class="store-hours mt-2">
                        <isif condition="${pdict.storeDetail.storeHours}">
                            <isprint value="${pdict.storeDetail.storeHours}" encoding="off" />
                        </isif>
                    </div>
                    <a class="store-map h-clr--gray-4" target='_blank'
                        href="https://maps.google.com/?daddr=${pdict.storeDetail.latitude},${pdict.storeDetail.longitude}">
                        ${pdict.storeDetail.address1}
                        <isif condition="${pdict.storeDetail.address2}">
                            ${pdict.storeDetail.address2}
                        </isif>
                        <isif condition="${pdict.storeDetail.city}">
                            ${pdict.storeDetail.city},
                        </isif>
                        <isif condition="${pdict.storeDetail.stateCode}">
                            ${pdict.storeDetail.stateCode}
                        </isif>
                        ${pdict.storeDetail.postalCode}
                    </a>

                    <p>
                        <isif condition="${pdict.storeDetail.phone}">
                            <i class="fa fa-phone" aria-hidden="true"></i>
                            <span>
                                <a class="storelocator-phone"
                                    href="tel:${pdict.storeDetail.phone}">${pdict.storeDetail.phone}</a>
                            </span>
                        </isif>
                    </p>
                </address>
                <p class="open-now d-flex align-items-center h-clr--black-1"><span class="h-bg--green"></span>Open Now -
                    Closes At 20:00Pm</p>
                <div class="phone-email d-flex">
                    <p class="phone h-clr--black-1"><i class="fa fa-phone mr-2"></i>+60376127980</p>
                    <a href="#" class="email h-clr--black-1"><i
                            class="fa fa-envelope-o mr-2"></i>bbw.1utama@valiram.com</a>
                </div>
                <button class="text-uppercase get-direcetion">${Resource.msg('label.get.direction', 'storeLocator', null)}</button>
            </div>
        </div>
        <div class="col-md-5 my-4">
            <div class="store-carousel">
                <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img width="100%" alt="image" src="${URLUtils.staticURL('/images/store-locator/store1.png')}" />
                        </div>
                        <div class="carousel-item">
                            <img width="100%" alt="image" src="${URLUtils.staticURL('/images/store-locator/store1.png')}" />
                        </div>
                        <div class="carousel-item">
                            <img width="100%" alt="image" src="${URLUtils.staticURL('/images/store-locator/store1.png')}" />
                        </div>
                    </div>
                    <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="sr-only">Previous</span>
                    </a>
                    <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="sr-only">Next</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="jumbotron map-canvas" id="mapfordetail"
                data-has-google-api="${pdict.googleMapsApi ? true : false}"
                data-locations="${pdict.storeDetail.locations}" data-latitude="${pdict.storeDetail.latitude}"
                data-longitude="${pdict.storeDetail.longitude}">
                <div class="container">
                    <div class="row">
                        <p class="store-locator-no-api-key alert alert-danger">
                            ${Resource.msg('error.no.api.key', 'storeLocator', null)}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h1 class="text-center m-0 text-capitalize h-fw--bold h-bg--gray-1">Store nearby</h1>
        </div>
    </div>
    <div class="nearby-store">
        <div class="near-by-wrap">
            <div class="near-stores">
                <img alt="image" src="${URLUtils.staticURL('/images/store-locator/store.png')}" />
                <p class="h-clr--black-1 h-fw--semibold">Bath & Body Works</p>
                <button class="text-uppercase get-direcetion w-100 mt-0">${Resource.msg('label.get.direction', 'storeLocator', null)}</button>
            </div>
            <div class="near-stores">
                <img alt="image" src="${URLUtils.staticURL('/images/store-locator/store.png')}" />
                <p class="h-clr--black-1 h-fw--semibold">Bath & Body Works</p>
                <button class="text-uppercase get-direcetion w-100 mt-0">${Resource.msg('label.get.direction', 'storeLocator', null)}</button>
            </div>
            <div class="near-stores">
                <img alt="image" src="${URLUtils.staticURL('/images/store-locator/store.png')}" />
                <p class="h-clr--black-1 h-fw--semibold">Bath & Body Works</p>
                <button class="text-uppercase get-direcetion w-100 mt-0">${Resource.msg('label.get.direction', 'storeLocator', null)}</button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <iscontentasset aid="store-detail" />
        </div>
    </div>
</div>
