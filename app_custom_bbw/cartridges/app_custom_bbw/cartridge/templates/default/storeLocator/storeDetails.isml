<isset name="STORE_DETAIL_URL" value="${URLUtils.url('Page-Show', 'cid', store.ID)}" scope="PAGE" />
<div class="card store-details border-0 p-0" data-store-id="${store.ID}">
    <div class="card-head results-store-name" data-store-title="${store.name}" id="${store.ID}">
        <h2 class="mb-0 store-name store-accordian-element-heading ${loopState.count == 1 ? "not-collapsed" : "collapsed"} cursor-pointer"
            data-toggle="collapse" data-target="${'#collapse' + store.ID}" aria-expanded="true" aria-controls="collapseOne">
            <div class="store-head-heading h-font-size--18 h-fw--bold h-clr--black-1 text-uppercase "><span>${loopState.count}.</span>${store.name}</div>
            <div class="store-head-distance">${Resource.msg('label.distance', 'storeLocator', null)} <span class="h-fw--bold"><isprint value="${store.distance}" encoding="off" />${Resource.msg('label.km', 'storeLocator', null)}</span>
            </div>
        </h2>
    </div>
    <div id="${'collapse' + store.ID}" class="collapse store-accordian-element-div ${loopState.count == 1 ? "show" : "not-show"}" aria-labelledby="${store.ID}" data-parent="#accordion">
        <div class="card-body h-font-size--16">
            <div class="row">
                <div class="col">
                    <div class="store-address">
                        <span class="text-uppercase d-block">
                            ${store.address1}</span>
                        <span class="d-block">
                            <isif condition="${store.address2}">
                                ${store.address2}
                            </isif>
                            <isif condition="${store.city}">
                                ${store.city},
                            </isif>
                            <isif condition="${store.stateCode}">
                                ${store.stateCode}
                            </isif>
                            ${store.postalCode}
                        </span>
                    </div>

                    <div class="store-phone">
                        <isif condition="${store.phone}">
                            <span>${store.phone}</span>
                        </isif>
                    </div>

                    <div class="store-direction">
                        <a class="h-fw--semibold h-clr--black-1" target='_blank'
                            hreflang="${request.getLocale()}" href="${store.storeMapLink}">
                            ${Resource.msg('label.get.directions', 'storeLocator', null)}
                        </a>
                        <a class="h-fw--semibold h-clr--black-1 mt-1 d-block" target='_blank'
                            hreflang="${request.getLocale()}" href="${STORE_DETAIL_URL}">
                            ${Resource.msg('label.get.details', 'storeLocator', null)}
                        </a>
                    </div>

                    <iscomment> <div class="store-events h-clr--blue-4">
                        <span>${Resource.msg('label.store.pickup', 'storeLocator', null)}</span>
                    </div> </iscomment>
                </div>

                <div class="col">
                    <div class="store-hours d-block">
                        <isif condition="${store.storeHours}">
                            <isprint value="${store.storeHours}" encoding="off" />
                        </isif>
                    </div>
                </div>
                <div class="col">
                    <div class="store-distance">
                        <isif condition="${store.distance}">
                            <span class="distance-left">${Resource.msg('label.distance', 'storeLocator', null)}</span>
                            <strong><isprint value="${store.distance}" encoding="off" /></strong>
                            <span class="distanc-right">${Resource.msg('label.km', 'storeLocator', null)}</span>
                        </isif>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
