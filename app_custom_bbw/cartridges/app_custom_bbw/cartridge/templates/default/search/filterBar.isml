<ul class="list-unstyled h-mb--15 h-mt--15">
    <isloop items="${pdict.productSearch.selectedFilters}" var="selectedfilter">
        <isif condition="${selectedfilter.type === 'color'}">
            <li class="swatch-filter swatch-filter-${selectedfilter.presentationId}">
                <button data-href="${selectedfilter.url}"
                    data-seo-href="${selectedfilter.seoRefineUrl || selectedfilter.url}" class="btn">
                    <span class="sr-only">
                        ${Resource.msgf('assistive.text.remove.filter.button', 'search', null, selectedfilter.title)}
                    </span>
                </button>
            </li>
        <iselse/>
            <isif condition="${selectedfilter.id == refinement.id}">
                <li class="filter-value filter-selected">
                    <button data-href="${selectedfilter.url}" data-seo-href="${selectedfilter.seoRefineUrl}"
                        data-fil="${selectedfilter.presentationId} ${refinement.displayName}"
                        class="text-left btn-no-style filter-selected__btn position-relative  h-bg-md-down--gray-1 h-bg-md--white h-clr--black-3 h-font-size--14 h-mb--10">
                        <div class="d-flex align-items-center justify-content-between">
                            <span aria-hidden="true">${selectedfilter.displayValue}</span>
                            <img class="h-ml--15" src="${URLUtils.staticURL('/images/icons/UI-Close-dark.svg')}"
                                alt="${Resource.msgf('assistive.text.remove.filter.button', 'search', null, selectedfilter.title)}"
                                width="17px" height="17px" />
                        </div>
                        <span class="sr-only">
                            ${Resource.msgf('assistive.text.remove.filter.button', 'search', null, selectedfilter.title)}
                        </span>
                    </button>
                </li>
            </isif>
        </isif>
    </isloop>
</ul>
