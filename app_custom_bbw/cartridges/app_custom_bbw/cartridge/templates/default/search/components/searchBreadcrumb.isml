<div class="row search__breadcrumb-wrapper no-gutters h-maxwidth--1400 mx-auto">
    <div class="col-12">
        <div class="search__breadcrumb d-flex">
            <isloop items="${pdict.breadcrumbs}" var="breadcrumbValue" status="loopState">
                <isif condition="${loopState.last}">
                    <div class="search__breadcrumb__category-name">
                        <span class="${pdict.productSearch.isCategorySearch ? 'h-clr--gray-4' : 'h-clr--black-1'}">
                            <isprint value="${breadcrumbValue.htmlValue}" encoding="off" />
                        </span>
                    </div>
                <iselse/>
                    <div class="search__breadcrumb__home-link d-flex flex-nowrap">
                        <a class="b-link--underlined h-clr--gray-4" href="${breadcrumbValue.url}" hreflang="${request.getLocale()}">${breadcrumbValue.htmlValue}</a>
                    </div>
                </isif>
            </isloop>
        </div>
    </div>
</div>
