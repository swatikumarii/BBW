<div class="row no-gutters search-results__top-header justify-content-beetween">
    <div class="col">
        <isif condition="${pdict.productSearch.isRefinedCategorySearch && pdict.productSearch.category.id === 's-fragrance'}">
            <h1 class="search-results__top-header__category-name h-clr--black-1 h-fw--bold h-mb--0 h-mb-sm-down--0">
                ${pdict.productSearch.selectedFilters[0].displayValue}</h1>
        <iselseif condition="${pdict.productSearch.isCategorySearch}" />
            <h1 class="search-results__top-header__category-name h-clr--black-1 h-fw--bold h-mb--0 h-mb-sm-down--0">
                ${pdict.productSearch.promotionTitle ? pdict.productSearch.promotionTitle : pdict.productSearch.category.name}</h1>
                ${pdict.productSearch.promotionDescription}
        <iselse/>
            <h1 class="search-results__top-header__category-name h-clr--black-1 h-fw--bold h-mb--0 h-mb-sm-down--0"> ${Resource.msg('title.search.result.page', 'search', null)}</h1>
        </isif>
    </div>
    <div class="col search-results__top-header__pagination d-none d-md-flex justify-content-end align-items-center">
        <isif condition="${require('*/cartridge/config/seoPreferences').enablePLPPagination}">
            <isinclude template="search/pagination" />
        </isif>
    </div>
</div>
