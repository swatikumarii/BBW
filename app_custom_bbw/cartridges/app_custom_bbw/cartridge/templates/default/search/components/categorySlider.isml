<nav data-cgid="${pdict.productSearch.category.id}">
    <isloop items="${pdict.productSearch.levelOneCategory.onlineSubCategories}" var="levelTwoCategory">
        <isloop items="${levelTwoCategory.onlineSubCategories}" var="levelThreeCategory">
            <a href="${URLUtils.url('Search-Show', 'cgid', levelThreeCategory.ID)}"
                data-cgid="${levelThreeCategory.ID}">
                <img src="${levelThreeCategory.thumbnail.absURL}" alt="${levelThreeCategory.name}" />
                <div class="navigation-label">
                    ${levelThreeCategory.displayName}
                </div>
            </a>
        </isloop>
    </isloop>
</nav>
