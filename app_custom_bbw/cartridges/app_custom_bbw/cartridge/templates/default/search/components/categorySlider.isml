<nav class="d-flex ds-smooth-scroll flex-nowrap h-mb--30 h-pl--30 h-pr--30 plp-category-swiper position-relative row" data-cgid="${pdict.productSearch.category.id}">
    <div class="w-100 overflow-hidden h-pr--5" id="plp-swiper">
        <div class="swiper-wrapper">
            <isloop items="${pdict.productSearch.levelOneCategory.levelTwoCategories}" var="levelTwoCategory">
                <isloop items="${levelTwoCategory.levelThreeCategories}" var="levelThreeCategory">
                    <isif condition="${levelThreeCategory.isShowCategoryInSlider}">
                        <div class="swiper-slide">
                            <a class="plp-category-swiper__link rounded b-text-h2 h-fw--medium text-center d-flex flex-column js-category-swiper ${pdict.productSearch.category.id === levelThreeCategory.ID ? 'active' : ''}" hreflang="${pdict.hrefLang}" href="${URLUtils.url('Search-Show', 'cgid', levelThreeCategory.ID)}"
                                data-cgid="${levelThreeCategory.ID}">
                                <img class="plp-category-swiper__image card-img-top mx-auto border-0 lazy" width="100%" height="156.67" data-src="${levelThreeCategory.absURL}" alt="${levelThreeCategory.displayName}" />
                                <div class="navigation-label plp-category-swiper__name h-fw--semibold h-font-size--16 d-flex justify-content-center align-items-center h-100">
                                    ${levelThreeCategory.displayName}
                                </div>
                            </a>
                        </div>
                    </isif>
                </isloop>
            </isloop>
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>
</nav>
