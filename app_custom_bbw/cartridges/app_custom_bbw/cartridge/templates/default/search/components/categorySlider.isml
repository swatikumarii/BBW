<nav class="plp-category-swiper ds-smooth-scroll d-flex flex-nowrap row h-mb--30"
    data-cgid="${pdict.productSearch.category.id}">
    <div class="w-100 overflow-hidden position-relative" id="plp-swiper">
        <div class="swiper-wrapper">
            <isloop items="${pdict.productSearch.levelOneCategory.onlineSubCategories}" var="levelTwoCategory">
                <isloop items="${levelTwoCategory.onlineSubCategories}" var="levelThreeCategory">
                    <isif
                        condition="${levelThreeCategory && levelThreeCategory.custom && levelThreeCategory.custom.showInMenu && levelThreeCategory.products
                                   .empty == false && levelThreeCategory.onlineProducts.empty == false && (levelThreeCategory.custom
                                       .showCategoryInSlider == null || levelThreeCategory.custom.showCategoryInSlider)}">
                        <div class="swiper-slide">
                            <a class="plp-category-swiper__link rounded b-text-h2 h-fw--medium text-center d-flex flex-column js-category-swiper ${pdict.productSearch.category.id === levelThreeCategory.ID ? 'active' : ''}"
                                hreflang="${pdict.hrefLang}"
                                href="${levelThreeCategory.custom && levelThreeCategory.custom.categoryIDForURL ? URLUtils.url('Search-Show', 'cgid',
                                      levelThreeCategory.custom.categoryIDForURL) : URLUtils.url('Search-Show', 'cgid', levelThreeCategory.ID)}"
                                data-cgid="${levelThreeCategory.ID}">
                                <img class="plp-category-swiper__image card-img-top mx-auto border-0 lazy" width="100%"
                                    height="156.67" data-src="${levelThreeCategory.thumbnail.absURL}"
                                    alt="${levelThreeCategory.name}" />
                                <div
                                    class="navigation-label plp-category-swiper__name h-fw--semibold h-font-size--16 d-flex justify-content-center align-items-center h-100">
                                    ${levelThreeCategory.displayName}
                                </div>
                            </a>
                        </div>
                    </isif>
                </isloop>
            </isloop>
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>
</nav>
