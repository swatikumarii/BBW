<link rel="stylesheet" hreflang="${request.getLocale()}" href="${URLUtils.staticURL('/css/marketingTiles.css').toString()}" />
<isloop items="${pdict.productSearch.productIds}" var="product" status="loopState">
    <isinclude template="search/components/customPlpPromotionTilesBefore" />
    <div class="col product-grid-item">
        <isobject object="${product.productSearchHit}" view="searchhit">
            <isinclude url="${URLUtils.url('Tile-Show', 'pid', product.productID, 'swatches', true, 'ratings', true, 'cgid', pdict.cgid,'plp',true)}" />
        </isobject>
    </div>
    <isinclude template="search/components/customPlpPromotionTilesAfter" />
</isloop>
<isinclude template="product/components/removeGiftLineItem" />
