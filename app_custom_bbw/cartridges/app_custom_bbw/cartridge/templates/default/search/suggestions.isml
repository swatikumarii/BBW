<div class="suggestions d-flex h-grid-gap-md--20">
    <isif condition="${!pdict.suggestions.product || !pdict.suggestions.product.available}">
        <div class="content h-width-perc--100">
            <isslot id="search-popular-picks" description="Slot search popular pick for 0 search results"
                context="global" />
        </div>
    </isif>
    <div class="suggestions__products-wrapper h-width-perc-md--80">
        <div class="suggestions__search-product-header d-flex justify-content-between my-2">
            <isif condition="${pdict.suggestions.product && pdict.suggestions.product.phrases.length > 0}">
                <isloop items="${pdict.suggestions.product.phrases}" var="phrase" status="listindex">
                    <div class="items" id="phrase-1-${listindex.index}" role="option">
                        <div class="item term">
                            <isif condition="${!phrase.exactMatch}">
                                <span>Results For &quot;</span><a
                                    href="${URLUtils.url('Search-Show', 'q', phrase.value)}">${phrase.value}</a>&quot;
                            </isif>
                        </div>
                    </div>
                </isloop>
                <a data-viewall="" href="" class="viewall-link h-clr--blue-1 h-fw--semibold">View All</a>
            <iselse/>
                <div class="row no-gutters header">
                    <div class="col">
                        <h2>${Resource.msg('label.suggest.products', 'search', null)}</h2>
                    </div>
                </div>
                <iscomment>
                    <isif condition="${pdict.suggestions.product && pdict.suggestions.product.available}">
                    </isif>
                </iscomment>
            </isif>
        </div>
        <div role="listbox" id="search-results" class="suggestions__results">
            <isif condition="${pdict.suggestions.product && pdict.suggestions.product.available}">
                <div class="h-100 p-2">
                    <div class="list h-dsp--grid h-grid-gap-md--30 suggestions__product-list">
                        <isloop items="${pdict.suggestions.product.products}" var="product" status="listindex">
                            <div class="item position-relative d-flex flex-column" id="product-${listindex.index}" role="option">
                                <div class="position-absolute suggestions__wishlist-icon-wrapper">
                                    <button class="suggestions__wishlist-btn btn-nostyle"
                                        data-href="${URLUtils.url('Wishlist-AddProduct')}">
                                        <img class="hidden-xs-down suggestions__wishlist-icon" alt=""
                                            src="https://blfz-003.dx.commercecloud.salesforce.com/on/demandware.servlet/webdav/Sites/Libraries/bbw-au/default/images/icons/PDP-Wishlist-4.svg"
                                            width="24px" height="24px" />
                                    </button>
                                </div>
                                <a href="${product.url}" aria-label="${product.name}" class="link">
                                    <div class="suggestions__product-img-wrapper mb-md-3">
                                        <img class="hidden-xs-down suggestions__product-img"
                                            alt="${Resource.msg('label.suggest.imagethumb', 'search', null)} ${product.name}"
                                            src="https://blfz-003.dx.commercecloud.salesforce.com/on/demandware.servlet/webdav/Sites/Libraries/bbw-au/default/images/026777212_crop.jpg"
                                            width="190px" height="172px" />
                                    </div>
                                </a>
                                <div class="suggestions__product-badge h-clr--blue">Product Type</div>
                                <div class="suggestions__product-name h-clr--black-1 my-1">${product.name}</div>
                                <div class="suggestions__product-price h-clr--black-1 h-fw--bold mt-2">$25.00</div>
                                <div class="suggestions__product-promotext h-clr--pink my-1 mb-3">Mix & Match All Body, Skin
                                    & Hair Care: Buy 3, Get 3 FREE or Buy 2, Get 1 FREE</div>
                                <div class="suggestions__btn-add-to-cart mt-auto mb-4">
                                    <button class="add-to-cart btn btn-white h-width-perc--80" data-toggle="modal" data-target="#chooseBonusProductModal" data-pid="${product.id}" ${!product.available ? "disabled" : ""}>Add to bag</button>
                                </div>
                            </div>
                        </isloop>
                    </div>
                </div>
            </isif>

            <isif condition="${pdict.suggestions.recent && pdict.suggestions.recent.available}">
                <li class="row justify-content-end header">
                    <div class="col-xs-12 col-sm-10">
                        ${Resource.msg('label.suggest.recent', 'search', null)}
                    </div>
                </li>
                <li class="row items">
                    <isloop items="${pdict.suggestions.recent.phrases}" var="phrase" status="listindex">
                        <div class="col-12 item" id="phrase-2-${listindex.index}" role="option">
                            <div class="row">
                                <div class="col-xs-12 offset-sm-2 col-sm-10 name">
                                    <a href="${phrase.url}">${phrase.value}</a>
                                </div>
                            </div>
                        </div>
                    </isloop>
                </li>
            <iselseif condition="${pdict.suggestions.popular && pdict.suggestions.popular.available}" />
                <li class="row justify-content-end header">
                    <div class="col-xs-12 col-sm-10">
                        ${Resource.msg('label.suggest.popular', 'search', null)}
                    </div>
                </li>
                <li class="row items">
                    <isloop items="${pdict.suggestions.popular.phrases}" var="phrase" status="listindex">
                        <div class="col-12 item" id="phrase-3-${listindex.index}" role="option">
                            <div class="row">
                                <div class="col-xs-12 offset-sm-2 col-sm-10 name">
                                    <a href="${phrase.url}">${phrase.value}</a>
                                </div>
                            </div>
                        </div>
                    </isloop>
                </li>
            </isif>
            <iscomment>
                <isif condition="${pdict.suggestions.brand && pdict.suggestions.brand.available}">
                    <li class="row justify-content-end header">
                        <div class="col-xs-12 col-sm-10">
                            ${Resource.msg('label.suggest.brand', 'search', null)}
                        </div>
                    </li>
                    <li class="row items">
                        <isloop items="${pdict.suggestions.brand.phrases}" var="phrase" status="listindex">
                            <div class="col-12 item" id="phrase-4-${listindex.index}" role="option">
                                <div class="row">
                                    <div class="col-xs-12 offset-sm-2 col-sm-10 name">
                                        <a href="${phrase.url}">${phrase.value}</a>
                                    </div>
                                </div>
                            </div>
                        </isloop>
                    </li>
                </isif>
            </iscomment>
            <isif condition="${pdict.suggestions.content && pdict.suggestions.content.available}">
                <li class="row justify-content-end header">
                    <div class="col-xs-12 col-sm-10">
                        ${Resource.msg('label.suggest.content', 'search', null)}
                    </div>
                </li>
                <li class="row items">
                    <isloop items="${pdict.suggestions.content.contents}" var="content" status="listindex">
                        <div class="col-12 item" id="content-${listindex.index}" role="option">
                            <div class="row">
                                <div class="col-xs-12 offset-sm-2 col-sm-10 name">
                                    <a href="${content.url}">${content.name}</a>
                                </div>
                            </div>
                        </div>
                    </isloop>
                </li>
            </isif>
        </div>
    </div>
    <div class="suggestions__phrase h-width-perc-md--20">
        <h2 class="header">Search History</h2>
    </div>
    <span id="search-result-count" class="sr-only">
        ${pdict.suggestions.message}
    </span>
    <span id="search-assistive-text" class="sr-only">
        ${Resource.msg('label.header.search.assistive_msg', 'common', null)}
    </span>
</div>
