<iscomment>Produc Grid - Footer </iscomment>
<isinclude template="search/components/topPagination" />

<iscomment> Mobile Filters - Buttons Section </iscomment>
<isif condition="${pdict.productSearch.productIds.length > 0}">
    <div class="row grid-header d-md-none no-gutters">
        <div class="col-6 col-sm-3 text-right d-md-none order-sm-3">
            <button type="button" class="filter-results col-12">
                ${Resource.msg('button.filter', 'search', null)}
            </button>
        </div>
        <div class="col-6 col-sm-3 order-sm-1">
            <isinclude template="search/sortOrderMenu" />
        </div>
        <div class="result-count text-center col-12 col-md-9 col-sm-6 order-sm-2 h-pt--15 pb-0">
            <isinclude template="search/resultsCount" />
        </div>
    </div>
<iselse/>
    <div class="row grid-header justify-content-center">
        <div class="result-count col">
            <isinclude template="search/resultsCount" />
        </div>
    </div>
</isif>

<iscomment> <div class="refinement-bar-without-store p-3 h-bg--gray-1">
    <div class="d-flex align-items-center ">
        <div class="pis-txt mr-2">
            <img class="" alt="" src="${URLUtils.staticURL('/images/icons/bopis-icon-small.svg')}" width="15px" height="19px"/>
        </div>
        <div class="selected-store-container h-font-size--16">
            <a class="choose-store b-text-a h-clr--black-1 h-fw--semibold h-font-size--16" href="javascript:void(0)" role="button" tabindex="0">Set Store</a> <span class="h-font-size--16">to check availability</span>
        </div>
    </div>
</div> </iscomment>

<iscomment>Product Grid - Product List </iscomment>
<div class="product-grid h-dsp--grid h-grid-gap--15 h-grid-gap-lg--55 no-gutters h-mt-md--30 h-mb-md--50"
    itemtype="http://schema.org/SomeProducts" itemid="#product">
    <isinclude template="search/components/productTiles" />
    <isinclude template="product/components/requestUserEmailForOOSModal" />
    <input type="hidden" class="add-to-cart-url" value="${URLUtils.url('Cart-AddProduct')}" />
</div>

<iscomment>Produc Grid - Footer </iscomment>
<isinclude template="search/components/productGridFooter" />
