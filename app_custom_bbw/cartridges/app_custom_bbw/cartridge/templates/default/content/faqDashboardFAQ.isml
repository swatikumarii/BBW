<link rel="stylesheet" href="${URLUtils.staticURL('/css/pages/faq/pageFAQ.css')}" />
<script src="${URLUtils.staticURL('/js/faqSearch.js')}"></script>

<div class="faq-search text-center h-clr--black position-relative">
    <h1 class="text-capitalize h-font-size--24 h-fw--bold">
        ${Resource.msg('faq.header.how.can.we.help.you', 'faq', null)}
    </h1>
    <div class="header-search mx-auto position-relative">
        <input type="hidden" class="faq-search-url" data-url="${URLUtils.url('Faq-Content', 'query')}"/>
        <form class="position-relative" role="search" data-search="" action="${URLUtils.url('Faq-Search')}" method="get">
            <svg aria-hidden="true" class="search-icon position-absolute h-clr--gray-24" focusable="false" height="18"
                viewbox="0 0 12 12" width="18" xmlns="http://www.w3.org/2000/svg">
                <circle cx="4.5" cy="4.5" fill="none" r="4" stroke="currentColor"></circle>
                <path d="M11 11L7.5 7.5" stroke="currentColor" stroke-linecap="round"></path>
            </svg>
            <input type="text" name="query" id="query" class="search-input" placeholder="${Resource.msg('faq.type.your.question.here', 'faq', null)}"/>
        </form>
        <div class="faq-search-suggestions h-bg--white w-100 js-faq-search-suggestions" id="faq-search-suggestions">
            <div class="faq-suggestions-wrapper h-bg--white">
                <div class="faq-suggestions d-flex">
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="questions">
        <img src="${pdict.folder.custom.image.absURL}" alt="${pdict.folder.custom.image.alt}" />
        <h3>${pdict.folder.displayName}</h3>
        <ul class="articlelettler">
            <isloop items="${pdict.folder.onlineContent}" var="content" status="status">
                <isif condition="${pdict.isWrapped && status.index == 7}">
                    <isbreak/>
                </isif>
                <li>
                    <a href="${URLUtils.url('Page-Show', 'cid', content.ID)}">${content.name}</a>
                </li>
            </isloop>
        </ul>
        <isif condition="${pdict.isWrapped}">
            <isif condition="${pdict.folder.onlineContent.length > 7}">
                <a href="${URLUtils.url('Page-Show', 'cid', pdict.folder.ID)}" class="morequestions">
                    ${Resource.msg('faq.link.more.frequently.asked.questions', 'faq', null)}
                </a>
            </isif>
        <iselse/>
            <a href="${URLUtils.url('Page-Show', 'cid', 'help-faq-dashboard')}" class="morequestions">
                ${Resource.msg('faq.link.show.all.customer.service.topics', 'faq', null)}
            </a>
        </isif>
    </div>
</div>
