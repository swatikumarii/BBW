<isset name="level" value="${level+1}" scope="page" />
<isloop items="${contents}" var="content">
    <li>
        <a class=""
            hreflang="${request.getLocale()}" href="${URLUtils.url('Page-Show', 'cid', content.ID)}">
            <span>${content.name}</span>
        </a>
    </li>
</isloop>
