<link rel="stylesheet" hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.staticURL('/css/pages/faq/pageFAQ.css')}" />

<div class="container">
    <nav class="sub-nav d-flex justify-content-between">
        <ul class="breadcrumbs p-0">
            <isinclude template="/content/faqRootBreadcrumb" />
            <li class="current-breadcrumb" title="${pdict.folder.displayName}">
                ${pdict.folder.displayName}
            </li>
        </ul>

        <isinclude template="/content/faqSearchField" />
    </nav>
    <div class="category-container">
        <div class="category-content">
            <div class="content-heading d-flex justify-content-between m-0 flex-row flex-wrap">
                <h1 class="text-uppercase h-fw--semibold h-font-size--32">${pdict.folder.displayName}</h1>
            </div>
            <div id="main-content" class="section-tree d-flex justify-content-between flex-wrap">
                <isloop items="${pdict.folder.onlineSubFolders}" var="folder">
                    <section class="section">
                        <h2 class="section-tree-title mb-0 h-font-size--18 h-fw--semibold">
                            <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Page-Show', 'cid', folder.ID)}">${folder.displayName}</a>
                        </h2>
                        <ul class="article-list">
                            <isloop items="${folder.onlineContent}" var="content" status="status">
                                <isif condition="${status.index == 6}">
                                    <isbreak/>
                                </isif>
                                <li class="article-list-item">
                                    <isif condition="${content.custom && 'isImportant' in content.custom && content.custom.isImportant}">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="9" height="9" focusable="false" viewBox="0 0 12 12" class="icon-star"
                                            title="Promoted article">
                                            <path fill="currentColor"
                                                d="M2.88 11.73c-.19 0-.39-.06-.55-.18a.938.938 0 01-.37-1.01l.8-3L.35 5.57a.938.938 0 01-.3-1.03c.12-.37.45-.63.85-.65L4 3.73 5.12.83c.14-.37.49-.61.88-.61s.74.24.88.6L8 3.73l3.11.17a.946.946 0 01.55 1.68L9.24 7.53l.8 3a.95.95 0 01-1.43 1.04L6 9.88l-2.61 1.69c-.16.1-.34.16-.51.16z">
                                            </path>
                                        </svg>
                                    </isif>
                                    <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Page-Show', 'cid', content.ID)}"
                                        class="article-list-link">${content.name}</a>
                                </li>
                            </isloop>
                        </ul>
                        <isif condition="${folder.onlineContent.length > 6}">
                            <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.url('Page-Show', 'cid', folder.ID)}" class="see-all-articles">
                                ${Resource.msgf('link.faq.see.all.articles', 'common', null, folder.onlineContent.length)}
                            </a>
                        </isif>
                    </section>
                </isloop>
            </div>
        </div>
    </div>
</div>
