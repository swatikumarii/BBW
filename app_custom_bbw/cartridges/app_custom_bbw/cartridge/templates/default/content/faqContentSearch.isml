<isif condition="${pdict.contentSearch.contents.length > 0}">
    ${Resource.msg('faq.search.suggestion.title', 'faq', null)}
    <div>
        <isloop items="${pdict.contentSearch.contents}" var="contentAsset">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header clearfix">
                            <h4><a href="${contentAsset.url}">${contentAsset.name}</a></h4>
                        </div>
                        <div class="card-body card-info-group">
                            ${contentAsset.description}
                        </div>
                    </div>
                </div>
            </div>
        </isloop>
    </div>
</isif>
