<iscontent type="text/html" charset="UTF-8" compact="true" />
<isif condition="${slotcontent}">
    <div class="minicart-recommendation-side-panel-wrap">
        <div class="minicart-recommendation-side-panel">
            <div class="recommendations">
                <span class="cart-product-recommendation-text">${slotcontent.calloutMsg}</span>
                <div class="sidepanel-product-listing">
                    <isloop items="${slotcontent.content}" var="product" begin="0" end="6">
                        <div class="item">
                            <div class="product" data-pid="${product.ID}">
                                <isobject object="${product}" view="recommendation">
                                    <isinclude
                                        url="${URLUtils.url('Tile-Show', 'pid', product.ID, 'pview', 'tile', 'ratings', false, 'swatches', false, 'recommendationType', slotcontent.calloutMsg, 'recommendationId', slotcontent.slotID, 'isRecommendedSlot', true)}" />
                                </isobject>
                            </div>
                        </div>
                    </isloop>
                </div>
            </div>
        </div>
    </div>
</isif>
