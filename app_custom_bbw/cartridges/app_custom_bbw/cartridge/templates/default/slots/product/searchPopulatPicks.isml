<iscontent type="text/html" charset="UTF-8" compact="true" />
<isif condition="${slotcontent}">
    <isloop items="${slotcontent.content}" var="product" begin="0" end="6">
        <isobject object="${product}" view="recommendation">
            <isinclude url="${URLUtils.url('Tile-Show', 'pid', product.ID)}" />
        </isobject>
        <iscomment> <div class="product" data-pid="${product.ID}">
        </div> </iscomment>
    </isloop>
    <isinclude template="product/components/removeGiftLineItem" />
</isif>
