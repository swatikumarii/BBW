<isif condition="${slotcontent}">
<isset name="commonHelper" value="${require('*/cartridge/scripts/helpers/commonHelpers')}" scope="page" />
<isset name="showOutOfStockProducts" value="${slotcontent.custom.showOutOfStockProducts === true ? true : false}" scope="page" />
    <isif condition="${!empty(slotcontent.content)}">
        <div class="picked-just-header-wrapper mb-3">
            <h2 class="picked-just-header-wrapper__title text-center h-fw--bold h-clr--black-1 mb-3 h-font-size--24">
                <isprint value="${slotcontent.calloutMsg}" encoding="off" />
            </h2>
        </div>
    </isif>
    <div class="row no-gutters picked-just-recomm ds-smooth-scroll js-picked-just-recomm">
        <isloop items="${slotcontent.content}" var="product" status="loopState">
            <isset name="checkAvailability" value="${commonHelper.checkProductAvailability(product.ID)}" scope="page" />
            <isif
                condition="${checkAvailability.isAvailable === true || (showOutOfStockProducts === true && checkAvailability
                           .isSearchableIfUnavailable === true)}">
                <div class="picked-just-recomm__item col js-picked-just-recomm-item">
                    <isobject object="${product}" view="recommendation">
                        <isinclude url="${URLUtils.url('Tile-Show', 'pid', product.ID, 'pview', 'tile', 'ratings', true, 'swatches', false, 'showQuickView', false, 'wishlist', false)}" />
                    </isobject>
                </div>
            </isif>
        </isloop>
        <isinclude template="product/components/removeGiftLineItem" />
    </div>
</isif>
