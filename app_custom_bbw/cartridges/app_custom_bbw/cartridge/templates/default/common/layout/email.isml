<isinclude template="/components/modules" sf-toolkit="off" />
<iscontent type="text/html" charset="UTF-8" compact="true"/>

<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional //EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="${require('dw/util/Locale').getLocale(request.getLocale()).getLanguage()}"
    dir="${Resource.msg('global.site.direction', 'version', null)}" xmlns="http://www.w3.org/1999/xhtml"
    xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:v="urn:schemas-microsoft-com:vml">
    <head>
        <!--[if gte mso 9]><xml><o:OfficeDocumentSettings><o:AllowPNG/><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->
        <meta content="text/html; charset=utf-8" http-equiv="Content-Type"/>
        <iscomment> <meta content="width=device-width, initial-scale=1.0" name="viewport"/> </iscomment>
        <!--[if !mso]><!-->
        <meta content="IE=edge" http-equiv="X-UA-Compatible"/>
        <!--<![endif]-->
    </head>
    <body bgcolor="#f2f2f2" style="font-family: 'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,'Lucida Grande',sans-serif; font-size: 18px; line-height: 26px; background: #f2f2f2; padding:50px 0; color: #333; margin: 0;">
        <table cellpadding="0" cellspacing="0" border="0" align="center" style=" border-collapse: collapse; border-spacing: 0; margin: 0 auto; max-width: 700px; min-width: 320px; mso-table-lspace: 0pt; mso-table-rspace: 0pt; table-layout: fixed; vertical-align: top; width: 100%; background: #ffffff;">
            <tr style="padding: 0; display: none;">
                <td style="padding: 0; width: 100%;" width="100%">
                    <table align="center" width="100%">
                        <tbody>
                            <tr style="padding: 0;">
                                <td style="padding: 0;">
                                    <isprint value="${pdict.preHeader}" encoding="on" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </td>
            </tr>
            <iscomment>Email Header</iscomment>
            <tr style="padding: 0;">
                <td style="height: 120px; text-align: center; vertical-align: middle;">
                    <isprint value="${pdict.content ? pdict.content.headerContent : ''}" encoding="off" />
                </td>
            </tr>

            <iscomment> Email Content </iscomment>
            <isreplace/>

            <iscomment>Email Footer</iscomment>
            <isprint value="${pdict.content ? pdict.content.footerContent : ''}" encoding="off" />
        </table>
    </body>
</html>
