<isdecorate template="common/layout/page">
    <div class="hero slant-down login-banner">
        <h1 class="page-title">${Resource.msg('header.site.map', 'common', null)}</h1>
    </div>
    <div class="container">
        <div class="row justify-content-center equal-height">
            <div class="col-sm-3">
                <iscontentasset aid="site-map-customer-care" />
            </div>
            <div class="col-sm-9">
                <isloop items="${pdict.categories}" var="category">
                    <isif condition="${category.siteMapIncluded
                        && (category.hasOnlineProducts() || category.hasOnlineSubCategories())}">
                        <h1>
                            <a href="${URLUtils.url('Search-Show', 'cgid', category.ID)}" id="${category.ID}">
                                ${category.displayName}
                            </a>
                        </h1>
                        <div class="row">
                            <isloop items="${category.onlineSubCategories}" var="category">
                                <isif condition="${category.siteMapIncluded
                                            && (category.hasOnlineProducts() || category.hasOnlineSubCategories())}">
                                    <div class="col-sm-3">
                                        <h1>
                                            <a href="${URLUtils.url('Search-Show', 'cgid', category.ID)}" id="${category.ID}">
                                                ${category.displayName}
                                            </a>
                                        </h1>
                                        <isloop items="${category.onlineSubCategories}" var="category">
                                            <isif condition="${category.siteMapIncluded
                                                        && (category.hasOnlineProducts() || category.hasOnlineSubCategories())}">
                                                <div class="end-level-category">
                                                    <a href="${URLUtils.url('Search-Show', 'cgid', category.ID)}" id="${category.ID}">
                                                        ${category.displayName}
                                                    </a>
                                                </div>
                                            </isif>
                                        </isloop>
                                    </div>
                                </isif>
                            </isloop>
                        </div>
                    </isif>
                </isloop>
            </div>
        </div>
    </div>
</isdecorate>
