<isdecorate template="common/layout/page">
    <isinclude template="/components/modules" sf-toolkit="off" />
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addJs('/js/fragranceName.js');
        assets.addCss('/css/pages/sitemap/b-sitemap.css');
    </isscript>
    <div class="container">
    <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
        <div class="row justify-content-center equal-height sitemap-page">
        <div class="col-md-12">
        <div class="hero slant-down sitemap-banner">
            <h1 class="page-title h-clr--black-3 h-font-size--22 text-center text-uppercase h-fw--medium">
                ${Resource.msg('header.site.map', 'common', null)}</h1>
        </div>
        </div>
            <div class="col-sm-3 customer-list">
                <iscontentasset aid="site-map-customer-care" />
            </div>
            <div class="col-sm-9">
                <isloop items="${pdict.categories}" var="category">
                    <isif condition="${(category.siteMapIncluded === null || category.siteMapIncluded === 1)
                        && (category.hasOnlineProducts() || category.hasOnlineSubCategories())}">
                        <h1 class="sitemap-title-head mb-0">
                            <isif condition="${category.custom && category.custom.alternativeUrl}">
                                <a class="sitemap-cateogry h-font-size--18 h-fw--bold text-uppercase text-left h-clr--blue"
                                    hreflang="${request.getLocale()}" href="${category.custom.alternativeUrl}" id="${category.ID}">
                                    ${category.displayName}
                                </a>
                            <iselse>
                                <a class="sitemap-cateogry h-font-size--18 h-fw--bold text-uppercase text-left h-clr--blue"
                                    hreflang="${request.getLocale()}" href="${URLUtils.url('Search-Show', 'cgid', category.ID)}" id="${category.ID}">
                                    ${category.displayName}
                                </a>
                            </isif>
                        </h1>
                        <div class="row">
                            <isloop items="${category.onlineSubCategories}" var="category">
                                <isif condition="${(category.siteMapIncluded === null || category.siteMapIncluded === 1)
                                            && (category.hasOnlineProducts() || category.hasOnlineSubCategories())}">
                                    <div class="col-md-4 col-sm-12">
                                        <h1 class="sitemap-title">
                                            <a class="text-uppercase h-fw--semibold h-clr--black-3 h-font-size--20" hreflang="${request.getLocale()}" href="${URLUtils.url('Search-Show', 'cgid', category.ID)}" id="${category.ID}">
                                                ${category.displayName}
                                            </a>
                                        </h1>
                                        <isloop items="${category.onlineSubCategories}" var="category">
                                            <isif condition="${(category.siteMapIncluded === null || category.siteMapIncluded === 1)
                                                        && (category.hasOnlineProducts() || category.hasOnlineSubCategories())}">
                                                <div class="end-level-category">
                                                    <a class="h-font-size--16 h-clr--blue"  hreflang="${request.getLocale()}" href="${URLUtils.url('Search-Show', 'cgid', category.ID)}" id="${category.ID}">
                                                        ${category.displayName}
                                                    </a>
                                                </div>
                                            </isif>
                                        </isloop>
                                    </div>
                                </isif>
                            </isloop>
                        </div>
                    </isif>
                </isloop>
            </div>
        </div>
    </div>
</isdecorate>
