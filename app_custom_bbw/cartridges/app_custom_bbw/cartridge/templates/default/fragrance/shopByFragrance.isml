<isdecorate template="common/layout/page">
    <isinclude template="/components/modules" sf-toolkit="off" />

    <isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/fragranceName.js');
    assets.addCss('/css/pages/shopbyfragrance/b-shopbyfragrance.css');
    </isscript>
    <div class="container">
        <!---Breadcrumbs--->
        <isinclude template="components/breadcrumbs/pageBreadcrumbs" />
        <div class="shop-fragrance_content">
            <div class="fragrance-topbanner text-center">
                <iscontentasset aid="fragrance-finder" />
            </div>
            <div class="fragrance-list fr-category col-md-10 text-center">
                <h2 class="subtitle h-font-size--18 m-0 position-absolute text-uppercase bg-white h-fw--bold">
                    ${Resource.msg('shop.by.fragrance.categories.title', 'fragrance', null)}</h2>
                <p class="note h-font-size--16 text-center  h-clr--gray">
                    ${Resource.msg('shop.by.fragrance.categories.sub', 'fragrance', null)}</p>
                <ul class="clearfix list-unstyled w-100 position-relative p-0 m-0" role="list">
                    <isloop iterator="${pdict.fragranceCategories}" alias="fragranceCategories" status="loopstate">
                        <li class="new-row">
                            <a
                                href="${URLUtils.https('Search-Show', 'cgid', 's-fragrance', 'prefn1', 'fragranceCategory', 'prefv1', fragranceCategories
                                      .fragrance)}">
                                <img width="221" height="100"
                                    src="${URLUtils.httpStatic(URLUtils.CONTEXT_LIBRARY, pdict.currentSite, fragranceCategories.image)}"
                                    alt="${fragranceCategories.fragrance}" />
                            </a>
                        </li>
                    </isloop>
                </ul>
            </div>

            <div class="fr-category col-md-12 mt-5">
                <iscomment>
                    <h2 class="subtitle h-font-size--18 m-0 position-absolute text-uppercase h-bg--gray-1 h-fw--bold">
                        ${Resource.msg('shop.by.fragrance.name.title', 'fragrance', null)}</h2>
                    <p class="note h-font-size--16 text-center  h-clr--gray">
                        ${Resource.msg('shop.by.fragrance.name.sub1', 'fragrance', null)}</p>
                    <p class="note h-font-size--16 text-center  h-clr--gray">
                        <img src="${URLUtils.httpStatic(URLUtils.CONTEXT_LIBRARY, pdict.currentSite, '/images/shop-by-fragrance/top-badge-lrg-2.svg')}"
                            alt="top-fragrance"> ${Resource.msg('shop.by.fragrance.name.sub2', 'fragrance', null)}
                    </p>
                </iscomment>
                <iscomment>
                    <div class="mobile-only button filter-show d-md-none h-bg--black-3 cursor-pointer h-bdc--black-3 h-clr--white text-center h-font-size--12 h-fw--normal"
                        role="button" tabindex="0">
                        ${Resource.msg('shop.by.fragrance.button', 'fragrance', null)}
                    </div>
                </iscomment>
                <div class="all-fragrance-header">
                    <div class="fragrance-top-border">
                    </div>
                    <div class="top-fr-head-container d-flex justify-content-center align-items-center mb-3">
                        <h2 class="top-fr-header h-clr--black-3 h-font-size--36 text-center bg-white ">
                            ${Resource.msg('fragrance.title', 'fragrance', null)}</h2>
                    </div>
                    <p class="top-fr-subheader h-clr--black-3 h-font-size--16 h-fw--bold mt-0 text-center">
                        ${Resource.msg('fragrance.content', 'fragrance', null)}</p>
                    <div class="top-fr-head d-flex justify-content-center align-items-center">
                        <img class="icon top-badge-lrg-2 svg-top-badge-lrg-2-dims frag-icon"
                            src="${URLUtils.staticURL('/images/shopByFragrance/top-badge-lrg-2.svg')}" role="img" alt="top-fragrance"
                            aria-label="top fragrance icon" />

                        <span class="top-fr-subheader h-font-size--14">${Resource.msg('fragrance.content.span.data', 'fragrance', null)}</span>
                    </div>
                </div>
                <isif condition="${!empty(pdict.fragranceNames)}">
                    <div class="fragrance-header-search col-12 mt-3">
                        <div class="fragrance-search search-wrapper">
                            <fieldset class="text-justify seatch-text">
                                <span class="h-clr--gray h-font-size--14 ">
                                    ${Resource.msg('lable.fragrance.name.search', 'fragrance', null)} </span>
                                <input class="search-input-box" type="text" id="search-input"
                                    placeholder="What are you looking for" name="search-input" autocomplete="off" />
                                <div class="search-icon-details">
                                    <img width="20" class="h-auto"
                                        src="${URLUtils.staticURL('/images/shopByFragrance/UI-Search.svg')}"
                                        alt="Search Icon">
                                </div>
                            </fieldset>
                        </div>
                    </div>
                    <div class="row no-gutter mt-4">
                        <div class="col-md-12 col-xl-12 fragrance-list-data">
                            <isloop iterator="${pdict.fragranceNames}" alias="fragranceGroup" status="loopstate">
                                <div id="${fragranceGroup.key}"
                                    class="alphabet-group-${fragranceGroup.key} alphabetically-data">
                                    <div class="level-1-${fragranceGroup.key} static-level text-justify">
                                        <h3 class="title m-0 p-0">${fragranceGroup.key}</h3>
                                        <div class="alphabet-border"></div>
                                    </div>
                                    <ul class="list-unstyled frg-listing">
                                        <isloop iterator="${fragranceGroup.value}" alias="fragrance" status="loopstate">
                                            <li class="level-2 text-start mt-3 mb-3">
                                                <a class="h-clr--gray"
                                                    href="${URLUtils.https('Search-Show', 'cgid', 's-fragrance', 'prefn1', 'fragranceName', 'prefv1', fragrance.name)}"
                                                    data-fragrancename="${fragrance.name}">
                                                    ${fragrance.name}</a>
                                                <isif condition="${fragrance.topFragrance}">
                                                    <img src="${URLUtils.httpStatic(URLUtils.CONTEXT_LIBRARY, pdict.currentSite, '/images/shop-by-fragrance/top-badge-lrg-2.svg')}"
                                                      class="fragrance-img"  alt="top-fragrance">
                                                </isif>
                                            </li>
                                        </isloop>
                                    </ul>
                                </div>
                            </isloop>
                        </div>
                    </div>
                    <div class="noresult text-center" id="noresult">${Resource.msg('shop.by.fragrance.name.noresult', 'fragrance', null)}
                    </div>
                <iselse/>
                    <div class="nofragrance">${Resource.msg('shop.by.fragrance.name.empty', 'fragrance', null)}</div>
                </isif>
            </div>
        </div>
        <div class="row">
            <!-- Find a Fragrance -->
            <div class="col-sm-12">
                <iscontentasset aid="find-fragrance" />
            </div>
        </div>
    </div>
</isdecorate>
