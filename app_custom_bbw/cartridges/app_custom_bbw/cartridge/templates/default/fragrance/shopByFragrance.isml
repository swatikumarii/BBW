<isdecorate template="common/layout/page">
    <isscript>
        var assets = require('*/cartridge/scripts/assets.js');
        assets.addCss('/css/login.css');
        assets.addJs('/js/fragranceName.js');
          assets.addCss('/css/pages/shopbyfragrance/b-shopbyfragrance.css');
    </isscript>
    <div class="container">
        <div class="shop-fragrance_content">
            <div class="fragrance-topbanner text-center">
                <h1 class="h-fw--bold h-font-size-md--100 h-font-size-sm--50 text-center">
                    ${Resource.msg('shop.by.fragrance.title', 'fragrance', null)}
                </h1>
                <p class="text-center text-live h-font-size--28 h-clr--black-3 mt-5">
                    ${Resource.msg('shop.by.fragrance.sub', 'fragrance', null)}</p>
            </div>
            <div class="fragrance-list fr-category col-md-12">
                <h2 class="subtitle h-font-size--18 m-0 position-absolute text-uppercase h-bg--gray-1 h-fw--bold">
                    ${Resource.msg('shop.by.fragrance.categories.title', 'fragrance', null)}</h2>
                <p class="note h-font-size--16 text-center  h-clr--gray">
                    ${Resource.msg('shop.by.fragrance.categories.sub', 'fragrance', null)}</p>
                <ul class="clearfix list-unstyled w-100 position-relative p-0 m-0" role="list">
                    <isloop iterator="${pdict.fragranceCategories}" alias="fragranceCategories" status="loopstate">
                        <li class="new-row">
                            <a href="${URLUtils.https('Search-Show', 'cgid', 'shop-by-fragrance', 'prefn1', 'fragranceCategory', 'prefv1', fragranceCategories.fragrance)}">
                                <img src="${URLUtils.httpStatic(URLUtils.CONTEXT_LIBRARY, pdict.currentSite, fragranceCategories.image)}"
                                    alt="${fragranceCategories.fragrance}">
                            </a>
                        </li>
                    </isloop>
                </ul>
            </div>

            <div class="fragrance-list fr-category col-md-12">
                <h2 class="subtitle h-font-size--18 m-0 position-absolute text-uppercase h-bg--gray-1 h-fw--bold">
                    ${Resource.msg('shop.by.fragrance.name.title', 'fragrance', null)}</h2>
                <p class="note h-font-size--16 text-center  h-clr--gray">${Resource.msg('shop.by.fragrance.name.sub1', 'fragrance', null)}</p>
                <p class="note h-font-size--16 text-center  h-clr--gray">
                    <img src="${URLUtils.httpStatic(URLUtils.CONTEXT_LIBRARY, pdict.currentSite, '/images/shop-by-fragrance/top-badge-lrg-2.svg')}"
                        alt="top-fragrance"> ${Resource.msg('shop.by.fragrance.name.sub2', 'fragrance', null)}
                </p>
                <div class="mobile-only button filter-show d-md-none h-bg--black-3 cursor-pointer h-bdc--black-3 h-clr--white text-center h-font-size--12 h-fw--normal" role="button" tabindex="0">
                    ${Resource.msg('shop.by.fragrance.button', 'fragrance', null)}
                </div>
                <isif condition="${!empty(pdict.fragranceNames)}">
                    <div class="fragrance-header-search d-none d-md-block">
                        <div class="fragrance-search search-wrapper">
                            <fieldset>
                                <input type="text" id="search-input" name="search-input" autocomplete="off" />
                            </fieldset>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 ">
                            <isloop iterator="${pdict.fragranceNames}" alias="fragranceGroup" status="loopstate">
                                <div id="${fragranceGroup.key}" class="alphabet-group-${fragranceGroup.key}">
                                    <div
                                        class="level-1-${fragranceGroup.key} static-level h-width-perc--80 text-justify">
                                        <h3 class="title m-0 p-0">${fragranceGroup.key}</h3>
                                        <div class="alphabet-border"></div>
                                    </div>
                                    <ul>
                                        <isloop iterator="${fragranceGroup.value}" alias="fragrance" status="loopstate">
                                            <li class="level-2 text-justify mt-3 mb-3">
                                                <a class="h-clr--black-3"
                                                    href="${URLUtils.https('Search-Show', 'cgid', 'shop-by-fragrance', 'prefn1', 'fragranceName', 'prefv1', fragrance.name)}"
                                                    data-fragrancename="${fragrance.name}">
                                                    ${fragrance.name}</a>
                                                <isif condition="${fragrance.topFragrance}">
                                                    <img src="${URLUtils.httpStatic(URLUtils.CONTEXT_LIBRARY, pdict.currentSite, '/images/shop-by-fragrance/top-badge-lrg-2.svg')}"
                                                        alt="top-fragrance">
                                                </isif>
                                            </li>
                                        </isloop>
                                    </ul>
                                </div>
                            </isloop>
                        </div>
                    </div>
                    <div class="noresult" id="noresult">${Resource.msg('shop.by.fragrance.name.noresult', 'fragrance', null)}
                    </div>
                <iselse/>
                    <div class="nofragrance">${Resource.msg('shop.by.fragrance.name.empty', 'fragrance', null)}</div>
                </isif>
            </div>
        </div>
        <div class="row">
            <!-- Find a Fragrance -->
            <div class="col-sm-12">
                <iscontentasset aid="find-fragrance" />
            </div>
        </div>
    </div>
</isdecorate>
