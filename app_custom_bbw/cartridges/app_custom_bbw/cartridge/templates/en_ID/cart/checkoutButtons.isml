<div class="mb-sm-3">
    <a hreflang="${request.getLocale().replace('_', '-').toLowerCase()}" href="${URLUtils.https('Checkout-Begin')}"
        data-check-motivator="${URLUtils.https('Cart-MissingFree')}"
        class="btn btn-primary btn-block checkout-btn h-fw--semibold h-font-size--16 cart-checkout-btn ${pdict.valid.error ? 'disabled' : ''}"
        role="button" id="cart-mobile-checkout">
        <span class="checkout-button-lock"></span>
        ${Resource.msg('button.checkout', 'cart', null)}
    </a>

    <!-- Responsive Checkout Button -->
    <button type="button" id="secure-checkout-mbl-btn" class="btn btn-primary checkout-mobile-modal-btn"
        data-toggle="modal" data-target="#mobile-cart-checkout">
        ${Resource.msg('checkout.mobile.modal.btn', 'cart', null)}
        <span class="arrow"></span>
    </button>

    <!-- Responsive Checkout Modal -->
    <isinclude template="cart/cartCheckoutMobileModal" />
</div>
