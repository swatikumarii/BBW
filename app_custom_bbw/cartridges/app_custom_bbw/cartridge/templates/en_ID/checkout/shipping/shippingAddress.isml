<isinclude template="/components/modules" sf-toolkit="off" />
<isset name="addressFields" value="${pdict.forms.shippingForm.shippingAddress.addressFields}" scope="page" />
<isif condition="${shippingModel.shippingAddress}">
    <isset name="shippingAddress" value="${shippingModel.shippingAddress}" scope="page" />
<iselse/>
    <isset name="shippingAddress" value="${{}}" scope="page" />
</isif>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.firstName.mandatory === true ? 'required' : ''}
                ${addressFields.firstName.htmlName}">
            <div class="d-flex justify-content-between">
                <label class="form-control-label h-font-size--16 h-fw--semibold h-clr--black-1"
                    for="shippingFirstName${lineItem ? lineItem.UUID : 'default'}">
                    <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.first.name', 'address', null)}
                </label>
                <span class="h-font-size--14 required-indicator-text h-clr--black-1 h-line-height--16"><span class="h-clr--red-9 required-star">${'*'}</span>${Resource.msg('label.required', 'account', null)}</span>
            </div>
            <input type="text" class="form-control shippingFirstName"
                id="shippingFirstName${lineItem ? lineItem.UUID : 'default'}"
                aria-describedby="${lineItem ? lineItem.UUID : 'default'}FirstName"
                value="${shippingAddress.firstName || ''}"
                data-missing-error="${Resource.msg('error.first.name', 'forms', null)}"
                data-pattern-mismatch="${Resource.msg('error.message.parse.FName', 'forms', null)}"
                <isprint value="${addressFields.firstName.attributes}" encoding="off" />
            >
            <div class="invalid-feedback" id="${lineItem ? lineItem.UUID : 'default'}FirstName">
                <isprint value="${addressFields.firstName.error}">
            </div>
        </div>
    </div>
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.lastName.mandatory === true ? 'required' : ''}
                ${addressFields.lastName.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingLastName${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.last.name', 'address', null)}
            </label>
            <input type="text" class="form-control shippingLastName"
                id="shippingLastName${lineItem ? lineItem.UUID : 'default'}"
                aria-describedby="${lineItem ? lineItem.UUID : 'default'}LastName"
                data-missing-error="${Resource.msg('error.last.name', 'forms', null)}"
                data-pattern-mismatch="${Resource.msg('error.message.parse.LName', 'forms', null)}"
                value="${shippingAddress.lastName || ''}" <isprint value="${addressFields.lastName.attributes}"
                encoding="off" /> autocomplete="shipping family-name">
            <div class="invalid-feedback" id="${lineItem ? lineItem.UUID : 'default'}LastName">
                <isprint value="${addressFields.lastName.error}">
            </div>
        </div>
    </div>
</div>

<div class="row ${dw.system.Site.getCurrent().getCustomPreferenceValue('enableGoogleAutoFill') ? '' : 'd-none'}">
    <div class="col-sm-12">
        <div class="form-group">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingAddressAutoComplete">
                ${Resource.msg('field.address.auto', 'address', null)}
            </label>
            <input id="shippingAddressAutoComplete" type="text" size="50" disabled='disabled'>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.address1.mandatory === true ? 'required' : ''}
                ${addressFields.address1.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingAddressOne${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.one', 'address', null)}
            </label>
            <input type="text" class="form-control shippingAddressOne"
                id="shippingAddressOne${lineItem ? lineItem.UUID : 'default'}"
                aria-describedby="${lineItem ? lineItem.UUID : 'default'}AddressLine1"
                data-pattern-mismatch="${Resource.msg('error.message.parse.address', 'forms', null)}"
                data-missing-error="${Resource.msg('error.address.line-1', 'forms', null)}"
                value="${shippingAddress.address1 || ''}" <isprint value="${addressFields.address1.attributes}"
                encoding="off" />>
                <div class="invalid-feedback" id="${lineItem ? lineItem.UUID : 'default'}AddressLine1">
                    <isprint value="${addressFields.address1.error}" />
                </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.address2.mandatory === true ? 'required' : ''}
                ${addressFields.address2.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingAddressTwo${lineItem ? lineItem.UUID : 'default'}">
                ${Resource.msg('field.shipping.address.two', 'address', null)}
            </label>
            <input type="text" class="form-control shippingAddressTwo"
                id="shippingAddressTwo${lineItem ? lineItem.UUID : 'default'}"
                aria-describedby="${lineItem ? lineItem.UUID : 'default'}AddressLine2"
                data-pattern-mismatch="${Resource.msg('error.message.parse.address', 'forms', null)}"
                value="${shippingAddress.address2 || ''}" <isprint value="${addressFields.address2.attributes}"
                encoding="off" />
                >
            <div class="invalid-feedback" id="${lineItem ? lineItem.UUID : 'default'}AddressLine2">
                <isprint value="${addressFields.address2.error}" />
            </div>
        </div>
    </div>
</div>

<!--- make drop down--->
<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.country.mandatory === true ? 'required' : ''}
                ${addressFields.country.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingCountry${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.country', 'address', null)}
            </label>
            <div class="custom-select-wrap">
                <select class="form-control shippingCountry custom-select"
                    id="shippingCountry${lineItem ? lineItem.UUID : 'default'}" <isprint
                    value=${addressFields.country.attributes} encoding="off" />
                autocomplete="shipping country"
                aria-describedby="${lineItem ? lineItem.UUID : 'default'}Country">
                <isloop items=${addressFields.country.options} var="country">
                    <option id="${country.id}" value="${country.htmlValue}" selected="selected">${country.label}
                    </option>
                </isloop>
                </select>
            </div>
            <div class="invalid-feedback" id="${lineItem ? lineItem.UUID : 'default'}Country">
                <isprint value="${addressFields.country.error}">
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.states.stateCode.mandatory === true ? 'required' : ''}
                ${addressFields.states.stateCode.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingState${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.state', 'address', null)}
            </label>
            <div class="custom-select-wrap">
                <select class="form-control shippingState custom-select"
                    id="shippingState${lineItem ? lineItem.UUID : 'default'}"
                    data-missing-error="${Resource.msg('error.state', 'forms', null)}" data-selected="${shippingAddress.stateCode}"
                    <isprint value=${addressFields.states.stateCode.attributes} encoding="off" />
                autocomplete="shipping address-level1"
                aria-describedby="${lineItem ? lineItem.UUID : 'default'}State">
                <isloop items=${addressFields.states.stateCode.options} var="state">
                    <option id="${state.id}" value="${state.htmlValue}" ${state.id === shippingAddress.stateCode ? 'selected' : ''}>${state.label || ' '}</option>
                </isloop>
                </select>
                <div class="invalid-feedback shipping-select-error" id="${lineItem ? lineItem.UUID : 'default'}State">
                    <isprint value="${addressFields.states.stateCode.error}">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.city.mandatory === true ? 'required' : ''}
                ${addressFields.city.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingAddressCity${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.city', 'address', null)}
            </label>
            <div class="custom-select-wrap">
                <select class="form-control shippingAddressCity custom-select"
                    id="shippingAddressCity${lineItem ? lineItem.UUID : 'default'}"
                    aria-describedby="${lineItem ? lineItem.UUID : 'default'}City"
                    data-missing-error="${Resource.msg('error.city', 'forms', null)}"
                    data-selected="${shippingAddress.city}"
                    autocomplete="shipping address-level2"
                    <isprint value="${addressFields.city.attributes}" encoding="off" />
                    >
                    <isif condition="${shippingAddress && shippingAddress.city}">
                        <option id="${shippingAddress.city}" value="${shippingAddress.city}" selected> ${shippingAddress.city} </option>
                    </isif>
                </select>
                <div class="invalid-feedback shipping-select-error" id="${lineItem ? lineItem.UUID : 'default'}City">
                    <isprint value="${addressFields.city.error}"/>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12">
        <div class="form-group
                        ${addressFields.district.mandatory === true ? 'required' : ''}
                        ${addressFields.district.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingAddressDistrict${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.district', 'address', null)}
            </label>
            <div class="custom-select-wrap">
                <select class="form-control shippingAddressDistrict custom-select"
                    id="shippingAddressDistrict${lineItem ? lineItem.UUID : 'default'}"
                    aria-describedby="${lineItem ? lineItem.UUID : 'default'}District"
                    data-missing-error="${Resource.msg('error.district', 'forms', null)}"
                    data-selected="${shippingAddress.district}" autocomplete="shipping address-district" <isprint
                    value="${addressFields.district.attributes}" encoding="off" />
                >
                <isif condition="${shippingAddress && shippingAddress.district}">
                    <option id="${shippingAddress.district}" value="${shippingAddress.district}" selected>
                        ${shippingAddress.district}
                    </option>
                </isif>
                </select>
                <div class="invalid-feedback shipping-select-error" id="${lineItem ? lineItem.UUID : 'default'}District">
                    <isprint value="${addressFields.district.error}" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12">
        <div class="form-group
                            ${addressFields.subdistrict.mandatory === true ? 'required' : ''}
                            ${addressFields.subdistrict.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingAddressSubdistrict${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.subdistrict', 'address', null)}
            </label>
            <div class="custom-select-wrap">
                <select class="form-control shippingAddressSubdistrict custom-select"
                    id="shippingAddressSubdistrict${lineItem ? lineItem.UUID : 'default'}"
                    aria-describedby="${lineItem ? lineItem.UUID : 'default'}Subdistrict"
                    data-missing-error="${Resource.msg('error.subdistrict', 'forms', null)}"
                    data-selected="${shippingAddress.subDistrict}" autocomplete="shipping address-subdistrict" <isprint
                    value="${addressFields.subDistrict.attributes}" encoding="off" />
                >
                <isif condition="${shippingAddress && shippingAddress.Subdistrict}">
                    <option id="${shippingAddress.subDistrict}" value="${shippingAddress.Subdistrict}" selected>
                        ${shippingAddress.Subdistrict}
                    </option>
                </isif>
                </select>
                <div class="invalid-feedback shipping-select-error" id="${lineItem ? lineItem.UUID : 'default'}Subdistrict">
                    <isprint value="${addressFields.subDistrict.error}" />
                </div>
            </div>
        </div>
    </div>


    <div class="col-sm-12">
        <div class="form-group
                    ${addressFields.postalCode.mandatory === true ? 'required' : ''}
                    ${addressFields.postalCode.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingZipCode${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.zip.code', 'address', null)}
            </label>
            <div class="custom-select-wrap">
                <select class="form-control shippingZipCode custom-select"
                    id="shippingZipCode${lineItem ? lineItem.UUID : 'default'}"
                    aria-describedby="${lineItem ? lineItem.UUID : 'default'}ZipCode"
                    data-missing-error="${Resource.msg('error.zip.code', 'forms', null)}"
                    data-pattern-mismatch="${Resource.msg('valid.zip.code', 'forms', null)}"
                    data-selected="${shippingAddress.postalCode}" <isprint value="${addressFields.postalCode.attributes}"
                    encoding="off" />
                autocomplete="shipping postal-code">
                <isif condition="${shippingAddress && shippingAddress.postalCode}">
                    <option id="${shippingAddress.postalCode}" value="${shippingAddress.postalCode}" selected>
                        ${shippingAddress.postalCode} </option>
                </isif>
                </select>
                <div class="invalid-feedback shipping-select-error" id="${lineItem ? lineItem.UUID : 'default'}ZipCode">
                    <isprint value="${addressFields.postalCode.error}" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group
                ${addressFields.phone.mandatory === true ? 'required' : ''}
                ${addressFields.phone.htmlName}">
            <label class="form-control-label h-font-size--16 h-fw--semibold"
                for="shippingPhoneNumber${lineItem ? lineItem.UUID : 'default'}">
                <span class="h-clr--red-9 require-indicator">${'*'}</span>${Resource.msg('field.shipping.address.phone', 'address', null)}
            </label>
                <input type="tel" class="form-control shippingPhoneNumber" initOptions.allowDropdown="true"
                    id="shippingPhoneNumber${lineItem ? lineItem.UUID : 'default'}"
                    aria-describedby="${lineItem ? lineItem.UUID : 'default'}TelephoneNumber"
                    data-missing-error="${Resource.msg('error.phone.missing', 'forms', null)}"
                    data-pattern-mismatch="${Resource.msg('error.message.pattern.phone', 'forms', null)}"
                    value="${shippingAddress.phone || ''}" <isprint value="${addressFields.phone.attributes}"
                    encoding="off" />>
                <span class="info-icon">
                    <img src="${URLUtils.staticURL('/images/i-icon-gray.svg')}" alt="info icon" class="info-icon-img-gray" width="10px" />
                    <img src="${URLUtils.staticURL('/images/i-icon-white.svg')}" alt="info icon" class="info-icon-img-white" width="10px" />
                </span>
                <input type="hidden" class="dialCode"
                    value="${addressFields.dialCode.htmlValue || dw.system.Site.getCurrent().getCustomPreferenceValue('defaultDialCode')}"
                    <isprint value="${addressFields.dialCode.attributes}" encoding="off" />
                />
                <input type="hidden" class="dialCodeCountry"
                    value="${addressFields.dialCodeCountry.htmlValue || dw.system.Site.getCurrent().getCustomPreferenceValue(
                           'defaultDialCodeCountry')}"
                    <isprint value="${addressFields.dialCodeCountry.attributes}" encoding="off" />
                />
                <div class="info-icon-text">
                    <iscontentasset aid="phone-info-icon-content" />
                </div>
                <div class="info-icon-border-arrow-outline"></div>
                <div class="info-icon-border-arrow"></div>
            <div class="invalid-feedback" id="${lineItem ? lineItem.UUID : 'default'}TelephoneNumber">
                <isprint value="${addressFields.phone.error}"/>
            </div>
        </div>
    </div>
</div>
