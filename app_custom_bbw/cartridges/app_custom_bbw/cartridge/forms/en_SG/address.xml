<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19">

       <field
              formid="addressId"
              label="label.input.addressid"
              type="string"
              mandatory="true"
              max-length="20"
              missing-error="error.address.title"
              range-error="error.message.20orless"
              regexp="^[a-zA-Z0-9 ''\-]+$" parse-error="error.message.parse.lname"
       />

       <field formid="firstName"
              label="label.input.firstname.profile"
              type="string"
              mandatory="true"
              binding="firstName"
              min-length="1"
              max-length="50"
              regexp="^[a-zA-Z0-9 ''\-]+$"
              missing-error="error.first.name"
              parse-error="error.message.parse.fname"
              range-error="error.message.50orless.fname"/>

       <field formid="lastName"
              label="label.input.lastname.profile"
              type="string"
              mandatory="true"
              binding="lastName"
              min-length="1"
              max-length="50"
              regexp="^[a-zA-Z0-9 ''\-]+$"
              missing-error="error.last.name"
              parse-error="error.message.parse.lname"
              range-error="error.message.50orless.lname"/>

       <field formid="address1"
              label="label.input.address1"
              type="string" mandatory="true"
              binding="address1"
              max-length="50"
              missing-error="address.address1.missing"
              range-error="error.message.50orless" />

    <field formid="address2" label="label.input.address2" type="string" mandatory="false" binding="address2"
           max-length="50" range-error="error.message.50orless"/>

       <field formid="city" label="label.input.city" type="string" mandatory="true" binding="city"
              min-length="2"
              max-length="50" missing-error="address.city.missing"
              range-error="error.message.between2and50">
