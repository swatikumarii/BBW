<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19" secure="false">
	<group formid="customer">
		<field
            formid="salutation"
            label="label.input.salutation.profile"
            mandatory="true"
            missing-error="error.message.salutation.required"
            type="string">
            <options>
                <option optionid="Mr" label="label.select.mr.salutation.profile" value="1" />
                <option optionid="Mrs" label="label.select.mrs.salutation.profile" value="2" />
                <option optionid="Miss" label="label.select.miss.salutation.profile" value="3" />
            </options>
        </field>
		<field
			formid="firstname"
			label="label.input.firstname.profile"
			mandatory="true"
			min-length="2"
			max-length="50"
			regexp="^[a-zA-Z0-9 ''\-]+$"
			missing-error="error.message.fname.required"
			range-error="error.message.fname.2orGreater"
			parse-error="error.message.parse.fname"
			value-error="ValueErrorText"
			type="string" />

		<field
			formid="lastname"
			label="label.input.lastname.profile"
			mandatory="true"
			max-length="50"
			regexp="^[a-zA-Z0-9'\-]+$"
			missing-error="error.message.required"
			range-error="error.message.lname.2orGreater"
			parse-error="error.message.parse.lname"
			value-error="ValueErrorText"
			type="string" />

		<field
			formid="email"
			label="label.input.email.profile"
			mandatory="true"
			max-length="50"
			missing-error="error.message.email.required"
			parse-error="error.message.parse.email"
			range-error="error.message.email.50orless"
			regexp="^[\w.%+\-]+@[\w.\-]+\.\w{2,}$"
			value-error="ValueErrorText"
			type="string"/>
			<!-- TODO value-error not comming back from the platform -->

		<field
			formid="emailconfirm"
			label="label.input.emailconfirm.profile"
			mandatory="true"
			max-length="50"
			missing-error="error.message.email.required"
			parse-error="error.message.parse.email"
			range-error="error.message.email.50orless"
			regexp="^[\w.%+\-]+@[\w.\-]+\.\w{2,}$"
			value-error="ValueErrorText"
			type="string"/>
			<!-- TODO value-error not comming back from the platform -->

		<field
			formid="phone"
			label="label.input.phone.profile"
			mandatory="true"
        	regexp="^(?!0)[0-9\s]{8,13}$"
           	missing-error="error.phone.number"
           	parse-error="error.message.pattern.phone"
			type="string"/>

		<field
            formid="gender"
            label="label.input.gender.profile"
            mandatory="true"
            missing-error="error.message.gender.required"
            type="string">
            <options>
                <option optionid="Male" label="label.select.mr.gender.profile" value="1" />
                <option optionid="Female" label="label.select.mrs.gender.profile" value="2" />
                <option optionid="Prefer Not To Say" label="label.select.miss.gender.profile" value="3" />
            </options>
        </field>

		<field
			formid="dob"
			label="label.input.dob.profile"
			mandatory="true"
            max-length="10"
			regexp="^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[1-2][0-9]|3[0-1])$"
			missing-error="error.message.dob.required"
			parse-error="error.message.parse.dob"
			value-error="ValueErrorText"
			type="string" />

		<field
			formid="zip"
			label="label.input.zip.profile"
			min-length="4"
			max-length="10"
			regexp="^[a-zA-Z0-9'\-]{4,10}$"
			range-error="error.message.zip.10orless"
			parse-error="error.message.zip.fname"
			value-error="ValueErrorText"
			type="string" />

		<field
			formid="zipCode"
			label="label.input.zip.profile"
			min-length="4"
			max-length="10"
			regexp="^[0-9]*$"
			missing-error="error.message.zip.required"
			range-error="error.message.zip.10orless"
			parse-error="error.message.zip.fname"
			value-error="ValueErrorText"
			type="string" />

		<field
            formid="nationality"
            label="label.input.nationality.profile"
            mandatory="true"
            missing-error="error.message.nationality.required"
			parse-error="error.message.parse.nationality"
            type="string">
        </field>

		<field
			formid="addtoemaillist"
			label="description.checkbox.emailsignup.profile"
			type="boolean"/>

		<field
            formid="dialCode"
            type="string">
        </field>

		<field
            formid="dialCodeCountry"
            type="string">
        </field>
	</group>

	<group formid="login">
		<field
			formid="password"
			label="label.input.password.profile"
			mandatory="true"
			min-length="8"
			max-length="50"
			regexp="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?])[A-Za-z\d@$!%*?]{8,50}$"
			missing-error="error.message.password"
			range-error="error.message.8_50aracters"
			parse-error="error.message.parse.password"
			value-error="error.message.currentpasswordnomatch"
			type="string" />
			<!-- TODO value-error -->

		<field
			formid="passwordconfirm"
			label="label.input.passwordconfirm.profile"
			type="string"
			mandatory="true"
			min-length="8"
			max-length="50"
			regexp="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?])[A-Za-z\d@$!%*?]{8,50}$"
			missing-error="error.message.password"
			range-error="error.message.8_50aracters"
			parse-error="error.message.parse.password"
			value-error="error.message.currentpasswordnomatch"/>
			<!-- TODO value-error -->

		<field
			formid="currentpassword"
			label="label.input.currentpassword.profile"
			mandatory="true"
			min-length="8"
			max-length="50"
			regexp="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?])[A-Za-z\d@$!%*?]{8,50}$"
			missing-error="error.message.currentpassword"
			range-error="error.message.8_50aracters"
			parse-error="error.message.parse.password"
			value-error="error.message.currentpasswordnomatch"
			type="string" />

		<include formid="newpasswords" name="newPasswords"
			mandatory="true"
			min-length="8"
			max-length="50"
			regexp="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?])[A-Za-z\d@$!%*?]{8,50}$"
			missing-error="error.message.password"
			range-error="error.message.8_50aracters"
			parse-error="error.message.parse.password"
			type="string" />
	</group>
</form>
