<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19" secure="false">
    <field
        formid="newpassword"
        label="label.input.newpassword.profile"
        mandatory="true"
        min-length="8"
        max-length="50"
        regexp="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?])[A-Za-z\d@$!%*?]{8,50}$"
        missing-error="error.message.password"
        range-error="error.message.8_50aracters"
        parse-error="error.message.parse.password"
        value-error="ValueErrorText"
        type="string"/>

    <field
        formid="newpasswordconfirm"
        label="label.input.newpasswordconfirm.profile"
        mandatory="true"
        min-length="8"
        max-length="50"
        regexp="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?])[A-Za-z\d@$!%*?]{8,50}$"
        missing-error="error.message.password"
        range-error="error.message.8_50aracters"
        parse-error="error.message.parse.password"
        value-error="ValueErrorText"
        type="string"/>
</form>
