<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19">
	<field formid="stateCode" label="label.input.state" type="string" mandatory="true" binding="stateCode" missing-error="address.state.missing" value-error="address.field.invalid" parse-error="error.message.required">
		<options>
			<option optionid="" 	label="resource.select" 		value=""/>

			<!-- regular AU states -->
			<option label="Australian Capital Territory" 		value="ACT"/>
			<option label="New South Wales" 		value="NSW"/>
			<option label="Northern Territory" 		value="NT"/>
			<option label="Queensland" 		value="QLD"/>
			<option label="South Australia" 		value="SA"/>
			<option label="Tasmania" 		value="TAS"/>
			<option label="Victoria" 		value="VIC"/>
			<option label="Western Australia" 		value="WA"/>
		</options>
	</field>
</form>
