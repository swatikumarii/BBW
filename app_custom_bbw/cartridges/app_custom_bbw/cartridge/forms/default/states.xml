			<!-- regular AU states -->
			<option label="Australian Captial Territory" 		value="Australian Captial Territory"/>
			<option label="New South Wales" 		value="New South Wales"/>
			<option label="Northern Territory" 		value="Northern Territory"/>
			<option label="Queensland" 		value="Queensland"/>
			<option label="South Australia" 		value="South Australia"/>
			<option label="Tasmania" 		value="Tasmania"/>
			<option label="Victoria" 		value="Victoria"/>
			<option label="Western Australia" 		value="Western Australia"/>
		</options>
	</field>
</form>
