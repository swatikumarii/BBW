{
  "root": true,
  "extends": [
    "airbnb-base/legacy",
    "prettier",
    "plugin:jsdoc/recommended-error"
  ],
  "rules": {
    "camelcase": [
      "error",
      {
        "properties": "always"
      }
    ],
    "quotes": [
      "error",
      "single"
    ],
    "semi": [
      "error",
      "always"
    ],
    "import/no-unresolved": "off",
    "indent": [
      "error",
      4,
      {
        "SwitchCase": 1,
        "VariableDeclarator": 1
      }
    ],
    "func-names": "off",
    "vars-on-top": "off",
    "global-require": "off",
    "no-shadow": [
      "error",
      {
        "allow": [
          "err",
          "callback"
        ]
      }
    ],
    "max-len": "off",
    "no-plusplus": "off",
    "eqeqeq": [
      "error",
      "always"
    ]
  },
  "globals": {
    "empty": true,
    "XML": true,
    "dw": true,
    "request": true,
    "response": true,
    "session": true,
    "customer": true,
    "document": true,
    "window": true,
    "location": true,
    "$": true,
    "jQuery": true,
    "middleware": true,
    "querystringparameter": true,
    "renders": true,
    "serverfunction": true,
    "httpparameter": true,
    "grecaptcha": true,
    "Promise": true,
    "google":true,
    "SelectedOption": true,
    "Object": true
  }
}
