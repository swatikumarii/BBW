<div id="dynamic-modal-exit-intent-popup" data-href="${URLUtils.url('Popup-PopupConfig')}"
    hreflang="${request.getLocale()}" class="modal" role="dialog" data-backdrop="false">
    <div class="modal-dialog dynamic-popup-dialog dynamicPopup-exitIntent">
        <div class="modal-content dynamic-popup-content dynamicPopup-exitIntent">
            <div class="modal-header">
                <button type="button" class="close modal-close-icon" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>
