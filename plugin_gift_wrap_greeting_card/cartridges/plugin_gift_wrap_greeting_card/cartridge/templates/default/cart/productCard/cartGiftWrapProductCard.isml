<isif condition="${pdict && pdict.giftWrapItem}">
    <isset name="giftWrapItem" value="${pdict.giftWrapItem}" scope="page" />
</isif>
<isif condition="${typeof(giftWrapItem) != 'undefined' && giftWrapItem}">
    <isset name="lineItem" value="${giftWrapItem}" scope="page" />
    <isset name="hasEmbeddedBonusProducts" value="${lineItem.bonusProductLineItemUUID === 'bonus'}" scope="page" />
    <isset name="bonusproductlineitem" value="${hasEmbeddedBonusProducts ? 'bonus-product-line-item' : ''}"
        scope="page" />
    <isset name="bonuslineitemrow" value="${hasEmbeddedBonusProducts ? 'bonus-line-item-row' : ''}" scope="page" />

    <div class="gift-wrap-product-card card product-info ${bonusproductlineitem} uuid-${lineItem.UUID}"
        data-uuid="${lineItem.UUID}" data-pid="${lineItem.id}" data-price="${lineItem.price.sales.formatted}">
        <!--- name and remove buttons --->
        <iscomment>
            <isinclude template="cart/productCard/cartProductCardHeader" />
        </iscomment>

        <div class="d-flex w-100 ${bonuslineitemrow}">
            <div class="col-md-7 p-0">
                <div class="d-flex">
                    <div class="item-image">
                        <img class="product-image" src="${lineItem.images.small[0].url}"
                            alt="${lineItem.images.small[0].alt}" title="${lineItem.images.small[0].title}" />
                    </div>
                    <div class="item-detail item-attributes d-flex flex-column">
                        <div class="item-desc">
                            <div class="line-item-header">
                                <div class="line-item-name">
                                    ${lineItem.fragranceName && lineItem.fragranceName !== '' ? lineItem.fragranceName : lineItem.productName}
                                </div>
                            </div>
                        </div>
                        <iscomment>
                            <isloop items="${lineItem.variationAttributes}" var="attribute">
                                <p class="line-item-attributes ${attribute.displayName}-${lineItem.UUID}">
                                    ${attribute.displayName}: ${attribute.displayValue}</p>
                            </isloop>
                            <isloop items="${lineItem.options}" var="option">
                                <isif condition="${!!option}">
                                    <div class="lineItem-options-values" data-option-id="${option.optionId}"
                                        data-value-id="${option.selectedValueId}">
                                        <p class="line-item-attributes">${option.displayName}</p>
                                    </div>
                                </isif>
                            </isloop>
                        </iscomment>

                        <iscomment>
                            <isinclude template="cart/productCard/cartProductCardAvailability" />
                        </iscomment>
                        <iscomment>
                            <isinclude template="cart/productCard/cartProductCardEdit" />
                        </iscomment>
                    </div>
                </div>
            </div>

            <div class="col-md-5 col-3 pr-0">
                <div class="d-flex">
                    <div class="">
                        <input type="number" class="quantity form-control h-fw--semibold border-0 p-0" data-uuid="${lineItem.UUID}"
                            data-pid="${lineItem.id}" data-action="${pdict.actionUrls.updateQuantityUrl}"
                            data-pre-select-qty="${StringUtils.formatInteger(lineItem.quantity)}" id="quantity-${lineItem.UUID}"
                            name="quantity-${lineItem.UUID}" data-max-order-qty="${lineItem.maxOrderQty}"
                            aria-label="quantity: ${StringUtils.formatInteger(lineItem.quantity)}"
                            value="${StringUtils.formatInteger(lineItem.quantity)}" ${lineItem.isFreeItem || lineItem.isEgiftCard ? 'disabled' : ''} />
                    </div>
                    <!---item price--->
                    <div class="text-right w-100 line-item-price line-item-total-price">
                        <div class="item-total-${lineItem.UUID} price">
                            <isinclude template="checkout/productCard/productCardProductTotalPrice" />
                        </div>
                    </div>

                    <isif condition="${!lineItem.isBonusProductLineItem}">

                        <div class="line-item-remove">
                            <span class="cart-delete-confirmation-btn" data-pid="${lineItem.id}" data-name="${lineItem.productName}"
                                data-action="${pdict.actionUrls.removeProductLineItemUrl}" data-uuid="${lineItem.UUID}">
                                <img src="${URLUtils.staticURL('/images/close-icon.svg')}" alt="close icon" width="20" />
                            </span>
                        </div>

                    </isif>
                </div>
            </div>
        </div>

        <isif condition="${lineItem.bonusProductLineItemUUID === 'bonus'}">
            <isinclude template="cart/productCard/cartEmbeddedBonusProducts" />
        </isif>
    </div>
</isif>
