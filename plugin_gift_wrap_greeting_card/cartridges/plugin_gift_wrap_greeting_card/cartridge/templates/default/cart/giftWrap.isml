<isscript>
    var assets = require('*/cartridge/scripts/assets.js');
    assets.addJs('/js/giftWrap.js');
</isscript>
<isif condition="${pdict.isGiftWrapEnable && pdict.wrapItemMethod}">
    <div class="giftWrapIndividualProductParent">
        <isinclude template="cart/giftWrapIndividualProduct" />
    </div>
    <iscomment> Gift - Wrap - Block </iscomment>
    <div class="giftwrap-block js-giftwrap">
        <div class="js-giftwrap-block">
            <div class="giftwrap-block-toggle">
                <input type="checkbox" id="giftwrap" class="js-giftwrap-checkbox" />
                <label for="giftwrap">${Resource.msg('add.gift.wrapping', 'giftWrap', null)}</label>
            </div>
            <div class="giftWrap-edit-product addGiftWrapProduct">
                <div hreflang="${request.getLocale()}" class="js-giftwrap-edit">
                    <span>${Resource.msg('edit.label', 'common', null)}</span>
                </div>
            </div>
            <isif condition="${pdict.items.length >= 1}">
                <div class="giftwrap-block-options js-giftwrap-options">
                    <div class="giftwrap-block-radio-wrapper"
                        data-error-message="${Resource.msg('error.select.giftwraptype', 'giftWrap', null)}">
                        <isif
                            condition="${pdict.wrapItemMethod == 'wrapTogether' || pdict.wrapItemMethod == 'wrapIndividualTogether'}">
                            <div id="giftwrap-block-radio" class="giftwrap-block-radio gift-wrap-toggle">
                                <isif condition="${pdict.isDisableTogetherOption}">
                                    <input type="radio" name="giftwrap-type" id="wrapTogether" value="TOGETHER"
                                        disabled />
                                <iselse/>
                                    <input type="radio" name="giftwrap-type" id="wrapTogether" value="TOGETHER" />
                                </isif>
                                <iscomment> class="${disableClass}" </iscomment>
                                <label for="wrapTogether">
                                    <span>${Resource.msg('wrap.everything.together', 'giftWrap', null)}</span>
                                    <span class="gift-wrap-price disabled"> (
                                        ${pdict.giftWrapProductPrice} )</span>
                                </label>
                            </div>
                        </isif>

                        <isif
                            condition="${pdict.wrapItemMethod == 'wrapIndividual' || pdict.wrapItemMethod == 'wrapIndividualTogether'}">
                            <div class="giftwrap-block-radio greeting-card-toggle" data-error-message="">
                                <isif condition="${pdict.isDisableIndividualOption}">
                                    <input type="radio" name="giftwrap-type" id="wrapIndividually" value="INDIVIDUAL"
                                        disabled />
                                <iselse/>
                                    <input type="radio" name="giftwrap-type" id="wrapIndividually" value="INDIVIDUAL" />
                                </isif>
                                <label class="wrapIndividuallyLabel" for="wrapIndividually">
                                    <span>${Resource.msg('wrap.items.individually', 'giftWrap', null)}</span>
                                    <span class="gift-wrap-price disabled">(
                                        ${pdict.giftWrapProductPrice}
                                        ${Resource.msg('individual.per.item', 'giftWrap', null)})</span>
                                </label>
                            </div>
                        </isif>
                        <div class="giftWrapProductOptions">
                            <isset name="isFirstIteration" value="${true}" scope="page" />
                            <isloop items="${pdict.giftWrapProducts}" var="giftWrapProduct" status="loopstate">
                                <isif condition="${giftWrapProduct !== null}">
                                    <div class="imgGiftWrap">
                                        <img src="${giftWrapProduct.images.large[0].url}"
                                            alt="${giftWrapProduct.productName}" />
                                        <input class="giftWrapProductOptionsRadio" name="gift-wrap-product"
                                            id="giftWrapProductOptionsRadio-${loopstate.count}" type="radio"
                                            value="${giftWrapProduct.id}" />
                                        <label class="giftWrapProductLabel"
                                            for="giftWrapProductOptionsRadio-${loopstate.count}"></label>
                                    </div>
                                    <isset name="isFirstIteration" value="${false}" scope="page" />
                                </isif>
                            </isloop>
                        </div>
                        <button id="addGiftWrapProduct" type="button" class="btn"
                            ${Resource.msg('error.select.wrappable.product', 'giftWrap', null)}
                            ${Resource.msg('error.select.giftwrap.product', 'giftWrap', null)}
                            data-actionurl="${URLUtils.url('Cart-AddProduct')}" data-wrap-pid data-wrap-type
                            data-gift-wrap-product-count>${Resource.msg('add.label', 'common', null)}</button>
                    </div>
                </div>
            </isif>
        </div>
    </div>
</isif>
