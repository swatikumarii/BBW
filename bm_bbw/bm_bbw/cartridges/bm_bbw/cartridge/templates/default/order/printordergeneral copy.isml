<iscontent type="text/html" charset="UTF-8" compact="true">
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.0 Transitional//EN">

<html>

    <head>
        <title>Order <isprint value="${pdict.Order.orderNo}"></title>
        <link rel="STYLESHEET" type="text/css" href="${URLUtils.webRoot()}/css/enterprisesite.css"/>
        <ismodule template = "inc/AddressInfoSmall_52.isml" name="AddressInfo" attribute="address">
        <link rel="shortcut icon" href="${URLUtils.webRoot()}/images/favicon.ico" />
    </head>

    <body id="print_order" onload="window.print();">
    <isscript>
        var formatMoney = require('dw/util/StringUtils').formatMoney;
        function getTotals(total) {
            return !total.available ? '-' : formatMoney(total);
        }
    </isscript>
        <div id="content">
            <table style="table-layout: fixed; width: 100%; ">
                <tbody>
                    <tr style="vertical-align: baseline; font-family: SourceSansPro, Arial, sans-serif;">
                        <td class="" style="vertical-align: bottom; width:56%;">
                            <div style="margin-left: 30px;">
                                <isset name="headerImage"
                                    value="${require('dw/system/Site').getCurrent().getCustomPreferenceValue('header_image')}"
                                    scope="page" />
                                <img class="hidden-md-down img-fluid w-100"
                                    src="${headerImage ? headerImage.url : URLUtils.staticURL('/images/invoice/bbw-logo-invoice.png')}"
                                    alt="${Resource.msg('global.storename', 'common', null)}" style="width: 220px" />
                            </div>
                        </td>
                        <td style="vertical-align: baseline;">
                        <h1>${Resource.msg('label.invoice', 'order', null)}</h1>
                            <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('companyAddress')}">
                                <div
                                    style="margin: 0;line-height: 18px; letter-spacing:0.75px;color:#1a1919">
                                    <isprint value="${dw.system.Site.getCurrent().getCustomPreferenceValue('companyAddress')}"
                                        encoding="off" />
                                </div>
                            </isif>
                            <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('customerServicePhone')}">
                                <div
                                    style="margin: 0;line-height: 18px; letter-spacing:0.75px;color:#1a1919">
                                    ${Resource.msg('label.contact', 'order', null)}:
                                    <isprint value="${dw.system.Site.getCurrent().getCustomPreferenceValue('customerServicePhone')}"
                                        encoding="off" />
                                </div>
                            </isif>
                            <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('customerServiceEmail')}">
                                <p
                                    style="margin: 0;line-height: 18px; letter-spacing:0.75px;color:#1a1919">
                                    ${dw.system.Site.getCurrent().getCustomPreferenceValue('customerServiceEmail')}
                                </p>
                            </isif>
                            <isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('companyTaxNumber')}">
                                <div style="margin: 0;line-height: 18px; letter-spacing:0.75px;color:#1a1919">
                                    ${Resource.msg('label.tax.number', 'order', null)}:
                                    <isprint value="${dw.system.Site.getCurrent().getCustomPreferenceValue('companyTaxNumber')}" encoding="off" />
                                </div>
                            </isif>
                        </td>
                    </tr>
                </tbody>
            </table>

            <div>
                <table
                    style="table-layout: fixed; width: 100%; background-color: #5a88b5; margin-top: 30px;">
                    <tbody>
                        <tr style="vertical-align: baseline;">
                            <td style="vertical-align:baseline;     padding: 19px 0px 19px 7px;">
                                <p style="color:white; font-size:19px; margin:0px; font-family: SourceSansPro, Arial, sans-serif; margin-bottom: 11px;">
                                    <span style="color:white; font-weight:700; font-size:19px">${Resource.msg('label.order', 'order', null)}: </span>
                                    ${pdict.Order.orderNo}
                                </p>
                                <p style="color:white; font-size:19px; margin-top:5px; font-family: SourceSansPro, Arial, sans-serif;">
                                    <span
                                        style="color:white; font-weight:700; font-size:19px">${Resource.msg('label.order.date', 'confirmation', null)} </span>
                                    <isprint value="${pdict.Order.creationDate}" style="DATE_LONG" />
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div style="padding-top:8px; padding-bottom:8px;">
                <table style="table-layout: fixed; width: 100%;    margin-left: 3px;">
                    <tbody>
                        <tr style="vertical-align: baseline; font-family: SourceSansPro, Arial, sans-serif;">
                            <td style="width:56%;">
                                <div>
                                    <div style="    background-color:#B0C8EA;  margin-left: -5px;     padding: 12px 9px;">
                                        <strong
                                            style="text-transform: uppercase;font-family: SourceSansPro, Arial,
                                            sans-serif;font-size:19px;letter-sapcing:1px;line-height:normal;display: block;width: 100%;">
                                            ${Resource.msg('billing.details.invoice', 'order', null)}:
                                        </strong>
                                    </div>
                                    <div>
                                        <isset name="address" value="${pdict.Order.billingAddress}"
                                            scope="page" />
                                        <p style="margin:0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            <isinclude template="order/addressSummaryInvoice" />
                                        </p>
                                    </div>
                                </div>
                            </td>
                            <td style="vertical-align:baseline; width:44%;">
                                <div style="    background-color:#B0C8EA; margin-left: -4px; padding: 12px 9px;">
                                    <strong class=""
                                        style="text-transform: uppercase;font-family: SourceSansPro, Arial,
                                            sans-serif;font-size:19px;letter-sapcing:1px;line-height:normal;">
                                        ${Resource.msg('shipping.details.invoice', 'order', null)}:
                                    </strong>
                                </div>
                                <div>
                                    <isloop items="${pdict.Order.shipments}" var="shippingModel" status="shippingLoop">
                                        <isset name="address" value="${shippingModel.shippingAddress}" scope="page" />
                                        <isinclude template="order/addressSummaryInvoice" />
                                    </isloop>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div style="padding-top:8px; padding-bottom:8px;">
                <table style="table-layout: fixed; width: 100%;">
                    <tbody>
                        <tr style="vertical-align: baseline; font-family: SourceSansPro, Arial, sans-serif;">
                            <td style="width:56%;">
                                <div>
                                    <div style=" background-color:#B0C8EA;  margin-left: -4px;     padding: 12px 9px;">
                                        <strong
                                            style="text-transform: uppercase;font-family: SourceSansPro, Arial,
                                            sans-serif;font-size:19px;letter-sapcing:1px;line-height:normal;display: block;width: 100%;">
                                        ${Resource.msg('label.order.payment.info', 'order', null)}:
                                        </strong>
                                    </div>
                                    <div style="padding: 0 10px;">
                                    <p>${Resource.msg('label.online.payment', 'order', null)}:
                                    <iscomment> <isinclude template="checkout/billing/paymentOptions/paymentOptionsSummary" />  </iscomment>
                                    </p>
                                    <div style="letter-spacing:0.75px;color:#1a1919"
                                        class="email">
                                        <p>${Resource.msg('label.payer.email', 'order', null)}:
                                        <span>
                                            <isif condition="${pdict.Order.customerEmail}">${pdict.Order.customerEmail}</isif>
                                        </span>
                                        </p>
                                    </div>
                                    </div>
                                </div>
                            </td>
                            <td style="vertical-align:baseline; width:44%;">
                                <div style="    background-color:#B0C8EA; margin-left: -4px; padding: 12px 9px;">
                                    <strong
                                        style="text-transform: uppercase;font-family: SourceSansPro, Arial, sans-serif;font-size:19px;letter-sapcing:1px;line-height:normal;">
                                        ${Resource.msg('label.order.shipping.method', 'confirmation', null)}
                                    </strong>
                                </div>
                                <div style="padding: 0 10px;">
                                    <isloop var="shippingModel" items="${pdict.Order.shipments}" status="shippingLoop">
                                        <p class="shipping-method"  style="text-align:left; margin-left: -3px;">
                                            <span
                                                class="shipping-method-title h-font-size--16">${Resource.msg('label.shipping', 'order', null)} : ${shippingModel.shippingMethod.ID} ${Resource.msg('label.shipping', 'order', null)}
                                                <isif condition="${shippingModel.trackingNumber}">
                                                    <a href="${pdict.order.trackingUrl + shippingModel.trackingNumber}" hreflang="${request.getLocale()}"
                                                        target="_blank">
                                                        <span>${shippingModel.trackingNumber}</span>
                                                    </a>
                                                </isif>
                                            </span>
                                        </p>
                                    </isloop>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <isloop var="shipping" items="${pdict.Order.shipments}">
                <iscomment> //pdict.order.items.items </iscomment>
                <div>
                    <table style="width: 100%;">
                        <thead style="width: 100%; vertical-align:baseline; font-family: SourceSansPro, Arial, sans-serif;">
                            <tr>
                                <th 
                                    style="text-align:left; width: 27%; font-size:19px; background-color:#B0C8EA; padding: 12px 9px;">
                                    ${Resource.msg('label.item.invoice.description', 'order', null)}
                                </th>
                                <th  style=" width: 18%; font-size:19px; background-color:#B0C8EA; padding: 12px 9px;">
                                    ${Resource.msg('label.item.sku', 'order', null)}
                                </th>
                                <th style="    background-color:#B0C8EA; font-size:19px; width: 16%; padding: 12px 9px;">
                                    ${Resource.msg('label.qty', 'order', null)}
                                </th>
                                <th style="    background-color:#B0C8EA; font-size:19px; width: 15%; padding: 12px 9px;">
                                    ${Resource.msg('label.price', 'order', null)}
                                </th>
                                <th
                                    style="    background-color:#B0C8EA; text-align: right; font-size:19px;  width: 12%; padding: 12px 9px;">
                                    ${Resource.msg('label.amount', 'order', null)}
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            <isloop items="${shipping.productLineItems}" var="lineItem">
                            
                                <tr style="font-family: SourceSansPro, Arial, sans-serif;">
                                    <td style=" padding: 5px; vertical-align: middle; height: 120px;"
                                        valign="center">
                                        <div class="product-card-wrapper" style="width: 100%;height: auto;display: flex;">
                                            <div class="product-image">
                                                <isif condition="${lineItem.ispersonalizedGiftcard}">
                                                    <img style="float:left;margin-right:10px"
                                                        src="${lineItem.personalizeGiftcardImage}" alt="${lineItem.alt}" height="90"
                                                        width="90">
                                                <iselse/>
                                                    <img style="float:left;" src="${lineItem.images.small[0].absURL}"
                                                        alt="${lineItem.images.small[0].alt}"
                                                        title="${lineItem.images.small[0].title}" height="90" width="90">
                                                </isif>
                                            </div>
                                            <div class="product-details" style="margin-top:12px;">
                                                <isif condition="${lineItem.ispersonalizedGiftcard}">
                                                    <p style="margin:0px;font-size:16px;letter-spacing: 0.75px;color: #1a1919;">
                                                        ${Resource.msg('personalized.giftcard.name', 'common', null)}</p>
                                                <iselse/>
                                                    <p style="margin:0px;font-size:16px;letter-spacing: 0.75px;color: #1a1919; margin-left:16px;">
                                                    ${lineItem.product.custom.fragranceName && lineItem.product.custom.fragranceName !== '' ? lineItem.product.custom.fragranceName : lineItem.productName}</p>
                                                </isif>
                                                <isif condition="${lineItem.product.custom.titlePartB}">
                                                    <p style="margin:0px;font-size:16px;letter-spacing: 0.75px;color: #1a1919; margin-left:16px;">${lineItem.product.custom.titlePartB}
                                                    </p>
                                                </isif>
                                                <isif condition="${lineItem.product.custom.volume}">
                                                    <p style="margin:0px;font-size:16px;letter-spacing: 0.75px;color: #1a1919; margin-left:16px;">${lineItem.product.custom.volume}</p>
                                                </isif>
                                                <isif condition="${lineItem.custom.productCategory === 'greetingCardProducts'}">
                                                    <p
                                                        style="margin:0px;font-size:14px;font: normal 14px/24px ScalaSansOT,sans-serif; letter-spacing: 0.75px;color: #1a1919;">
                                                        ${lineItem.custom.greetingCardMessage}</p>
                                                </isif>
                                                <isif
                                                    condition="${lineItem.custom.isEgiftCard}">
                                                    <p
                                                        style="margin:0px; margin-left: 10px;font-size:14px;font: normal 14px/24px ScalaSansOT,sans-serif; letter-spacing: 0.75px;color: #1a1919;">
                                                        ${Resource.msg('productCard.egift.email.label', 'cart', null)}
                                                        ${lineItem.custom.eGiftReceiverEmail}</p>
                                                </isif>
                                            </div>
                                        </div>
                                    </td>
                                    <td valign="center">
                                        <div class="product-card-wrapper">
                                            <div class="product-details" style="text-align:center">
                                                <p
                                                    style="margin:0px;font-size:14px;font: normal 14px/24px ScalaSansOT,sans-serif; letter-spacing: 0.75px;color: #1a1919;">
                                                    ${lineItem.productID}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td align="center">
                                        <isprint value="${lineItem.quantity.value}" formatter="##" />
                                    </td>
                                    <td align="center">
                                    <iscomment> TODO: check this again </iscomment>
                                        <isset name="price" value="${lineItem.adjustedPrice}" scope="page" />
                                        <isloop items="${lineItem.optionProductLineItems}" var="item">
                                            <isset name="price" value="${price.add(item.adjustedPrice)}" scope="page" />
                                        </isloop>
                                        <isif condition="${lineItem.noProduct}">
                                            <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                            ${lineItem.basePrice.currencyCode} ${lineItem.basePrice.value}</div>
                                        <iselseif condition="${price && price.value <= 0}"/>
                                            <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                            </div>
                                        <iselse/>
                                            <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                                <isscript>
                                                    var PromotionMgr = require('dw/campaign/PromotionMgr');
                                                    var promotions = PromotionMgr.activeCustomerPromotions.getProductPromotions(apiProduct);
                                                </isscript>
                                                ${getTotals(price)}
                                                <iscomment> ${lineItem.adjustedPrice}
                                                ${lineItem.price.sales.formatted} </iscomment>
                                            </div>
                                        </isif>
                                    </td>
                                    <td align="right" style=" padding: 5px; font-family: SourceSansPro, Arial,
                                                sans-serif;">
                                        <isif condition="${lineItem.noProduct}">
                                            <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                            ${price.currencyCode} ${price.value}</div>
                                        <iselseif
                                            condition="${price && price.value <= 0}"/>
                                            <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                                ${Resource.msg('label.free.price', 'cart', null)}</div>
                                        <iselse/>
                                            <div class="pricing line-item-total-price-amount item-total-${lineItem.UUID}">
                                                ${getTotals(price)}</div>
                                        </isif>
                                    </td>
                                </tr>
                            </isloop>
                        </tbody>
                    </table>
                </div>
                <iscomment> TODO: TotalDiscount and alldiscount </iscomment>
                <isscript>
                    var Money = require('dw/value/Money');
                    var totalDiscount = 0;
                    var allDiscounts = [];
                    var allProductLineItems = shipping.allProductLineItems;
                    var orderLevelpriceAdjustments = shipping.priceAdjustments;
                    for (var i = 0; i < allProductLineItems.length; i++) {
                        var productLineItem = allProductLineItems[i];
                        if (
                            'priceAdjustments' in productLineItem &&
                            productLineItem.priceAdjustments &&
                            productLineItem.priceAdjustments.length > 0
                        ) {
                            for(var j = 0; j < productLineItem.priceAdjustments.length; j++) {
                                var priceAdjustment = productLineItem.priceAdjustments[j];
                                var discountObject = {
                                    promotion: priceAdjustment.lineItemText,
                                    discount: getTotals(priceAdjustment.grossPrice)
                                };
                                totalDiscount+= priceAdjustment.grossPrice.value;
                                allDiscounts.push(discountObject);
                            };
                        }
                    }
                    if (orderLevelpriceAdjustments.length > 0) {
                        for (var k = 0; k < orderLevelpriceAdjustments.length; k++) {
                            var orderLevelpriceAdjustment = orderLevelpriceAdjustments[k];
                            var discountObject = {
                                promotion: orderLevelpriceAdjustment.lineItemText,
                                discount: getTotals(orderLevelpriceAdjustment.grossPrice)
                            };
                            totalDiscount += orderLevelpriceAdjustment.grossPrice.value;
                            allDiscounts.push(discountObject);
                        }
                    }
                    totalDiscount = new Money(totalDiscount, shipping.currencyCode)
                </isscript>
                =======${allDiscounts.length}
                ++++${totalDiscount}
                <div style="text-align:end;">
                    <table style="table-layout: fixed; width: 100%; border-collapse: collapse; max-width:800px; margin:15px auto; font-family: SourceSansPro, Arial, sans-serif;">
                        <tbody>
                            <isset name="totalExclusiveTax"
                                value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showTotalsExcludingTaxes')}"
                                scope="page" />
                            <isset name="shippingExclusiveTax"
                                value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingExcludingTaxes')}"
                                scope="page" />
                            <isset name="showSalesTaxes" value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showSalesTaxes')}"
                                scope="page" />
                            <isset name="showShippingHandlingTaxes"
                                value="${dw.system.Site.getCurrent().getCustomPreferenceValue('showShippingHandlingTaxes')}" scope="page" />

                            <isif condition="${totalExclusiveTax}">
                                <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                    <div class="col-md-10">
                                        <p class="h-font-size--16 h-clr--red-1" style=" margin-bottom: 0px;">
                                            <strong>${Resource.msg('label.merchandise.subtotal.excluding.taxes', 'cart', null)}:</strong>
                                        </p>
                                    </div>
                                    <div class="col-md-2" style=" margin-left: 31px;">
                                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total "
                                            style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            <iscomment> TODO:
                                            app_custom_bbw/cartridges/app_custom_bbw/cartridge/models/totals.js
                                            lineItemContainer.adjustedMerchandizeTotalNetPrice - allDiscounts.totalDiscount </iscomment>
                                            ${shipping.adjustedMerchandizeTotalNetPrice - totalDiscount}
                                            <iscomment> ${pdict.order.totals.subTotalExclTax} </iscomment>
                                        </p>
                                    </div>
                                </div>
                            <iselse/>
                                <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                    <div class="col-md-10">
                                        <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            <strong>${Resource.msg('label.merchandise.subtotal', 'cart', null)}:</strong>
                                        </p>
                                    </div>
                                    <div class="col-md-2" style=" margin-left: 31px;">
                                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total"
                                            style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            ${pdict.order.totals.subTotal}
                                        </p>
                                    </div>
                                </div>
                            </isif>
                            <isif condition="${totalDiscount.value != 0}">
                                <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                    <div class="col-md-10">
                                        <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            <strong>${Resource.msg('label.order.savings', 'common', null)}:</strong>
                                        </p>
                                    </div>
                                    <div class="col-md-2" style=" margin-left: 31px;">
                                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total"
                                            style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            -----${totalDiscount}
                                            ${getTotals(totalDiscount)}</p>
                                    </div>
                                </div>
                                <isif condition="${allDiscounts.length > 0}">
                                    <isloop items="${allDiscounts}" var="discount" status="loopstatus">
                                        <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                            <div class="col-md-10">
                                                <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                                    <strong>${discount.promotion}:</strong>
                                                </p>
                                            </div>
                                            <div class="col-md-2" style=" margin-left: 31px;">
                                                <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sub-total"
                                                    style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                                    ${discount.discount}</p>
                                            </div>
                                        </div>
                                    </isloop>
                                </isif>
                            </isif>

                            <isscript>
                                var hasFreeShipping=false;
                                if (shipping && shipping.allShippingPriceAdjustments && shipping.allShippingPriceAdjustments.length) {
                                    if (shipping.allShippingPriceAdjustments[0].appliedDiscount && shipping.allShippingPriceAdjustments[0].appliedDiscount.type === 'FREE'){
                                        hasFreeShipping = true;
                                    }
                                }
                            </isscript>
                            <isif condition="${shippingExclusiveTax}">
                                <div class="row" style="display:flex; justify-content: flex-end;">
                                    <div class="col-md-10">
                                        <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            <strong>${Resource.msg('label.shipping.and.handling.excluding.taxes', 'cart', null)}:</strong>
                                        </p>
                                    </div>
                                    <div class="col-md-2" style=" margin-left: 38px;">
                                        <isif condition="${!hasFreeShipping}">
                                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive">
                                                ${getTotals(shipping.adjustedShippingTotalNetPrice)}</p>
                                        <iselse/>
                                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-exclusive">
                                                ${Resource.msg('label.free.price', 'cart', null)}</p>
                                        </isif>
                                    </div>
                                </div>
                            <iselse/>
                                <div class="row" style="display:flex; justify-content: flex-end;">
                                    <div class="col-md-10">
                                        <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;">
                                            <strong>${Resource.msg('label.shipping.and.handling', 'cart', null)}:</strong>
                                        </p>
                                    </div>
                                    <div class="col-md-2" style=" margin-left: 35px;">
                                        <p style=" margin-bottom: 0px; font-family: SourceSansPro, Arial, sans-serif;"
                                            class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-cost tax-inclusive">
                                            <isif condition="${!hasFreeShipping}">
                                                ${getTotals(shipping.shippingTotalPrice)}
                                            <iselse/>
                                                ${Resource.msg('label.free.price', 'cart', null)}
                                            </isif>
                                        </p>
                                    </div>
                                </div>
                            </isif>

                            <isif condition="${showShippingHandlingTaxes}">
                                <isif condition="${!hasFreeShipping}">
                                    <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                        <div class="col-md-10">
                                            <isif condition="${shippingExclusiveTax}">
                                                <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px;">
                                                    <strong>${Resource.msg('label.shipping.and.handling.tax', 'cart', null)}:</strong>
                                                </p>
                                            <iselse/>
                                                <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px;">
                                                    <strong> ${Resource.msg('label.shipping.and.handling.tax.inclusive', 'cart', null)}:</strong>
                                                </p>
                                            </isif>
                                        </div>
                                        <div class="col-md-2" style=" margin-left: 34px;">
                                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-tax"
                                                style=" margin-bottom: 0px;">
                                                ${getTotals(shipping.shippingTotalTax)}</p>
                                        </div>
                                    </div>
                                </isif>
                            </isif>

                            <isif condition="${!hasFreeShipping}">
                                <isscript>
                                    var totalExcludingShippingDiscount = shipping.shippingTotalPrice;
                                    var totalIncludingShippingDiscount = shipping.adjustedShippingTotalPrice;
                                    var shippingDiscount = totalExcludingShippingDiscount.subtract(totalIncludingShippingDiscount);

                                    var shippingDiscountValue = shippingDiscount.value;
                                    var shippingDiscountFormatted = getTotals(shippingDiscount);
                                </isscript>
                                <isif condition="${shippingDiscountValue === 0}">
                                    <div class="row shipping-discount" style="display:none; font-family: SourceSansPro, Arial, sans-serif;">
                                        <div class="col-md-10">
                                            <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px;">
                                                <strong>${Resource.msg('label.shipping.discount', 'common', null)}:</strong>
                                            </p>
                                        </div>
                                        <div class="col-md-2" style=" margin-left: 29px;">
                                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-discount-total"
                                                style=" margin-bottom: 0px;">
                                                ${'-' + shippingDiscountFormatted}</p>
                                        </div>
                                    </div>
                                <iselse/>
                                    <div class="row shipping-discount" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                        <div class="col-md-10">
                                            <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px;">
                                                <strong>${Resource.msg('label.shipping.discount', 'common', null)}:</strong>
                                            </p>
                                        </div>
                                        <div class="col-md-2" style=" margin-left: 29px;">
                                            <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold shipping-discount-total"
                                                style=" margin-bottom: 0px;">
                                                <iscomment> ${'-' + pdict.order.totals.shippingLevelDiscountTotal.formatted} </iscomment>
                                                ${'-' + shippingDiscountFormatted}
                                            </p>
                                        </div>
                                    </div>
                                </isif>
                            </isif>
                            <isif condition="${showSalesTaxes}">
                                <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                    <div class="col-md-10">
                                        <isif condition="${totalExclusiveTax}">
                                            <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px;">
                                                <strong>${Resource.msg('label.sales.tax', 'cart', null)}:</strong>
                                            </p>
                                        <iselse/>
                                            <p class="h-font-size--16 h-clr--black-1" style=" margin-bottom: 0px;">
                                                <strong>${Resource.msg('label.sales.tax.inclusive', 'cart', null)}:</strong>
                                            </p>
                                        </isif>
                                    </div>
                                    <div class="col-md-2" style=" margin-left: 33px;">
                                        <p class="text-right h-font-size--16 h-clr--black-1 h-fw--semibold sales-tax"
                                            style=" margin-bottom: 0px;">
                                            <iscomment> ${pdict.order.totals.salesTax} </iscomment>
                                            ${getTotals(shipping.adjustedMerchandizeTotalTax)}
                                        </p>
                                    </div>
                                </div>
                            </isif>

                            <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                <div class="col-md-10">
                                    <p class="h-font-size--18 h-clr--black-1 h-fw--semibold" style=" margin-bottom: 0px;">
                                        <strong>${Resource.msg('label.estimatedtotal', 'cart', null)}:</strong>
                                    </p>
                                </div>
                                <div class="col-md-2" style=" margin-left: 26px;">
                                    <p class="text-right h-font-size--18 h-clr--black-1 h-fw--semibold grand-total"
                                        style=" margin-bottom: 0px;">
                                        <iscomment> ${pdict.order.totals.grandTotal} </iscomment>
                                        ${getTotals(shipping.totalGrossPrice)}
                                    </p>
                                </div>
                            </div>
                            <isscript>
                                var TaxMgr = require('dw/order/TaxMgr');
                                var taxClassId = TaxMgr.getDefaultTaxClassID();
                                var taxJurisdictionId = TaxMgr.getDefaultTaxJurisdictionID();
                                var getTaxRate = TaxMgr.getTaxRate(taxClassId, taxJurisdictionId);
                                var taxRate = getTaxRate * 100;
                            </isscript>
                            <isif condition="${taxRate !== 0}">
                                <div class="row" style="display:flex; justify-content: flex-end; font-family: SourceSansPro, Arial, sans-serif;">
                                    <p class="h-font-size--18 h-clr--black-1 h-fw--semibold" style=" margin-bottom: 0px;">
                                        ${Resource.msgf('label.tax.rate', 'order', null, taxRate)}</p>
                                </div>
                            </isif>
                        </tbody>
                    </table>
                </div>
            </isloop>
            <div>
                <table style="table-layout: fixed; width: 100%; font-family: SourceSansPro, Arial, sans-serif;">
                    <tbody>
                        <tr style="vertical-align: baseline; font-family: SourceSansPro, Arial, sans-serif;">
                            <td style="vertical-align:baseline;">
                                <p style="font-size:16px; margin-bottom: 20px;">
                                    ${Resource.msg('label.invoice.purchase', 'order', null)}
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div>
                <table style="table-layout: fixed; width: 100%; font-family: SourceSansPro, Arial, sans-serif;">
                    <tbody>
                        <tr style="vertical-align: baseline;">
                            <td style="vertical-align:baseline;">
                                <p style="font-size:16px; margin-bottom: 20px;">
                                    ${Resource.msg('label.contact.return', 'order', null)}
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div>
                <table style="table-layout: fixed; width: 100%; font-family: SourceSansPro, Arial, sans-serif;">
                    <tbody>
                        <tr style="vertical-align: baseline;">
                            <td style="vertical-align:baseline;">
                                <p style="font-size:16px;">
                                    ${Resource.msg('label.contat.service', 'order', null)}
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div>
                <table style="table-layout: fixed; width: 880px; margin-top: 20px; margin-bottom: 21px; font-family: SourceSansPro, Arial, sans-serif; ">
                    <tbody>
                        <tr style="vertical-align: baseline; display:flex;  margin-left: 40px;">
                            <td style="vertical-align:baseline; display:flex; align-items:center;">
                                <img class=" img-fluid w-100"
                                    src="${headerImage ? headerImage.url : URLUtils.staticURL('/images/invoice/InvoiceReports-revis-logo-01.png')}"
                                    alt="${Resource.msg('global.storename', 'common', null)}" style="width: 50px" />
                                <p style="font-size:16px; margin-bottom: 20px; width: 227px; margin-left: 20px;">
                                    ${Resource.msg('label.return.faulty', 'order', null)}
                                </p>
                            </td>
                            <td style="vertical-align:baseline;  display:flex; align-items:center;">
                                <img class=" img-fluid w-100"
                                    src="${headerImage ? headerImage.url : URLUtils.staticURL('/images/invoice/InvoiceReports-revis-logo-02.png')}"
                                    alt="${Resource.msg('global.storename', 'common', null)}" style="width: 50px" />
                                <p style="font-size:16px; margin-bottom: 20px; width: 176px; margin-left: 10px;">
                                    ${Resource.msg('label.invoice.available', 'order', null)}
                                </p>
                            </td>
                            <td style="vertical-align:baseline;  display:flex; align-items:center;">
                                <img class="img-fluid w-100"
                                    src="${headerImage ? headerImage.url : URLUtils.staticURL('/images/invoice/InvoiceReports-revis-logo-03.png')}"
                                    alt="${Resource.msg('global.storename', 'common', null)}" style="width: 50px" />
                                <p style="font-size:16px; margin-bottom: 20px; width: 200px; margin-left: 20px;">
                                    ${Resource.msg('label.packaging', 'order', null)}
                                </p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div>
                <table style="table-layout: fixed; width: 100%; font-family: SourceSansPro, Arial, sans-serif;">
                    <tbody>
                        <tr style="vertical-align: baseline;">
                            <td style="vertical-align:baseline;">
                                <h1 style="font-size:16px; margin-bottom:0px;">
                                    ${Resource.msg('label.return.policy', 'order', null)}
                                </h1>
                                <ol style="padding-left:22px; padding-top:0px; margin-top:0px;">
                                    <li style="font-size:16px">
                                        ${Resource.msg('first.return.policy', 'order', null)}
                                    </li>
                                    <li style="font-size:16px">
                                        ${Resource.msg('second.return.policy', 'order', null)}
                                    </li>
                                    <li style="font-size:16px">
                                        ${Resource.msg('third.return.policy', 'order', null)}
                                    </li>
                                    <li style="font-size:16px">
                                        ${Resource.msg('fourth.return.policy', 'order', null)}
                                    </li>
                                </ol>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </body>
</html>
