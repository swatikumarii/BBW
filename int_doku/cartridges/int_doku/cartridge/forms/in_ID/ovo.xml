<?xml version="1.0"?>
<form xmlns="http://www.demandware.com/xml/form/2008-04-19">

    <!-- fields for email and phone number -->
    <field formid="ovoID" label="profile.ovoid" type="string" mandatory="true" binding="ovoID"
           min-length="6" max-length="12" regexp="^([0-9]{8,12})$" missing-error="error.card.info.missing.ovoID"
           parse-error="error.message.parse.ovoid.form" range-error="error.message.between12and6"
           value-error="ValueErrorText" required="" />

</form>
