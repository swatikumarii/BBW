{
  "name": "plugin_event_tracking",
  "version": "0.0.1",
  "description": "New overlay cartridge",
  "main": "index.js",
  "scripts": {
    "lint": "npm run lint:js && npm run lint:isml",
    "lint:css": "sgmf-scripts --lint css",
    "lint:js": "sgmf-scripts --lint js",
    "lint:fix": "sgmf-scripts --lint js --fix && sgmf-scripts --lint css --fix",
    "init:isml": "./node_modules/.bin/isml-linter --init",
    "lint:isml": "./node_modules/.bin/isml-linter",
    "build:isml": "./node_modules/.bin/isml-linter --build",
    "fix:isml": "./node_modules/.bin/isml-linter --autofix",
    "upload": "sgmf-scripts --upload -- ",
    "uploadCartridge": "sgmf-scripts --uploadCartridge plugin_notify_back_in_stock",
    "compile:js": "sgmf-scripts --compile js",
    "compile:scss": "sgmf-scripts --compile css"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint"
    ],
    "*.json": [
      "prettier"
    ],
    "*.{css,scss}": [
      "stylelint"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "chai": "^3.5.0",
    "css-loader": "^6.0.0",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsdoc": "^48.2.2",
    "isml-linter": "^5.26.4",
    "lint-staged": "^15.2.2",
    "mini-css-extract-plugin": "^2.7.6",
    "mocha": "^10.0.0",
    "nyc": "^15.1.0",
    "postcss-loader": "^7.0.0",
    "prettier": "3.0.0",
    "proxyquire": "1.7.4",
    "sass": "^1.69.7",
    "sass-loader": "^13.3.2",
    "sgmf-scripts": "^3.0.0",
    "sinon": "^17.0.1",
    "stylelint": "^16.3.1",
    "stylelint-config-standard-scss": "^13.0.0",
    "stylelint-prettier": "^5.0.0",
    "webpack-remove-empty-scripts": "^1.0.4"
  },
  "browserslist": [
    "last 2 versions",
    "ie >= 10"
  ]
}
