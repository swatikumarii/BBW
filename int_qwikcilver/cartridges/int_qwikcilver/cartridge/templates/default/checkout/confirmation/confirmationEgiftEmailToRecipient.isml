<!DOCTYPE html>
<html lang="en">

<head>
    <isinclude template="/components/modules" sf-toolkit="off" />
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>

<body>
        <isloop items="${pdict.order.items.items}" var="lineItem" status="loopState">
            <isif condition="${pdict.sendEmailNow && pdict.recipientEmail === lineItem.giftCardDetails.recipientEmail && pdict.giftcardNumber ===
                                            loopState.index}">
                <isinclude template="checkout/confirmation/confirmationEmailGiftLineItem" sf-toolkit="off" />
            </isif>
        </isloop>
   
    <table border="0" cellspacing="0" width="660" align="center"
        style="font-size:12px; font-family:arial,helvetica,sans-serif; color:#000000; background-color:#f6f4f2">
        <tbody>
            <iscontentassetmail aid="egift-order-email" />
        </tbody>
    </table>
</body>

</html>
