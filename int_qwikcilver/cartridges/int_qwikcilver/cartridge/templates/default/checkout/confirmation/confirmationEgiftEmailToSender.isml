<isinclude template="/components/modules" sf-toolkit="off" />
<isdecorate template="common/layout/email">
    <isset name="urlHelpers" value="${require('*/cartridge/scripts/helpers/urlHelpers')}" scope="page" />

    <tr style="padding: 0;">
        <td style="vertical-align: middle; text-align: center; color: #333; font-size:14px;">
            <table style="padding-top:35px;" cellpadding="0" cellspacing="0" border="0" align="center" width="100%">

                <tr style="padding: 0;">
                    <td style="padding:0 32px 15px;vertical-align:top;text-align:left;">

                        <table cellpadding="0" cellspacing="0" style="width:100%">
                            <tbody>
                                <tr>
                                    <td style="vertical-align:bottom;text-align:left;font-size:18px">
                                        ${Resource.msg('label.order.number', 'confirmation', null)}
                                        <div style="color:#005699;font-weight:bold;font-size:22px;padding-top:6px">
                                            <a href="${dw.web.URLUtils.abs('Order-Status')}"
                                                title="${pdict.order.orderNumber}"
                                                style="text-decoration:none;color:#005699;font-weight:bold;font-size:22px;"
                                                target="_blank">
                                                ${pdict.order.orderNumber}
                                            </a>
                                        </div>
                                    </td>
                                    <td style="vertical-align:bottom;text-align:right;font-size:18px">
                                        ${Resource.msg('label.order.date', 'confirmation', null)} <span
                                            style="font-weight:bold">
                                            <isprint value="${new Date(pdict.order.creationDate)}"
                                                formatter="dd/MM/YYYY " timezone="SITE" />
                                        </span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <iscomment> Order Customer Name and Thank you Text</iscomment>
                        <h1
                            style="margin:35px 0 14px;font-size:28px;font-weight:normal;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            ${Resource.msgf('email.title.confirmation.sender.name', 'confirmation', null, pdict.order.billing.billingAddress.address
                            .firstName)}
                        </h1>
                        <p
                            style="margin:0 0 20px;font-size:22px;line-height:33px;padding-right:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            <isprint
                                value="${Resource.msgf('egift.card.msg.thank.you', 'giftcards', null, pdict.recipientName, pdict.recipientEmail)}"
                                encoding="off" />
                        </p>
                        <p
                            style="margin:0 0 20px;font-size:22px;line-height:33px;padding-right:20px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif">
                            <isprint value="${Resource.msg('egift.copy.friend.see.text', 'giftcards', null)}"
                                encoding="off" />
                        </p>
                        <iscomment> Gift Card Image Details </iscomment>
                        <div style="border:2px solid #f2f2f2;padding:15px 0 24px; margin-bottom:30px;">
                            <isloop items="${pdict.order.items.items}" var="lineItem">
                                <p
                                    style="margin:0;font-size:36px;line-height:50px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center">
                                    <isprint value="${Resource.msg('egift.surprise.heading', 'giftcards', null)}"
                                        encoding="off" />
                                </p>
                                <p
                                    style="margin:0 0 20px;font-size:16px;line-height:18px;font-family:'HelveticaNeue-Light','Helvetica Neue Light','Helvetica Neue',Helvetica,Arial,sans-serif;color:#005699;font-weight:bold;text-align:center;text-transform: capitalize;">
                                    ${Resource.msgf('egift.treated.msg', 'giftcards', null, lineItem.giftCardDetails.senderName)}
                                </p>
                                <iscomment> Normal Product Line Items </iscomment>
                                <table width="100%" cellpadding="0" cellspacing="0"
                                    style="border-collapse:collapse;margin-top:15px;">
                                    <tbody>
                                        <isif condition="${pdict.order.shipping.length === 1}">
                                            <tr>
                                                <td style="vertical-align:middle;padding-left: 32px;padding-right: 15px;width: 50%;">
                                                    <a style="display:block;text-align:left;"
                                                        href="${URLUtils.https('Product-Show', 'pid', lineItem.id)}">
                                                        <img src="${lineItem.images.small_2x[0].absURL}"
                                                            alt="${lineItem.images.large[0].alt}"
                                                            title="${lineItem.images.large[0].title}"
                                                            style="border:0;vertical-align:top;width:100%;max-height: 261px;height: 100%;max-width:261px;"
                                                            width="261" />
                                                    </a>
                                                    <p
                                                        style="color:#666;font-size:14px;line-height:18px;padding: 0;margin: 5px 0 0;text-align:left;">
                                                        ${Resource.msg('egift.amount.label', 'giftcards', null)}
                                                    </p>
                                                    <p
                                                        style="color:#000000;font-size:20px;font-weight:bold;padding:0;margin: 5px 0;text-align:left;">
                                                        ${lineItem.priceTotal.price}</p>
                                                    <p
                                                        style="margin:0;color:#000000;font-size:14px;line-height:18px;padding:0;text-align:left;">
                                                        ${Resource.msg('egift.useit.store.text', 'giftcards', null)}
                                                    </p>
                                                </td>
                                                <td style="padding: 0;vertical-align:top;width: 30%;">
                                                    <iscomment> <div
                                                        style="text-transform:uppercase;font-size:16px;color:#333;margin-bottom:15px;line-height:23px">
                                                        <a href="${URLUtils.https('Product-Show', 'pid', lineItem.id)}"
                                                            title="${lineItem.productName}"
                                                            style="text-decoration:none;text-transform:uppercase;font-size:16px;color:#333;line-height:23px;margin-bottom:15px;font-family:'HelveticaNeue-Light',Arial,sans-serif"
                                                            target="_blank">${lineItem.productName}</a>
                                                    </div> </iscomment>
                                                    <div style="text-transform: capitalize;color:#666;font-size:14px;line-height:18px;margin-bottom:15px;">
                                                        ${lineItem.giftCardDetails.recipientName + ','}
                                                    </div>
                                                    <isif
                                                        condition="${lineItem.giftCardDetails.eGiftMessage && lineItem.giftCardDetails.eGiftMessage !== null}">
                                                        <div style="color:#666;font-size:14px;line-height:18px;margin-bottom:15px;">
                                                            ${lineItem.giftCardDetails.eGiftMessage}
                                                        </div>
                                                    </isif>
                                                    <div style="color:#666;font-size:14px;line-height:18px;text-transform: capitalize;">
                                                        ${'- ' + lineItem.giftCardDetails.senderName}
                                                    </div>
                                                </td>
                                                <td style="width: 20%;"></td>
                                            </tr>
                                        </isif>
                                    </tbody>
                                </table>
                            </isloop>
                        </div>
                        <div>
                            <iscomment> Terms and Conditions Content Asset </iscomment>
                            <isprint value="${pdict.markup}" encoding="off" />
                        </div>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</isdecorate>
