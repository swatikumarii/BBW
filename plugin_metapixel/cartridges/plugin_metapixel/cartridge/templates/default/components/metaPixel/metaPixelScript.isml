<isif condition="${dw.system.Site.getCurrent().getCustomPreferenceValue('metaPixelEnabled')}">
    <isprint value="${dw.system.Site.getCurrent().getCustomPreferenceValue('metaPixelScript')}" encoding="off" />
    <script defer="defer" src="${URLUtils.staticURL('/js/metaPixel.js')}"></script>
        <isif condition="${pdict.fbqData.event && pdict.fbqData.data}">
            <script>
                var fbqDataEvent = <isprint value="${JSON.stringify(pdict.fbqData.event)}" encoding="off" />;
                var fbqDataData = <isprint value="${JSON.stringify(pdict.fbqData.data)}" encoding="off" />;
                if (fbqDataEvent && fbqDataData) {
                    if (['Locator Search'].includes(fbqDataEvent)){
                        fbq('trackCustom', fbqDataEvent, fbqDataData);
                    } else {
                        fbq('track', fbqDataEvent, fbqDataData);
                    }
                }
            </script>
    </isif>
</isif>
