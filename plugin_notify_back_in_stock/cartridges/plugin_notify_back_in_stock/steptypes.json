{
    "step-types": {
        "script-module-step": [
            {
                "@type-id": "custom.NotifyBackInStock",
                "@supports-parallel-execution": "true",
                "@supports-site-context": "true",
                "@supports-organization-context": "false",
                "description": "Send email notification if product is back in stock",
                "module": "plugin_notify_back_in_stock/cartridge/scripts/jobs/notifyBackInStock.js",
                "function": "sendEmail",
                "transactional": "true",
                "timeout-in-seconds": "900",
                "parameters": {
                    "parameter": []
                },
                "status-codes": {
                    "status": [
                        {
                            "@code": "ERROR",
                            "description": "The process cound not be completed successfully."
                        },
                        {
                            "@code": "FINISHED",
                            "description": "Successfully notified."
                        }
                    ]
                }
            }
        ]
    }
}
