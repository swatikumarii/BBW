<isinclude template="/components/modules" sf-toolkit="off" />
<isset name="urlHelpers" value="${require('*/cartridge/scripts/helpers/urlHelpers')}" scope="page" />
<isset name="totalRows" value="${Math.ceil(pdict.product.length / 4)}" scope="page" />
<isdecorate template="common/layout/email">
    <tr style="padding: 0;">
        <td style="vertical-align: middle; text-align: center; color: #333; font-size:14px;">
            <table style="padding:35px 0; table-layout: fixed;" cellpadding="0" cellspacing="0" border="0" align="center"
                width="100%">
                <iscomment> Notify Email Content Asset - Content </iscomment>
                <tr style="padding: 0;">
                    <td style="padding:0;vertical-align:top;text-align:left;">
                        <isprint value="${pdict.markup}" encoding="off" />
                    </td>
                </tr>
                <tr style="padding: 0;">
                    <td style="padding:0 32px 0;vertical-align:top;text-align:left;">
                        <h2
                            style="text-align:center;margin:24px 0;color: #005699;font-size: 24px;letter-spacing: 0;line-height: 28px;font-weight: 700;text-transform: uppercase;">
                            ${Resource.msg('header.notifyme.email', 'email', null)}</h2>
                    </td>
                </tr>
            </table>
            <table style="padding: 0 32px 35px; table-layout: fixed;" cellpadding="0" cellspacing="0" border="0" align="center" width="100%">
                <isset name="rowindex" value="${Array(totalRows).fill(0)}" scope="page" />
                <isset name="rowNo" value="${0}" scope="page" />
                <isloop items="${rowindex}" var="productRow" status="loopstatus">
                    <tr style="padding: 0;">
                        <isloop items="${pdict.product.slice(rowNo * 4, (rowNo + 1) * 4)}" var="productDetail" status="productLoop">
                            <td align="center" style="padding:0 5px 20px;vertical-align:top;text-align:center;">
                                <div class="product-tile" style="width: 100%;max-width: 200px;margin: 0 auto;">
                                    <div class="img-wrapper" style="width: 100%;text-align: center;margin: 0 auto;">
                                        <a class="product-ing-link" href="${URLUtils.https('Product-Show', 'pid', productDetail.id)}" hreflang="${request.getLocale()}" style="display: block;width: 100%;">
                                            <img class="product-image" src="${productDetail.imageUrl}"
                                                alt="${productDetail.name}" title="${productDetail.name}"
                                                itemprop="image" style="width: 100%;margin: 0 auto;"/>
                                        </a>
                                    </div>
                                    <div class="detail-wrapper" style="height: 149px;table-layout: auto;display: table-cell;vertical-align: bottom;width: 100vw;">
                                        <div class="product-details" style="text-align: center;">
                                            <isif condition="${productDetail.name}">
                                                <div class="product-name" style="color: #1a1a1a;letter-spacing: .16px;line-height: 20px;font-size: 16px;text-transform: capitalize;font-weight: 600;margin-bottom: 5px;">${productDetail.name}</div>
                                            </isif>
                                            <isif condition="${productDetail.productTitlePartB}">
                                                <div class="product-title-b" style="font-size: 14px;color: #1a1a1a;line-height: 16px;letter-spacing: 0.21px;margin-bottom: 5px;">${productDetail.productTitlePartB}</div>
                                            </isif>
                                            <isif condition="${productDetail.productPrice}">
                                                <div class="product-price" style="color: #1a1a1a;font-weight: 600;font-size: 16px;letter-spacing: .09px;line-height: 20px;">${productDetail.productPrice}</div>
                                            </isif>
                                        </div>
                                        <div class="product-btn-wrapper">
                                            <div>
                                                <!--[if mso]>
                                                <v:rect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="${URLUtils.https('Product-Show', 'pid', productDetail.id)}" style="height:35px;v-text-anchor:middle;width:100%;max-width:80%;margin-top:10px;" strokecolor="#333" fillcolor="#333">
                                                    <w:anchorlock/>
                                                    <center style="font-size:14px;text-transform:uppercase;color:#ffffff;font-family:sans-serif;font-size:13px;">${Resource.msg('btn.label.notifyme', 'email', null)}</center>
                                                </v:rect>
                                                <![endif]-->
                                                <a href="${URLUtils.https('Product-Show', 'pid', productDetail.id)}"
                                                    style="font-size:14px;text-transform:uppercase;background-color:#333;border:1px solid #333;color:#ffffff;display:inline-block;font-family:sans-serif;font-size:14px;line-height:35px;text-align:center;text-decoration:none;width:100%;max-width:80%;margin-top:10px;-webkit-text-size-adjust:none;mso-hide:all;cursor: pointer;">${Resource.msg('btn.label.notifyme', 'email', null)}</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </isloop>
                    </tr>
                    <isset name="rowNo" value="${rowNo + 1}" scope="page" />
                </isloop>
            </table>
        </td>
    </tr>
</isdecorate>
