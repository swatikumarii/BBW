<?xml version="1.0" encoding="UTF-8"?>
<search xmlns="http://www.demandware.com/xml/impex/search2/2010-02-19">
    <searchable-attributes>
        <searchable-attribute>
            <attribute-path>category.displayName</attribute-path>
            <boost>1.01</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>content.ID</attribute-path>
            <boost>1.0</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>content.custom.body</attribute-path>
            <boost>2.0</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>content.description</attribute-path>
            <boost>1.02</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>content.name</attribute-path>
            <boost>1.01</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.ID</attribute-path>
            <boost>1.0</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.brand</attribute-path>
            <boost>3.0</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.custom.fragranceCategory</attribute-path>
            <boost>1.04</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.custom.fragranceDescription</attribute-path>
            <boost>1.05</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.custom.fragranceName</attribute-path>
            <boost>1.03</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.custom.ingredients</attribute-path>
            <boost>2.05</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.longDescription</attribute-path>
            <boost>2.0</boost>
            <auto-correction>false</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.name</attribute-path>
            <boost>1.0</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
        <searchable-attribute>
            <attribute-path>product.custom.titlePartB</attribute-path>
            <boost>1.02</boost>
            <auto-correction>true</auto-correction>
        </searchable-attribute>
    </searchable-attributes>

    <index-settings>
        <full-reindexing-schedule>
            <date-from>2024-03-29Z</date-from>
            <start-time>03:33:00.000Z</start-time>
            <factor>1</factor>
            <unit>days</unit>
        </full-reindexing-schedule>
        <indexed-locales>
            <locale>de-DE</locale>
            <locale>en-AU</locale>
            <locale>x-default</locale>
        </indexed-locales>
        <stemming xml:lang="de-DE">German2</stemming>
        <stemming xml:lang="en-AU">English</stemming>
        <stemming xml:lang="x-default">English</stemming>
    </index-settings>

</search>
