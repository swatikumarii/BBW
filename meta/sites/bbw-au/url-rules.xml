<?xml version="1.0" encoding="UTF-8"?>
<url-rules xmlns="http://www.demandware.com/xml/impex/urlrules/2012-12-01">
    <general-settings>
        <lower-case-urls>true</lower-case-urls>
        <blank-substitute>-</blank-substitute>
        <character-replacements-enabled>true</character-replacements-enabled>
        <character-replacements-for-page-url-enabled>true</character-replacements-for-page-url-enabled>
    </general-settings>
    <category-rule>[ category-path, [ attribute, ID ], / ]</category-rule>
    <category-page-url-override>true</category-page-url-override>
    <category-trailing-slash>false</category-trailing-slash>
    <category-offline-url-generation>true</category-offline-url-generation>
    <category-search-refinement-url-enabled>true</category-search-refinement-url-enabled>
    <category-search-refinements xml:lang="x-default">
        <url-search-refinements>
            <search-refinement-name>titlePartB</search-refinement-name>
        </url-search-refinements>
        <url-search-refinements>
            <search-refinement-name>fragranceName</search-refinement-name>
        </url-search-refinements>
        <url-search-refinements>
            <search-refinement-name>fragranceCategory</search-refinement-name>
        </url-search-refinements>
    </category-search-refinements>
    <product-rule>[ [ constant, p ] , / , [ [ attribute, custom.fragranceName, name ] , - , [ attribute, custom.titlePartB ] ] ]</product-rule>
    <product-page-url-override>true</product-page-url-override>
    <product-id-separator>-</product-id-separator>
    <folder-rule>[ attribute, ID ]</folder-rule>
    <folder-page-url-override>false</folder-page-url-override>
    <folder-trailing-slash>false</folder-trailing-slash>
    <folder-offline-url-generation>true</folder-offline-url-generation>
    <folder-search-refinement-url-enabled>false</folder-search-refinement-url-enabled>
    <content-rule/>
    <content-page-url-override>false</content-page-url-override>
    <content-id-separator>/</content-id-separator>
    <pipeline-aliases xml:lang="x-default">
        <pipeline-alias pipeline="Account-EditProfile">profile</pipeline-alias>
        <pipeline-alias pipeline="Fragrance-Show">shop-by-fragrance</pipeline-alias>
        <pipeline-alias pipeline="Careers-Show">careers</pipeline-alias>
        <pipeline-alias pipeline="Checkout-Begin">checkout-begin</pipeline-alias>
        <pipeline-alias pipeline="Login-CreateAccount">sign-up</pipeline-alias>
        <pipeline-alias pipeline="Address-List">saved-address</pipeline-alias>
        <pipeline-alias pipeline="Fragrance-Ingredient">ingredient</pipeline-alias>
        <pipeline-alias pipeline="Wishlist-Show">wishlist</pipeline-alias>
        <pipeline-alias pipeline="Order-History">orders-list</pipeline-alias>
        <pipeline-alias pipeline="Login-Show">sign-in</pipeline-alias>
        <pipeline-alias pipeline="Search-Show">search</pipeline-alias>
        <pipeline-alias pipeline="Stores-Find">store-locator</pipeline-alias>
        <pipeline-alias pipeline="Order-Status">track-order</pipeline-alias>
        <pipeline-alias pipeline="Cart-Show">cart</pipeline-alias>
        <pipeline-alias pipeline="Blogs-Show">get-inspired</pipeline-alias>
        <pipeline-alias pipeline="CorporateGifting-Landing">corporate-gifting</pipeline-alias>
        <pipeline-alias pipeline="Account-Show">dashboard</pipeline-alias>
        <pipeline-alias pipeline="Order-Confirm">order-confirm</pipeline-alias>
        <pipeline-alias pipeline="Order-Pending">order-pending</pipeline-alias>
        <pipeline-alias pipeline="Order-Failed">order-failed</pipeline-alias>
        <pipeline-alias pipeline="Giftcard-Show">e-giftcard</pipeline-alias>
        <pipeline-alias pipeline="Order-Details">order-details</pipeline-alias>
        <pipeline-alias pipeline="PaymentInstruments-List">payment-methods-list</pipeline-alias>
        <pipeline-alias pipeline="PaymentInstruments-AddPayment">add-payment-method</pipeline-alias>
        <pipeline-alias pipeline="Wishlist-ShowOthers">wishlist-others</pipeline-alias>
        <pipeline-alias pipeline="Login-Logout">logout</pipeline-alias>
        <pipeline-alias pipeline="Account-PasswordReset">reset-password</pipeline-alias>
        <pipeline-alias pipeline="Careers-ApplyForJob">careers/apply-job</pipeline-alias>
    </pipeline-aliases>
    <pipeline-trailing-slash>false</pipeline-trailing-slash>
    <pipeline-perform-redirect>false</pipeline-perform-redirect>
    <character-replacements xml:lang="x-default">
        <character-replacement>
            <character>&amp;</character>
            <replacement>and</replacement>
        </character-replacement>
        <character-replacement>
            <character>'</character>
            <replacement/>
        </character-replacement>
    </character-replacements>
    <search-refinement-url-settings>
        <position>after</position>
        <segment-delimiter>slash</segment-delimiter>
        <refinements-delimiter>slash</refinements-delimiter>
        <value-delimiter>underscore</value-delimiter>
        <conflicting-value-delimiter>blank</conflicting-value-delimiter>
        <exclude-pipeline-alias-type>none</exclude-pipeline-alias-type>
        <product-name-identifier>prefn</product-name-identifier>
        <product-value-identifier>prefv</product-value-identifier>
        <content-name-identifier>crefn</content-name-identifier>
        <content-value-identifier>crefv</content-value-identifier>
    </search-refinement-url-settings>
</url-rules>

