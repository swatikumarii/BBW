<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">

    <type-extension type-id="Product">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="enableNotifyMe">
                <display-name xml:lang="x-default">Enable NotifyMe Button?</display-name>
                <type>boolean</type>
                <site-specific-flag>true</site-specific-flag>
                <mandatory-flag>false</mandatory-flag>
                <visible-flag>false</visible-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <order-required-flag>false</order-required-flag>
                <externally-defined-flag>false</externally-defined-flag>
            </attribute-definition>
            <attribute-definition attribute-id="notifyMeThreshold">
                <display-name xml:lang="x-default">NotifyMe Threshold</display-name>
                <type>double</type>
                <localizable-flag>false</localizable-flag>
                <site-specific-flag>true</site-specific-flag>
                <mandatory-flag>false</mandatory-flag>
                <visible-flag>false</visible-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <order-required-flag>false</order-required-flag>
                <externally-defined-flag>false</externally-defined-flag>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="storefrontAttributes">
                <display-name xml:lang="x-default">Storefront Attributes</display-name>
                <attribute attribute-id="tabDescription"/>
                <attribute attribute-id="tabDetails"/>
                <attribute attribute-id="refinementColor"/>
                <attribute attribute-id="notifyMeThreshold"/>
                <attribute attribute-id="enableNotifyMe"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="notifyEmailThreshold">
                <display-name xml:lang="x-default">Notify Email Threshold</display-name>
                <description xml:lang="x-default">Notify me Email Threshold for all the product which do not have the value explicitly defined.</description>
                <type>double</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-value>0.0</min-value>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="Storefront Configs">
                <display-name xml:lang="x-default">Storefront Configurations</display-name>
                <attribute attribute-id="listPriceDefault"/>
                <attribute attribute-id="GoogleVerificationTag"/>
                <attribute attribute-id="countryCode"/>
                <attribute attribute-id="customerServiceEmail"/>
                <attribute attribute-id="mapAPI"/>
                <attribute attribute-id="notifyEmailThreshold"/>
            </attribute-group>
        </group-definitions>
    </type-extension>

</metadata>
